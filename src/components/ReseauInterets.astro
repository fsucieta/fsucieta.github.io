---
interface Props {
  titre?: string;
  acteurPublic: string;
  delegatairePrive: string;
  actionnaireFinal: string;
  montantPublic?: string;
  typeContrat?: string;
  remonteeDividendes?: string;
}

const {
  titre = "Cartographie Relationnelle des Réseaux d'Affaires",
  acteurPublic,
  delegatairePrive,
  actionnaireFinal,
  montantPublic = "Fonds Publics",
  typeContrat = "Contrat / DSP",
  remonteeDividendes = "Remontée Dividendes"
} = Astro.props;
---

<div class="relative my-8 rounded-2xl p-[1px] bg-gradient-to-b from-amber-500/20 via-slate-800 to-transparent shadow-xl">
  <div class="bg-slate-900/80 backdrop-blur-xl rounded-2xl p-5 md:p-6 space-y-4 border border-white/5">
    
    <div class="flex items-center justify-between border-b border-white/10 pb-3">
      <h4 class="text-sm md:text-base font-serif font-bold text-slate-100">
        {titre}
      </h4>
      <span class="text-[10px] font-mono text-cyan-400 bg-cyan-950/50 border border-cyan-500/30 px-2.5 py-0.5 rounded-full uppercase font-bold">
        FollowTheMoney (OCCRP)
      </span>
    </div>

    <!-- Schéma des flux -->
    <div class="w-full overflow-x-auto py-2">
      <div class="min-w-[550px] flex items-center justify-between gap-3 relative font-sans">
        
        <!-- Nœud 1 : Public -->
        <div class="flex-1 bg-slate-950 border border-amber-500/40 rounded-xl p-3.5 text-center space-y-1 shadow-md">
          <span class="text-[10px] font-mono text-amber-400 uppercase font-bold tracking-wider block">Autorité Publique</span>
          <div class="text-xs font-bold text-slate-100 truncate">{acteurPublic}</div>
          <div class="text-[11px] font-mono text-slate-400">{montantPublic}</div>
        </div>

        <!-- Flèche 1 -->
        <div class="flex flex-col items-center justify-center shrink-0">
          <span class="text-[10px] font-mono text-slate-400 font-bold mb-0.5">{typeContrat}</span>
          <div class="w-10 h-0.5 bg-gradient-to-r from-amber-500 to-cyan-500"></div>
          <span class="text-[10px] text-cyan-400 mt-0.5">▶</span>
        </div>

        <!-- Nœud 2 : Privé -->
        <div class="flex-1 bg-slate-950 border border-cyan-500/40 rounded-xl p-3.5 text-center space-y-1 shadow-md">
          <span class="text-[10px] font-mono text-cyan-400 uppercase font-bold tracking-wider block">Délégataire Privé</span>
          <div class="text-xs font-bold text-slate-100 truncate">{delegatairePrive}</div>
          <div class="text-[11px] font-mono text-cyan-300">Exploitant Local</div>
        </div>

        <!-- Flèche 2 -->
        <div class="flex flex-col items-center justify-center shrink-0">
          <span class="text-[10px] font-mono text-red-400 font-bold mb-0.5">{remonteeDividendes}</span>
          <div class="w-10 h-0.5 bg-gradient-to-r from-cyan-500 to-red-500"></div>
          <span class="text-[10px] text-red-400 mt-0.5">▶</span>
        </div>

        <!-- Nœud 3 : Actionnaire -->
        <div class="flex-1 bg-slate-950 border border-red-500/40 rounded-xl p-3.5 text-center space-y-1 shadow-md">
          <span class="text-[10px] font-mono text-red-400 uppercase font-bold tracking-wider block">Actionnaire Ultime</span>
          <div class="text-xs font-bold text-slate-100 truncate">{actionnaireFinal}</div>
          <div class="text-[11px] font-mono text-red-300">Bénéficiaire Effectif</div>
        </div>

      </div>
    </div>

    <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 pt-1 border-t border-white/5">
      <span>Modélisation : Graphe financier conforme ISO 27037</span>
      <span class="text-amber-400/80">Traçabilité des flux</span>
    </div>

  </div>
</div>
