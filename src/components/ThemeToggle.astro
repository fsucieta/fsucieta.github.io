---
---
<div class="flex flex-col items-end">
  <span class="text-[9px] font-mono text-slate-500 uppercase tracking-wider mb-1 block">Mode d'affichage</span>
  <button
    id="themeToggle"
    type="button"
    class="px-3 py-1.5 rounded-xl border text-xs font-bold font-mono transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-md"
    aria-label="Changer le mode d'affichage jour ou nuit"
  >
    <span id="themeIcon">🌙</span>
    <span id="themeLabel">MODE NUIT</span>
  </button>
</div>

<script is:inline>
  const themeToggle = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');
  const themeLabel = document.getElementById('themeLabel');

  function getPreferredTheme() {
    const saved = localStorage.getItem('theme');
    if (saved) return saved;
    return 'dark'; // Thème par défaut: Mode Nuit
  }

  function applyTheme(theme) {
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      if (themeIcon) themeIcon.textContent = '☀️';
      if (themeLabel) themeLabel.textContent = 'MODE JOUR (PRESSE)';
      if (themeToggle) {
        themeToggle.className = "px-3 py-1.5 rounded-xl border border-amber-500/50 bg-amber-50 text-slate-900 text-xs font-bold font-mono hover:bg-amber-100 transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-md";
      }
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.classList.add('dark');
      if (themeIcon) themeIcon.textContent = '🌙';
      if (themeLabel) themeLabel.textContent = 'MODE NUIT (FORENSIC)';
      if (themeToggle) {
        themeToggle.className = "px-3 py-1.5 rounded-xl border border-amber-500/40 bg-slate-900 text-amber-400 text-xs font-bold font-mono hover:bg-slate-800 transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-md";
      }
    }
    localStorage.setItem('theme', theme);
  }

  const currentTheme = getPreferredTheme();
  applyTheme(currentTheme);

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const activeTheme = document.documentElement.classList.contains('light') ? 'dark' : 'light';
      applyTheme(activeTheme);
    });
  }
</script>
