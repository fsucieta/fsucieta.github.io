---
---
<div class="flex flex-col items-end">
  <span class="text-[9px] font-mono text-slate-500 uppercase tracking-wider mb-1 block">Mode d'affichage</span>
  <button
    id="themeToggle"
    type="button"
    class="theme-toggle-btn px-3 py-1.5 rounded-xl border text-xs font-bold font-mono transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-md"
    aria-label="Changer le mode d'affichage jour ou nuit"
  >
    <span class="theme-icon">🌙</span>
    <span class="theme-label">MODE NUIT</span>
  </button>
</div>

<script is:inline>
  (function() {
    function updateThemeUI(theme) {
      var isLight = (theme === 'light');
      if (isLight) {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
        document.documentElement.classList.add('dark');
      }

      var buttons = document.querySelectorAll('.theme-toggle-btn, #themeToggle');
      buttons.forEach(function(btn) {
        var icon = btn.querySelector('.theme-icon, #themeIcon');
        var label = btn.querySelector('.theme-label, #themeLabel');
        if (isLight) {
          if (icon) icon.textContent = '☀️';
          if (label) label.textContent = 'MODE JOUR (PRESSE)';
          btn.className = "theme-toggle-btn px-3 py-1.5 rounded-xl border border-amber-500/50 bg-amber-50 text-slate-900 text-xs font-bold font-mono hover:bg-amber-100 transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-md";
        } else {
          if (icon) icon.textContent = '🌙';
          if (label) label.textContent = 'MODE NUIT (FORENSIC)';
          btn.className = "theme-toggle-btn px-3 py-1.5 rounded-xl border border-amber-500/40 bg-slate-900 text-amber-400 text-xs font-bold font-mono hover:bg-slate-800 transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-md";
        }
      });
      localStorage.setItem('theme', theme);
    }

    window.toggleAppTheme = function() {
      var current = localStorage.getItem('theme') || 'dark';
      var nextTheme = (current === 'light') ? 'dark' : 'light';
      updateThemeUI(nextTheme);
    };

    function initThemeButtons() {
      var saved = localStorage.getItem('theme') || 'dark';
      updateThemeUI(saved);

      var buttons = document.querySelectorAll('.theme-toggle-btn, #themeToggle');
      buttons.forEach(function(btn) {
        btn.onclick = function(e) {
          e.preventDefault();
          window.toggleAppTheme();
        };
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initThemeButtons);
    } else {
      initThemeButtons();
    }
  })();
</script>
