---
// ThemeToggle.astro — Sélecteur Dual-Axis Tri-Palette L'OCHJU
// Axe 1 : Mode Nuit / Jour (classe .dark / .light sur <html>)
// Axe 2 : Palette Paolien / FININT / Granit (attribut data-palette sur <html>)
// Persistance indépendante via localStorage : 'lochju-mode' et 'lochju-palette'
---

<div class="flex flex-col items-end gap-1.5" id="lochju-theme-selector">

  <!-- Libellé discret -->
  <span class="text-[9px] font-mono text-slate-500 uppercase tracking-wider hidden sm:block">Thème</span>

  <!-- Conteneur principal du double sélecteur -->
  <div class="flex items-center gap-1.5 bg-slate-900/80 border border-slate-800 rounded-xl p-1 shadow-lg backdrop-blur-sm">

    <!-- === AXE 1 : Toggle Mode Nuit / Jour === -->
    <button
      id="modeToggleBtn"
      type="button"
      title="Basculer entre Mode Nuit et Mode Jour"
      aria-label="Changer le mode d'affichage"
      class="px-2.5 py-1.5 rounded-lg text-xs font-bold font-mono transition-all duration-300 flex items-center gap-1.5 cursor-pointer border border-transparent hover:border-slate-700"
      style="min-width: 80px;"
    >
      <span id="modeIcon" class="text-base leading-none">🌙</span>
      <span id="modeLabel" class="hidden sm:inline">NUIT</span>
    </button>

    <!-- Séparateur -->
    <div class="w-px h-6 bg-slate-700/60"></div>

    <!-- === AXE 2 : Sélecteur Palette === -->
    <!-- Swatch Paolien (Or Antique) -->
    <button
      id="palettePaoli"
      type="button"
      title="🏛️ Thème Paolien — Chambre des Comptes 1755 (Obsidienne & Or Antique)"
      aria-label="Thème Paolien"
      class="group relative w-7 h-7 rounded-lg border-2 transition-all duration-300 cursor-pointer flex items-center justify-center"
      style="background: linear-gradient(135deg, #0b0f17 50%, #d4af37 50%);"
    >
      <span class="absolute -top-8 left-1/2 -translate-x-1/2 text-[10px] font-mono bg-slate-800 text-amber-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap border border-slate-700 z-50">🏛️ PAO</span>
    </button>

    <!-- Swatch FININT (Émeraude) -->
    <button
      id="paletteFinint"
      type="button"
      title="📊 Thème Bloomberg FININT — Terminal Renseignement Financier (Cobalt & Émeraude)"
      aria-label="Thème Bloomberg FININT"
      class="group relative w-7 h-7 rounded-lg border-2 transition-all duration-300 cursor-pointer flex items-center justify-center"
      style="background: linear-gradient(135deg, #080d18 50%, #10b981 50%);"
    >
      <span class="absolute -top-8 left-1/2 -translate-x-1/2 text-[10px] font-mono bg-slate-800 text-emerald-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap border border-slate-700 z-50">📊 FIN</span>
    </button>

    <!-- Swatch Granit (Cuivre Martelé) -->
    <button
      id="paletteGranit"
      type="button"
      title="🌿 Thème Granit Insulaire — Maquis, Schiste & Châtaigneraie (Ardoise & Cuivre)"
      aria-label="Thème Granit Insulaire"
      class="group relative w-7 h-7 rounded-lg border-2 transition-all duration-300 cursor-pointer flex items-center justify-center"
      style="background: linear-gradient(135deg, #0d1112 50%, #c26d43 50%);"
    >
      <span class="absolute -top-8 left-1/2 -translate-x-1/2 text-[10px] font-mono bg-slate-800 text-orange-400 px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap border border-slate-700 z-50">🌿 GRA</span>
    </button>

  </div>
</div>

<script is:inline>
(function() {
  /* ============================================================
   * CONTRÔLEUR TRI-PALETTE BI-MODE — L'OCHJU ThemeToggle
   * Persistance indépendante :
   *   localStorage['lochju-mode']    = 'dark' | 'light'
   *   localStorage['lochju-palette'] = 'paoli' | 'finint' | 'granit'
   * ============================================================ */

  const html = document.documentElement;
  const modeBtn      = document.getElementById('modeToggleBtn');
  const modeIcon     = document.getElementById('modeIcon');
  const modeLabel    = document.getElementById('modeLabel');
  const btnPaoli     = document.getElementById('palettePaoli');
  const btnFinint    = document.getElementById('paletteFinint');
  const btnGranit    = document.getElementById('paletteGranit');

  /* --- Helpers --- */
  function getCurrentMode()    { return localStorage.getItem('lochju-mode')    || 'dark'; }
  function getCurrentPalette() { return localStorage.getItem('lochju-palette') || 'granit'; }

  /* --- Application du mode (nuit / jour) --- */
  function applyMode(mode) {
    html.classList.remove('dark', 'light');
    html.classList.add(mode);
    localStorage.setItem('lochju-mode', mode);

    if (mode === 'dark') {
      if (modeIcon)  modeIcon.textContent  = '🌙';
      if (modeLabel) modeLabel.textContent = 'NUIT';
      if (modeBtn) {
        modeBtn.style.color      = 'var(--accent-primary, #c26d43)';
        modeBtn.style.background = 'rgba(15,21,30,0.8)';
      }
    } else {
      if (modeIcon)  modeIcon.textContent  = '☀️';
      if (modeLabel) modeLabel.textContent = 'JOUR';
      if (modeBtn) {
        modeBtn.style.color      = 'var(--text-muted, #475569)';
        modeBtn.style.background = 'rgba(248,247,242,0.9)';
      }
    }
  }

  /* --- Application de la palette --- */
  function applyPalette(palette) {
    html.setAttribute('data-palette', palette);
    localStorage.setItem('lochju-palette', palette);

    /* Activer / désactiver visuellement les swatches */
    var swatches = [
      { btn: btnPaoli,  name: 'paoli'  },
      { btn: btnFinint, name: 'finint' },
      { btn: btnGranit, name: 'granit' }
    ];

    swatches.forEach(function(s) {
      if (!s.btn) return;
      if (s.name === palette) {
        s.btn.style.border        = '2px solid rgba(255,255,255,0.9)';
        s.btn.style.boxShadow     = '0 0 0 2px rgba(255,255,255,0.2), 0 0 12px rgba(255,255,255,0.12)';
        s.btn.style.transform     = 'scale(1.15)';
        s.btn.style.outline       = '2px solid rgba(255,255,255,0.08)';
        s.btn.style.outlineOffset = '2px';
      } else {
        s.btn.style.border        = '2px solid transparent';
        s.btn.style.boxShadow     = 'none';
        s.btn.style.transform     = 'scale(1)';
        s.btn.style.outline       = 'none';
      }
    });
  }

  /* --- Initialisation au chargement --- */
  function init() {
    applyMode(getCurrentMode());
    applyPalette(getCurrentPalette());
  }

  init();

  /* --- Gestionnaires d'événements --- */
  if (modeBtn) {
    modeBtn.addEventListener('click', function() {
      applyMode(getCurrentMode() === 'dark' ? 'light' : 'dark');
    });
  }

  if (btnPaoli)   btnPaoli.addEventListener('click',  function() { applyPalette('paoli');  });
  if (btnFinint)  btnFinint.addEventListener('click', function() { applyPalette('finint'); });
  if (btnGranit)  btnGranit.addEventListener('click', function() { applyPalette('granit'); });

})();
</script>