---
---
<button
  id="themeToggle"
  type="button"
  class="px-3.5 py-1.5 rounded-full border text-xs font-bold font-mono transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-sm"
  aria-label="Changer le thème"
>
  <span id="themeIcon">🌙</span>
  <span id="themeLabel">FORENSIC NUIT</span>
</button>

<script is:inline>
  const themeToggle = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');
  const themeLabel = document.getElementById('themeLabel');

  function getPreferredTheme() {
    const saved = localStorage.getItem('theme');
    if (saved) return saved;
    return 'dark'; // Thème par défaut: Forensic Nuit
  }

  function applyTheme(theme) {
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
      document.documentElement.classList.add('light');
      if (themeIcon) themeIcon.textContent = '☀️';
      if (themeLabel) themeLabel.textContent = 'PRESSE JOUR';
      if (themeToggle) {
        themeToggle.className = "px-3.5 py-1.5 rounded-full border border-red-900/30 bg-amber-50/90 text-red-950 text-xs font-bold font-mono hover:bg-amber-100 transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-sm";
      }
    } else {
      document.documentElement.classList.remove('light');
      document.documentElement.classList.add('dark');
      if (themeIcon) themeIcon.textContent = '🌙';
      if (themeLabel) themeLabel.textContent = 'FORENSIC NUIT';
      if (themeToggle) {
        themeToggle.className = "px-3.5 py-1.5 rounded-full border border-cyan-500/30 bg-slate-900 text-cyan-400 text-xs font-bold font-mono hover:bg-slate-800 transition-all duration-300 flex items-center gap-2 cursor-pointer shadow-sm";
      }
    }
    localStorage.setItem('theme', theme);
  }

  const currentTheme = getPreferredTheme();
  applyTheme(currentTheme);

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const activeTheme = document.documentElement.classList.contains('light') ? 'dark' : 'light';
      applyTheme(activeTheme);
    });
  }
</script>
