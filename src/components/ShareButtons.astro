---
// Composant réutilisable de partage social pour L'OCHJU
// Supporte : X (Twitter), Facebook, WhatsApp, Telegram, et Copie de lien
interface Props {
  title: string;
  url?: string;
  chapeau?: string;
}

const { title, url = '', chapeau = '' } = Astro.props;
---

<div class="share-buttons-container flex flex-wrap items-center gap-2" data-title={title} data-url={url} data-chapeau={chapeau}>
  <!-- Bouton X / Twitter -->
  <button 
    type="button"
    class="share-x-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-black text-slate-200 hover:text-white border border-slate-800 hover:border-slate-700 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Partager sur X (Twitter)"
  >
    <span>✖️</span> <span class="hidden sm:inline">X</span>
  </button>

  <!-- Bouton TikTok Carrousels Officiels -->
  <a 
    href="https://www.tiktok.com/@lochjulaveti"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-[#ff0050]/20 text-slate-200 hover:text-white border border-slate-800 hover:border-[#ff0050]/50 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Rejoindre les synthèses visuelles sur TikTok (@lochjulaveti)"
  >
    <span>📱</span> <span class="hidden sm:inline">TikTok</span>
  </a>

  <!-- Bouton WhatsApp Partage de Proximité -->
  <button 
    type="button"
    class="share-wa-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-[#25D366]/20 text-slate-200 hover:text-white border border-slate-800 hover:border-[#25D366]/50 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Diffuser dans vos cercles WhatsApp de confiance"
  >
    <span>💬</span> <span class="hidden sm:inline">WhatsApp</span>
  </button>

  <!-- Bouton Copier le lien -->
  <button 
    type="button"
    class="share-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500 text-amber-300 hover:text-slate-950 border border-amber-500/30 text-xs font-mono font-bold transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Copier le lien direct"
  >
    <span class="copy-icon">🔗</span> <span class="copy-label">Copier</span>
  </button>
</div>

<script>
  // Initialisation dynamique des boutons de partage
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.share-buttons-container').forEach((container) => {
      const el = container as HTMLElement;
      const getShareUrl = () => {
        const rawUrl = el.dataset.url;
        if (rawUrl && rawUrl.startsWith('http')) return rawUrl;
        if (rawUrl) {
          const origin = window.location.origin;
          return `${origin}/${rawUrl.replace(/^\.\//, '').replace(/^\//, '')}`;
        }
        return window.location.href;
      };

      const title = el.dataset.title || document.title;
      const chapeau = el.dataset.chapeau || '';

      // Partage X
      el.querySelector('.share-x-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        const tweetText = `🔴 Enquête L'OCHJU : ${title}\n\n${chapeau ? chapeau.slice(0, 140) + '...' : ''}\n\nÀ lire ici :`;
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(url)}`, '_blank', 'noopener,noreferrer,width=600,height=400');
      });

      // Partage WhatsApp (canaux familiaux & de confiance)
      el.querySelector('.share-wa-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        const text = `🔴 *Enquête L'OCHJU : ${title}*\n\n${chapeau ? chapeau + '\n\n' : ''}👉 ${url}`;
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
      });

      // Copier le lien
      el.querySelector('.share-copy-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        navigator.clipboard.writeText(url).then(() => {
          const btn = el.querySelector('.share-copy-btn') as HTMLElement;
          const label = btn?.querySelector('.copy-label') as HTMLElement;
          const icon = btn?.querySelector('.copy-icon') as HTMLElement;
          if (label && icon) {
            label.innerText = 'Copié !';
            icon.innerText = '✅';
            setTimeout(() => {
              label.innerText = 'Copier';
              icon.innerText = '🔗';
            }, 2500);
          }
        });
      });
    });
  });
</script>
