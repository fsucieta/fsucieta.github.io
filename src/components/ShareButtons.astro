---
// ====================================================================
// COMPOSANT MAÎTRE DE PARTAGE CITOYEN — L'OCHJU
// Supporte : X (Twitter), Facebook, WhatsApp, Partage Mobile (SMS/Signal) & Copie directe
// ====================================================================
interface Props {
  title: string;
  url?: string;
  chapeau?: string;
}

const { title, url = '', chapeau = '' } = Astro.props;
---

<div class="share-buttons-container flex flex-wrap items-center gap-2" data-title={title} data-url={url} data-chapeau={chapeau}>
  <!-- Bouton X / Twitter -->
  <button 
    type="button"
    class="share-x-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-black text-slate-200 hover:text-white border border-slate-800 hover:border-slate-700 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Diffuser cette enquête sur X (Twitter)"
  >
    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
    <span class="hidden sm:inline">X</span>
  </button>

  <!-- Bouton Facebook Officiel -->
  <button 
    type="button"
    class="share-fb-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-[#1877F2]/20 text-slate-200 hover:text-white border border-slate-800 hover:border-[#1877F2]/60 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Partager cette enquête sur Facebook"
  >
    <svg class="w-3.5 h-3.5 fill-current text-[#1877F2]" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
    <span class="hidden sm:inline">Facebook</span>
  </button>

  <!-- Bouton WhatsApp Proximité -->
  <button 
    type="button"
    class="share-wa-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-[#25D366]/20 text-slate-200 hover:text-white border border-slate-800 hover:border-[#25D366]/60 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Diffuser dans vos cercles et groupes WhatsApp"
  >
    <svg class="w-3.5 h-3.5 fill-current text-[#25D366]" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.77.828 2.791.828 3.18 0 5.767-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm0 10.518c-.896 0-1.636-.263-2.378-.716l-.17-.104-1.764.463.471-1.721-.115-.183c-.496-.788-.758-1.552-.757-2.49 0-2.618 2.13-4.748 4.748-4.748 2.618 0 4.748 2.13 4.748 4.748 0 2.617-2.13 4.747-4.748 4.747z"/></svg>
    <span class="hidden sm:inline">WhatsApp</span>
  </button>

  <!-- Bouton Partage Mobile Natif (SMS, Signal, etc.) -->
  <button 
    type="button"
    class="share-native-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-amber-500/20 text-slate-200 hover:text-amber-400 border border-slate-800 hover:border-amber-500/50 text-xs font-mono font-medium transition-all duration-200 cursor-pointer shadow-sm active:scale-95 sm:hidden"
    title="Partager via vos applications mobiles"
  >
    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
    <span>Partager</span>
  </button>

  <!-- Bouton Copier le lien -->
  <button 
    type="button"
    class="share-copy-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500 text-amber-300 hover:text-slate-950 border border-amber-500/30 text-xs font-mono font-bold transition-all duration-200 cursor-pointer shadow-sm active:scale-95"
    title="Copier le lien direct de l'enquête"
  >
    <span class="copy-icon">🔗</span> <span class="copy-label">Copier</span>
  </button>
</div>

<script>
  // Initialisation dynamique et robuste des boutons de partage
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.share-buttons-container').forEach((container) => {
      const el = container as HTMLElement;
      const getShareUrl = () => {
        const rawUrl = el.dataset.url;
        if (rawUrl && rawUrl.startsWith('http')) return rawUrl;
        if (rawUrl) {
          const origin = window.location.origin;
          return `${origin}/${rawUrl.replace(/^\.\//, '').replace(/^\//, '')}`;
        }
        return window.location.href;
      };

      const title = el.dataset.title || document.title;
      const chapeau = el.dataset.chapeau || '';

      // 1. Partage X (Twitter) avec texte pré-rempli
      el.querySelector('.share-x-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        const tweetText = `🔴 Enquête L'OCHJU : ${title}\n\n${chapeau ? chapeau.slice(0, 140) + '...' : ''}\n\nÀ lire ici :`;
        window.open(`https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(url)}`, '_blank', 'noopener,noreferrer,width=600,height=400');
      });

      // 2. Partage Facebook
      el.querySelector('.share-fb-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        window.open(`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`, '_blank', 'noopener,noreferrer,width=600,height=400');
      });

      // 3. Partage WhatsApp
      el.querySelector('.share-wa-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        const text = `🔴 *Enquête L'OCHJU : ${title}*\n\n${chapeau ? chapeau + '\n\n' : ''}👉 ${url}`;
        window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
      });

      // 4. Partage Mobile Natif (Web Share API)
      el.querySelector('.share-native-btn')?.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        if (navigator.share) {
          try {
            await navigator.share({
              title: `Enquête L'OCHJU : ${title}`,
              text: chapeau ? chapeau.slice(0, 140) + '...' : `Enquête L'OCHJU : ${title}`,
              url: url
            });
          } catch (err) {
            // Annulation normale
          }
        }
      });

      // 5. Copier le lien
      el.querySelector('.share-copy-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const url = getShareUrl();
        navigator.clipboard.writeText(url).then(() => {
          const btn = el.querySelector('.share-copy-btn') as HTMLElement;
          const label = btn?.querySelector('.copy-label') as HTMLElement;
          const icon = btn?.querySelector('.copy-icon') as HTMLElement;
          if (label && icon) {
            label.innerText = 'Copié !';
            icon.innerText = '✅';
            setTimeout(() => {
              label.innerText = 'Copier';
              icon.innerText = '🔗';
            }, 2500);
          }
        });
      });
    });
  });
</script>
