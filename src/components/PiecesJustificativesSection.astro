const t = i18n[currentLang as keyof typeof i18n] || i18n.fr;

// Résolution intelligente des liens selon la langue et la structure d'URL
function resolveDocHref(rawTarget: string, langKey: string): string {
  if (!rawTarget) return '#';
  if (rawTarget.startsWith('http')) return rawTarget;
  const clean = rawTarget.replace(/^(\.\.\/)+/, '').replace(/^\//, '');
  
  if (langKey === 'fr') {
    return `/${clean}`;
  } else if (langKey === 'en') {
    return `/${clean}`;
  } else {
    return `/${clean}`;
  }
}
---

{sources && sources.length > 0 && (
  <section id="pieces-justificatives-officielles" class="mt-16 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 border border-emerald-500/30 p-6 md:p-8 rounded-3xl shadow-2xl space-y-6 not-prose">
    
    <!-- En-tête de la section des pièces -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-5">
      <div class="space-y-1">
        <div class="flex items-center gap-2">
          <span class="text-xl">📂</span>
          <h3 class="text-lg md:text-xl font-bold font-sans text-emerald-400 m-0">
            {t.sectionTitle} <span class="text-emerald-300/80 font-mono text-sm">({sources.length})</span>
          </h3>
        </div>
        <p class="text-[11px] font-mono text-slate-400 m-0">
          {t.badgeIso}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="text-[10px] font-mono bg-emerald-500/15 text-emerald-300 px-3 py-1.5 rounded-full border border-emerald-500/30 font-bold tracking-wide">
          🔒 {t.badgeSha}
        </span>
      </div>
    </div>

    <!-- Bandeau pédagogique dépliable -->
    <details class="bg-slate-900/90 border border-cyan-500/30 rounded-2xl p-4 cursor-pointer group transition">
      <summary class="font-sans font-bold text-xs text-cyan-300 flex items-center justify-between select-none">
        <span class="flex items-center gap-2">
          <span>💡</span> 
          <span>{t.howItWorksTitle}</span> 
          <span class="text-cyan-400/70 font-normal">{t.howItWorksClick}</span>
        </span>
        <span class="text-cyan-400 group-open:rotate-180 transition transform text-xs font-mono">▼</span>
      </summary>
      
      <div class="mt-4 text-xs font-sans text-slate-300 space-y-3 leading-relaxed border-t border-slate-800 pt-3">
        <div class="space-y-1">
          <div class="font-bold text-cyan-300 font-mono text-[11px] flex items-center gap-1.5">
            <span>🔒</span> <span>{t.whyShaTitle}</span>
          </div>
          <p class="text-slate-400 text-[11px] m-0">
            {t.whyShaDesc}
          </p>
        </div>

        <div class="space-y-1">
          <div class="font-bold text-amber-300 font-mono text-[11px] flex items-center gap-1.5">
            <span>🏛️</span> <span>{t.whyCadaTitle}</span>
          </div>
          <p class="text-slate-400 text-[11px] m-0">
            {t.whyCadaDesc}
          </p>
        </div>
      </div>
    </details>

    <!-- Grille des pièces justificatives avec actions directes -->
    <div class="grid grid-cols-1 gap-4 pt-2">
      {sources.map((src, index) => {
        const rawTarget = src.pdfDirect || src.url;
        const finalHref = resolveDocHref(rawTarget, currentLang);
        const isPdfOrCsv = rawTarget.toLowerCase().endsWith('.pdf') || rawTarget.toLowerCase().endsWith('.csv');
        const isExternal = rawTarget.startsWith('http');

        return (
          <div class="bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-emerald-500/50 p-5 rounded-2xl transition duration-200 flex flex-col lg:flex-row lg:items-center justify-between gap-4 shadow-lg group">
            
            <!-- Informations de la pièce -->
            <div class="space-y-2 min-w-0 flex-1">
              <div class="flex items-start gap-2.5">
                <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-mono font-bold text-xs border border-emerald-500/30 shrink-0 mt-0.5">
                  #{String(index + 1).padStart(2, '0')}
                </span>
                <div class="min-w-0">
                  <h4 class="text-sm font-sans font-bold text-slate-100 group-hover:text-emerald-300 transition leading-snug m-0">
                    {src.name}
                  </h4>
                  <div class="flex flex-wrap items-center gap-2 mt-1.5 text-[10px] font-mono text-slate-400">
                    <span class="text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 font-semibold">
                      ✓ {t.docCertified}
                    </span>
                    <span>• {t.instantConsult}</span>
                  </div>
                </div>
              </div>

              <!-- Empreinte SHA-256 avec bouton de copie -->
              {src.sha256 && (
                <div class="pt-1 flex flex-wrap items-center gap-2 font-mono text-[11px]">
                  <span class="text-slate-500 uppercase text-[10px] font-bold">SHA-256:</span>
                  <code class="text-amber-300/90 bg-black/40 px-2 py-0.5 rounded border border-white/5 select-all truncate max-w-[280px] sm:max-w-md font-mono text-[10px]">
                    {src.sha256}
                  </code>
                  <button 
                    type="button"
                    onclick={`navigator.clipboard.writeText('${src.sha256}'); alert('${t.hashCopied}');`}
                    class="text-[10px] bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white px-2 py-0.5 rounded border border-slate-700 transition cursor-pointer font-bold inline-flex items-center gap-1"
                    title={t.copyHash}
                  >
                    <span>📋</span> <span>{t.copyHash}</span>
                  </button>
                </div>
              )}
            </div>

            <!-- Boutons d'accès directs (Consulter / Télécharger) -->
            <div class="flex items-center gap-2 shrink-0 w-full lg:w-auto pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-800">
              <a 
                href={finalHref}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-none px-4 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl font-mono text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-1.5 cursor-pointer uppercase tracking-wider"
              >
                <span>↗️</span> <span>{t.openDoc}</span>
              </a>

              {isPdfOrCsv && !isExternal && (
                <a 
                  href={finalHref}
                  download
                  class="px-3.5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-mono text-xs font-bold rounded-xl border border-slate-700 transition flex items-center justify-center gap-1.5 cursor-pointer"
                  title={t.downloadDoc}
                >
                  <span>📥</span> <span class="hidden sm:inline">{t.downloadDoc}</span>
                </a>
              )}
            </div>

          </div>
        );
      })}
    </div>

    <!-- Note d'appui citoyen & CADA -->
    <div class="pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
      <div class="flex items-center gap-2 text-slate-400 text-[11px]">
        <span>⚖️</span>
        <span>{t.cadaHelp}</span>
      </div>

      <a 
        href={currentLang === 'fr' ? "/#cada-generator" : `/${currentLang}/#cada-generator`}
        class="shrink-0 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/30 text-xs font-mono font-bold transition flex items-center gap-2"
      >
        <span>{t.cadaBtn} →</span>
      </a>
    </div>

  </section>
)}
