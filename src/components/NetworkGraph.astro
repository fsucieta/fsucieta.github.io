---
---
<div class="bg-slate-950 border border-amber-500/30 rounded-2xl p-6 md:p-8 shadow-2xl my-12">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        NETWORK FORENSICS — STYLE ICIJ OFFSHORE LEAKS
      </span>
      <h3 class="text-2xl font-bold font-serif text-slate-100 mt-2">
        🌐 Explorateur de Réseaux d'Influence & Prête-Noms
      </h3>
    </div>
    <div class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
      Visualisation interactive des connexions foncières & financières
    </div>
  </div>

  <!-- Conteneur Graphe Canvas / SVG -->
  <div class="relative w-full h-[400px] bg-slate-900/90 rounded-xl border border-slate-800 flex items-center justify-center overflow-hidden" id="networkCanvasContainer">
    <svg id="networkSvg" class="w-full h-full" viewBox="0 0 900 400">
      <!-- Lignes de connexions -->
      <line x1="450" y1="200" x2="180" y2="100" stroke="#007791" stroke-width="2" stroke-dasharray="4,4" />
      <line x1="450" y1="200" x2="720" y2="100" stroke="#007791" stroke-width="2" stroke-dasharray="4,4" />
      <line x1="450" y1="200" x2="220" y2="300" stroke="#b8860b" stroke-width="2" />
      <line x1="450" y1="200" x2="680" y2="300" stroke="#b8860b" stroke-width="2" />
      <line x1="180" y1="100" x2="220" y2="300" stroke="#38bdf8" stroke-width="1.5" />
      <line x1="720" y1="100" x2="680" y2="300" stroke="#38bdf8" stroke-width="1.5" />

      <!-- Noeud Central : Enquête / Dossier -->
      <g transform="translate(450,200)" class="cursor-pointer hover:scale-110 transition duration-300">
        <circle r="42" fill="#0f172a" stroke="#d4af37" stroke-width="3" />
        <text y="4" text-anchor="middle" fill="#d4af37" font-family="sans-serif" font-size="12" font-weight="bold">DOSSIER #01-26</text>
      </g>

      <!-- Noeud 1 : SCI Non-Résidente -->
      <g transform="translate(180,100)" class="cursor-pointer hover:scale-110 transition duration-300">
        <circle r="32" fill="#1e293b" stroke="#007791" stroke-width="2" />
        <text y="4" text-anchor="middle" fill="#38bdf8" font-family="sans-serif" font-size="10" font-weight="bold">SCI ÉCRAN</text>
      </g>

      <!-- Noeud 2 : Prête-Noms / Ayant Droit INPI RBE -->
      <g transform="translate(720,100)" class="cursor-pointer hover:scale-110 transition duration-300">
        <circle r="32" fill="#1e293b" stroke="#007791" stroke-width="2" />
        <text y="4" text-anchor="middle" fill="#38bdf8" font-family="sans-serif" font-size="10" font-weight="bold">BÉNÉFICIAIRE RBE</text>
      </g>

      <!-- Noeud 3 : Permis Tacite R. 424-1 -->
      <g transform="translate(220,300)" class="cursor-pointer hover:scale-110 transition duration-300">
        <circle r="32" fill="#1e293b" stroke="#b8860b" stroke-width="2" />
        <text y="4" text-anchor="middle" fill="#fef08a" font-family="sans-serif" font-size="10" font-weight="bold">PERMIS TACITE</text>
      </g>

      <!-- Noeud 4 : Parcelle Littorale DVF/SAFER -->
      <g transform="translate(680,300)" class="cursor-pointer hover:scale-110 transition duration-300">
        <circle r="32" fill="#1e293b" stroke="#b8860b" stroke-width="2" />
        <text y="4" text-anchor="middle" fill="#fef08a" font-family="sans-serif" font-size="10" font-weight="bold">PARCELLE DVF</text>
      </g>
    </svg>

    <div class="absolute bottom-3 left-4 text-xs font-mono text-slate-400 bg-slate-950/80 px-3 py-1.5 rounded-md border border-slate-800">
      💡 Survolez les nœuds pour explorer les liaisons d'ingénierie financière
    </div>
  </div>
</div>
