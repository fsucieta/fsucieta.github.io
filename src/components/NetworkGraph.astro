---
import networkData from '../data/network_data.json';
---

<div class="bg-slate-950 border border-amber-500/30 rounded-2xl p-6 md:p-8 shadow-2xl my-12 relative overflow-hidden" id="network-explorer-wrapper">
  <!-- En-tête du composant -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        OPEN DATA FORENSICS — STYLE ICIJ OFFSHORE LEAKS
      </span>
      <h3 class="text-2xl font-bold font-serif text-slate-100 mt-2 flex items-center gap-2">
        <span>🌐 Explorateur d'Influence & Maillage Territorial</span>
      </h3>
    </div>
    <div class="flex items-center gap-2 text-xs font-mono">
      <span class="bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800 text-amber-400 font-bold">
        {networkData.nodes.length} Nœuds d'Audit Actifs
      </span>
    </div>
  </div>

  <!-- Zone de Graphe et Panneau latéral d'Inspecteur -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Zone Canvas / Interactive SVG (2/3 largeur sur grand écran) -->
    <div class="lg:col-span-2 relative h-[450px] bg-slate-900/90 rounded-xl border border-slate-800 flex items-center justify-center overflow-hidden shadow-inner" id="networkCanvasContainer">
      
      <!-- SVG Dynamique avec Nœuds cliquables -->
      <svg id="networkSvg" class="w-full h-full select-none" viewBox="0 0 900 450">
        <!-- Fond quadrillé style Radar/Forensic -->
        <defs>
          <pattern id="gridPattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255, 255, 255, 0.03)" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#gridPattern)" />

        <!-- Lignes de connexions -->
        <g id="networkLinksGroup">
          <line x1="450" y1="225" x2="160" y2="100" stroke="#06b6d4" stroke-width="2" stroke-dasharray="4,4" class="transition-all duration-300" />
          <line x1="450" y1="225" x2="740" y2="100" stroke="#3b82f6" stroke-width="2" stroke-dasharray="4,4" class="transition-all duration-300" />
          <line x1="450" y1="225" x2="200" y2="350" stroke="#eab308" stroke-width="2" class="transition-all duration-300" />
          <line x1="450" y1="225" x2="700" y2="350" stroke="#10b981" stroke-width="2" class="transition-all duration-300" />
          <line x1="450" y1="225" x2="450" y2="70" stroke="#ec4899" stroke-width="2" class="transition-all duration-300" />
          <line x1="450" y1="225" x2="450" y2="380" stroke="#8b5cf6" stroke-width="2" class="transition-all duration-300" />
          <line x1="160" y1="100" x2="700" y2="350" stroke="#06b6d4" stroke-width="1" stroke-opacity="0.4" />
          <line x1="200" y1="350" x2="160" y2="100" stroke="#eab308" stroke-width="1" stroke-opacity="0.4" />
        </g>

        <!-- Nœuds Interactifs -->
        <g id="networkNodesGroup">
          <!-- Nœud Central -->
          <g transform="translate(450,225)" class="node-item cursor-pointer group" data-id="dossier_root">
            <circle r="38" fill="#0f172a" stroke="#f59e0b" stroke-width="3" class="group-hover:scale-110 group-hover:stroke-amber-300 transition duration-300 shadow-lg" />
            <text y="4" text-anchor="middle" fill="#f59e0b" font-family="sans-serif" font-size="11" font-weight="bold">26 ENQUÊTES</text>
          </g>

          <!-- Nœud SCI Écran -->
          <g transform="translate(160,100)" class="node-item cursor-pointer group" data-id="sci_ecran">
            <circle r="28" fill="#1e293b" stroke="#06b6d4" stroke-width="2" class="group-hover:scale-110 group-hover:stroke-cyan-300 transition duration-300" />
            <text y="4" text-anchor="middle" fill="#38bdf8" font-family="sans-serif" font-size="9" font-weight="bold">SCI ÉCRANS</text>
          </g>

          <!-- Nœud RBE -->
          <g transform="translate(740,100)" class="node-item cursor-pointer group" data-id="rbe_inpi">
            <circle r="28" fill="#1e293b" stroke="#3b82f6" stroke-width="2" class="group-hover:scale-110 group-hover:stroke-blue-300 transition duration-300" />
            <text y="4" text-anchor="middle" fill="#60a5fa" font-family="sans-serif" font-size="9" font-weight="bold">RBE INPI</text>
          </g>

          <!-- Nœud Permis Tacite -->
          <g transform="translate(200,350)" class="node-item cursor-pointer group" data-id="permis_tacite">
            <circle r="28" fill="#1e293b" stroke="#eab308" stroke-width="2" class="group-hover:scale-110 group-hover:stroke-yellow-300 transition duration-300" />
            <text y="4" text-anchor="middle" fill="#fef08a" font-family="sans-serif" font-size="9" font-weight="bold">PERMIS TACITES</text>
          </g>

          <!-- Nœud DVF -->
          <g transform="translate(700,350)" class="node-item cursor-pointer group" data-id="dvf_parcelles">
            <circle r="28" fill="#1e293b" stroke="#10b981" stroke-width="2" class="group-hover:scale-110 group-hover:stroke-emerald-300 transition duration-300" />
            <text y="4" text-anchor="middle" fill="#34d399" font-family="sans-serif" font-size="9" font-weight="bold">DVF FONCIER</text>
          </g>

          <!-- Nœud CADA -->
          <g transform="translate(450,70)" class="node-item cursor-pointer group" data-id="cada_saisines">
            <circle r="26" fill="#1e293b" stroke="#ec4899" stroke-width="2" class="group-hover:scale-110 group-hover:stroke-pink-300 transition duration-300" />
            <text y="4" text-anchor="middle" fill="#f472b6" font-family="sans-serif" font-size="9" font-weight="bold">SAISINES CADA</text>
          </g>

          <!-- Nœud SAFER -->
          <g transform="translate(450,380)" class="node-item cursor-pointer group" data-id="safer_preemption">
            <circle r="26" fill="#1e293b" stroke="#8b5cf6" stroke-width="2" class="group-hover:scale-110 group-hover:stroke-purple-300 transition duration-300" />
            <text y="4" text-anchor="middle" fill="#c084fc" font-family="sans-serif" font-size="9" font-weight="bold">SAFER</text>
          </g>
        </g>
      </svg>

      <!-- Badge d'aide -->
      <div class="absolute bottom-3 left-4 text-xs font-mono text-slate-400 bg-slate-950/90 px-3 py-1.5 rounded-md border border-slate-800 backdrop-blur">
        👆 <span class="text-amber-400 font-bold">Cliquez sur n'importe quel nœud</span> pour inspecter les preuves & recoupe Open Data
      </div>
    </div>

    <!-- Panneau Lateral Inspecteur Forensic (1/3 largeur) -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 flex flex-col justify-between" id="inspectorPanel">
      <div>
        <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-4">
          <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider">INSPECTEUR OPEN DATA</span>
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        </div>

        <h4 class="text-xl font-bold font-serif text-amber-400 mb-2" id="inspectorTitle">
          26 ENQUÊTES L'OCHJU
        </h4>

        <p class="text-slate-300 text-sm font-serif leading-relaxed mb-6" id="inspectorDetails">
          Sélectionnez un nœud dans la carte d'influence pour afficher l'analyse médico-légale et la qualification juridique CADA/Open Data.
        </p>

        <div class="space-y-3 font-mono text-xs" id="inspectorMeta">
          <div class="p-3 bg-slate-950 rounded-lg border border-slate-800 flex justify-between items-center">
            <span class="text-slate-400">Statut Audit :</span>
            <span class="text-emerald-400 font-bold">100% Documenté</span>
          </div>
          <div class="p-3 bg-slate-950 rounded-lg border border-slate-800 flex justify-between items-center">
            <span class="text-slate-400">Volume Preuves :</span>
            <span class="text-amber-400 font-bold">+40 000 mots nets</span>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-800">
        <a 
          href="#fiches-grid-section" 
          id="inspectorActionBtn"
          class="w-full block text-center py-2.5 px-4 bg-amber-500/10 border border-amber-500/30 text-amber-400 rounded-lg text-xs font-bold uppercase tracking-wider font-mono hover:bg-amber-500/20 transition"
        >
          📂 Consulter les dossiers associés →
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Script d'interactivité du Graphe (Exécution garantie avec is:inline) -->
<script is:inline define:vars={{ networkData }}>
  (function initNetworkGraph() {
    function setupGraph() {
      const nodes = document.querySelectorAll('#networkNodesGroup .node-item');
      const titleEl = document.getElementById('inspectorTitle');
      const detailsEl = document.getElementById('inspectorDetails');

      if (!nodes.length) return;

      nodes.forEach(function(node) {
        node.addEventListener('click', function() {
          const nodeId = node.getAttribute('data-id');
          const nodeInfo = networkData.nodes.find(function(n) { return n.id === nodeId; });

          if (nodeInfo && titleEl && detailsEl) {
            titleEl.textContent = nodeInfo.label;
            detailsEl.textContent = nodeInfo.details;

            nodes.forEach(function(n) {
              const circle = n.querySelector('circle');
              if (circle) circle.setAttribute('stroke-width', '2');
            });

            const currentCircle = node.querySelector('circle');
            if (currentCircle) currentCircle.setAttribute('stroke-width', '4');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupGraph);
    } else {
      setupGraph();
    }
  })();
</script>
