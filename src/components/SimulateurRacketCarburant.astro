<!-- ==========================================================================
     PROTOTYPE VISUEL : CALCULATEUR CITOYEN DU RACKET À LA POMPE
     Enquête 26 — L'Arme de notre Soumission : Le Verrou Pétrolier Corse
     ========================================================================== -->

<div class="my-10 not-prose rounded-3xl border-2 border-amber-500/50 bg-gradient-to-b from-slate-900 via-slate-950 to-slate-950 p-6 sm:p-8 shadow-2xl relative overflow-hidden font-sans">
  <div class="absolute -top-20 -right-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- En-tête du simulateur -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-5 mb-6 border-b border-white/10 gap-2">
    <div>
      <div class="flex items-center gap-2 mb-1">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="text-xs font-mono font-bold tracking-widest uppercase text-amber-400">
          ⚖️ OUTIL D'ÉMANCIPATION POPULAIRE · L'OCHJU LABS
        </span>
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-white m-0 tracking-tight font-serif">
        Simulateur Citoyen : Calculez Votre Rançon à la Pompe
      </h3>
    </div>
    <span class="text-[11px] font-mono text-slate-400 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800 self-start sm:self-auto">
      Réf. Décision 25-D-07 & CGI Art. 297
    </span>
  </div>

  <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-serif">
    La loi accorde à la Corse un taux légal de TVA réduit à <strong>13 %</strong> (contre 20 % sur le continent). Pourtant, à chaque passage en station, le cartel DPLC et l'inaction de Bercy captent <strong>18 centimes indus par litre</strong>. Entrez votre consommation pour mesurer l'hémorragie exacte de votre foyer :
  </p>

  <!-- Grille de Saisie Interactive -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 p-5 rounded-2xl bg-black/60 border border-white/10 mb-6 font-mono text-xs">
    
    <!-- Choix Carburant -->
    <div>
      <label class="block text-slate-400 uppercase tracking-wider mb-2 font-bold">1. Carburant du Véhicule</label>
      <select id="simCarburant" class="w-full bg-slate-900 border border-slate-700 text-slate-100 rounded-xl px-3 py-2.5 text-xs focus:outline-none focus:border-amber-400 cursor-pointer">
        <option value="gazole" selected>Gazole Routier B7</option>
        <option value="sp95">Super Sans Plomb 95</option>
        <option value="sp98">Super Sans Plomb 98</option>
      </select>
    </div>

    <!-- Taille du Plein -->
    <div>
      <label class="block text-slate-400 uppercase tracking-wider mb-2 font-bold">
        2. Volume d'un Plein : <span id="volLabel" class="text-amber-400 font-bold">50 L</span>
      </label>
      <input type="range" id="simVolume" min="20" max="100" step="5" value="50" class="w-full accent-amber-400 cursor-pointer" />
      <div class="flex justify-between text-[10px] text-slate-500 mt-1">
        <span>20 L (Citadine)</span>
        <span>50 L</span>
        <span>100 L (Utilitaire)</span>
      </div>
    </div>

    <!-- Fréquence de Plein -->
    <div>
      <label class="block text-slate-400 uppercase tracking-wider mb-2 font-bold">
        3. Pleins par Mois : <span id="freqLabel" class="text-amber-400 font-bold">2 pleins</span>
      </label>
      <input type="range" id="simFrequence" min="1" max="8" step="1" value="2" class="w-full accent-amber-400 cursor-pointer" />
      <div class="flex justify-between text-[10px] text-slate-500 mt-1">
        <span>1 / mois</span>
        <span>2 / mois (Moyen)</span>
        <span>8 / mois (Artisan)</span>
      </div>
    </div>

  </div>

  <!-- Résultat Dynamique en 3 Cartouches Chiffrés -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-center mb-6">
    
    <div class="p-4 rounded-2xl bg-rose-950/30 border border-rose-500/40">
      <span class="text-[10px] uppercase text-rose-300 tracking-wider block mb-1">Vol Direct sur Votre Plein</span>
      <span id="resVolPlein" class="text-2xl sm:text-3xl font-black text-rose-400 font-mono block">9,00 €</span>
      <span class="text-[10px] text-slate-400 block mt-1">Siphonné à chaque passage au totem</span>
    </div>

    <div class="p-4 rounded-2xl bg-amber-950/30 border border-amber-500/40">
      <span class="text-[10px] uppercase text-amber-300 tracking-wider block mb-1">Rançon Annuelle par Foyer</span>
      <span id="resVolAn" class="text-2xl sm:text-3xl font-black text-amber-400 font-mono block">216,00 €</span>
      <span class="text-[10px] text-slate-400 block mt-1">Confisqué sur votre pouvoir d'achat</span>
    </div>

    <div class="p-4 rounded-2xl bg-cyan-950/30 border border-cyan-500/40">
      <span class="text-[10px] uppercase text-cyan-300 tracking-wider block mb-1">Prix Juste Légal (TVA 13%)</span>
      <span id="resPrixJuste" class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono block">-0,18 € / L</span>
      <span class="text-[10px] text-slate-400 block mt-1">Économie si le décret L. 410-2 était pris</span>
    </div>

  </div>

  <!-- Note d'imputabilité politique et forensique -->
  <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-slate-400 flex items-start gap-3">
    <span class="text-base">📌</span>
    <p class="m-0 leading-relaxed">
      <strong class="text-slate-200">Preuve médico-légale :</strong> Ce calcul repose sur la base des 191 000 relevés citoyens certifiés du collectif A4C et les 80 pages de la décision 25-D-07. L'arrêt du Conseil d'État du 21 octobre 2026 confirme que l'État dispose de l'arme juridique (Code de commerce L. 410-2) mais choisit délibérément de ne pas l'utiliser.
    </p>
  </div>
</div>

<script is:inline>
  function updateFuelSimulator() {
    const vol = parseFloat(document.getElementById('simVolume')?.value || 50);
    const freq = parseFloat(document.getElementById('simFrequence')?.value || 2);
    const carb = document.getElementById('simCarburant')?.value || 'gazole';

    const surcoutLitre = carb === 'sp95' ? 0.22 : (carb === 'sp98' ? 0.24 : 0.18);

    const volPleinEl = document.getElementById('volLabel');
    const freqLabelEl = document.getElementById('freqLabel');
    const resPleinEl = document.getElementById('resVolPlein');
    const resAnEl = document.getElementById('resVolAn');
    const resPrixJusteEl = document.getElementById('resPrixJuste');

    if (volPleinEl) volPleinEl.innerText = vol + ' L';
    if (freqLabelEl) freqLabelEl.innerText = freq + (freq > 1 ? ' pleins' : ' plein');

    const pertePlein = vol * surcoutLitre;
    const perteAn = pertePlein * freq * 12;

    if (resPleinEl) resPleinEl.innerText = pertePlein.toFixed(2).replace('.', ',') + ' €';
    if (resAnEl) resAnEl.innerText = Math.round(perteAn) + ' €';
    if (resPrixJusteEl) resPrixJusteEl.innerText = '-' + surcoutLitre.toFixed(2).replace('.', ',') + ' € / L';
  }

  document.getElementById('simVolume')?.addEventListener('input', updateFuelSimulator);
  document.getElementById('simFrequence')?.addEventListener('input', updateFuelSimulator);
  document.getElementById('simCarburant')?.addEventListener('change', updateFuelSimulator);
  updateFuelSimulator();
</script>
