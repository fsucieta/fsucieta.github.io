---
interface Props {
  mapping?: string;
  term?: string;
  lang?: string;
}

const {
  mapping = "pathname",
  term = "",
  lang = "fr"
} = Astro.props;

// Normalisation de la langue pour Giscus (supporte fr, en, it, es, pt, ru, zh-CN, ja)
const giscusLangs: Record<string, string> = {
  fr: "fr",
  en: "en",
  it: "it",
  es: "es",
  pt: "pt",
  ru: "ru",
  zh: "zh-CN",
  ja: "ja"
};

const giscusLang = giscusLangs[lang] || "fr";

