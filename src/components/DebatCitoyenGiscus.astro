const t = i18n[lang as keyof typeof i18n] || i18n.fr;
---

<section id="espace-debat-citoyen" class="my-16 not-prose rounded-3xl bg-slate-950/90 border border-slate-800 p-6 md:p-10 shadow-2xl space-y-8">
  
  <!-- En-tête de la section -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800/80 pb-6">
    <div class="space-y-1.5">
      <div class="flex items-center gap-2 font-mono-tech text-xs">
        <span class="px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 font-bold uppercase tracking-wider text-[10px]">
          {t.badge}
        </span>
        <span class="text-slate-400">• {t.badgeSub}</span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-press font-black text-white m-0">
        {t.title}
      </h3>
      <p class="text-xs sm:text-sm text-slate-400 font-sans m-0 max-w-2xl leading-relaxed">
        {t.desc}
      </p>
    </div>

    <!-- Badge Statut -->
    <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-2 bg-slate-900/80 px-4 py-2.5 rounded-2xl border border-slate-800 shrink-0">
      <span class="text-[10px] font-mono-tech text-emerald-400 flex items-center gap-1.5 font-bold">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {t.status}
      </span>
      <span class="text-[10px] font-mono-tech text-slate-500">
        {t.statusSub}
      </span>
    </div>
  </div>

  <!-- Conteneur Réel Officiel Giscus (Actif avec vos identifiants GitHub) -->
  <div class="giscus-wrapper min-h-[160px] pt-2">
    <script 
      src="https://giscus.app/client.js"
      data-repo="fsucieta/fsucieta.github.io"
      data-repo-id="R_kgDOTgqQGg"
      data-category="General"
      data-category-id="DIC_kwDOTgqQGs4DKkBN"
      data-mapping={mapping}
      data-term={term}
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="dark_dimmed"
      data-lang={giscusLang}
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>

  <!-- Note déontologique & Respect de la vie privée -->
  <div class="pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] font-mono-tech text-slate-500">
    <div class="flex items-center gap-2">
      <span>🛡️</span>
      <span>{t.privacy}</span>
    </div>
    <a href="https://github.com/fsucieta/fsucieta.github.io/discussions" target="_blank" rel="noopener noreferrer" class="text-amber-400/80 hover:text-amber-300 hover:underline flex items-center gap-1">
      <span>💬</span> <span>{t.credit} ↗</span>
    </a>
  </div>

</section>
