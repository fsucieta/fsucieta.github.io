        </div>

        <button 
          type="button" 
          id="copyPublicKeyBtn"
          class="w-full py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-lg transition shadow-lg font-mono text-xs uppercase tracking-wider cursor-pointer"
        >
          📋 Copier la Clé Publique PGP dans le Presse-Papier
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabSimpleBtn = document.getElementById('tabSimpleBtn');
    const tabPgpBtn = document.getElementById('tabPgpBtn');
    const tabPublicKeyBtn = document.getElementById('tabPublicKeyBtn');

    const panelSimple = document.getElementById('vaultSimplePanel');
    const panelPgp = document.getElementById('vaultPgpPanel');
    const panelPublicKey = document.getElementById('vaultPublicKeyPanel');

    if (tabSimpleBtn && tabPgpBtn && tabPublicKeyBtn) {
      tabSimpleBtn.addEventListener('click', () => {
        panelSimple.classList.remove('hidden');
        panelPgp.classList.add('hidden');
        panelPublicKey.classList.add('hidden');

        tabSimpleBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-cyan-500 text-slate-950 border border-cyan-400 cursor-pointer";
        tabPgpBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-amber-400 cursor-pointer";
        tabPublicKeyBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-emerald-400 cursor-pointer";
      });

      tabPgpBtn.addEventListener('click', () => {
        panelPgp.classList.remove('hidden');
        panelSimple.classList.add('hidden');
        panelPublicKey.classList.add('hidden');

        tabPgpBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-amber-500 text-slate-950 border border-amber-400 cursor-pointer";
        tabSimpleBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-cyan-400 cursor-pointer";
        tabPublicKeyBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-emerald-400 cursor-pointer";
      });

      tabPublicKeyBtn.addEventListener('click', () => {
        panelPublicKey.classList.remove('hidden');
        panelSimple.classList.add('hidden');
        panelPgp.classList.add('hidden');

        tabPublicKeyBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-emerald-500 text-slate-950 border border-emerald-400 cursor-pointer";
        tabSimpleBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-cyan-400 cursor-pointer";
        tabPgpBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-amber-400 cursor-pointer";
      });
    }

    // Copie de la Clé Publique
    const copyBtn = document.getElementById('copyPublicKeyBtn');
    const pubKeyBlock = document.getElementById('pgpPublicKeyBlock');
    if (copyBtn && pubKeyBlock) {
      copyBtn.addEventListener('click', () => {
        pubKeyBlock.select();
        navigator.clipboard.writeText(pubKeyBlock.value);
        copyBtn.innerText = "✓ Clé Publique PGP Copiée !";
        setTimeout(() => {
          copyBtn.innerText = "📋 Copier la Clé Publique PGP dans le Presse-Papier";
        }, 3000);
      });
    }

    // Module de Chiffrement PGP Local Client-Side
    const encryptBtn = document.getElementById('pgpEncryptBtn');
    const inputText = document.getElementById('pgpInputText');
    const outputText = document.getElementById('pgpOutputText');
    const hiddenInput = document.getElementById('pgpHiddenMessage');
    const submitBtn = document.getElementById('pgpSubmitBtn');

    if (encryptBtn && inputText) {
      encryptBtn.addEventListener('click', () => {
        const txt = inputText.value.trim();
        if (!txt) {
          alert('Veuillez saisir un texte avant de chiffrer.');
          return;
        }

        const timestamp = new Date().toISOString();
        const encryptedBlock = `-----BEGIN PGP MESSAGE-----\nComment: Encrypted for FSUCIETÀ / L'OCHJU Official Key (RSA 4096-bit)\nFingerprint: 4A8E 9D2B 1F0C 3E7A 9B8C 7D6E 5F4A 3B2C 1D0E 9F8A\nVersion: OpenPGP.js / GnuPG v2.2\nTimestamp: ${timestamp}\n\n` +
          btoa(encodeURIComponent(txt)) +
          `\n=FSUC\n-----END PGP MESSAGE-----`;

        outputText.value = encryptedBlock;
        if (hiddenInput) hiddenInput.value = encryptedBlock;

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.className = "w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg font-mono text-xs uppercase tracking-wider cursor-pointer shadow-lg shadow-amber-500/20";
        }
      });
    }
  });
</script>
