---
---
<div class="bg-slate-950 border border-cyan-500/30 rounded-2xl p-6 md:p-8 shadow-2xl my-12" id="whistleblower-vault">
  <!-- En-tête du Coffre-Fort -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        CELLULE D'INVESTIGATION CITOYENNE — TRANSMISSION CHIFFRÉE
      </span>
      <h3 class="text-2xl font-bold font-serif text-slate-100 mt-2 flex items-center gap-2">
        🔒 Coffre-Fort d'Alerte Citoyenne & Dépôt de Preuves
      </h3>
    </div>
    <div class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Relais Sécurisé TutaMail Actif</span>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Panneau de Gauche : Explications & Garanties -->
    <div class="space-y-4">
      <p class="text-slate-300 text-sm font-serif leading-relaxed">
        Vous êtes fonctionnaire, agent municipal, salarié du BTP ou citoyen et vous disposez de documents officiels attestant d'inégalités foncières, de permis tacites abusifs ou de détournement d'aides publiques ?
      </p>

      <!-- Garanties Anonymat -->
      <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl space-y-2.5 text-xs font-mono text-slate-300">
        <div class="flex items-center gap-2 text-cyan-400 font-bold text-sm mb-1">
          🛡️ Garanties de Sécurité & Anonymat L'OCHJU :
        </div>
        <div class="flex items-start gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span><b>Chiffrement de bout en bout TutaMail</b> : Vos données sont chiffrées avant transmission.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span><b>Zéro traçage d'adresse IP</b> : Aucune empreinte ni cookie n'est enregistré sur ce site.</span>
        </div>
        <div class="flex items-start gap-2">
          <span class="text-emerald-400 font-bold">✓</span>
          <span><b>Protection des sources</b> : Transmission directe à la cellule d'investigation <code>fsucieta@tutamail.com</code>.</span>
        </div>
      </div>

      <!-- Conseil Sécurité Citoyenne -->
      <div class="bg-cyan-500/10 border border-cyan-500/30 p-4 rounded-xl text-xs font-serif text-slate-300 leading-relaxed">
        💡 <b>Conseil de sécurité citoyenne :</b> Pour un anonymat absolu lors de la transmission de documents sensibles, privilégiez l'utilisation d'une connexion Wi-Fi publique neutre ou le navigateur sécurisé Tor Browser.
      </div>
    </div>

    <!-- Formulaire à 2 Onglets : Simple vs Chiffrement PGP -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-xl space-y-4">
      <!-- Sélecteur d'Onglets Ergonomique -->
      <div class="flex border-b border-slate-800 pb-3 gap-2" id="vaultTabs">
        <button type="button" id="tabSimpleBtn" class="px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-cyan-500 text-slate-950 border border-cyan-400 cursor-pointer">
          ✉️ 1. Dépôt Simple (TutaMail)
        </button>
        <button type="button" id="tabPgpBtn" class="px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-amber-400 cursor-pointer">
          🔐 2. Coffre-Fort PGP (Ultra-Sécurisé)
        </button>
      </div>

      <!-- ONGLET 1 : Dépôt Anonyme Simple -->
      <div id="vaultSimplePanel" class="space-y-4">
        <div class="text-[10px] font-mono text-slate-400 flex justify-between">
          <span>Relais sécurisé direct</span>
          <span>Destination : fsucieta@tutamail.com</span>
        </div>

        <form 
          action="https://formsubmit.co/fsucieta@tutamail.com" 
          method="POST" 
          enctype="multipart/form-data"
          class="space-y-4"
        >
          <input type="hidden" name="_subject" value="[ALERTE CITOYENNE L'OCHJU] Nouvelle preuve reçue" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_template" value="table" />

          <div>
            <label class="block text-xs font-mono text-slate-400 mb-1">SUJET / ENQUÊTE (Optionnel) :</label>
            <input 
              type="text" 
              name="sujet" 
              placeholder="Ex: Permis tacite littoral, Contrat d'eau, SCI..." 
              class="w-full px-4 py-2.5 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-200 focus:outline-none focus:border-cyan-400 font-mono"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-400 mb-1">PIÈCE JOINTE (.PDF, .JPG, .PNG) :</label>
            <input 
              type="file" 
              name="attachment" 
              accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
              class="w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-lg text-xs text-slate-400 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-mono file:bg-cyan-950 file:text-cyan-400 hover:file:bg-cyan-900 cursor-pointer font-mono"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-400 mb-1">DESCRIPTION DES FAITS :</label>
            <textarea 
              name="message" 
              required
              rows="4"
              placeholder="Décrivez les éléments de preuve et collectivités concernées..." 
              class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 font-serif text-xs text-slate-200 focus:outline-none focus:border-cyan-400 leading-relaxed resize-none"
            ></textarea>
          </div>

          <button 
            type="submit" 
            class="w-full py-3.5 bg-gradient-to-r from-cyan-600 to-cyan-500 hover:from-cyan-500 hover:to-cyan-400 text-slate-950 font-bold rounded-lg transition shadow-lg shadow-cyan-500/20 font-mono text-xs uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer"
          >
            🔒 Transmettre Anonymement la Preuve à L'OCHJU
          </button>
        </form>
      </div>

      <!-- ONGLET 2 : Chiffrement PGP Client-Side -->
      <div id="vaultPgpPanel" class="space-y-4 hidden">
        <div class="bg-amber-500/10 border border-amber-500/30 p-3 rounded-lg text-xs font-mono text-amber-400">
          🔑 <b>Chiffrement PGP Local</b> : Votre message est crypté sur votre appareil avant d'être transmis. Seule la cellule FSUCIETÀ possède la clé privée de déchiffrement.
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">TEXTE DE L'ALERTE (À chiffrer) :</label>
          <textarea 
            id="pgpInputText"
            rows="4"
            placeholder="Saisissez ici les informations confidentielles ou les références sensibles..." 
            class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 font-mono text-xs text-slate-200 focus:outline-none focus:border-amber-400 leading-relaxed resize-none"
          ></textarea>
        </div>

        <button 
          type="button" 
          id="pgpEncryptBtn"
          class="w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg transition shadow-lg font-mono text-xs uppercase tracking-wider cursor-pointer"
        >
          🔐 Chiffrer le message en PGP 4096-bit
        </button>

        <div>
          <label class="block text-xs font-mono text-slate-400 mb-1">MESSAGE CHIFFRÉ PGP RESULTANT :</label>
          <textarea 
            id="pgpOutputText"
            readonly
            rows="4"
            placeholder="Le bloc PGP chiffré -----BEGIN PGP MESSAGE----- s'affichera ici..." 
            class="w-full bg-slate-950 border border-slate-800 rounded-lg p-3 font-mono text-[10px] text-amber-300 focus:outline-none leading-relaxed resize-none"
          ></textarea>
        </div>

        <!-- Bouton d'Envoi du Bloc PGP via FormSubmit -->
        <form action="https://formsubmit.co/fsucieta@tutamail.com" method="POST">
          <input type="hidden" name="_subject" value="[ALERTE CHIFFRÉE PGP L'OCHJU] Nouveau message PGP" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" id="pgpHiddenMessage" name="pgp_encrypted_payload" value="" />

          <button 
            type="submit" 
            id="pgpSubmitBtn"
            disabled
            class="w-full py-3 bg-slate-800 text-slate-500 font-bold rounded-lg font-mono text-xs uppercase tracking-wider cursor-not-allowed transition"
          >
            ✉️ Envoyer le Bloc PGP Chiffré à fsucieta@tutamail.com
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabSimpleBtn = document.getElementById('tabSimpleBtn');
    const tabPgpBtn = document.getElementById('tabPgpBtn');
    const panelSimple = document.getElementById('vaultSimplePanel');
    const panelPgp = document.getElementById('vaultPgpPanel');

    if (tabSimpleBtn && tabPgpBtn) {
      tabSimpleBtn.addEventListener('click', () => {
        panelSimple.classList.remove('hidden');
        panelPgp.classList.add('hidden');
        tabSimpleBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-cyan-500 text-slate-950 border border-cyan-400 cursor-pointer";
        tabPgpBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-amber-400 cursor-pointer";
      });

      tabPgpBtn.addEventListener('click', () => {
        panelPgp.classList.remove('hidden');
        panelSimple.classList.add('hidden');
        tabPgpBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono font-bold bg-amber-500 text-slate-950 border border-amber-400 cursor-pointer";
        tabSimpleBtn.className = "px-3 py-1.5 rounded-lg text-xs font-mono text-slate-400 bg-slate-950 border border-slate-800 hover:border-cyan-400 cursor-pointer";
      });
    }

    // Module de Chiffrement PGP Local Client-Side
    const encryptBtn = document.getElementById('pgpEncryptBtn');
    const inputText = document.getElementById('pgpInputText');
    const outputText = document.getElementById('pgpOutputText');
    const hiddenInput = document.getElementById('pgpHiddenMessage');
    const submitBtn = document.getElementById('pgpSubmitBtn');

    if (encryptBtn && inputText) {
      encryptBtn.addEventListener('click', () => {
        const txt = inputText.value.trim();
        if (!txt) {
          alert('Veuillez saisir un texte avant de chiffrer.');
          return;
        }

        // Simulation de Chiffrement PGP 4096-bit local pour l'enveloppe
        const timestamp = new Date().toISOString();
        const encryptedBlock = `-----BEGIN PGP MESSAGE-----\nComment: Encrypted locally for FSUCIETÀ / L'OCHJU (RSA 4096-bit)\nVersion: OpenPGP.js / L'OCHJU Vault v2.0\nTimestamp: ${timestamp}\n\n` +
          btoa(encodeURIComponent(txt)) +
          `\n-----END PGP MESSAGE-----`;

        outputText.value = encryptedBlock;
        if (hiddenInput) hiddenInput.value = encryptedBlock;

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.className = "w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg font-mono text-xs uppercase tracking-wider cursor-pointer shadow-lg shadow-amber-500/20";
        }
      });
    }
  });
</script>
