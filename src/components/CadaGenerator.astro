---
const enquetesList = [
  { id: 1, title: "Enquête 01 : Le Grand Verrou Financier & les Prêts Bancaires" },
  { id: 2, title: "Enquête 02 : Le Mythe des Subventions & l'Évasion Fiscale" },
  { id: 3, title: "Enquête 03 : Étude Comparative — Régimes Fonciers Insulaires" },
  { id: 4, title: "Enquête 04 : La Marchandisation de l'Eau & la Régie Publique" },
  { id: 5, title: "Enquête 05 : L'Empire des SCI Non-Résidentes & l'INPI RBE" },
  { id: 6, title: "Enquête 06 : Le Pillage des Quotas de Pêche & la DPMA" },
  { id: 7, title: "Enquête 07 : Le Cadastre Minier Secret & le Plan IRM" },
  { id: 8, title: "Enquête 08 : Le Pillage de la Forêt Corse & l'ONF" },
  { id: 9, title: "Enquête 09 : L'Évasion des Capitaux Touristiques & l'IEDOM" },
  { id: 10, title: "Enquête 10 : La Tutelle de la Haute Fonction Publique" },
  { id: 11, title: "Enquête 11 : L'Emprise & les Servitudes Militaires de Solenzara" },
  { id: 12, title: "Enquête 12 : La Dépendance Sanitaire & les EVASAN" },
  { id: 13, title: "Enquête 13 : Le Sous-Investissement Éducatif & l'Université" },
  { id: 14, title: "Enquête 14 : Le Dessaisissement Judiciaire & la JIRS" },
  { id: 15, title: "Enquête 15 : Le Contrôle de Légalité & Déférés Préfectoraux" },
  { id: 16, title: "Enquête 16 : La Continuité des Arrêtés Miot & GIRTEC" },
  { id: 17, title: "Enquête 17 : Le Verrou de la Charte Européenne" },
  { id: 18, title: "Enquête 18 : Le Monopole Énergétique EDF-SEI" },
  { id: 19, title: "Enquête 19 : La Dépendance Numérique & Câbles Sous-Marins" },
  { id: 20, title: "Enquête 20 : L'Accaparement des Primes PAC & l'Élevage" },
  { id: 21, title: "Enquête 21 : Le Scandale des Déchets & le SYVADEC" },
  { id: 22, title: "Enquête 22 : La Captation Bancaire & l'Épargne Locale" },
  { id: 23, title: "Enquête 23 : La Sous-Dotation de la Sécurité Civile" },
  { id: 24, title: "Enquête 24 : Le Radar d'Urbanisme & Permis Tacites R. 424-1" },
  { id: 25, title: "Enquête 25 : La Transparence des Pétitionnaires & MRAe" },
  { id: 26, title: "Enquête 26 : La Spéculation sur le Bâti Agricole & Bergeries" }
];
---

<div class="bg-slate-950 border border-amber-500/30 rounded-2xl p-6 md:p-8 shadow-2xl my-12" id="cada-generator">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        ACTION CITOYENNE — ARTICLE L. 311-1 CRPA
      </span>
      <h3 class="text-2xl font-bold font-serif text-slate-100 mt-2">
        ⚖️ Générateur Automatisé de Recours CADA
      </h3>
    </div>
    <div class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
      Générez en 1 clic votre demande de documents administratifs
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Formulaire -->
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">1. SÉLECTIONNER L'ENQUÊTE CONCERNÉE :</label>
        <select id="cadaEnqueteSelect" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400">
          {enquetesList.map(e => (
            <option value={e.id}>{e.title}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">2. AUTORITÉ PUBLIQUE DESTINATAIRE (Mairie, Préfecture, Syndicat) :</label>
        <input type="text" id="cadaDestinataire" value="Monsieur le Maire / Monsieur le Préfet" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400" />
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">3. COMMUNE OU TERRITOIRE CONCERNÉ :</label>
        <input type="text" id="cadaCommune" value="Commune de Bastia / Ajaccio / Bonifacio" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400" />
      </div>

      <button id="cadaGenerateBtn" type="button" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-lg transition shadow-lg shadow-amber-500/20 font-sans cursor-pointer">
        📄 Générer la lettre de saisine CADA
      </button>
    </div>

    <!-- Aperçu du Courrier Officiel -->
    <div class="bg-slate-900 border border-slate-800 rounded-xl p-5 relative">
      <div class="flex justify-between items-center mb-3">
        <span class="text-xs font-mono text-cyan-400 font-bold">COURRIER OFFICIEL GÉNÉRÉ</span>
        <button id="cadaCopyBtn" type="button" class="text-xs bg-slate-800 hover:bg-slate-700 text-slate-300 px-3 py-1 rounded border border-slate-700 transition cursor-pointer">
          📋 Copier le texte
        </button>
      </div>

      <textarea id="cadaTextarea" readonly class="w-full h-[240px] bg-slate-950 border border-slate-800 rounded-lg p-4 font-mono text-xs text-slate-300 focus:outline-none leading-relaxed resize-none"></textarea>
    </div>
  </div>
</div>

<script is:inline>
  const enqueteSelect = document.getElementById('cadaEnqueteSelect');
  const destinataireInput = document.getElementById('cadaDestinataire');
  const communeInput = document.getElementById('cadaCommune');
  const generateBtn = document.getElementById('cadaGenerateBtn');
  const copyBtn = document.getElementById('cadaCopyBtn');
  const textarea = document.getElementById('cadaTextarea');

  function updateCadaLetter() {
    if (!textarea) return;
    const enqueteText = enqueteSelect ? enqueteSelect.options[enqueteSelect.selectedIndex].text : '';
    const dest = destinataireInput ? destinataireInput.value : '';
    const commune = communeInput ? communeInput.value : '';

    textarea.value = `Objet : Demande de communication de documents administratifs en application de l'article L. 311-1 du CRPA

À l'attention de : ${dest} (${commune})

Madame, Monsieur,

En qualité de citoyen résidant sur le territoire de la Corse, je sollicite par la présente la communication intégrale des documents administratifs suivants relatifs à l'opération visée dans l'audit : "${enqueteText}" :

1. Les arrêtés d'autorisation d'urbanisme (CERFA) et le registre des permis tacites délivrés au titre de l'article R. 424-1 du Code de l'Urbanisme.
2. Les bordereaux de prix, conventions d'attribution de subventions publiques et comptes-rendus d'audit environnemental MRAe.
3. Les actes de transfert et d'évaluation foncière SAFER/DVF concernant les parcelles rattachées.

Conformément à l'article L. 311-1 du Code des Relations entre le Public et l'Administration, cette communication doit intervenir dans un délai de 30 jours à compter de la réception de la présente. À défaut, je me verrai contraint de saisir la Commission d'Accès aux Documents Administratifs (CADA).

Je vous prie d'agréer, Madame, Monsieur, l'expression de mes salutations distinguées.`;
  }

  if (generateBtn) generateBtn.addEventListener('click', updateCadaLetter);
  if (enqueteSelect) enqueteSelect.addEventListener('change', updateCadaLetter);

  if (copyBtn && textarea) {
    copyBtn.addEventListener('click', () => {
      textarea.select();
      navigator.clipboard.writeText(textarea.value);
      copyBtn.textContent = '✅ Copié dans le presse-papier !';
      setTimeout(() => { copyBtn.textContent = '📋 Copier le texte'; }, 2000);
    });
  }

  // Initialisation au chargement
  updateCadaLetter();
</script>
