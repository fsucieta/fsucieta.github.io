---
/**
 * MODALE GLOBALE EN VERRE FUMÉ — SOUTIEN CITOYEN L'OCHJU
 *
 * S'ouvre au clic sur tout bouton porteur de la classe '.open-soutien-modal-btn'.
 * Comporte un confinement du focus clavier (WAI-ARIA Dialog), une barre de défilement
 * discrète dédiée (.custom-scrollbar) et une exclusion automatique à l'impression (.no-print).
 */
import SoutienCitoyen from './SoutienCitoyen.astro';
---

<div
  id="soutienModalOverlay"
  class="no-print fixed inset-0 bg-slate-950/88 backdrop-blur-md z-[110] hidden items-center justify-center p-2.5 sm:p-6 transition-opacity duration-200 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="soutienModalHeaderLabel"
>
  <div
    id="soutienModalBox"
    class="custom-scrollbar relative w-full max-w-5xl max-h-[92vh] overflow-y-auto bg-slate-950 border border-amber-500/45 rounded-2xl shadow-2xl shadow-black/80 px-3 pb-3 pt-0 sm:px-5 sm:pb-5 sm:pt-0 transform transition-transform duration-200 scale-95"
  >
    <!-- Barre supérieure collée au sommet sans fuite visuelle du contenu en arrière-plan -->
    <div class="sticky top-0 z-20 flex items-center justify-between gap-3 bg-slate-950/98 backdrop-blur px-2 sm:px-3 py-3 border-b border-slate-800 mb-3">
      <span id="soutienModalHeaderLabel" class="text-[10px] font-mono uppercase tracking-widest text-slate-400 leading-tight">
        CHARTE DE SOUTIEN CITOYEN — ADRESSES PUBLIQUES VÉRIFIÉES HORS-LIGNE
      </span>
      <button
        type="button"
        id="closeSoutienModalBtn"
        class="shrink-0 px-3 py-1.5 rounded bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-amber-400 border border-slate-700 hover:border-amber-500/50 text-xs font-mono uppercase tracking-wider transition cursor-pointer"
        aria-label="Fermer la fenêtre de soutien"
      >
        Fermer [ESC]
      </button>
    </div>

    <SoutienCitoyen
      variant="compact"
      idPrefix="modal_sc_"
      title="Soutenir l'Indépendance de L'OCHJU"
      subtitle="Contribution volontaire libre, sans montant conseillé ni abonnement. Choisissez votre situation : parcours débutant guidé ou accès direct aux adresses publiques."
    />
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const overlay = document.getElementById('soutienModalOverlay');
    const box = document.getElementById('soutienModalBox');
    const closeBtn = document.getElementById('closeSoutienModalBtn');
    const openBtns = document.querySelectorAll('.open-soutien-modal-btn');
    let lastFocusedElement = null;

    function openModal(triggerEl) {
      if (!overlay) return;
      lastFocusedElement = triggerEl || document.activeElement;
      overlay.classList.remove('hidden', 'pointer-events-none', 'opacity-0');
      overlay.classList.add('flex', 'pointer-events-auto', 'opacity-100');
      if (box) {
        box.classList.remove('scale-95');
        box.classList.add('scale-100');
      }
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        if (closeBtn) closeBtn.focus();
      }, 30);
    }

    function closeModal() {
      if (!overlay) return;
      overlay.classList.add('opacity-0', 'pointer-events-none');
      if (box) {
        box.classList.remove('scale-100');
        box.classList.add('scale-95');
      }
      setTimeout(() => {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = '';
        if (lastFocusedElement && typeof lastFocusedElement.focus === 'function') {
          lastFocusedElement.focus();
        }
      }, 200);
    }

    openBtns.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal(btn);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    if (overlay) {
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
      });

      // Si l'utilisateur clique sur une action à 0 € pointant vers une ancre de la page courante, fermer la modale
      const zeroEuroLinks = overlay.querySelectorAll('.sc-zero-euro-link');
      zeroEuroLinks.forEach((link) => {
        link.addEventListener('click', () => {
          const href = link.getAttribute('href') || '';
          const path = window.location.pathname.replace(/\/+$/, '');
          if (href.startsWith('/#') && (path === '' || path === '/index.html')) {
            closeModal();
          }
        });
      });
    }

    // Gestion clavier : fermeture par Échap et confinement du focus (Tab / Shift+Tab) dans la modale
    document.addEventListener('keydown', (e) => {
      if (!overlay || overlay.classList.contains('hidden')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
        return;
      }

      if (e.key === 'Tab' && box) {
        const focusables = Array.from(
          box.querySelectorAll(
            'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])'
          )
        ).filter((el) => el.offsetParent !== null);

        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  });
</script>
