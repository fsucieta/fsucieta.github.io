---

<div class="bg-slate-950 border border-amber-500/30 rounded-2xl p-6 md:p-8 shadow-2xl my-12" id="cada-generator">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        CITIZEN ACTION — FREEDOM OF INFORMATION (FOIA / ART. L. 311-1 CRPA)
      </span>
      <h3 class="text-2xl font-bold font-serif text-slate-100 mt-2">
        ⚖️ Demand Public Records — The Citizen Right-to-Know
      </h3>
    </div>
    <div class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
      Generate official administrative records requests in 1 click
    </div>
  </div>

  <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-6">
    <h4 class="text-sm font-bold font-serif text-amber-400 mb-1 flex items-center gap-2">
      💡 What is the "Citizen Right to Know"?
    </h4>
    <p class="text-xs text-slate-300 font-serif leading-relaxed">
      Under French and European public transparency law, <strong>no mayor, prefect, or public utility director can conceal public documents</strong> (budgets, building permits, water contracts, council deliberations). Every citizen has the strict legal right to demand unredacted copies. If an agency refuses, the official statutory watchdog is the <strong>CADA (Commission on Access to Administrative Documents)</strong>. Use this tool to generate your legal notice in 10 seconds.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">1. SELECT INVESTIGATION TOPIC :</label>
        <select id="cadaEnqueteSelectEn" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400 font-mono">
          {investigationsList.map(e => (
            <option value={e.id}>{e.title}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">2. TARGET PUBLIC AUTHORITY (Town Hall, Prefecture, Utility) :</label>
        <input type="text" id="cadaAutoriteInputEn" placeholder="e.g. Mairie de Porto-Vecchio, Préfecture de Corse, OEHC..." class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400" />
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">3. YOUR FULL NAME / CITIZEN IDENTITY :</label>
        <input type="text" id="cadaNomInputEn" placeholder="e.g. Jean Paoli, Citizen Investigator" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400" />
      </div>

      <button type="button" id="cadaGenerateBtnEn" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-sans rounded-xl transition shadow-lg shadow-amber-500/20 text-sm uppercase tracking-wider">
        Generate Official Legal Notice ↗
      </button>
    </div>

    <div>
      <label class="block text-xs font-mono text-slate-400 mb-1">PREVIEW OF STATUTORY DEMAND LETTER :</label>
      <textarea id="cadaLetterPreviewEn" rows="11" readonly class="w-full p-4 bg-slate-900 border border-slate-800 rounded-xl text-xs font-mono text-slate-300 leading-relaxed focus:outline-none select-all"></textarea>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('cadaEnqueteSelectEn') as HTMLSelectElement | null;
    const autorite = document.getElementById('cadaAutoriteInputEn') as HTMLInputElement | null;
    const nom = document.getElementById('cadaNomInputEn') as HTMLInputElement | null;
    const btn = document.getElementById('cadaGenerateBtnEn');
    const preview = document.getElementById('cadaLetterPreviewEn') as HTMLTextAreaElement | null;

    const updatePreview = () => {
      const auth = autorite?.value.trim() || "[Target Public Authority / Prefecture]";
      const name = nom?.value.trim() || "[Citizen Name]";
      const topic = select?.options[select.selectedIndex]?.text || "Public Records";

      if (preview) {
        preview.value = `To : ${auth}\nDate : ${new Date().toLocaleDateString('en-US')}\nFrom : ${name}\n\nSUBJECT : Formal Request for Communication of Administrative Records under Article L. 311-1 of the Code of Relations between the Public and the Administration (CRPA)\n\nSir/Madam,\n\nPursuant to the fundamental right of access to public records guaranteed by Article L. 311-1 et seq. of the CRPA, I hereby formally request full, unredacted certified copies of all administrative decisions, concession ledgers, and technical audit files relating to :\n\n>>> ${topic} <<<\n\nUnder statutory law, public authorities are required to communicate requested records within thirty (30) days of receipt. In the absence of communication within this mandatory timeframe, this file will be formally referred to the Commission d'Accès aux Documents Administratifs (CADA) and the Administrative Court of Bastia.\n\nRespectfully submitted,\n\n${name}`;
      }
    };

    btn?.addEventListener('click', updatePreview);
    select?.addEventListener('change', updatePreview);
    updatePreview();
  });
</script>
