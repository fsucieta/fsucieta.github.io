---

<div class="bg-slate-950 border border-amber-500/30 rounded-2xl p-6 md:p-8 shadow-2xl my-12" id="cada-generator">
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        {t.badge}
      </span>
      <h3 class="text-2xl font-bold font-serif text-slate-100 mt-2">
        {t.title}
      </h3>
    </div>
    <div class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800">
      {t.sub}
    </div>
  </div>

  <div class="bg-amber-500/10 border border-amber-500/30 rounded-xl p-4 mb-6">
    <h4 class="text-sm font-bold font-serif text-amber-400 mb-1 flex items-center gap-2">
      {t.infoTitle}
    </h4>
    <p class="text-xs text-slate-300 font-serif leading-relaxed">
      {t.infoDesc}
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="space-y-4">
      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">{t.lblTopic}</label>
        <select id="cadaEnqueteSelectEn" class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400 font-mono">
          {investigationsList.map(e => (
            <option value={e.id}>{e.title}</option>
          ))}
        </select>
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">{t.lblAuth}</label>
        <input type="text" id="cadaAutoriteInputEn" placeholder={t.phAuth} class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400" />
      </div>

      <div>
        <label class="block text-xs font-mono text-slate-400 mb-1">{t.lblName}</label>
        <input type="text" id="cadaNomInputEn" placeholder={t.phName} class="w-full px-4 py-2.5 bg-slate-900 border border-slate-700 rounded-lg text-sm text-slate-200 focus:outline-none focus:border-amber-400" />
      </div>

      <button type="button" id="cadaGenerateBtnEn" class="w-full py-3 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-sans rounded-xl transition shadow-lg shadow-amber-500/20 text-sm uppercase tracking-wider cursor-pointer">
        {t.btnGen}
      </button>
    </div>

    <div>
      <label class="block text-xs font-mono text-slate-400 mb-1">{t.lblPrev}</label>
      <textarea id="cadaLetterPreviewEn" rows="11" readonly class="w-full p-4 bg-slate-900 border border-slate-800 rounded-xl text-xs font-mono text-slate-300 leading-relaxed focus:outline-none select-all"></textarea>
    </div>
  </div>
</div>

<script is:inline define:vars={{ t }}>
  document.addEventListener('DOMContentLoaded', () => {
    const select = document.getElementById('cadaEnqueteSelectEn');
    const autorite = document.getElementById('cadaAutoriteInputEn');
    const nom = document.getElementById('cadaNomInputEn');
    const btn = document.getElementById('cadaGenerateBtnEn');
    const preview = document.getElementById('cadaLetterPreviewEn');

    const updatePreview = () => {
      const auth = (autorite && autorite.value.trim()) || t.defAuth;
      const name = (nom && nom.value.trim()) || t.defName;
      const topic = (select && select.options[select.selectedIndex] && select.options[select.selectedIndex].text) || "Public Records";
      const d = new Date().toLocaleDateString(t.dateLoc);

      if (preview) {
        preview.value = `${t.tplTo} ${auth}\n${t.tplDate} ${d}\n${t.tplFrom} ${name}\n\n${t.tplSubj}\n\n${t.tplBody1}\n\n>>> ${topic} <<<\n\n${t.tplBody2}\n\n${name}`;
      }
    };

    if (btn) btn.addEventListener('click', updatePreview);
    if (select) select.addEventListener('change', updatePreview);
    updatePreview();
  });
</script>
