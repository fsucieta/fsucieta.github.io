---

<div class="bg-slate-950 border border-slate-800 rounded-2xl p-6 md:p-8 shadow-2xl my-10" id="carto-fonciere-section">
  <!-- En-tête -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6 border-b border-slate-800 pb-4">
    <div>
      <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
        SIG SOUVERAIN & BAROMÈTRE — 19 INTERCOMMUNALITÉS (360 COMMUNES)
      </span>
      <h3 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
        🗺️ Cartographie & Action Citoyenne Intercommunale
      </h3>
    </div>
    <div class="flex items-center gap-2 text-xs font-mono">
      <span class="bg-slate-900 px-3 py-1.5 rounded-lg border border-slate-800 text-amber-400 font-bold">
        19 EPCI • Recherche par Commune Active
      </span>
    </div>
  </div>

  <!-- Barre de Recherche Directe par Commune (FONCTIONNALITÉ 1) -->
  <div class="mb-6 bg-slate-900 p-4 rounded-xl border border-slate-800 flex flex-col md:flex-row gap-4 items-center justify-between">
    <div class="w-full md:w-2/3 relative">
      <label for="communeSearch" class="text-xs font-mono text-slate-400 block mb-1">🔍 Recherche Directe par Commune ou Village :</label>
      <input 
        type="text" 
        id="communeSearch" 
        placeholder="Tapez le nom de votre commune (ex: Bonifacio, Corte, Cargèse, Sartène, Afa...)..." 
        class="w-full bg-slate-950 border border-slate-700 text-amber-400 text-xs font-mono rounded-lg p-2.5 focus:outline-none focus:border-amber-400 transition"
      />
      <div id="searchResults" class="hidden absolute top-full left-0 right-0 bg-slate-950 border border-amber-500/40 rounded-lg shadow-2xl z-50 mt-1 max-h-48 overflow-y-auto font-mono text-xs"></div>
    </div>

    <div class="w-full md:w-1/3">
      <label for="epciSelect" class="text-xs font-mono text-slate-400 block mb-1">Ou choisir l'EPCI :</label>
      <select 
        id="epciSelect" 
        class="w-full bg-slate-950 border border-slate-700 text-amber-400 text-xs font-mono rounded-lg p-2.5 focus:outline-none focus:border-amber-400"
      >
        {intercommunalites.map((epci) => (
          <option value={epci.id}>
            {epci.icon} {epci.name} — {epci.pression}
          </option>
        ))}
      </select>
    </div>
  </div>

  <!-- Conteneur 2 Colonnes : Carte Interactive Leaflet + Inspecteur & Baromètre (7/12 + 5/12) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- Carte SIG Leaflet (7/12) -->
    <div class="lg:col-span-7 flex flex-col justify-between">
      <div class="w-full h-[560px] rounded-xl border border-slate-800 bg-slate-900 relative overflow-hidden shadow-inner" id="gisMapContainer"></div>
      <div class="mt-3 flex items-center justify-between text-xs font-mono text-slate-400 bg-slate-900/90 px-4 py-2 rounded-lg border border-slate-800">
        <span>📍 Survolez ou cliquez sur les repères pour auditer une intercommunalité</span>
        <span class="text-amber-400 font-bold">CARTO OpenStreetMap Dark</span>
      </div>
    </div>

    <!-- Inspecteur Intercommunal & Baromètre (5/12) -->
    <div class="lg:col-span-5 flex flex-col justify-between bg-slate-900 border border-slate-800 rounded-xl p-6">
      <div>
        <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider block mb-3">INSPECTEUR & BAROMÈTRE EPCI</span>

        <!-- Fiche Détails EPCI Sélectionnée -->
        <div id="epciDetailPanel" class="bg-slate-950 border border-slate-800 rounded-xl p-5">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3 mb-3">
            <div>
              <h4 class="text-base font-bold font-serif text-amber-400 flex items-center gap-1.5" id="panelEpciName">
                {intercommunalites[0].icon} {intercommunalites[0].name}
              </h4>
              <span class="text-[10px] font-mono text-slate-400 block" id="panelEpciType">{intercommunalites[0].type}</span>
            </div>
            <span class="px-2.5 py-1 text-[11px] font-mono font-bold rounded bg-red-500/20 text-red-400 border border-red-500/30" id="panelEpciPression">
              Pression : {intercommunalites[0].pression}
            </span>
          </div>

          <!-- BAROMÈTRE COMPARATIF (FONCTIONNALITÉ 3) -->
          <div class="mb-4 bg-slate-900/90 p-3 rounded-lg border border-slate-800/80">
            <span class="text-[11px] font-mono text-slate-400 font-bold block mb-2">📊 Baromètre de Pression Foncière & Spéculation :</span>
            
            <!-- Jauge 1 : Indice Pression globale -->
            <div class="mb-2">
              <div class="flex justify-between text-[10px] font-mono text-slate-400 mb-1">
                <span>Indice Pression Spéculative :</span>
                <span class="text-amber-400 font-bold" id="panelBarometerValue">{intercommunalites[0].pressionValue}%</span>
              </div>
              <div class="w-full bg-slate-950 h-2 rounded-full overflow-hidden border border-slate-800">
                <div class="bg-gradient-to-r from-amber-500 to-red-500 h-full transition-all duration-500" id="panelBarometerBar" style={`width: ${intercommunalites[0].pressionValue}%`}></div>
              </div>
            </div>

            <!-- Jauge 2 : Part Résidences Secondaires -->
            <div class="grid grid-cols-2 gap-2 mt-2 pt-2 border-t border-slate-800 text-[10px] font-mono">
              <div class="bg-slate-950 p-2 rounded border border-slate-800">
                <span class="text-slate-400 block">Résidences Secondaires :</span>
                <span class="text-cyan-400 font-bold text-xs" id="panelRatioSecundaire">{intercommunalites[0].ratioSecundaire}</span>
              </div>
              <div class="bg-slate-950 p-2 rounded border border-slate-800">
                <span class="text-slate-400 block">Permis Tacites R.424-1 :</span>
                <span class="text-amber-400 font-bold text-xs" id="panelPermisTacites">{intercommunalites[0].permisTacitesCount}</span>
              </div>
            </div>
          </div>

          <div class="mb-3">
            <span class="text-xs font-mono text-slate-400 block mb-1">Communes Membres (<span id="panelCommunesCount">{intercommunalites[0].communesCount}</span>) :</span>
            <p class="text-xs font-serif text-slate-300 bg-slate-900 p-2.5 rounded border border-slate-800/80 leading-relaxed max-h-20 overflow-y-auto" id="panelEpciCommunes">
              {intercommunalites[0].details}
            </p>
          </div>

          <div class="mb-4">
            <span class="text-xs font-mono text-slate-400 block mb-1">Indicateur Clé Audit :</span>
            <div class="text-xs font-mono font-bold text-cyan-400 bg-cyan-500/10 p-2 rounded border border-cyan-500/20" id="panelEpciIndicateur">
              {intercommunalites[0].indicateur}
            </div>
          </div>

          <div>
            <span class="text-xs font-mono text-slate-400 block mb-1.5">Enquêtes d'Impact Associées (Cliquables) :</span>
            <div class="flex flex-wrap gap-2 mb-4" id="panelEpciEnquetes">
              {intercommunalites[0].enquetesAssociees.map(id => {
                const slug = enqueteSlugMap[id] || `01-le-grand-verrou-financier`;
                return (
                  <a 
                    href={`./enquetes/${slug}/`} 
                    class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 hover:border-amber-400 rounded text-xs font-mono text-amber-400 font-bold hover:bg-amber-500/20 transition flex items-center gap-1 shadow-sm"
                  >
                    <span>📖 Enquête #{id.toString().padStart(2, '0')}</span>
                  </a>
                );
              })}
            </div>
          </div>

          <!-- BOUTON SAISINE CADA DIRECTE (FONCTIONNALITÉ 2) -->
          <a 
            href="#cada-generator" 
            id="panelCadaActionBtn"
            class="w-full block text-center py-2.5 px-4 bg-amber-500 text-slate-950 font-bold rounded-lg text-xs uppercase tracking-wider font-mono hover:bg-amber-400 transition shadow-lg shadow-amber-500/20"
          >
            ⚖️ Générer la saisine CADA pour cette Intercommunalité →
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ intercommunalites, enqueteSlugMap }}>
  document.addEventListener('DOMContentLoaded', function() {
    const mapElement = document.getElementById('gisMapContainer');
    if (!mapElement || typeof L === 'undefined') return;

    // 1. Initialisation Carte Leaflet
    const map = L.map('gisMapContainer', {
      center: [42.15, 9.15],
      zoom: 8,
      zoomControl: true
    });

    L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap &copy; CARTO',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);

    // Création de 2 couches séparées (Panes) pour supprimer 100% des conflits et bugs d'affichage
    map.createPane('geojsonPane');
    map.getPane('geojsonPane').style.zIndex = 400;

    map.createPane('markerPane');
    map.getPane('markerPane').style.zIndex = 650;

    // 1. Chargement de la Couche GeoJSON des 360 Communes sur le Pane Fond (zIndex 400)
    let communesGeoJsonLayer = null;

    fetch('./corsica_communes.geojson')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        communesGeoJsonLayer = L.geoJSON(data, {
          pane: 'geojsonPane',
          style: function(feature) {
            return {
              color: '#334155',
              weight: 1,
              fillColor: '#0f172a',
              fillOpacity: 0.3
            };
          }
        }).addTo(map);
      })
      .catch(function(err) { console.error('GeoJSON Load error:', err); });

    // 2. Repères & Pointeurs Interactifs des 19 EPCI sur le Pane Supérieur (zIndex 650)
    const markersMap = {};

    intercommunalites.forEach(function(epci) {
      const circle = L.circleMarker(epci.coords, {
        pane: 'markerPane',
        radius: epci.pression === 'Critique' ? 14 : (epci.pression.includes('Très') ? 12 : 9),
        fillColor: epci.pression === 'Critique' ? '#ef4444' : (epci.pression.includes('Très') ? '#f97316' : '#f59e0b'),
        color: '#ffffff',
        weight: 2,
        fillOpacity: 0.95
      }).addTo(map);

      circle.bindTooltip(`<b>${epci.name}</b><br/>${epci.communesCount} communes • Indice ${epci.pressionValue}%`, { permanent: false, direction: 'top' });

      circle.on('click', function() {
        selectEPCI(epci.id);
      });

      markersMap[epci.id] = circle;
    });

    // 2. Fonction de sélection EPCI avec Illumination des VRAIS POLYGONES de Communes
    const epciSelect = document.getElementById('epciSelect');

    function selectEPCI(epciId) {
      const epci = intercommunalites.find(function(item) { return item.id === epciId; });
      if (!epci) return;

      if (epciSelect) epciSelect.value = epciId;

      document.getElementById('panelEpciName').innerHTML = `${epci.icon} ${epci.name}`;
      document.getElementById('panelEpciType').textContent = epci.type;
      document.getElementById('panelEpciPression').textContent = `Pression : ${epci.pression}`;
      document.getElementById('panelCommunesCount').textContent = epci.communesCount;
      document.getElementById('panelEpciCommunes').textContent = epci.details;
      document.getElementById('panelEpciIndicateur').textContent = epci.indicateur;
      
      // Update Baromètre
      document.getElementById('panelBarometerValue').textContent = `${epci.pressionValue}%`;
      document.getElementById('panelBarometerBar').style.width = `${epci.pressionValue}%`;
      document.getElementById('panelRatioSecundaire').textContent = epci.ratioSecundaire;
      document.getElementById('panelPermisTacites').textContent = epci.permisTacitesCount;

      const actionBtn = document.getElementById('panelCadaActionBtn');
      if (actionBtn) {
        actionBtn.textContent = `⚖️ Générer la saisine CADA pour ${epci.name} →`;
      }

      // Génération dynamique de vrais liens cliquables pour chaque enquête associée
      const enquetesContainer = document.getElementById('panelEpciEnquetes');
      if (enquetesContainer) {
        enquetesContainer.innerHTML = epci.enquetesAssociees.map(function(id) {
          const slug = enqueteSlugMap[id] || '01-le-grand-verrou-financier';
          return `<a href="./enquetes/${slug}/" class="px-2.5 py-1 bg-amber-500/10 border border-amber-500/30 hover:border-amber-400 rounded text-xs font-mono text-amber-400 font-bold hover:bg-amber-500/20 transition flex items-center gap-1 shadow-sm">
            <span>📖 Enquête #${id.toString().padStart(2, '0')}</span>
          </a>`;
        }).join('');
      }

      // SURBRILLANCE EXCLUSIVE DES POLYGONES CADASTRAUX DES COMMUNES DU TERRITOIRE
      if (communesGeoJsonLayer) {
        const highlightColor = epci.pression === 'Critique' ? '#ef4444' : '#f59e0b';

        communesGeoJsonLayer.setStyle(function(feature) {
          const name = feature.properties.nom;
          const isMember = epci.communesList.some(function(cName) {
            return cName.toLowerCase() === name.toLowerCase();
          });

          if (isMember) {
            return {
              color: highlightColor,
              weight: 2.5,
              fillColor: highlightColor,
              fillOpacity: 0.45
            };
          } else {
            return {
              color: '#1e293b',
              weight: 0.8,
              fillColor: '#090d16',
              fillOpacity: 0.2
            };
          }
        });
      }

      map.flyTo(epci.coords, 9.5, { duration: 1.2 });
    }

    if (epciSelect) {
      epciSelect.addEventListener('change', function(e) {
        selectEPCI(e.target.value);
      });
    }

    // 3. FONCTIONNALITÉ 1 : Recherche Directe par Commune
    const communeSearchInput = document.getElementById('communeSearch');
    const searchResults = document.getElementById('searchResults');

    if (communeSearchInput && searchResults) {
      communeSearchInput.addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase().trim();
        if (query.length < 2) {
          searchResults.classList.add('hidden');
          return;
        }

        const matches = [];
        intercommunalites.forEach(function(epci) {
          epci.communesList.forEach(function(commune) {
            if (commune.toLowerCase().includes(query)) {
              matches.push({ commune: commune, epci: epci });
            }
          });
        });

        if (matches.length > 0) {
          searchResults.innerHTML = matches.map(function(m) {
            return `<div class="p-2.5 hover:bg-slate-900 cursor-pointer border-b border-slate-800/80 flex justify-between items-center" data-epci-id="${m.epci.id}">
              <span class="font-bold text-amber-400">📍 ${m.commune}</span>
              <span class="text-[10px] text-slate-400">${m.epci.name}</span>
            </div>`;
          }).join('');
          searchResults.classList.remove('hidden');

          // Clic sur un résultat de commune
          searchResults.querySelectorAll('div').forEach(function(item) {
            item.addEventListener('click', function() {
              const selectedEpciId = item.getAttribute('data-epci-id');
              selectEPCI(selectedEpciId);
              searchResults.classList.add('hidden');
              communeSearchInput.value = item.querySelector('.font-bold').textContent.replace('📍 ', '');
            });
          });
        } else {
          searchResults.innerHTML = `<div class="p-3 text-slate-400 text-center">Aucune commune trouvée</div>`;
          searchResults.classList.remove('hidden');
        }
      });

      // Masquer les résultats si clic extérieur
      document.addEventListener('click', function(e) {
        if (!communeSearchInput.contains(e.target) && !searchResults.contains(e.target)) {
          searchResults.classList.add('hidden');
        }
      });
    }
  });
</script>
