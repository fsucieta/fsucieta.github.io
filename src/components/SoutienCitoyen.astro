<!-- SCRIPT JS LOCAL ET LÉGER DE BASCULE D'ONGLETS ET COPIE -->
<script is:inline>
  function switchCryptoTab(asset) {
    const tabXmr = document.getElementById('tab_xmr');
    const tabBtc = document.getElementById('tab_btc');
    const panelXmr = document.getElementById('panel_xmr');
    const panelBtc = document.getElementById('panel_btc');

    if (asset === 'xmr') {
      panelXmr.classList.remove('hidden');
      panelBtc.classList.add('hidden');
      tabXmr.classList.add('bg-cyan-500/15', 'border-cyan-400', 'text-white');
      tabXmr.classList.remove('bg-black/40', 'border-white/10', 'text-slate-400');
      tabBtc.classList.remove('bg-amber-500/15', 'border-amber-400', 'text-white');
      tabBtc.classList.add('bg-black/40', 'border-white/10', 'text-slate-400');
    } else {
      panelBtc.classList.remove('hidden');
      panelXmr.classList.add('hidden');
      tabBtc.classList.add('bg-amber-500/15', 'border-amber-400', 'text-white');
      tabBtc.classList.remove('bg-black/40', 'border-white/10', 'text-slate-400');
      tabXmr.classList.remove('bg-cyan-500/15', 'border-cyan-400', 'text-white');
      tabXmr.classList.add('bg-black/40', 'border-white/10', 'text-slate-400');
    }
  }

  function copyText(val, btnId) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(val);
    } else {
      const el = document.createElement('textarea');
      el.value = val;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
    }

    const labelId = btnId.replace('btn_', 'label_');
    const labelEl = document.getElementById(labelId);
    if (labelEl) {
      const orig = labelEl.innerText;
      labelEl.innerText = "✓ COPIÉ DANS LE PRESSE-PAPIER !";
      setTimeout(() => {
        labelEl.innerText = orig;
      }, 2500);
    }
  }
</script>
