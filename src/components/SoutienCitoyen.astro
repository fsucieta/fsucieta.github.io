  <!-- ================= VOIE 3 : SOUTIEN CITOYEN 0 € (ESPRIT FMHY) ================= -->
  <div class="rounded-3xl bg-black/40 border border-emerald-500/30 p-6 sm:p-8 space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2.5 font-mono-tech text-xs text-emerald-400 font-bold uppercase tracking-widest">
        <span>✊</span> VOIE 3 · ACTION CITOYENNE SANS ARGENT (0 €)
      </div>
      <span class="text-[11px] font-mono-tech text-slate-400">
        Le partage vaut plus que l'or
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono-tech text-xs">
