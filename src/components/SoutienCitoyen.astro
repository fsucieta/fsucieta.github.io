---
/**
 * COMPOSANT MAÎTRE D'ENGAGEMENT & DE SOUTIEN CITOYEN — L'OCHJU
 *
 * Architecture progressive vérifiée (ergonomie mobile, accessibilité WAI-ARIA 1.2 & conformité MiCA/CGI/RGPD) :
 * 1. Explication factuelle en français courant avant toute technique.
 * 2. Contribution volontaire libre : zéro montant suggéré, zéro palier incitatif, zéro affectation fléchée.
 * 3. Deux portes d'entrée adaptées à la situation réelle du visiteur :
 *    - Porte 01 (par défaut) : parcours débutant en auto-garde depuis un prestataire européen agréé (PSCA).
 *    - Porte 02 : affichage unitaire d'un seul QR Code vectoriel fluide à la fois avec contrôle anti-erreur.
 * 4. Engagement citoyen à 0 € (affiché en grand sur page complète et en bandeau synthétique dans la modale).
 * 5. Clause de gratuité intégrale (BYAF) et mentions légales, fiscales, électorales et RGPD opposables.
 */
import QRCode from 'qrcode';
import {
  CRYPTO_WALLETS,
  WHY_NO_CLASSIC_CB,
  BEGINNER_GUIDE_STEPS,
  ZERO_EURO_ACTIONS,
  LEGAL_DISCLOSURES
} from '../data/crypto_config';

interface Props {
  variant?: 'full' | 'compact';
  title?: string;
  subtitle?: string;
  idPrefix?: string;
  hideCharterLink?: boolean;
}

const {
  variant = 'full',
  title = "Soutenir l'Indépendance de L'OCHJU",
  subtitle = "Zéro subvention publique. Zéro publicité. Zéro abonnement payant. Notre liberté d'enquêter en Corse ne dépend que des citoyens — par une contribution libre du montant de votre choix, ou en relayant nos preuves.",
  idPrefix = 'sc_',
  hideCharterLink = false
} = Astro.props;

// Masquage automatique du lien vers /soutenir/ si le lecteur consulte déjà cette page
const currentPath = Astro.url?.pathname?.replace(/\/+$/, '') || '';
const shouldShowCharterLink = !hideCharterLink && currentPath !== '/soutenir';

// Pré-génération statique locale des 3 QR Codes vectoriels SVG (margin: 2 norme ISO/IEC 18004, zéro appel externe)
const walletsWithQr = await Promise.all(
  CRYPTO_WALLETS.map(async (wallet) => {
    const rawSvg = await QRCode.toString(wallet.address, {
      type: 'svg',
      margin: 2,
      errorCorrectionLevel: 'M',
      color: { dark: '#06080d', light: '#ffffff' },
      width: 208
    });
    // Injection d'attributs accessibles et responsives pour éviter tout débordement sur écrans 320px-375px
    const safeLabel = `QR Code officiel ${wallet.name} (${wallet.networkLabel})`;
    const qrSvg = rawSvg.replace(
      '<svg ',
      `<svg role="img" aria-label="${safeLabel}" class="w-full h-auto max-w-[168px] sm:max-w-[204px] block mx-auto" `
    );
    return { ...wallet, qrSvg };
  })
);
---

<section
  class={`bg-slate-950 border border-amber-500/40 rounded-2xl shadow-2xl overflow-hidden not-prose ${variant === 'compact' ? 'p-4 sm:p-6 md:p-7 my-1' : 'p-4 sm:p-6 md:p-10 my-10'}`}
  id={`${idPrefix}container`}
  aria-label="Soutenir l'indépendance de la Cellule L'OCHJU"
>
  <!-- ========================================================================= -->
  <!-- BLOC 1 : EN-TÊTE & LE « POURQUOI » HUMAIN (AVANT TOUTE TECHNIQUE)         -->
  <!-- ========================================================================= -->
  <div class="border-b border-slate-800 pb-6 mb-6 space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-2.5">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded text-[11px] font-mono font-bold uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span>INDÉPENDANCE FINANCIÈRE TOTALE</span>
      </div>
      <div class="text-[11px] font-mono text-slate-300 bg-slate-900 px-3 py-1 rounded border border-slate-800">
        Contribution 100 % libre · Sans minimum ni palier conseillé
      </div>
    </div>

    <div>
      <h3 class={`${variant === 'compact' ? 'text-xl md:text-2xl' : 'text-2xl md:text-3xl'} font-black text-slate-100 font-serif leading-tight tracking-tight`}>
        {title}
      </h3>
      <p class="text-slate-300 text-sm md:text-base font-serif mt-2.5 max-w-3xl leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Explication factuelle de l'absence de module de carte bancaire ou de cagnotte centralisée -->
    <div class="bg-slate-900/80 border border-slate-800 rounded-xl p-3.5 sm:p-5 space-y-3">
      <div class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider leading-snug">
        Pourquoi n’y a-t-il pas de module de paiement par Carte Bancaire ou de cagnotte centralisée sur cette page ?
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
        {WHY_NO_CLASSIC_CB.map((reason) => (
          <div class="bg-slate-950/90 border border-slate-800/90 rounded-lg p-3.5 space-y-1.5">
            <span class="text-[10px] font-mono font-bold text-cyan-400 uppercase tracking-widest block">
              {reason.badge}
            </span>
            <h4 class="text-xs md:text-sm font-sans font-bold text-slate-100">
              {reason.title}
            </h4>
            <p class="text-xs font-serif text-slate-400 leading-relaxed">
              {reason.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- BLOC 2 : AIGUILLAGE ACCESSIBLE EN 2 GRANDES PORTES                        -->
  <!-- ========================================================================= -->
  <div class="space-y-6">
    <div>
      <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-slate-400 block mb-2.5">
        Choisissez votre situation pour afficher la marche à suivre :
      </span>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3" role="tablist" aria-label="Mode de contribution">
        <!-- PORTE 01 : Débutant (ouverte par défaut pour accompagner les lecteurs novices) -->
        <button
          type="button"
          id={`${idPrefix}tab_cb`}
          role="tab"
          aria-selected="true"
          aria-controls={`${idPrefix}view_cb`}
          tabindex="0"
          class="sc-door-cb p-4 rounded-xl border-2 border-amber-400 bg-amber-500/15 text-left transition cursor-pointer group"
        >
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-amber-400">
              PORTE 01 — PARCOURS DÉBUTANT GUIDÉ
            </span>
            <span class="sc-door-cb-pill text-[10px] font-mono px-2 py-0.5 rounded bg-amber-400 text-slate-950 font-bold shrink-0">
              Sélectionné
            </span>
          </div>
          <div class="text-sm md:text-base font-bold font-sans text-slate-100">
            Je n’ai jamais utilisé de crypto-actifs
          </div>
          <p class="text-xs font-serif text-slate-300 mt-1">
            Marche à suivre pas à pas (~3 minutes) depuis votre téléphone ou votre ordinateur.
          </p>
        </button>

        <!-- PORTE 02 : Utilisateur disposant déjà d'un portefeuille numérique -->
        <button
          type="button"
          id={`${idPrefix}tab_qr`}
          role="tab"
          aria-selected="false"
          aria-controls={`${idPrefix}view_qr`}
          tabindex="-1"
          class="sc-door-qr p-4 rounded-xl border border-slate-800 bg-slate-900 hover:border-cyan-400/60 text-left transition cursor-pointer group"
        >
          <div class="flex items-center justify-between gap-2 mb-1">
            <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-cyan-400">
              PORTE 02 — ACCÈS DIRECT AUX ADRESSES
            </span>
            <span class="sc-door-qr-pill text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-bold shrink-0">
              Afficher QR
            </span>
          </div>
          <div class="text-sm md:text-base font-bold font-sans text-slate-100">
            J’ai déjà un portefeuille en auto-garde
          </div>
          <p class="text-xs font-serif text-slate-400 mt-1">
            Copier l’adresse ou scanner le QR Code officiel (Monero, Bitcoin ou USDC Polygon).
          </p>
        </button>
      </div>
    </div>

    <!-- ----------------------------------------------------------------------- -->
    <!-- CONTENU PORTE 01 : GUIDE PAS-À-PAS EN FRANÇAIS COURANT (CADRE MiCA)     -->
    <!-- ----------------------------------------------------------------------- -->
    <div
      id={`${idPrefix}view_cb`}
      role="tabpanel"
      aria-labelledby={`${idPrefix}tab_cb`}
      class="bg-slate-900/90 border border-amber-500/30 rounded-xl p-4 sm:p-5 md:p-7 space-y-5"
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4">
        <div>
          <h4 class="text-base md:text-lg font-bold font-serif text-slate-100">
            Soutenir L’OCHJU en auto-garde en 3 étapes simples
          </h4>
          <p class="text-xs font-serif text-slate-400 mt-1 leading-relaxed">
            Ce parcours en auto-garde (self-custody) s’exerce dans le cadre du règlement européen MiCA (UE 2023/1114) : aucun paiement par carte n’est exécuté sur notre site.
          </p>
        </div>
        <span class="text-[11px] font-mono text-amber-300 bg-slate-950 px-3 py-1 rounded border border-amber-500/30 shrink-0 w-fit">
          Durée : ~3 minutes
        </span>
      </div>

      <!-- Les 3 étapes détaillées sans jargon -->
      <div class="space-y-4">
        {BEGINNER_GUIDE_STEPS.map((step) => (
          <div class="bg-slate-950 border border-slate-800 rounded-xl p-3.5 sm:p-5 flex flex-col md:flex-row gap-3.5 md:gap-4">
            <div class="flex md:flex-col items-center md:items-start justify-between md:justify-start gap-2 shrink-0 md:w-28 border-b md:border-b-0 md:border-r border-slate-800 pb-2 md:pb-0 md:pr-4">
              <span class="w-8 h-8 rounded-lg bg-amber-400 text-slate-950 font-mono font-black text-sm flex items-center justify-center">
                {step.number}
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400">
                {step.duration}
              </span>
            </div>

            <div class="space-y-2.5 flex-1">
              <h5 class="text-sm md:text-base font-sans font-bold text-slate-100 leading-snug">
                {step.title}
              </h5>
              <p class="text-xs md:text-sm font-serif text-slate-300 leading-relaxed">
                {step.explanation}
              </p>
              <div class="bg-slate-900/90 border border-slate-800 px-3.5 py-2.5 rounded-lg text-xs font-serif leading-relaxed">
                <strong class="font-mono text-[11px] text-emerald-400 uppercase tracking-wide mr-1.5">
                  {step.reassuranceLabel}
                </strong>
                <span class="text-slate-300">{step.reassuranceText}</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Passerelle directe vers chacune des 3 adresses officielles -->
      <div class="pt-3 border-t border-slate-800 space-y-3">
        <span class="text-xs font-serif text-slate-300 block">
          Votre portefeuille personnel est prêt ? Affichez l’adresse officielle à copier ou à scanner :
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
          <button
            type="button"
            class="sc-jump-to-coin px-4 py-3 rounded-lg bg-amber-400 hover:bg-amber-300 text-slate-950 font-mono font-black text-xs uppercase tracking-wider transition cursor-pointer shadow-lg shadow-amber-400/15 text-center"
            data-target-coin="btc"
          >
            Adresse Bitcoin (BTC) →
          </button>
          <button
            type="button"
            class="sc-jump-to-coin px-4 py-3 rounded-lg bg-cyan-400/15 hover:bg-cyan-400/25 text-cyan-200 border border-cyan-400/45 font-mono font-bold text-xs uppercase tracking-wider transition cursor-pointer text-center"
            data-target-coin="xmr"
          >
            Adresse Monero (XMR) →
          </button>
          <button
            type="button"
            class="sc-jump-to-coin px-4 py-3 rounded-lg bg-slate-950 hover:bg-slate-800 text-emerald-300 border border-emerald-500/35 font-mono font-bold text-xs uppercase tracking-wider transition cursor-pointer text-center"
            data-target-coin="usdc"
          >
            Adresse USDC (Polygon) →
          </button>
        </div>
      </div>
    </div>

    <!-- ----------------------------------------------------------------------- -->
    <!-- CONTENU PORTE 02 : UN SEUL GRAND QR CODE CENTRAL À LA FOIS              -->
    <!-- ----------------------------------------------------------------------- -->
    <div
      id={`${idPrefix}view_qr`}
      role="tabpanel"
      aria-labelledby={`${idPrefix}tab_qr`}
      class="hidden scroll-mt-28 bg-slate-900/90 border border-cyan-400/35 rounded-xl p-4 sm:p-5 md:p-7 space-y-6"
    >
      <!-- Sélecteur accessible entre les 3 coffres (1 seul affiché à la fois) -->
      <div class="space-y-2">
        <span class="text-[11px] font-mono uppercase tracking-widest text-slate-400 block">
          1. Sélectionnez l’actif que vous souhaitez envoyer :
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="tablist" aria-label="Sélection du coffre de réception">
          {walletsWithQr.map((w, idx) => (
            <button
              type="button"
              id={`${idPrefix}cointab_${w.id}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`${idPrefix}coinpanel_${w.id}`}
              tabindex={idx === 0 ? '0' : '-1'}
              class={`sc-coin-tab px-3.5 py-3 rounded-lg border text-left transition cursor-pointer ${idx === 0 ? w.accentClasses.activeTab : 'bg-slate-950 border-slate-800 text-slate-300 hover:border-slate-700'}`}
              data-coin={w.id}
              data-active-class={w.accentClasses.activeTab}
            >
              <div class="text-xs font-mono font-black uppercase tracking-wider">
                {w.rank} · {w.tabTitle}
              </div>
              <div class={`sc-coin-sub text-[11px] font-sans mt-0.5 ${idx === 0 ? 'text-slate-900 font-semibold' : 'text-slate-400'}`}>
                {w.tabSubtitle}
              </div>
            </button>
          ))}
        </div>
      </div>

      <!-- Panneau unitaire spacieux du coffre sélectionné -->
      {walletsWithQr.map((wallet, idx) => (
        <div
          id={`${idPrefix}coinpanel_${wallet.id}`}
          role="tabpanel"
          aria-labelledby={`${idPrefix}cointab_${wallet.id}`}
          class={`sc-coin-panel ${idx === 0 ? '' : 'hidden'} bg-slate-950 border ${wallet.accentClasses.border} rounded-xl p-4 sm:p-5 md:p-6`}
          data-coin-panel={wallet.id}
        >
          <div class="grid grid-cols-1 md:grid-cols-12 gap-5 md:gap-6 items-center">
            <!-- Colonne Gauche : QR Code vectoriel fluide centré -->
            <div class="md:col-span-5 flex flex-col items-center text-center space-y-2.5">
              <div class="bg-white p-2.5 sm:p-3.5 rounded-xl shadow-xl border-2 border-slate-200 max-w-full" set:html={wallet.qrSvg} />
              <span class="text-[11px] font-mono text-slate-400 leading-snug">
                Sur ordinateur : flashez avec votre portefeuille {wallet.symbol}<br />
                Sur téléphone : utilisez le bouton « Copier » ci-contre
              </span>
            </div>

            <!-- Colonne Droite : Explication claire + Contrôle Réseau + Copie 1-clic -->
            <div class="md:col-span-7 space-y-4 min-w-0">
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                  <span class={`text-[10px] font-mono font-bold px-2.5 py-0.5 rounded border uppercase tracking-wider ${wallet.accentClasses.badge}`}>
                    Coffre {wallet.rank} · {wallet.symbol}
                  </span>
                  <span class="text-xs font-mono text-slate-400">
                    Réseau : <strong class="text-slate-100">{wallet.networkLabel}</strong>
                  </span>
                </div>
                <h4 class="text-lg md:text-xl font-bold font-serif text-slate-100">
                  {wallet.name}
                </h4>
                <p class="text-xs md:text-sm font-serif text-slate-300 mt-1 leading-relaxed">
                  {wallet.humanExplanation}
                </p>
              </div>

              <!-- Encadré anti-erreur de vérification réseau et d'irréversibilité -->
              <div class={`rounded-lg border p-3.5 text-xs font-serif leading-relaxed ${wallet.accentClasses.alertBox}`}>
                <strong class="font-mono text-[11px] uppercase tracking-wider block mb-0.5">
                  Point à contrôler avant de valider l’envoi :
                </strong>
                {wallet.networkCheckInstruction}
              </div>

              <!-- Adresse complète + repère visuel exact des 6 premiers et 6 derniers caractères -->
              <div class="space-y-1.5">
                <div class="flex flex-wrap items-center justify-between gap-1.5 text-[11px] font-mono text-slate-400">
                  <span>Adresse publique {wallet.symbol} :</span>
                  <span>
                    Contrôle 6 car. : début <strong class="text-slate-200">{wallet.prefixCheck}</strong> · fin <strong class="text-slate-200">{wallet.suffixCheck}</strong>
                  </span>
                </div>
                <div class={`sc-addr-display bg-slate-900 border border-slate-800 p-3 rounded-lg text-xs font-mono ${wallet.accentClasses.text} break-all select-all leading-relaxed`}>
                  {wallet.address}
                </div>
              </div>

              <!-- Bouton d'action de copie compatible mobile et WebView TikTok iOS -->
              <button
                type="button"
                class={`sc-copy-addr w-full py-3.5 px-4 rounded-lg font-mono font-black text-xs uppercase tracking-wider transition cursor-pointer shadow-lg ${wallet.accentClasses.copyBtn}`}
                data-address={wallet.address}
                data-label={`Copier l’adresse ${wallet.symbol}`}
              >
                Copier l’adresse {wallet.symbol}
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- BLOC 3 : SOUTENIR SANS VERSER 1 € (FORCE DE FRAPPE CITOYENNE)             -->
  <!-- ========================================================================= -->
  {variant === 'full' ? (
    <div class="mt-8 pt-6 border-t border-slate-800 space-y-4">
      <div>
        <span class="text-[11px] font-mono font-bold text-amber-400 uppercase tracking-widest block">
          VOUS NE SOUHAITEZ PAS UTILISER DE CRYPTO-ACTIFS ?
        </span>
        <h4 class="text-base md:text-lg font-bold font-serif text-slate-100 mt-0.5">
          Trois manières décisives de renforcer L’OCHJU pour 0 €
        </h4>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {ZERO_EURO_ACTIONS.map((act) => (
          <a
            href={act.href}
            class="sc-zero-euro-link bg-slate-900/80 hover:bg-slate-900 border border-slate-800 hover:border-amber-500/50 rounded-xl p-4 flex flex-col justify-between space-y-3 transition group"
          >
            <div class="space-y-1.5">
              <span class="text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest block">
                {act.tag}
              </span>
              <div class="text-sm font-sans font-bold text-slate-100 group-hover:text-amber-300 transition">
                {act.title}
              </div>
              <p class="text-xs font-serif text-slate-400 leading-relaxed">
                {act.description}
              </p>
            </div>
            <span class="text-[11px] font-mono font-bold text-amber-400 group-hover:translate-x-0.5 transition inline-block">
              {act.linkLabel}
            </span>
          </a>
        ))}
      </div>
    </div>
  ) : (
    /* Rappel compact des 3 actions à 0 € à l'intérieur de la modale pour n'exclure aucun lecteur */
    <div class="mt-6 pt-4 border-t border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <div class="text-xs font-serif text-slate-300">
        <strong class="font-mono text-[11px] text-amber-400 uppercase tracking-wider mr-1.5">Agir pour 0 € :</strong>
        Vous pouvez aussi soutenir L’OCHJU sans versement financier :
      </div>
      <div class="flex flex-wrap gap-2">
        {ZERO_EURO_ACTIONS.map((act) => (
          <a
            href={act.href}
            class="sc-zero-euro-link text-[11px] font-mono font-bold px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-amber-300 border border-slate-700 hover:border-amber-400/60 transition"
          >
            {act.title} →
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- ========================================================================= -->
  <!-- BLOC 4 : CLAUSE DE GRATUITÉ (BYAF) & MENTIONS LÉGALES FRANÇAISES          -->
  <!-- ========================================================================= -->
  <div class="mt-7 pt-5 border-t border-slate-800/90 space-y-3 text-xs text-slate-400 font-serif">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="leading-relaxed max-w-3xl">
        <strong class="font-mono text-[11px] text-slate-200 uppercase tracking-wider mr-1.5">Gratuité intégrale garantie —</strong>
        {LEGAL_DISCLOSURES.byafClause}
      </p>
      {shouldShowCharterLink && (
        <a
          href="/soutenir/"
          class="shrink-0 font-mono text-[11px] text-amber-400 hover:text-amber-300 uppercase tracking-wider underline underline-offset-4 transition"
        >
          Charte complète →
        </a>
      )}
    </div>

    <p class="text-[11px] text-slate-500 font-sans leading-relaxed border-t border-slate-900 pt-3">
      <strong class="font-mono uppercase text-slate-400 mr-1">Mentions légales, fiscales & RGPD :</strong>
      {LEGAL_DISCLOSURES.taxAndRegulatoryNotice}
    </p>
  </div>
</section>

<!-- Logique interactive isolée par préfixe d'instance (aucune collision entre page et modale) -->
<script is:inline define:vars={{ idPrefix }}>
  (function() {
    const container = document.getElementById(idPrefix + 'container');
    if (!container) return;

    const doorCbBtn = container.querySelector('.sc-door-cb');
    const doorQrBtn = container.querySelector('.sc-door-qr');
    const doorCbPill = container.querySelector('.sc-door-cb-pill');
    const doorQrPill = container.querySelector('.sc-door-qr-pill');
    const viewCb = document.getElementById(idPrefix + 'view_cb');
    const viewQr = document.getElementById(idPrefix + 'view_qr');

    // 1. Bascule accessible WAI-ARIA 1.2 entre Porte 01 (Guide débutant) et Porte 02 (Adresses & QR Codes)
    function activateDoor(mode, moveFocus) {
      if (!doorCbBtn || !doorQrBtn || !viewCb || !viewQr) return;
      if (mode === 'cb') {
        viewCb.classList.remove('hidden');
        viewQr.classList.add('hidden');
        doorCbBtn.setAttribute('aria-selected', 'true');
        doorCbBtn.setAttribute('tabindex', '0');
        doorQrBtn.setAttribute('aria-selected', 'false');
        doorQrBtn.setAttribute('tabindex', '-1');
        doorCbBtn.className = 'sc-door-cb p-4 rounded-xl border-2 border-amber-400 bg-amber-500/15 text-left transition cursor-pointer group';
        doorQrBtn.className = 'sc-door-qr p-4 rounded-xl border border-slate-800 bg-slate-900 hover:border-cyan-400/60 text-left transition cursor-pointer group';
        if (doorCbPill) {
          doorCbPill.className = 'sc-door-cb-pill text-[10px] font-mono px-2 py-0.5 rounded bg-amber-400 text-slate-950 font-bold shrink-0';
          doorCbPill.textContent = 'Sélectionné';
        }
        if (doorQrPill) {
          doorQrPill.className = 'sc-door-qr-pill text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-bold shrink-0';
          doorQrPill.textContent = 'Afficher QR';
        }
        if (moveFocus) doorCbBtn.focus();
      } else {
        viewCb.classList.add('hidden');
        viewQr.classList.remove('hidden');
        doorCbBtn.setAttribute('aria-selected', 'false');
        doorCbBtn.setAttribute('tabindex', '-1');
        doorQrBtn.setAttribute('aria-selected', 'true');
        doorQrBtn.setAttribute('tabindex', '0');
        doorQrBtn.className = 'sc-door-qr p-4 rounded-xl border-2 border-cyan-400 bg-cyan-400/15 text-left transition cursor-pointer group';
        doorCbBtn.className = 'sc-door-cb p-4 rounded-xl border border-slate-800 bg-slate-900 hover:border-amber-400/60 text-left transition cursor-pointer group';
        if (doorQrPill) {
          doorQrPill.className = 'sc-door-qr-pill text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-400 text-slate-950 font-bold shrink-0';
          doorQrPill.textContent = 'Sélectionné';
        }
        if (doorCbPill) {
          doorCbPill.className = 'sc-door-cb-pill text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400 font-bold shrink-0';
          doorCbPill.textContent = 'Voir le guide';
        }
        if (moveFocus) doorQrBtn.focus();
      }
    }

    if (doorCbBtn) {
      doorCbBtn.addEventListener('click', () => activateDoor('cb', false));
      doorCbBtn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          activateDoor('qr', true);
        }
      });
    }
    if (doorQrBtn) {
      doorQrBtn.addEventListener('click', () => activateDoor('qr', false));
      doorQrBtn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          activateDoor('cb', true);
        }
      });
    }

    // 2. Sélection unitaire accessible du coffre dans la Porte 02 (1 seul QR Code affiché à la fois)
    const coinTabs = Array.from(container.querySelectorAll('.sc-coin-tab'));
    const coinPanels = container.querySelectorAll('.sc-coin-panel');

    function selectCoin(coinId, moveFocus) {
      coinTabs.forEach((tab) => {
        const isMatch = tab.getAttribute('data-coin') === coinId;
        const activeCls = tab.getAttribute('data-active-class') || '';
        const sub = tab.querySelector('.sc-coin-sub');
        tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
        tab.setAttribute('tabindex', isMatch ? '0' : '-1');
        if (isMatch) {
          tab.className = 'sc-coin-tab px-3.5 py-3 rounded-lg border text-left transition cursor-pointer ' + activeCls;
          if (sub) sub.className = 'sc-coin-sub text-[11px] font-sans mt-0.5 text-slate-900 font-semibold';
          if (moveFocus) tab.focus();
        } else {
          tab.className = 'sc-coin-tab px-3.5 py-3 rounded-lg border text-left transition cursor-pointer bg-slate-950 border-slate-800 text-slate-300 hover:border-slate-700';
          if (sub) sub.className = 'sc-coin-sub text-[11px] font-sans mt-0.5 text-slate-400';
        }
      });

      coinPanels.forEach((panel) => {
        if (panel.getAttribute('data-coin-panel') === coinId) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    }

    coinTabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        const coinId = tab.getAttribute('data-coin');
        if (coinId) selectCoin(coinId, false);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const nextIdx = e.key === 'ArrowRight'
            ? (idx + 1) % coinTabs.length
            : (idx - 1 + coinTabs.length) % coinTabs.length;
          const nextCoin = coinTabs[nextIdx].getAttribute('data-coin');
          if (nextCoin) selectCoin(nextCoin, true);
        }
      });
    });

    // 3. Passerelle directe depuis la fin du guide débutant vers le bon coffre
    const jumpBtns = container.querySelectorAll('.sc-jump-to-coin');
    jumpBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetCoin = btn.getAttribute('data-target-coin') || 'btc';
        activateDoor('qr', false);
        selectCoin(targetCoin, false);
        if (viewQr) {
          viewQr.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    // 4. Copie robuste compatible navigateurs mobiles et WebView TikTok iOS (sans window.prompt bloqué)
    function legacyCopyFallback(text) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        ta.setSelectionRange(0, text.length);
        const ok = document.execCommand('copy');
        document.body.removeChild(ta);
        return ok;
      } catch (_e) {
        return false;
      }
    }

    const copyBtns = container.querySelectorAll('.sc-copy-addr');
    copyBtns.forEach((btn) => {
      let timerId = null;
      btn.addEventListener('click', async () => {
        const addr = btn.getAttribute('data-address') || '';
        const defaultLabel = btn.getAttribute('data-label') || 'Copier l’adresse';
        if (!addr) return;

        let copied = false;
        if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
          try {
            await navigator.clipboard.writeText(addr);
            copied = true;
          } catch (_err) {
            copied = legacyCopyFallback(addr);
          }
        } else {
          copied = legacyCopyFallback(addr);
        }

        if (timerId) clearTimeout(timerId);

        if (copied) {
          btn.textContent = 'Adresse copiée — prête à coller dans votre portefeuille';
        } else {
          // Dernier filet sur WebView ultra-restrictive : sélection automatique de la boîte d'adresse visible
          const panel = btn.closest('.sc-coin-panel');
          const addrBox = panel ? panel.querySelector('.sc-addr-display') : null;
          if (addrBox && window.getSelection) {
            const range = document.createRange();
            range.selectNodeContents(addrBox);
            const sel = window.getSelection();
            if (sel) {
              sel.removeAllRanges();
              sel.addRange(range);
            }
          }
          btn.textContent = 'Adresse surlignée ci-dessus — appuyez sur « Copier »';
        }

        timerId = setTimeout(() => {
          btn.textContent = defaultLabel;
        }, 3200);
      });
    });
  })();
</script>
