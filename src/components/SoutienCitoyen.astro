 * - MoonPay (Leader mondial CB & Apple Pay)
 * - DFX Swiss (Passerelle européenne souveraine, zéro KYC jusqu'à 1000 CHF/jour)
 * - Changelly (Alternative CB & Google Pay)
 * - Auto-garde directe : Monero (XMR) & Bitcoin (BTC) avec lien direct Cake Wallet
 */
import QRCode from 'qrcode';

interface Props {
  variant?: 'full' | 'compact';
  idPrefix?: string;
}

const {
  variant = 'full',
  idPrefix = 'sc_'
} = Astro.props;

// Adresses officielles vérifiées (Cake Wallet)
const BTC_ADDRESS = "bc1q7hthg2xv44rdwd7xq5jn6mceqlx9n45d7stl28";
const XMR_ADDRESS = "4Az8HHC47BndQp1t8reNiMMvKpWx55RuuP4nnEXFhYoEcP826Sb3gwZLk4AKu2erEtChqphf4LQYbHwzZFfUkXc491doTwq";

// Passerelles d'achat CB pré-remplies vers votre Cake Wallet
const ONRAMP_MOONPAY = `https://buy.moonpay.com/?currencyCode=btc&walletAddress=${BTC_ADDRESS}`;
