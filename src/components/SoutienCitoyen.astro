const ONRAMP_CHANGELLY = `https://buy.changelly.com/?crypto=BTC&address=${BTC_ADDRESS}`;

// QR Codes vectoriels générés en local
const qrBtc = await QRCode.toString(`bitcoin:${BTC_ADDRESS}`, {
  type: 'svg',
  margin: 2,
  errorCorrectionLevel: 'M',
  color: { dark: '#0a0b0e', light: '#ffffff' },
  width: 220
});

const qrXmr = await QRCode.toString(`monero:${XMR_ADDRESS}`, {
  type: 'svg',
  margin: 2,
  errorCorrectionLevel: 'M',
  color: { dark: '#0a0b0e', light: '#ffffff' },
  width: 220
