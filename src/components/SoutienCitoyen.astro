const t = i18n[currentLang as keyof typeof i18n] || i18n.fr;
---

<div class="space-y-12" id={`${idPrefix}wrapper`}>

  <!-- ================= CARTOUCHE DE CONFIANCE & DOCTRINE ================= -->
  <div class="p-5 rounded-2xl bg-black/60 border border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 font-mono-tech text-xs">
    <div class="flex items-center gap-3">
      <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
      <div>
        <div class="text-white font-bold">{t.trustTitle}</div>
        <div class="text-[11px] text-slate-400">{t.trustSub}</div>
      </div>
    </div>
    <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30 text-[10px] font-bold uppercase tracking-wider">
      {t.trustBadge}
    </span>
  </div>

  <!-- ================= VOIE 1 : PAIEMENT PAR CARTE BANCAIRE / APPLE PAY ================= -->
  <div class="rounded-3xl theme-surface border-2 border-amber-500/50 p-6 sm:p-10 shadow-2xl relative overflow-hidden group">
    <div class="absolute -right-20 -top-20 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="flex flex-wrap items-center justify-between gap-3 pb-6 border-b border-white/10">
      <div class="flex items-center gap-2.5">
        <span class="px-3.5 py-1 rounded-full bg-amber-500 text-black font-mono-tech text-xs font-black uppercase tracking-wider">
          {t.v1Badge}
        </span>
        <span class="font-mono-tech text-xs font-bold text-white uppercase tracking-widest hidden sm:inline">
          {t.v1Methods}
        </span>
      </div>
      <span class="text-xs font-mono-tech text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/30 font-bold">
        {t.v1NoCrypto}
      </span>
    </div>

    <div class="mt-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 space-y-4">
        <h3 class="text-2xl sm:text-4xl font-press font-bold text-white leading-tight">
          {t.v1TitleA} <br/>
          <span class="text-amber-400">{t.v1TitleB}</span>
        </h3>
        <p class="text-slate-300 font-press text-base leading-relaxed">
          {t.v1Desc}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 font-mono-tech text-xs text-slate-300">
          <div class="p-3 rounded-xl bg-black/40 border border-white/10 flex items-center gap-2.5">
            <span class="text-emerald-400 text-sm">✓</span>
            <span>{t.v1Feat1}</span>
          </div>
          <div class="p-3 rounded-xl bg-black/40 border border-white/10 flex items-center gap-2.5">
            <span class="text-emerald-400 text-sm">✓</span>
            <span>{t.v1Feat2}</span>
          </div>
          <div class="p-3 rounded-xl bg-black/40 border border-white/10 flex items-center gap-2.5">
            <span class="text-emerald-400 text-sm">✓</span>
            <span>{t.v1Feat3}</span>
          </div>
          <div class="p-3 rounded-xl bg-black/40 border border-white/10 flex items-center gap-2.5">
            <span class="text-emerald-400 text-sm">✓</span>
            <span>{t.v1Feat4}</span>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 p-6 sm:p-7 rounded-2xl bg-black/70 border border-white/15 space-y-5 text-center shadow-xl">
        <div class="font-mono-tech text-xs text-amber-400 font-bold uppercase tracking-wider">
          {t.v1Gateway}
        </div>

        <a 
          href={ONRAMP_MOONPAY}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-4 px-6 rounded-xl bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 text-black font-mono-tech text-sm font-black uppercase tracking-wider shadow-2xl hover:brightness-110 hover:scale-[1.02] transition duration-200 flex items-center justify-center gap-3 cursor-pointer"
        >
          <span>💳</span>
          <span>{t.v1BtnMoonpay}</span>
        </a>

        <a 
          href={ONRAMP_DFX}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-3 px-4 rounded-xl bg-black border border-amber-400/60 hover:border-amber-400 text-amber-300 font-mono-tech text-xs font-bold uppercase tracking-wider transition flex items-center justify-center gap-2"
        >
          <span>🇨🇭</span>
          <span>{t.v1BtnDfx}</span>
        </a>

        <div class="text-[11px] font-mono-tech text-slate-400 space-y-1 pt-2 border-t border-white/10">
          <div>{t.v1Preconfig}</div>
          <div class="text-amber-300 font-bold break-all select-all text-[10px] bg-black/80 p-2 rounded border border-white/10">
            {BTC_ADDRESS}
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- ================= VOIE 2 : AUTO-GARDE DIRECTE ================= -->
  <div class="rounded-3xl theme-surface border border-white/15 p-6 sm:p-10 shadow-2xl space-y-8">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-white/10">
      <div>
        <div class="font-mono-tech text-xs text-cyan-400 font-bold uppercase tracking-widest mb-1">
          {t.v2Over}
        </div>
        <h3 class="text-2xl font-press font-bold text-white">
          {t.v2Title}
        </h3>
      </div>
      <span class="text-xs font-mono-tech text-slate-400 bg-black/40 px-3 py-1.5 rounded-lg border border-white/10">
        {t.v2Privacy}
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono-tech text-xs">
      <button
        type="button"
        onclick="switchCryptoTab('xmr')"
        id="tab_xmr"
        class="crypto-tab-btn p-5 rounded-2xl border text-left transition duration-200 bg-cyan-500/15 border-cyan-400 text-white shadow-xl cursor-pointer flex flex-col justify-between gap-2"
      >
        <div class="flex items-center justify-between">
          <span class="font-bold text-sm text-cyan-300 flex items-center gap-2">
            <span>🛡️</span> Monero (XMR)
          </span>
          <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 text-[10px] font-bold border border-cyan-400/30">
            {t.xmrBadge}
          </span>
        </div>
        <p class="text-[11px] text-slate-300 font-press">
          {t.xmrTabDesc}
        </p>
      </button>

      <button
        type="button"
        onclick="switchCryptoTab('btc')"
        id="tab_btc"
        class="crypto-tab-btn p-5 rounded-2xl border text-left transition duration-200 bg-black/40 border-white/10 text-slate-400 hover:border-white/30 hover:text-white shadow-xl cursor-pointer flex flex-col justify-between gap-2"
      >
        <div class="flex items-center justify-between">
          <span class="font-bold text-sm text-white flex items-center gap-2">
            <span>₿</span> Bitcoin (BTC)
          </span>
          <span class="px-2 py-0.5 rounded bg-white/10 text-slate-300 text-[10px] font-bold border border-white/20">
            {t.btcBadge}
          </span>
        </div>
        <p class="text-[11px] text-slate-400 font-press">
          {t.btcTabDesc}
        </p>
      </button>
    </div>

    <!-- Panneau Monero (XMR) -->
    <div id="panel_xmr" class="crypto-panel p-6 sm:p-8 rounded-2xl bg-black/50 border border-cyan-500/30 space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-5 flex flex-col items-center justify-center p-5 bg-black/80 rounded-2xl border border-white/10 space-y-3">
          <div class="p-3 bg-white rounded-2xl shadow-xl w-full max-w-[210px] overflow-hidden">
            <div set:html={qrXmr} class="w-full h-auto" />
          </div>
          <div class="text-[11px] font-mono-tech text-slate-400 text-center">
            {t.xmrScan}
          </div>
        </div>

        <div class="lg:col-span-7 space-y-5">
          <div class="space-y-2">
            <span class="px-2.5 py-1 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-[10px] font-mono-tech font-bold uppercase tracking-wider">
              {t.xmrNet}
            </span>
            <h4 class="text-xl font-press font-bold text-white">
              {t.xmrPanelTitle}
            </h4>
            <p class="text-xs sm:text-sm font-press text-slate-300 leading-relaxed">
              {t.xmrPanelDesc}
            </p>
          </div>

          <div class="space-y-2">
            <label class="block font-mono-tech text-[10px] uppercase text-slate-400 tracking-wider">
              {t.xmrAddrLabel}
            </label>
            <div class="p-3 rounded-xl bg-black/90 border border-white/15 text-cyan-300 font-mono-tech text-xs break-all select-all">
              {XMR_ADDRESS}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button
              type="button"
              onclick={`copyText('${XMR_ADDRESS}', 'btn_copy_xmr', ${JSON.stringify(t.copied)})`}
              id="btn_copy_xmr"
              class="px-5 py-2.5 rounded-xl bg-cyan-400 hover:bg-cyan-300 text-slate-950 font-mono-tech text-xs font-black uppercase tracking-wider transition cursor-pointer flex items-center gap-2"
            >
              <span>📋</span>
              <span id="label_copy_xmr">{t.xmrCopy}</span>
            </button>

            <a
              href={`monero:${XMR_ADDRESS}`}
              class="px-5 py-2.5 rounded-xl bg-black border border-cyan-400/60 hover:border-cyan-400 text-cyan-300 font-mono-tech text-xs font-bold transition flex items-center gap-2"
            >
              <span>🍰</span>
              <span>{t.cakeOpen}</span>
            </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Panneau Bitcoin (BTC) -->
    <div id="panel_btc" class="crypto-panel hidden p-6 sm:p-8 rounded-2xl bg-black/50 border border-amber-500/30 space-y-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-5 flex flex-col items-center justify-center p-5 bg-black/80 rounded-2xl border border-white/10 space-y-3">
          <div class="p-3 bg-white rounded-2xl shadow-xl w-full max-w-[210px] overflow-hidden">
            <div set:html={qrBtc} class="w-full h-auto" />
          </div>
          <div class="text-[11px] font-mono-tech text-slate-400 text-center">
            {t.btcScan}
          </div>
        </div>

        <div class="lg:col-span-7 space-y-5">
          <div class="space-y-2">
            <span class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-300 border border-amber-500/30 text-[10px] font-mono-tech font-bold uppercase tracking-wider">
              {t.btcNet}
            </span>
            <h4 class="text-xl font-press font-bold text-white">
              {t.btcPanelTitle}
            </h4>
            <p class="text-xs sm:text-sm font-press text-slate-300 leading-relaxed">
              {t.btcPanelDesc}
            </p>
          </div>

          <div class="space-y-2">
            <label class="block font-mono-tech text-[10px] uppercase text-slate-400 tracking-wider">
              {t.btcAddrLabel}
            </label>
            <div class="p-3 rounded-xl bg-black/90 border border-white/15 text-amber-300 font-mono-tech text-xs break-all select-all">
              {BTC_ADDRESS}
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button
              type="button"
              onclick={`copyText('${BTC_ADDRESS}', 'btn_copy_btc', ${JSON.stringify(t.copied)})`}
              id="btn_copy_btc"
              class="px-5 py-2.5 rounded-xl bg-amber-400 hover:bg-amber-300 text-slate-950 font-mono-tech text-xs font-black uppercase tracking-wider transition cursor-pointer flex items-center gap-2"
            >
              <span>📋</span>
              <span id="label_copy_btc">{t.btcCopy}</span>
            </button>

            <a
              href={`bitcoin:${BTC_ADDRESS}`}
              class="px-5 py-2.5 rounded-xl bg-black border border-amber-400/60 hover:border-amber-400 text-amber-300 font-mono-tech text-xs font-bold transition flex items-center gap-2"
            >
              <span>🍰</span>
              <span>{t.cakeOpen}</span>
            </a>
          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- ================= VOIE 3 : SOUTIEN CITOYEN 0 € ================= -->
  <div class="rounded-3xl bg-black/40 border border-emerald-500/30 p-6 sm:p-8 space-y-6">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-white/10">
      <div class="flex items-center gap-2.5 font-mono-tech text-xs text-emerald-400 font-bold uppercase tracking-widest">
        <span>✊</span> {t.v3Title}
      </div>
      <span class="text-[11px] font-mono-tech text-slate-400">
        {t.v3Sub}
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono-tech text-xs">
      <a 
        href={t.memoHref} 
        class="p-4 rounded-xl bg-black/60 border border-white/10 hover:border-emerald-400 transition space-y-2 block"
      >
        <div class="text-white font-bold flex items-center gap-2">
          <span>📄</span> {t.v3Card1Title}
        </div>
        <p class="text-[11px] text-slate-400 font-press leading-relaxed">
          {t.v3Card1Desc}
        </p>
      </a>

      <a 
        href={t.cadaHref} 
        class="p-4 rounded-xl bg-black/60 border border-white/10 hover:border-emerald-400 transition space-y-2 block"
      >
        <div class="text-white font-bold flex items-center gap-2">
          <span>⚖️</span> {t.v3Card2Title}
        </div>
        <p class="text-[11px] text-slate-400 font-press leading-relaxed">
          {t.v3Card2Desc}
        </p>
      </a>

      <a 
        href={t.gisHref} 
        class="p-4 rounded-xl bg-black/60 border border-white/10 hover:border-emerald-400 transition space-y-2 block"
      >
        <div class="text-white font-bold flex items-center gap-2">
          <span>🗺️</span> {t.v3Card3Title}
        </div>
        <p class="text-[11px] text-slate-400 font-press leading-relaxed">
          {t.v3Card3Desc}
        </p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
  function switchCryptoTab(asset) {
    const tabXmr = document.getElementById('tab_xmr');
    const tabBtc = document.getElementById('tab_btc');
    const panelXmr = document.getElementById('panel_xmr');
    const panelBtc = document.getElementById('panel_btc');

    if (asset === 'xmr') {
      panelXmr.classList.remove('hidden');
      panelBtc.classList.add('hidden');
      tabXmr.classList.add('bg-cyan-500/15', 'border-cyan-400', 'text-white');
      tabXmr.classList.remove('bg-black/40', 'border-white/10', 'text-slate-400');
      tabBtc.classList.remove('bg-amber-500/15', 'border-amber-400', 'text-white');
      tabBtc.classList.add('bg-black/40', 'border-white/10', 'text-slate-400');
    } else {
      panelBtc.classList.remove('hidden');
      panelXmr.classList.add('hidden');
      tabBtc.classList.add('bg-amber-500/15', 'border-amber-400', 'text-white');
      tabBtc.classList.remove('bg-black/40', 'border-white/10', 'text-slate-400');
      tabXmr.classList.remove('bg-cyan-500/15', 'border-cyan-400', 'text-white');
      tabXmr.classList.add('bg-black/40', 'border-white/10', 'text-slate-400');
    }
  }

  function copyText(val, btnId, copiedMsg) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(val);
    } else {
      const el = document.createElement('textarea');
      el.value = val;
      document.body.appendChild(el);
      el.select();
      document.execCommand('copy');
      document.body.removeChild(el);
    }

    const labelId = btnId.replace('btn_', 'label_');
    const labelEl = document.getElementById(labelId);
    if (labelEl) {
      const orig = labelEl.innerText;
      labelEl.innerText = copiedMsg || "✓ COPIED!";
      setTimeout(() => {
        labelEl.innerText = orig;
      }, 2500);
    }
  }
</script>
