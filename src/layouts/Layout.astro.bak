      }

      .article-body li {
        font-family: 'Newsreader', Georgia, serif !important;
        font-size: 1.15rem !important;
        line-height: 1.85 !important;
        color: #cbd5e1 !important;
      }

      .article-body blockquote {
        border-left: 3px solid var(--theme-gold, #ffd700) !important;
        background: var(--theme-card, #080808) !important;
        border-radius: 0 16px 16px 0 !important;
        padding: 1.5rem 2rem !important;
        margin: 2.5rem 0 !important;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7) !important;
      }

      .article-body blockquote p {
        font-family: 'Newsreader', Georgia, serif !important;
        font-style: italic !important;
        font-size: 1.22rem !important;
        line-height: 1.9 !important;
        color: #f1f5f9 !important;
      }
    </style>

</head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased selection:bg-amber-500 selection:text-slate-950">
    <slot />
    <SoutienModal />
    
    <!-- Barre de Progression de Lecture Furtive (Stealth Reading Bar) -->
    <div id="readingProgressBar" class="no-print fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 z-[100] w-0 transition-all duration-150 pointer-events-none opacity-90"></div>

    <!-- Bouton Flottant "Retour en Haut" -->
    <button 
      id="backToTopBtn" 
      class="no-print fixed bottom-6 right-6 p-3.5 rounded-2xl bg-amber-500/90 text-slate-950 font-bold shadow-2xl backdrop-blur border border-amber-400 hover:bg-amber-400 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 z-50 flex items-center justify-center cursor-pointer group"
      aria-label="Retourner en haut de la page"
    >
      <span class="text-sm font-mono flex items-center gap-1">
        <span>▲</span>
        <span class="hidden sm:inline text-xs font-bold font-sans">HAUT</span>
      </span>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('backToTopBtn');
        const progressBar = document.getElementById('readingProgressBar');
        
        window.addEventListener('scroll', function() {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          
          if (progressBar && docHeight > 0) {
            const progress = (scrollY / docHeight) * 100;
            progressBar.style.width = `${progress}%`;
          }

          if (btn) {
            if (scrollY > 400) {
              btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
              btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            } else {
              btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }
          }
        });

        if (btn) {
          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>

    <!-- Moteur de Scrollytelling Forensique (Illumination fluide des preuves) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const highlights = document.querySelectorAll('mark.forensic-highlight');
        if (!highlights.length) return;

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('illuminated');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.25, rootMargin: '0px 0px -50px 0px' });

          highlights.forEach((h) => observer.observe(h));
        } else {
          highlights.forEach((h) => h.classList.add('illuminated'));
        }
      });
    </script>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <!-- Script universel d'enveloppement responsive des tableaux de données pour lecture mobile -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('article table, .article-body table').forEach((tbl) => {
          if (!tbl.closest('.overflow-x-auto') && !tbl.closest('.table-responsive-wrapper')) {
            const wrapper = document.createElement('div');
            wrapper.className = 'table-responsive-wrapper overflow-x-auto max-w-full my-6 rounded-xl border border-slate-800 bg-slate-950/80 shadow-xl';
            tbl.parentNode.insertBefore(wrapper, tbl);
            wrapper.appendChild(tbl);
          }
        });
      });
    </script>
  </body>
</html>


<style is:global>
      :root {
        --color-bg-body: #121316;
        --color-bg-card: #1a1c22;
        --color-bg-header: rgba(18, 19, 22, 0.85);
        --color-border-card: #2e323b;
        --color-text-primary: #f8fafc;
        --color-text-secondary: #cbd5e1;
        --color-text-muted: #94a3b8;
        --color-gold-main: #fbbf24;
        --color-grid: rgba(255, 255, 255, 0.05);
      }
      body {
        background-color: var(--color-bg-body) !important;
        color: var(--color-text-primary) !important;
        transition: background-color 0.4s ease, color 0.4s ease;
      }
      .bento-card {
        background-color: var(--color-bg-card) !important;
        border-color: var(--color-border-card) !important;
        transition: all 0.4s ease;
      }
      header.backdrop-blur-xl {
        background-color: var(--color-bg-header) !important;
      }

      /* Éradication absolue de toute barre de défilement (horizontale ou verticale) */
      html, body {
        overflow-x: hidden !important;
        max-width: 100vw;
      }

      /* Masquage universel des barres de défilement sur tous les moteurs (WebKit, Firefox, Edge) */
      *:not(.custom-scrollbar) {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
      }
      *:not(.custom-scrollbar)::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }

  /* ==========================================================================
     DESIGN SYSTEM SOUVERAIN L'OCHJU — MODE SOMBRE PERMANENT
     Obsidienne Minérale, Chiaroscuro & Or Antique Régalien
     ========================================================================== */

  :root, html, html.dark {
    scroll-behavior: smooth; scroll-padding-top: 205px;
    --bg-main:          #06080d;
    --bg-card:          #0b0f17;
    --bg-card-hover:    #101724;
    --bg-header:        rgba(6, 8, 13, 0.95);
    --text-main:        #f1f5f9;
    --text-muted:       #94a3b8;
    --border-color:     #151d2c;
    --border-highlight: #d4af37;
    --accent-primary:   #d4af37;
    --accent-hover:     #facc15;
    --accent-glow:      rgba(212, 175, 55, 0.12);
    --accent-card:      rgba(212, 175, 55, 0.14);
    --body-gradient:
      radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.05) 0%, transparent 60%),
      radial-gradient(circle at 85% 30%, rgba(194, 109, 67, 0.04) 0%, transparent 50%);
  }

  /* ---------- APPLICATION DU FOND ET DE L'AMBIANCE BODY ---------- */
  body {
    background-color: var(--bg-main) !important;
    background-image: var(--body-gradient) !important;
    color: var(--text-main) !important;
  }

  /* ---------- HEADER, NAVIGATION & CONTENEURS NOBLES ---------- */
  header {
    background-color: var(--bg-header) !important;
    border-color: var(--border-color) !important;
  }

  nav {
    background-color: rgba(6, 8, 13, 0.90) !important;
    border-color: var(--border-color) !important;
  }

  /* Cartes d'enquête & conteneurs de données */
  .fiche-card,
  .hero-card-container {
    border-color: var(--border-color);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .fiche-card:hover {
    border-color: var(--border-highlight) !important;
  }

  /* --------------------------------------------------------------------------
     STYLES SPÉCIFIQUES POUR LES ARTICLES (STANDARD FORENSIC PULITZER)
     -------------------------------------------------------------------------- */

  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* ==========================================================================
     ENCARTS DE RÉVÉLATION FORENSIQUE & CITATIONS NOBLES (BLOOMBERG / FT STYLE)
     ========================================================================== */
  .article-body blockquote {
    position: relative !important;
    border-left: 3px solid var(--accent-primary, #d4af37) !important;
    background: var(--bg-card, rgba(11, 15, 23, 0.75)) !important;
    backdrop-filter: blur(12px) !important;
    padding: 1.5rem 1.75rem !important;
    margin: 2.5rem 0 !important;
    border-radius: 0 12px 12px 0 !important;
    border-top: 1px solid var(--border-color, rgba(212, 175, 55, 0.15)) !important;
    border-right: 1px solid var(--border-color, rgba(21, 29, 44, 0.6)) !important;
    border-bottom: 1px solid var(--border-color, rgba(21, 29, 44, 0.6)) !important;
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.5) !important;
  }

  /* Suppression définitive de l'ampoule CSS artificielle ::before */
  .article-body blockquote::before {
    display: none !important;
    content: none !important;
  }

  .article-body blockquote p {
    color: #e2e8f0 !important;
    font-family: 'Merriweather', serif !important;
    font-size: 1.05rem !important;
    line-height: 1.85 !important;
    margin-bottom: 0.5rem !important;
    font-style: normal !important;
  }

  .article-body blockquote strong, .article-body blockquote b {
    color: #fef08a !important;
    font-weight: 700 !important;
  }

  /* CODES & LABELS FORENSIQUES */
  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  /* SURBRILLANCES FORENSIQUES LUMINEUSES SOBRES (HIGH-END MINIMALIST) */
  mark.forensic-highlight {
    background-color: rgba(245, 158, 11, 0.08);
    color: #fef08a;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border-bottom: 2px solid rgba(245, 158, 11, 0.4);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  mark.forensic-highlight.illuminated {
    background-color: rgba(245, 158, 11, 0.18);
    color: #ffffff;
    border-bottom-color: #f59e0b;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.25);
  }

  /* ==========================================================================
     STANDARD D'IMPRESSION A4 CITOYEN (AFFICHAGE VILLAGE / TRACT D'ACTION)
     ========================================================================== */
  @media print {
    /* Masquer les éléments interactifs et de navigation superflus sur papier */
    header, nav, footer, .no-print, [data-no-print], button {
      display: none !important;
    }

    body, html {
      background: #ffffff !important;
      color: #0f172a !important;
      font-size: 11pt !important;
      line-height: 1.5 !important;
    }

    /* Forcer l'encre noire et les contrastes nets pour les textes */
    p, span, li, td, th {
      color: #1e293b !important;
    }

    h1, h2, h3, h4 {
      color: #000000 !important;
      page-break-after: avoid;
    }

    /* Mise en valeur des surbrillances sur papier (soulignement élégant) */
    mark.forensic-highlight {
      background: transparent !important;
      color: #000000 !important;
      font-weight: 700 !important;
      text-decoration: underline 2px solid #b8860b !important;
      box-shadow: none !important;
    }

    /* Préservation des tableaux et bordures nettes */
    table {
      width: 100% !important;
      border-collapse: collapse !important;
      page-break-inside: avoid;
    }

    th, td {
      border: 1px solid #94a3b8 !important;
      padding: 6px 10px !important;
      font-size: 10pt !important;
    }

    th {
      background-color: #f1f5f9 !important;
      font-weight: bold !important;
    }

    /* Gestion des ruptures de page */
    article {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  }
</style>
