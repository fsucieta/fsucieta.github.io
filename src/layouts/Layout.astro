---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "L'OCHJU — Média Citoyen d'Investigation, Participatif & Open Data. L'aveti ?" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Initialisation Immédiate du Thème (Persistance & Anti-Flash) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    
    <!-- Tailwind CSS CDN avec directive is:inline obligatoire pour Astro -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              gold: {
                400: '#facc15',
                500: '#d4af37',
                600: '#b8860b'
              },
              cyan: {
                400: '#38bdf8',
                500: '#007791'
              }
            },
            fontFamily: {
              serif: ['Georgia', 'Merriweather', 'serif'],
              sans: ['Inter', 'system-ui', 'sans-serif']
            }
          }
        }
      }
    </script>
    
    <!-- Polices Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased selection:bg-amber-500 selection:text-slate-950">
    <slot />
    
    <!-- Bouton Flottant "Retour en Haut" -->
    <button 
      id="backToTopBtn" 
      class="fixed bottom-6 right-6 p-3.5 rounded-2xl bg-amber-500/90 text-slate-950 font-bold shadow-2xl backdrop-blur border border-amber-400 hover:bg-amber-400 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 z-50 flex items-center justify-center cursor-pointer group"
      aria-label="Retourner en haut de la page"
    >
      <span class="text-sm font-mono flex items-center gap-1">
        <span>▲</span>
        <span class="hidden sm:inline text-xs font-bold font-sans">HAUT</span>
      </span>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('backToTopBtn');
        if (btn) {
          window.addEventListener('scroll', function() {
            if (window.scrollY > 400) {
              btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
              btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            } else {
              btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }
          });

          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>

<style is:global>
  /* ==========================================================================
     SYSTÈME D'EXCELLENCE BI-THÈME (MODE JOUR NOBLE / MODE NUIT FORENSIC)
     ========================================================================== */

  html.dark {
    --bg-main: #090d16;
    --bg-card: #0f172a;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --border-color: #1e293b;
  }

  html.light {
    --bg-main: #fbf9f5;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #475569;
    --border-color: #cbd5e1;
  }

  html {
    scroll-behavior: smooth;
  }

  /* --------------------------------------------------------------------------
     1. SURCHARGES GLOBALES MODE JOUR (PRESSE D'INVESTIGATION PRESTIGE)
     -------------------------------------------------------------------------- */

  html.light body {
    background-color: #fbf9f5 !important;
    color: #0f172a !important;
  }

  html.light header {
    background-color: rgba(251, 249, 245, 0.96) !important;
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05) !important;
  }

  html.light nav {
    background-color: rgba(251, 249, 245, 0.96) !important;
    border-color: #cbd5e1 !important;
  }

  html.light nav a {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }

  html.light nav a:hover {
    border-color: #b8860b !important;
    color: #b8860b !important;
  }

  /* Titres et Hiérarchie Typographique en Mode Jour */
  html.light h1, html.light h2, html.light h3, html.light h4, html.light h5, html.light h6,
  html.light h1 a, html.light h2 a, html.light h3 a, html.light h4 a {
    color: #0f172a !important;
  }

  /* Conteneurs et Boîtes de Données en Mode Jour */
  html.light .hero-card-container,
  html.light .hero-banner,
  html.light .fiche-card,
  html.light article,
  html.light #manifeste-section,
  html.light #whistleblower-vault,
  html.light #cada-generator,
  html.light #radar-thermique-section,
  html.light #foncier-dvf-section,
  html.light .bg-slate-950,
  html.light .bg-slate-950\/60,
  html.light .bg-slate-950\/80,
  html.light .bg-slate-950\/90,
  html.light .bg-slate-950\/95,
  html.light .bg-slate-900,
  html.light .bg-slate-900\/60,
  html.light .bg-slate-900\/80,
  html.light .bg-slate-900\/90 {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 4px 18px -2px rgba(15, 23, 42, 0.06) !important;
  }

  /* Remplacement des Dégradés Sombres en Dégradés Blanc / Ivoire */
  html.light .bg-gradient-to-br,
  html.light .bg-gradient-to-r {
    background: #ffffff !important;
    border-color: #cbd5e1 !important;
  }

  html.light .bg-slate-800 {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }

  html.light .border-slate-800,
  html.light .border-slate-700 {
    border-color: #cbd5e1 !important;
  }

  /* Rendu des Textes & Paragraphes en Mode Jour (Contraste 100% Noir d'Encre) */
  html.light p, html.light li {
    color: #1e293b !important;
  }

  html.light .text-slate-100,
  html.light .text-slate-200,
  html.light .text-slate-300 {
    color: #0f172a !important;
  }

  html.light .text-slate-400,
  html.light .text-slate-500 {
    color: #475569 !important;
  }

  html.light strong, html.light b {
    color: #0f172a !important;
    font-weight: 700 !important;
  }

  /* Formulaires, Inputs et Sélecteurs en Mode Jour */
  html.light input,
  html.light select,
  html.light textarea {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }

  html.light input::placeholder,
  html.light textarea::placeholder {
    color: #94a3b8 !important;
  }

  /* --------------------------------------------------------------------------
     2. STYLES SPÉCIFIQUES POUR LES ARTICLES (STANDARD FORENSIC PULITZER)
     -------------------------------------------------------------------------- */

  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  html.light .article-body h2 {
    color: #0f172a !important;
    border-bottom: 2px solid #b8860b !important;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  html.light .article-body h3 {
    color: #0284c7 !important;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  html.light .article-body p {
    color: #1e293b !important;
  }

  /* ENCARTS DE DONNÉES CLÉS & CITATIONS (BLOCKQUOTES) */
  .article-body blockquote {
    position: relative !important;
    border-left: 5px solid #d4af37 !important;
    background: linear-gradient(145deg, #0b1120 0%, #0f172a 100%) !important;
    padding: 1.75rem 2rem !important;
    margin: 2rem 0 !important;
    border-radius: 0 16px 16px 0 !important;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.15) !important;
  }

  .article-body blockquote::before {
    content: "💡 CONSTAT MATÉRIEL ET DONNÉES CLÉS" !important;
    display: block !important;
    font-family: 'Inter', monospace !important;
    font-size: 0.78rem !important;
    font-weight: 800 !important;
    color: #d4af37 !important;
    margin-bottom: 0.75rem !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
  }

  .article-body blockquote p {
    color: #fef08a !important;
    font-size: 1.05rem !important;
    line-height: 1.8 !important;
    margin-bottom: 0.5rem !important;
    font-style: italic !important;
  }

  /* BLOCKQUOTE EN MODE JOUR */
  html.light .article-body blockquote {
    background: #fffdf5 !important;
    border-left: 5px solid #b8860b !important;
    border-top: 1px solid #fed7aa !important;
    border-right: 1px solid #fed7aa !important;
    border-bottom: 1px solid #fed7aa !important;
    box-shadow: 0 6px 20px -3px rgba(184, 134, 11, 0.12) !important;
  }

  html.light .article-body blockquote::before {
    color: #92400e !important;
  }

  html.light .article-body blockquote p {
    color: #78350f !important;
  }

  /* TABLEAUX EN MODE NUIT */
  .article-body table {
    width: 100% !important;
    margin: 2.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    background-color: #0f172a;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.6);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
  }

  .article-body th {
    background-color: #1e293b;
    color: #d4af37;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 2px solid rgba(212, 175, 55, 0.4);
  }

  .article-body td {
    padding: 1rem 1.25rem;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(51, 65, 85, 0.6);
  }

  /* TABLEAUX EN MODE JOUR */
  html.light .article-body table {
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08) !important;
  }

  html.light .article-body th {
    background-color: #f8fafc !important;
    color: #92400e !important;
    border-bottom: 2px solid #b8860b !important;
  }

  html.light .article-body td {
    color: #1e293b !important;
    border-bottom: 1px solid #e2e8f0 !important;
  }

  html.light .article-body tr:hover td {
    background-color: #f8fafc !important;
    color: #0f172a !important;
  }

  /* CODES & LABELS FORENSIQUES */
  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  html.light .article-body code {
    background-color: #f1f5f9 !important;
    color: #0369a1 !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* FOOTER */
  html.light footer {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #64748b !important;
  }
</style>
