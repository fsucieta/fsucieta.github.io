---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "CASA DI CRISTALE 2.0 — Plateforme d'investigation journalistique, juridique et financière souveraine corse." } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Polices Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georgia:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600;700;900&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="theme-wrapper antialiased min-h-screen transition-colors duration-300">
    <slot />
    
    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>

<style is:global>
  /* Variables bivalentes pour le thème Presse Jour / Forensic Nuit */
  html.dark {
    --bg-main: #090d16;
    --bg-card: #0f172a;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --accent-gold: #d4af37;
    --accent-cyan: #38bdf8;
    --border-color: #1e293b;
  }

  html.light {
    --bg-main: #fdfbf7;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #475569;
    --accent-gold: #b8860b;
    --accent-cyan: #007791;
    --border-color: #e2e8f0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Inter', sans-serif;
    background-color: var(--bg-main);
    color: var(--text-main);
  }

  .font-serif {
    font-family: 'Georgia', 'Merriweather', serif;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: var(--bg-main);
  }
  ::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--accent-gold);
  }
</style>
