---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "L'OCHJU — Média Citoyen d'Investigation, Participatif & Open Data. L'aveti ?" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Tailwind CSS CDN avec directive is:inline obligatoire pour Astro -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              gold: {
                400: '#facc15',
                500: '#d4af37',
                600: '#b8860b'
              },
              cyan: {
                400: '#38bdf8',
                500: '#007791'
              }
            },
            fontFamily: {
              serif: ['Georgia', 'Merriweather', 'serif'],
              sans: ['Inter', 'system-ui', 'sans-serif']
            }
          }
        }
      }
    </script>
    
    <!-- Polices Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georgia:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600;700;900&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen transition-colors duration-300">
    <slot />
    
    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>

<style is:global>
  /* Base & Custom Utilities */
  html.dark {
    --bg-main: #090d16;
    --bg-card: #0f172a;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --border-color: #1e293b;
  }

  html.light {
    --bg-main: #fdfbf7;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #475569;
    --border-color: #e2e8f0;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Hero Card Adaptative */
  .hero-card-container {
    background: linear-gradient(135deg, #090d16 0%, #0f172a 50%, #090d16 100%);
    color: #f8fafc;
  }

  html.light .hero-card-container {
    background: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08) !important;
  }

  html.light .hero-card-container h1, 
  html.light .hero-card-container h1 a,
  html.light .hero-card-container p {
    color: #0f172a !important;
  }

  /* Surcharges Thème Clair (PRESSE JOUR - Esthétique Journaliste Noble) */
  html.light body {
    background-color: #faf8f5 !important;
    color: #0f172a !important;
  }

  html.light header {
    background-color: rgba(250, 248, 245, 0.96) !important;
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05) !important;
  }

  html.light h1, html.light h2, html.light h3, html.light h4, 
  html.light h1 a, html.light h2 a, html.light h3 a, html.light h4 a {
    color: #0f172a !important;
  }

  html.light .hero-banner, 
  html.light .fiche-card, 
  html.light article, 
  html.light .radar-chip, 
  html.light #heatmapDetailPanel, 
  html.light #whistleblower-vault, 
  html.light #cada-generator, 
  html.light #matrice-test-wrapper, 
  html.light #radar-thermique-section,
  html.light #foncier-dvf-section,
  html.light #dvfDetailPanel,
  html.light .bg-slate-950,
  html.light .bg-slate-900,
  html.light .bg-slate-800 {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 4px 15px -3px rgba(15, 23, 42, 0.06) !important;
  }

  html.light .fiche-card:hover {
    border-color: #b8860b !important;
    box-shadow: 0 12px 30px -5px rgba(184, 134, 11, 0.2) !important;
  }

  html.light p, html.light li, html.light span {
    color: #334155;
  }

  html.light .text-slate-100, 
  html.light .text-slate-200, 
  html.light .text-slate-300 {
    color: #0f172a !important;
  }

  html.light .text-slate-400, 
  html.light .text-slate-500 {
    color: #475569 !important;
  }

  /* Surcharges Thème Clair pour le Radar Thermique */
  html.light .radar-chip {
    background-color: #f8fafc !important;
    border-width: 2px !important;
  }

  html.light .radar-chip[data-status-key="red"] {
    background-color: #fef2f2 !important;
    border-color: #ef4444 !important;
    color: #991b1b !important;
  }

  html.light .radar-chip[data-status-key="amber"] {
    background-color: #fffbe8 !important;
    border-color: #f59e0b !important;
    color: #92400e !important;
  }

  html.light .radar-chip[data-status-key="green"] {
    background-color: #f0fdf4 !important;
    border-color: #10b981 !important;
    color: #166534 !important;
  }

  html.light #radarFilters button {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }

  html.light #radarFilters button.active {
    background-color: #b8860b !important;
    color: #ffffff !important;
    border-color: #b8860b !important;
  }

  html.light #radarInspectorPanel {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08) !important;
  }

  html.light .text-cyan-400 {
    color: #0284c7 !important;
  }

  html.light .bg-amber-500\/10 {
    background-color: rgba(184, 134, 11, 0.12) !important;
  }

  html.light .border-slate-800, 
  html.light .border-slate-700 {
    border-color: #cbd5e1 !important;
  }

  /* Glassmorphism & UI Accents */
  .glass-panel {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  html.light .glass-panel {
    background: rgba(255, 255, 255, 0.85) !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #090d16;
  }
  ::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #d4af37;
  }
</style>
