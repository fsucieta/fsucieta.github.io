---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "L'OCHJU — Média Citoyen d'Investigation, Participatif & Open Data. L'aveti ?" } = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Initialisation Immédiate du Thème (Persistance & Anti-Flash) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    
    <!-- Tailwind CSS CDN avec directive is:inline obligatoire pour Astro -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              gold: {
                400: '#facc15',
                500: '#d4af37',
                600: '#b8860b'
              },
              cyan: {
                400: '#38bdf8',
                500: '#007791'
              }
            },
            fontFamily: {
              serif: ['Georgia', 'Merriweather', 'serif'],
              sans: ['Inter', 'system-ui', 'sans-serif']
            }
          }
        }
      }
    </script>
    
    <!-- Polices Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Georgia:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;600;700;900&family=Merriweather:ital,wght@0,300;0,400;0,700;1,300&display=swap" rel="stylesheet">
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen transition-colors duration-300">
    <slot />

    <!-- Bouton Flottant Global de Retour en Haut de Page ("Back to Top") -->
    <button 
      id="globalBackToTopBtn" 
      title="Retourner en haut de page"
      aria-label="Retourner en haut de page"
      class="fixed bottom-6 right-6 z-50 p-3.5 rounded-full bg-slate-900/90 border border-amber-500/40 text-amber-400 shadow-2xl hover:bg-amber-500 hover:text-slate-950 hover:border-amber-400 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 group backdrop-blur flex items-center justify-center cursor-pointer"
    >
      <svg class="w-6 h-6 group-hover:-translate-y-1 transition duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var btn = document.getElementById('globalBackToTopBtn');
        if (btn) {
          window.addEventListener('scroll', function() {
            if (window.scrollY > 300) {
              btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
              btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            } else {
              btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }
          });

          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>

<style is:global>
  /* Base & Custom Utilities */
  html.dark {
    --bg-main: #090d16;
    --bg-card: #0f172a;
    --text-main: #e2e8f0;
    --text-muted: #94a3b8;
    --border-color: #1e293b;
  }

  html.light {
    --bg-main: #fdfbf7;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #475569;
    --border-color: #e2e8f0;
  }

  html {
    scroll-behavior: smooth;
  }

  /* Hero Card Adaptative */
  .hero-card-container {
    background: linear-gradient(135deg, #090d16 0%, #0f172a 50%, #090d16 100%);
    color: #f8fafc;
  }

  html.light .hero-card-container {
    background: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.08) !important;
  }

  html.light .hero-card-container h1, 
  html.light .hero-card-container h1 a,
  html.light .hero-card-container p {
    color: #0f172a !important;
  }

  /* Surcharges Thème Clair (PRESSE JOUR - Esthétique Journaliste Noble) */
  html.light body {
    background-color: #faf8f5 !important;
    color: #0f172a !important;
  }

  html.light header {
    background-color: rgba(250, 248, 245, 0.96) !important;
    border-color: #cbd5e1 !important;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05) !important;
  }

  html.light nav {
    background-color: rgba(250, 248, 245, 0.96) !important;
    border-color: #cbd5e1 !important;
  }

  html.light nav a {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }

  html.light nav a:hover {
    border-color: #b8860b !important;
    color: #b8860b !important;
  }

  html.light h1, html.light h2, html.light h3, html.light h4, 
  html.light h1 a, html.light h2 a, html.light h3 a, html.light h4 a {
    color: #0f172a !important;
  }

  html.light .hero-banner, 
  html.light .fiche-card, 
  html.light article, 
  html.light .radar-chip, 
  html.light #heatmapDetailPanel, 
  html.light #whistleblower-vault, 
  html.light #cada-generator, 
  html.light #matrice-test-wrapper, 
  html.light #radar-thermique-section,
  html.light #foncier-dvf-section,
  html.light #dvfDetailPanel,
  html.light .bg-slate-950,
  html.light .bg-slate-950\/60,
  html.light .bg-slate-950\/80,
  html.light .bg-slate-950\/90,
  html.light .bg-slate-900,
  html.light .bg-slate-900\/90,
  html.light .bg-slate-800 {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 4px 15px -3px rgba(15, 23, 42, 0.06) !important;
  }

  /* 4 Piliers & 27 Dossiers en Mode Jour */
  html.light .bg-slate-950\/60:hover,
  html.light .bg-slate-950\/80:hover {
    background-color: #f8fafc !important;
    border-color: #b8860b !important;
    box-shadow: 0 8px 25px -4px rgba(184, 134, 11, 0.15) !important;
  }

  html.light .bg-slate-800 {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #475569 !important;
  }

  html.light .fiche-card:hover {
    border-color: #b8860b !important;
    box-shadow: 0 12px 30px -5px rgba(184, 134, 11, 0.2) !important;
  }

  html.light p, html.light li, html.light span {
    color: #334155;
  }

  html.light .text-slate-100, 
  html.light .text-slate-200, 
  html.light .text-slate-300 {
    color: #0f172a !important;
  }

  html.light .text-slate-400, 
  html.light .text-slate-500 {
    color: #475569 !important;
  }

  /* Badges & Pillules en Mode Jour */
  html.light .bg-emerald-500\/10,
  html.light .bg-emerald-500\/20 {
    background-color: #ecfdf5 !important;
    border-color: #10b981 !important;
    color: #047857 !important;
  }

  html.light .bg-blue-500\/10,
  html.light .bg-blue-500\/20 {
    background-color: #eff6ff !important;
    border-color: #3b82f6 !important;
    color: #1d4ed8 !important;
  }

  /* Tableaux en Mode Jour */
  html.light .article-body table {
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08) !important;
  }

  html.light .article-body th {
    background-color: #f8fafc !important;
    color: #b8860b !important;
    border-bottom: 2px solid #b8860b !important;
  }

  html.light .article-body td {
    color: #334155 !important;
    border-bottom: 1px solid #e2e8f0 !important;
  }

  html.light .article-body tr:hover td {
    background-color: #f8fafc !important;
    color: #0f172a !important;
  }

  html.light .article-body blockquote {
    background: #fffbe8 !important;
    border-left: 5px solid #b8860b !important;
    box-shadow: 0 4px 15px -3px rgba(184, 134, 11, 0.1) !important;
  }

  html.light .article-body blockquote p {
    color: #78350f !important;
  }

  /* Surcharges Thème Clair pour le Radar Thermique */
  html.light .radar-chip {
    background-color: #f8fafc !important;
    border-width: 2px !important;
  }

  html.light .radar-chip[data-status-key="red"] {
    background-color: #fef2f2 !important;
    border-color: #ef4444 !important;
    color: #991b1b !important;
  }

  html.light .radar-chip[data-status-key="amber"] {
    background-color: #fffbe8 !important;
    border-color: #f59e0b !important;
    color: #92400e !important;
  }

  html.light .radar-chip[data-status-key="green"] {
    background-color: #f0fdf4 !important;
    border-color: #10b981 !important;
    color: #166534 !important;
  }

  html.light #radarFilters button {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
  }

  html.light #radarFilters button.active {
    background-color: #b8860b !important;
    color: #ffffff !important;
    border-color: #b8860b !important;
  }

  html.light #radarInspectorPanel {
    background-color: #ffffff !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08) !important;
  }

  html.light .text-cyan-400 {
    color: #0284c7 !important;
  }

  html.light .bg-amber-500\/10 {
    background-color: rgba(184, 134, 11, 0.12) !important;
  }

  html.light .border-slate-800, 
  html.light .border-slate-700 {
    border-color: #cbd5e1 !important;
  }

  /* Glassmorphism & UI Accents */
  .glass-panel {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(212, 175, 55, 0.2);
  }

  html.light .glass-panel {
    background: rgba(255, 255, 255, 0.85) !important;
    border: 1px solid rgba(212, 175, 55, 0.3) !important;
  }

  /* Custom Scrollbar */
  ::-webkit-scrollbar {
    width: 10px;
  }
  ::-webkit-scrollbar-track {
    background: #090d16;
  }
  ::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #d4af37;
  }
</style>
