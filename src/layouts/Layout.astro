---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  lang?: string;
}

const { 
  title, 
  description = "L'OCHJU — Média Citoyen d'Investigation, Participatif & Open Data en Corse. Révélations forensiques et données d'intérêt public. L'aveti ?",
  image = "/alerte_censure_lochju.jpg",
  canonicalUrl = Astro.url.href,
  lang = "fr"
} = Astro.props;

const siteUrl = "https://fsucieta.github.io";
const cleanCanonical = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteUrl}/${canonicalUrl.replace(/^\//, '')}`;
const fullImageUrl = image.startsWith("http") ? image : `${siteUrl}/${image.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Primaire (Google Core Standard) -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={cleanCanonical} />

    <!-- Open Graph / Facebook / WhatsApp (Social Graph) -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="L'OCHJU" />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card (Format Grand Angle) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Mesure d'Audience Éthique & Souveraine sans cookies (GoatCounter) -->
    <script data-goatcounter="https://lochju.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

    <!-- Initialisation Immédiate du Thème Tri-Mode (Persistance Anti-Flash — Granit Insulaire par défaut) -->
    <script is:inline>
      (function() {
        /* Axe 1 : Mode Nuit / Jour — défaut : dark */
        const savedMode = localStorage.getItem('lochju-mode') || 'dark';
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(savedMode);

        /* Axe 2 : Palette (paoli / finint / granit) — défaut : granit */
        const savedPalette = localStorage.getItem('lochju-palette') || 'granit';
        document.documentElement.setAttribute('data-palette', savedPalette);
      })();
    </script>
    
    <!-- Tailwind CSS CDN avec directive is:inline obligatoire pour Astro -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              slate: {
                950: '#06080d', /* Noir minéral profond d'archive (Fond souverain L'OCHJU) */
                900: '#0b0f17', /* Surface d'obsidienne pure (Cartes, bannières & conteneurs) */
                850: '#101724', /* Niveau de profondeur intermédiaire */
                800: '#151d2c', /* Bordures et séparateurs ultra-fins */
                700: '#222f46', /* Éléments et contours secondaires */
                600: '#384860',
                500: '#64748b',
                400: '#94a3b8',
                300: '#cbd5e1',
                200: '#e2e8f0',
                100: '#f1f5f9',
                50: '#f8fafc'
              },
              gold: {
                400: '#facc15',
                500: '#d4af37',
                600: '#b8860b'
              },
              cyan: {
                400: '#38bdf8',
                500: '#007791'
              }
            },
            fontFamily: {
              serif: ['Merriweather', 'Georgia', 'serif'],
              sans: ['Inter', 'system-ui', 'sans-serif'],
              cinzel: ['Cinzel', 'serif'],
              mono: ['JetBrains Mono', 'monospace']
            }
          }
        }
      }
    </script>
    
    <!-- Polices Google Fonts : Inter, Merriweather, JetBrains Mono & Cinzel (Édition Régale) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Inter:wght@300;400;500;600;700;800;900&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
    
    <!-- Styles Forensiques Globaux : Scrollytelling, Surlignage Lumineux & Chiaroscuro -->
    <style is:global>
      /* Chiffres tabulaires alignés d'orfèvrerie financière */
      .font-mono, [data-tabular-nums] {
        font-variant-numeric: tabular-nums;
      }

      /* Effet de surlignage dynamique au défilement (Forensic Highlight) */
      mark.forensic-highlight {
        background: transparent;
        color: #f1f5f9;
        padding: 0.12em 0.3em;
        border-radius: 0.25em;
        border-bottom: 2px solid transparent;
        transition: background 0.8s ease, color 0.5s ease, border-color 0.8s ease, box-shadow 0.8s ease;
      }
      mark.forensic-highlight.illuminated {
        background: linear-gradient(120deg, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0.45) 100%);
        color: #fef08a;
        border-bottom: 2px solid #f59e0b;
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.25);
      }
      mark.forensic-highlight:hover {
        background: rgba(245, 158, 11, 0.55);
        box-shadow: 0 0 25px rgba(245, 158, 11, 0.4);
      }

      /* L'arrière-plan du body et son ambiance Chiaroscuro sont entièrement gérés par les tokens tri-palette / bi-mode */
    </style>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased selection:bg-amber-500 selection:text-slate-950">
    <slot />
    
    <!-- Barre de Progression de Lecture Furtive (Stealth Reading Bar) -->
    <div id="readingProgressBar" class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 z-[100] w-0 transition-all duration-150 pointer-events-none opacity-90"></div>

    <!-- Bouton Flottant "Retour en Haut" -->
    <button 
      id="backToTopBtn" 
      class="fixed bottom-6 right-6 p-3.5 rounded-2xl bg-amber-500/90 text-slate-950 font-bold shadow-2xl backdrop-blur border border-amber-400 hover:bg-amber-400 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 z-50 flex items-center justify-center cursor-pointer group"
      aria-label="Retourner en haut de la page"
    >
      <span class="text-sm font-mono flex items-center gap-1">
        <span>▲</span>
        <span class="hidden sm:inline text-xs font-bold font-sans">HAUT</span>
      </span>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('backToTopBtn');
        const progressBar = document.getElementById('readingProgressBar');
        
        window.addEventListener('scroll', function() {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          
          if (progressBar && docHeight > 0) {
            const progress = (scrollY / docHeight) * 100;
            progressBar.style.width = `${progress}%`;
          }

          if (btn) {
            if (scrollY > 400) {
              btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
              btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            } else {
              btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }
          }
        });

        if (btn) {
          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>

    <!-- Moteur de Scrollytelling Forensique (Illumination fluide des preuves) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const highlights = document.querySelectorAll('mark.forensic-highlight');
        if (!highlights.length) return;

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('illuminated');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.25, rootMargin: '0px 0px -50px 0px' });

          highlights.forEach((h) => observer.observe(h));
        } else {
          highlights.forEach((h) => h.classList.add('illuminated'));
        }
      });
    </script>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>

<style is:global>
  /* ==========================================================================
     SYSTÈME TRI-PALETTE × BI-MODE SOUVERAIN L'OCHJU (6 COMBINAISONS)
     Palette A — 🏛️ PAOLIEN    : Obsidienne & Or Antique 1755
     Palette B — 📊 FININT     : Cobalt Abyssal & Radar Émeraude
     Palette C — 🌿 GRANIT     : Ardoise Noire & Cuivre Martelé (DÉFAUT)
     Mode Dark × Mode Light — persistance via localStorage
     ========================================================================== */

  /* ---------- TOKENS PARTAGÉS (Indépendants de la palette) ---------- */
  html {
    scroll-behavior: smooth;
  }

  /* ---------- PALETTE A : 🏛️ PAOLIEN — Mode Nuit (Chambre des Comptes & Or 1755) ---------- */
  html.dark[data-palette="paoli"] {
    --bg-main:        #080705;
    --bg-card:        #12100d;
    --bg-card-hover:  #1a1713;
    --bg-header:      rgba(8, 7, 5, 0.96);
    --text-main:      #f5f0e1;
    --text-muted:     #a39b8b;
    --border-color:   #3d3118;
    --border-highlight:#d4af37;
    --accent-primary: #d4af37;
    --accent-hover:   #facc15;
    --accent-glow:    rgba(212, 175, 55, 0.08);
    --accent-card:    rgba(212, 175, 55, 0.12);
    --body-gradient:
      radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.08) 0%, transparent 65%),
      radial-gradient(circle at 85% 30%, rgba(245, 158, 11, 0.03) 0%, transparent 50%);
  }

  /* ---------- PALETTE A : 🏛️ PAOLIEN — Mode Jour ---------- */
  html.light[data-palette="paoli"] {
    --bg-main:        #fcfaf4;
    --bg-card:        #ffffff;
    --bg-card-hover:  #faf6eb;
    --bg-header:      rgba(252, 250, 244, 0.97);
    --text-main:      #1c170d;
    --text-muted:     #574d3c;
    --border-color:   #dfd3be;
    --border-highlight:#b8860b;
    --accent-primary: #b8860b;
    --accent-hover:   #d4af37;
    --accent-glow:    rgba(184, 134, 11, 0.06);
    --accent-card:    rgba(184, 134, 11, 0.08);
    --body-gradient:  none;
  }

  /* ---------- PALETTE B : 📊 FININT — Mode Nuit (Terminal Bloomberg Cobalt & Radar Émeraude) ---------- */
  html.dark[data-palette="finint"] {
    --bg-main:        #020617;
    --bg-card:        #08142b;
    --bg-card-hover:  #0f2247;
    --bg-header:      rgba(2, 6, 23, 0.96);
    --text-main:      #e0f2fe;
    --text-muted:     #7dd3fc;
    --border-color:   #0e3a59;
    --border-highlight:#10b981;
    --accent-primary: #10b981;
    --accent-hover:   #34d399;
    --accent-glow:    rgba(16, 185, 129, 0.12);
    --accent-card:    rgba(16, 185, 129, 0.14);
    --body-gradient:
      radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.08) 0%, transparent 60%),
      radial-gradient(circle at 80% 40%, rgba(14, 165, 233, 0.08) 0%, transparent 55%);
  }

  /* ---------- PALETTE B : 📊 FININT — Mode Jour ---------- */
  html.light[data-palette="finint"] {
    --bg-main:        #f0f7ff;
    --bg-card:        #ffffff;
    --bg-card-hover:  #e0f2fe;
    --bg-header:      rgba(240, 247, 255, 0.97);
    --text-main:      #082f49;
    --text-muted:     #0369a1;
    --border-color:   #bae6fd;
    --border-highlight:#059669;
    --accent-primary: #059669;
    --accent-hover:   #10b981;
    --accent-glow:    rgba(5, 150, 105, 0.08);
    --accent-card:    rgba(5, 150, 105, 0.10);
    --body-gradient:  none;
  }

  /* ---------- PALETTE C : 🌿 GRANIT INSULAIRE — Mode Nuit (DÉFAUT) (Ardoise & Cuivre Martelé) ---------- */
  html.dark[data-palette="granit"],
  html.dark:not([data-palette]) {
    --bg-main:        #070a08;
    --bg-card:        #101a14;
    --bg-card-hover:  #17261d;
    --bg-header:      rgba(7, 10, 8, 0.96);
    --text-main:      #edf2ed;
    --text-muted:     #98a89b;
    --border-color:   #283d31;
    --border-highlight:#c26d43;
    --accent-primary: #c26d43;
    --accent-hover:   #e07a4a;
    --accent-glow:    rgba(194, 109, 67, 0.12);
    --accent-card:    rgba(194, 109, 67, 0.14);
    --body-gradient:
      radial-gradient(circle at 50% 0%, rgba(194, 109, 67, 0.08) 0%, transparent 65%),
      radial-gradient(circle at 85% 60%, rgba(52, 211, 153, 0.05) 0%, transparent 50%);
  }

  /* ---------- PALETTE C : 🌿 GRANIT INSULAIRE — Mode Jour ---------- */
  html.light[data-palette="granit"],
  html.light:not([data-palette]) {
    --bg-main:        #f4f6f3;
    --bg-card:        #ffffff;
    --bg-card-hover:  #e7ede6;
    --bg-header:      rgba(244, 246, 243, 0.97);
    --text-main:      #121d15;
    --text-muted:     #3f5446;
    --border-color:   #ced9d1;
    --border-highlight:#b45309;
    --accent-primary: #b45309;
    --accent-hover:   #c26d43;
    --accent-glow:    rgba(180, 83, 9, 0.08);
    --accent-card:    rgba(180, 83, 9, 0.10);
    --body-gradient:  none;
  }

  /* ---------- APPLICATION DES TOKENS BODY ---------- */
  /* Fallback absolu : fond sombre Granit si aucun token CSS n'est encore chargé */
  body {
    background-color: #070a08; /* Granit nuit — couleur de sécurité anti-flash blanc */
    color: #edf2ed;            /* Texte clair par défaut — écrasé par les tokens */
    min-height: 100vh;
  }

  html.dark body {
    background-color: var(--bg-main, #070a08) !important;
    background-image: var(--body-gradient, none) !important;
    color: var(--text-main, #edf2ed) !important;
  }

  html.light body {
    background-color: var(--bg-main, #f4f6f3) !important;
    background-image: none !important;
    color: var(--text-main, #121d15) !important;
  }


  /* ---------- SURCHARGE FORCÉE DES CARTES ET CONTENEURS EN MODE NUIT SELON LA PALETTE ---------- */
  html.dark .fiche-card,
  html.dark .hero-card-container,
  html.dark .bg-slate-900,
  html.dark .bg-slate-950,
  html.dark #manifeste-section,
  html.dark #fichesGrid .fiche-card,
  html.dark #fichesGridEn .fiche-card-en {
    background-color: var(--bg-card) !important;
    border-color: var(--border-color) !important;
    color: var(--text-main) !important;
  }

  html.dark header,
  html.dark nav {
    background-color: var(--bg-header) !important;
    border-color: var(--border-color) !important;
  }

  html.dark .fiche-card:hover,
  html.dark .fiche-card-en:hover {
    background-color: var(--bg-card-hover) !important;
    border-color: var(--border-highlight) !important;
  }

  /* Accentuation dynamique des liserés et liens actifs */
  html.dark .text-amber-400 {
    color: var(--accent-primary) !important;
  }
  html.dark .border-amber-500\/40,
  html.dark .border-amber-500\/30 {
    border-color: var(--accent-primary) !important;
  }
  html.dark mark.forensic-highlight.illuminated {
    background: var(--accent-card) !important;
    border-bottom: 2px solid var(--accent-primary) !important;
    color: var(--text-main) !important;
    box-shadow: 0 0 15px var(--accent-glow) !important;
  }

  /* ---------- TRANSITIONS FLUIDES LORS DU CHANGEMENT DE PALETTE ---------- */
  html body,
  html header,
  html nav,
  html footer,
  html .fiche-card,
  html .hero-card-container {
    transition: background-color 0.4s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.4s ease !important;
  }

  /* --------------------------------------------------------------------------
     1. SURCHARGES COMPOSANTS — MODE JOUR (Papier Chiffon & Rapport Parlementaire)
     Ces règles gèrent les bordures et halos des éléments structuraux.
     Les couleurs de fond et texte sont désormais héritées des tokens CSS tri-palette.
     -------------------------------------------------------------------------- */

  html.light header {
    background-color: var(--bg-header) !important;
    border-color: var(--border-color) !important;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05) !important;
  }

  html.light nav {
    background-color: var(--bg-header) !important;
    border-color: var(--border-color) !important;
  }

  html.light nav a {
    background-color: var(--bg-card) !important;
    border-color: var(--border-color) !important;
    color: var(--text-muted) !important;
  }

  html.light nav a:hover {
    border-color: var(--accent-primary) !important;
    color: var(--accent-primary) !important;
  }

  /* Titres et Hiérarchie Typographique en Mode Jour */
  html.light h1, html.light h2, html.light h3, html.light h4, html.light h5, html.light h6,
  html.light h1 a, html.light h2 a, html.light h3 a, html.light h4 a {
    color: #0f172a !important;
  }

  /* Conteneurs et Boîtes de Données en Mode Jour (Blanc Pur Net) */
  html.light .hero-card-container,
  html.light .hero-banner,
  html.light .fiche-card,
  html.light .fiche-card-en,
  html.light #fichesGrid .fiche-card,
  html.light #fichesGridEn .fiche-card-en,
  html.light #fichesGridEnCours .fiche-card,
  html.light #fichesGridEnCoursEn .fiche-card-en,
  html.light article,
  html.light #alerte-censure-section,
  html.light #alerte-censure-section > div,
  html.light #manifeste-section,
  html.light #manifeste-section > div,
  html.light #whistleblower-vault,
  html.light #whistleblower-section,
  html.light #cada-generator,
  html.light #radar-thermique-section,
  html.light #foncier-dvf-section,
  html.light #dvf-foncier-section,
  html.light .bg-slate-950,
  html.light .bg-slate-950\/60,
  html.light .bg-slate-950\/80,
  html.light .bg-slate-950\/90,
  html.light .bg-slate-950\/95,
  html.light .bg-slate-900,
  html.light .bg-slate-900\/60,
  html.light .bg-slate-900\/80,
  html.light .bg-slate-900\/90,
  html.light .bg-slate-900\/40 {
    background: #ffffff !important;
    background-color: #ffffff !important;
    background-image: none !important;
    border-color: #cbd5e1 !important;
    color: #0f172a !important;
    box-shadow: 0 4px 18px -2px rgba(15, 23, 42, 0.06) !important;
  }

  /* Boutons de partage et pastilles d'action en mode Jour */
  html.light .card-share-btn {
    background-color: #f8fafc !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }
  html.light .card-share-btn:hover {
    background-color: #f59e0b !important;
    border-color: #d97706 !important;
    color: #ffffff !important;
  }

  /* Ajustements spécifiques de contraste pour les bandeaux du haut en mode Jour */
  html.light #alerte-censure-section h2,
  html.light #manifeste-section h1 {
    color: #0f172a !important;
  }
  html.light #manifeste-section p,
  html.light #alerte-censure-section p {
    color: #334155 !important;
  }
  html.light #censureMessageText {
    background: #f8fafc !important;
    color: #0f172a !important;
    border-color: #cbd5e1 !important;
  }
  html.light #manifeste-section p.text-amber-200\/90 {
    color: #78350f !important;
  }

  /* Remplacement des Dégradés Sombres en Dégradés Blanc / Ivoire pour les conteneurs */
  html.light .hero-card-container.bg-gradient-to-r,
  html.light .fiche-card.bg-gradient-to-b,
  html.light .fiche-card-en.bg-gradient-to-b {
    background: #ffffff !important;
    background-image: none !important;
    border-color: #cbd5e1 !important;
  }

  /* SUPPRESSION DU VOILE SUR LES ILLUSTRATIONS EN MODE JOUR */
  html.light .absolute.inset-0.bg-gradient-to-t,
  html.light img + .absolute.inset-0 {
    background: transparent !important;
    background-image: none !important;
    opacity: 0 !important;
  }

  html.light .bg-slate-800 {
    background-color: #f1f5f9 !important;
    border-color: #cbd5e1 !important;
    color: #334155 !important;
  }

  html.light .border-slate-800,
  html.light .border-slate-700 {
    border-color: #cbd5e1 !important;
  }

  /* Rendu des Textes & Paragraphes en Mode Jour (Contraste 100% Noir d'Encre) */
  html.light p, html.light li {
    color: #1e293b !important;
  }

  html.light .text-slate-100,
  html.light .text-slate-200,
  html.light .text-slate-300 {
    color: #0f172a !important;
  }

  html.light .text-slate-400,
  html.light .text-slate-500 {
    color: #475569 !important;
  }

  html.light strong, html.light b {
    color: #0f172a !important;
    font-weight: 700 !important;
  }

  /* Ajustement de lisibilité pour les accents jaune/ambre/cyan en mode Jour */
  html.light .text-amber-400,
  html.light .text-amber-300,
  html.light .text-amber-500 {
    color: #b45309 !important;
  }

  html.light .text-cyan-400,
  html.light .text-cyan-300 {
    color: #0369a1 !important;
  }

  html.light .text-emerald-400 {
    color: #047857 !important;
  }

