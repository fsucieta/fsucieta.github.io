---
import SoutienModal from '../components/SoutienModal.astro';
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  lang?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = "L'OCHJU — Média Citoyen d'Investigation, Participatif & Open Data en Corse. Révélations forensiques et données d'intérêt public. L'aveti ?",
  image = "/alerte_censure_lochju.jpg",
  canonicalUrl = Astro.url.href,
  lang = "fr",
  noindex = false
} = Astro.props;

const siteUrl = "https://fsucieta.github.io";
const cleanCanonical = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteUrl}/${canonicalUrl.replace(/^\//, '')}`;
const fullImageUrl = image.startsWith("http") ? image : `${siteUrl}/${image.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Primaire (Google Core Standard) -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={cleanCanonical} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />}

    <!-- Open Graph / Facebook / WhatsApp (Social Graph) -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="L'OCHJU" />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card (Format Grand Angle) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Mesure d'Audience Éthique & Souveraine sans cookies (GoatCounter) -->
    <script data-goatcounter="https://lochju.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>

    <!-- Mode Nuit Souverain Inaltérable L'OCHJU -->
    
    <!-- Tailwind CSS CDN avec directive is:inline obligatoire pour Astro -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              // PALETTE FUSION L'OCHJU : OBSIDIENNE + ENCRE CHAUDE + OR IMPÉRIAL (Zéro bleu logiciel)
              slate: {
                950: '#070605', /* Noir d'encre chaud / Obsidienne pure de fond */
                900: '#0e0d0b', /* Surface de papier d'archive sombre / cartes */
                850: '#151412', /* Élévation intermédiaire */
                800: '#211f1c', /* Bordures d'encre et filets d'acier fin */
                700: '#36332e', /* Séparateurs secondaires */
                600: '#57524a',
                500: '#7d776d', /* Métadonnées tertiaires */
                400: '#a8a296', /* Typographie de lecture reposante */
                300: '#cfc9be', /* Sous-titres ivoire */
                200: '#e7e2d7', /* Textes principaux ivoire chaud */
                100: '#f4f1ea', /* Papier d'archive immaculé */
                50: '#faf8f5'
              },
              amber: {
                50: '#fefce8',
                100: '#fef9c3',
                200: '#fef08a',
                300: '#fde047',
                400: '#eab308', /* Or Ancien lumineux */
                500: '#c59b27', /* Or Souverain officiel L'OCHJU */
                600: '#a17c1b',
                700: '#785b13',
                800: '#523e0d',
                900: '#332707',
                950: '#1a1303'
              },
              rose: {
                400: '#f87171',
                500: '#b91c1c', /* Rouge Sceau de Cire / Alerte Médicale */
                600: '#991b1b',
                900: '#450a0a',
                950: '#230404'
              },
              emerald: {
                400: '#4ade80',
                500: '#15803d', /* Vert Olive / Souveraineté */
                900: '#052e16',
                950: '#02180b'
              }
            },
            fontFamily: {
              serif: ['Merriweather', 'Georgia', 'serif'],
              sans: ['Inter', 'system-ui', 'sans-serif'],
              cinzel: ['Cinzel', 'serif'],
              mono: ['JetBrains Mono', 'monospace']
            }
          }
        }
      }
    </script>
    
    <!-- Polices Google Fonts : Inter, Merriweather, JetBrains Mono & Cinzel (Édition Régale) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Inter:wght@300;400;500;600;700;800;900&family=Newsreader:ital,opsz,wght@0,6..72,300..800;1,6..72,300..800&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
    
    <!-- Styles Forensiques Globaux : Scrollytelling, Surlignage Lumineux & Chiaroscuro -->
    <style is:global>
      :root {
        --color-bg-body: #121316;
        --color-bg-card: #1a1c22;
        --color-bg-header: rgba(18, 19, 22, 0.85);
        --color-border-card: #2e323b;
        --color-text-primary: #f8fafc;
        --color-text-secondary: #cbd5e1;
        --color-text-muted: #94a3b8;
        --color-gold-main: #fbbf24;
        --color-grid: rgba(255, 255, 255, 0.05);
      }
      body {
        background-color: var(--color-bg-body) !important;
        color: var(--color-text-primary) !important;
        transition: background-color 0.4s ease, color 0.4s ease;
      }
      .bento-card {
        background-color: var(--color-bg-card) !important;
        border-color: var(--color-border-card) !important;
        transition: all 0.4s ease;
      }
      header.backdrop-blur-xl {
        background-color: var(--color-bg-header) !important;
      }

      /* Éradication absolue de toute barre de défilement (horizontale ou verticale) */
      html, body {
        overflow-x: hidden !important;
        max-width: 100vw;
      }

      /* Adaptation universelle des tableaux à tous les modes de lecture (Mobile / Tablette / Bureau) */
      article table,
      .article-body table,
      main table:not([data-no-auto-scroll]) {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch !important;
      }

      /* Masquage universel des barres de défilement sur tous les moteurs (WebKit, Firefox, Edge) */
      *:not(.custom-scrollbar) {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
      }
      *:not(.custom-scrollbar)::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }

      .custom-scrollbar { scrollbar-width: thin !important; scrollbar-color: rgba(212, 175, 55, 0.45) #0b0f17 !important; } .custom-scrollbar::-webkit-scrollbar { display: block !important; width: 6px !important; height: 6px !important; } .custom-scrollbar::-webkit-scrollbar-track { background: #0b0f17 !important; } .custom-scrollbar::-webkit-scrollbar-thumb { background-color: rgba(212, 175, 55, 0.45) !important; border-radius: 9999px !important; }
      /* Chiffres tabulaires alignés d'orfèvrerie financière */
      .font-mono, [data-tabular-nums] {
        font-variant-numeric: tabular-nums;
      }

      /* Effet de surlignage dynamique au défilement (Forensic Highlight) */
      mark.forensic-highlight {
        background: transparent;
        color: #f1f5f9;
        padding: 0.12em 0.3em;
        border-radius: 0.25em;
        border-bottom: 2px solid transparent;
        transition: background 0.8s ease, color 0.5s ease, border-color 0.8s ease, box-shadow 0.8s ease;
      }
      mark.forensic-highlight.illuminated {
        background: linear-gradient(120deg, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0.45) 100%);
        color: #fef08a;
        border-bottom: 2px solid #f59e0b;
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.25);
      }
      mark.forensic-highlight:hover {
        background: rgba(245, 158, 11, 0.55);
        box-shadow: 0 0 25px rgba(245, 158, 11, 0.4);
      }

      /* Fond d'archives et ambiance Chiaroscuro subtile */
      body {
        background-color: #070605;
        background-image: radial-gradient(circle at 50% 0%, rgba(197, 155, 39, 0.05) 0%, transparent 60%);
      }
    </style>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
      <!-- Elimination universelle des barres de defilement intempestives -->
    <style is:inline>
      html, body {
        overflow-x: hidden !important;
        max-width: 100vw !important;
      }
      *:not(.custom-scrollbar) {
        scrollbar-width: none !important;
        -ms-overflow-style: none !important;
      }
      *:not(.custom-scrollbar)::-webkit-scrollbar {
        display: none !important;
        width: 0 !important;
        height: 0 !important;
      }
    </style>
  
    <style is:global>
      /* ================= THÈMES GLOBAUX SOUVERAINS L'OCHJU ================= */
      :root, [data-theme="noir"] {
        --theme-bg: #000000 !important;
        --theme-card: #080808 !important;
        --theme-card-subtle: #111111 !important;
        --theme-border: #1e1e1e !important;
        --theme-border-gold: #ffd700 !important;
        --theme-gold: #ffd700 !important;
        --theme-gold-glow: rgba(255, 215, 0, 0.4) !important;
        --theme-text-title: #ffffff !important;
        --theme-text-body: #e5e5e5 !important;
        --theme-text-muted: #888888 !important;
        --theme-header-bg: rgba(0, 0, 0, 0.85) !important;
      }

      [data-theme="granit"] {
        --theme-bg: #111317 !important;
        --theme-card: #181b22 !important;
        --theme-card-subtle: #222631 !important;
        --theme-border: #2d3340 !important;
        --theme-border-gold: #fbbf24 !important;
        --theme-gold: #fbbf24 !important;
        --theme-gold-glow: rgba(251, 191, 36, 0.35) !important;
        --theme-text-title: #f8fafc !important;
        --theme-text-body: #cbd5e1 !important;
        --theme-text-muted: #94a3b8 !important;
        --theme-header-bg: rgba(17, 19, 23, 0.90) !important;
      }

      [data-theme="emeraude"] {
        --theme-bg: #030d06 !important;
        --theme-card: #07170c !important;
        --theme-card-subtle: #0d2815 !important;
        --theme-border: #163d22 !important;
        --theme-border-gold: #f59e0b !important;
        --theme-gold: #f59e0b !important;
        --theme-gold-glow: rgba(245, 158, 11, 0.35) !important;
        --theme-text-title: #f0fdf4 !important;
        --theme-text-body: #dcfce7 !important;
        --theme-text-muted: #86efac !important;
        --theme-header-bg: rgba(3, 13, 6, 0.90) !important;
      }

      /* Application forcée sur TOUS les éléments du site */
      body {
        background-color: var(--theme-bg) !important;
        color: var(--theme-text-body) !important;
        transition: background-color 0.4s ease, color 0.4s ease !important;
      }

      /* Les cartes, conteneurs, bannières et sous-sections */
      .bg-slate-950, .bg-slate-900, .bg-slate-900\/90, .bg-slate-900\/80, 
      .bg-\[\#06080d\], .bg-\[\#070605\], .bg-\[\#0c1017\], .bg-\[\#0e0d0b\],
      .bg-black\/40, .bg-black\/50, .bg-black\/60, .bg-black\/80, .bg-black\/90,
      .enquete-card, .theme-surface {
        background-color: var(--theme-card) !important;
        border-color: var(--theme-border) !important;
        transition: background-color 0.4s ease, border-color 0.4s ease !important;
      }

      /* Les bordures */
      .border-slate-800, .border-slate-800\/80, .border-slate-700, 
      .border-white\/10, .border-white\/20, .border-\[\#1e293b\], .border-\[\#26231e\] {
        border-color: var(--theme-border) !important;
      }

      /* Le Header */
      header {
        background-color: var(--theme-header-bg) !important;
        border-color: var(--theme-border) !important;
      }

      /* Les Titres et Textes */
      h1, h2, h3, h4, .text-white {
        color: var(--theme-text-title) !important;
      }

      /* Les touches d'Or Souverain */
      .theme-gold-text, .text-amber-400, .text-amber-300 {
        color: var(--theme-gold) !important;
      }
    </style>

    <style is:global>
      /* Classes d'impact visuel unifiées pour toutes les pages */
      .font-press {
        font-family: 'Newsreader', Georgia, serif !important;
        letter-spacing: -0.015em;
      }

      .font-mono-tech {
        font-family: 'JetBrains Mono', monospace !important;
        font-variant-numeric: tabular-nums;
      }

      .theme-surface {
        background-color: var(--theme-card, #080808) !important;
        border-color: var(--theme-border, #1e1e1e) !important;
      }

      .theme-gold-text {
        color: var(--theme-gold, #ffd700) !important;
      }

      .theme-gold-glow {
        box-shadow: 0 0 25px var(--theme-gold-glow, rgba(255, 215, 0, 0.35)) !important;
      }

      /* Typographie éditoriale d'élite pour les articles */
      .article-body h2 {
        font-family: 'Newsreader', Georgia, serif !important;
        font-size: 1.85rem !important;
        font-weight: 800 !important;
        color: #f8fafc !important;
        margin-top: 3rem !important;
        margin-bottom: 1.25rem !important;
        padding-bottom: 0.5rem !important;
        border-bottom: 2px solid var(--theme-gold, #ffd700) !important;
        letter-spacing: -0.02em !important;
      }

      .article-body h3 {
        font-family: 'Newsreader', Georgia, serif !important;
        font-size: 1.45rem !important;
        font-weight: 700 !important;
        color: var(--theme-gold, #ffd700) !important;
        margin-top: 2.25rem !important;
        margin-bottom: 1rem !important;
      }

      .article-body p {
        font-family: 'Newsreader', Georgia, serif !important;
        font-size: 1.18rem !important;
        line-height: 1.95 !important;
        color: #e2e8f0 !important;
        margin-bottom: 1.75rem !important;
      }

      .article-body li {
        font-family: 'Newsreader', Georgia, serif !important;
        font-size: 1.15rem !important;
        line-height: 1.85 !important;
        color: #cbd5e1 !important;
      }

      .article-body blockquote {
        border-left: 3px solid var(--theme-gold, #ffd700) !important;
        background: var(--theme-card, #080808) !important;
        border-radius: 0 16px 16px 0 !important;
        padding: 1.5rem 2rem !important;
        margin: 2.5rem 0 !important;
        box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7) !important;
      }

      .article-body blockquote p {
        font-family: 'Newsreader', Georgia, serif !important;
        font-style: italic !important;
        font-size: 1.22rem !important;
        line-height: 1.9 !important;
        color: #f1f5f9 !important;
      }
    </style>

</head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased selection:bg-amber-500 selection:text-slate-950">
    <slot />
    <SoutienModal />
    
    <!-- Barre de Progression de Lecture Furtive (Stealth Reading Bar) -->
    <div id="readingProgressBar" class="no-print fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 z-[100] w-0 transition-all duration-150 pointer-events-none opacity-90"></div>

    <!-- Bouton Flottant "Retour en Haut" -->
    <button 
      id="backToTopBtn" 
      class="no-print fixed bottom-6 right-6 p-3.5 rounded-2xl bg-amber-500/90 text-slate-950 font-bold shadow-2xl backdrop-blur border border-amber-400 hover:bg-amber-400 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 z-50 flex items-center justify-center cursor-pointer group"
      aria-label="Retourner en haut de la page"
    >
      <span class="text-sm font-mono flex items-center gap-1">
        <span>▲</span>
        <span class="hidden sm:inline text-xs font-bold font-sans">HAUT</span>
      </span>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('backToTopBtn');
        const progressBar = document.getElementById('readingProgressBar');
        
        window.addEventListener('scroll', function() {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          
          if (progressBar && docHeight > 0) {
            const progress = (scrollY / docHeight) * 100;
            progressBar.style.width = `${progress}%`;
          }

          if (btn) {
            if (scrollY > 400) {
              btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
              btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            } else {
              btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }
          }
        });

        if (btn) {
          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>

    <!-- Moteur de Scrollytelling Forensique (Illumination fluide des preuves) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const highlights = document.querySelectorAll('mark.forensic-highlight');
        if (!highlights.length) return;

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('illuminated');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.25, rootMargin: '0px 0px -50px 0px' });

          highlights.forEach((h) => observer.observe(h));
        } else {
          highlights.forEach((h) => h.classList.add('illuminated'));
        }
      });
    </script>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <!-- Script universel d'enveloppement responsive des tableaux de données pour lecture mobile -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('article table, .article-body table').forEach((tbl) => {
          if (!tbl.closest('.overflow-x-auto') && !tbl.closest('.table-responsive-wrapper')) {
            const wrapper = document.createElement('div');
            wrapper.className = 'table-responsive-wrapper overflow-x-auto max-w-full my-6 rounded-xl border border-slate-800 bg-slate-950/80 shadow-xl';
            tbl.parentNode.insertBefore(wrapper, tbl);
            wrapper.appendChild(tbl);
          }
        });
      });
    </script>
  </body>
</html>


<style is:global>
      :root {
        --color-bg-body: #121316;
