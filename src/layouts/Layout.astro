---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  lang?: string;
}

const { 
  title, 
  description = "L'OCHJU — Média Citoyen d'Investigation, Participatif & Open Data en Corse. Révélations forensiques et données d'intérêt public. L'aveti ?",
  image = "/alerte_censure_lochju.jpg",
  canonicalUrl = Astro.url.href,
  lang = "fr"
} = Astro.props;

const siteUrl = "https://fsucieta.github.io";
const cleanCanonical = canonicalUrl.startsWith("http") ? canonicalUrl : `${siteUrl}/${canonicalUrl.replace(/^\//, '')}`;
const fullImageUrl = image.startsWith("http") ? image : `${siteUrl}/${image.replace(/^\//, '')}`;
---

<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Primaire (Google Core Standard) -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={cleanCanonical} />

    <!-- Open Graph / Facebook / WhatsApp (Social Graph) -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="L'OCHJU" />
    <meta property="og:url" content={cleanCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card (Format Grand Angle) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Mesure d'Audience Éthique & Souveraine sans cookies (GoatCounter) -->
    <script data-goatcounter="https://lochju.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

    <!-- Mode Nuit Souverain Inaltérable L'OCHJU -->
    
    <!-- Tailwind CSS CDN avec directive is:inline obligatoire pour Astro -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            colors: {
              slate: {
                950: '#06080d', /* Noir minéral profond d'archive (Fond souverain L'OCHJU) */
                900: '#0b0f17', /* Surface d'obsidienne pure (Cartes, bannières & conteneurs) */
                850: '#101724', /* Niveau de profondeur intermédiaire */
                800: '#151d2c', /* Bordures et séparateurs ultra-fins */
                700: '#222f46', /* Éléments et contours secondaires */
                600: '#384860',
                500: '#64748b',
                400: '#94a3b8',
                300: '#cbd5e1',
                200: '#e2e8f0',
                100: '#f1f5f9',
                50: '#f8fafc'
              },
              gold: {
                400: '#facc15',
                500: '#d4af37',
                600: '#b8860b'
              },
              cyan: {
                400: '#38bdf8',
                500: '#007791'
              }
            },
            fontFamily: {
              serif: ['Merriweather', 'Georgia', 'serif'],
              sans: ['Inter', 'system-ui', 'sans-serif'],
              cinzel: ['Cinzel', 'serif'],
              mono: ['JetBrains Mono', 'monospace']
            }
          }
        }
      }
    </script>
    
    <!-- Polices Google Fonts : Inter, Merriweather, JetBrains Mono & Cinzel (Édition Régale) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Inter:wght@300;400;500;600;700;800;900&family=Merriweather:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
    
    <!-- Styles Forensiques Globaux : Scrollytelling, Surlignage Lumineux & Chiaroscuro -->
    <style is:global>
      /* Chiffres tabulaires alignés d'orfèvrerie financière */
      .font-mono, [data-tabular-nums] {
        font-variant-numeric: tabular-nums;
      }

      /* Effet de surlignage dynamique au défilement (Forensic Highlight) */
      mark.forensic-highlight {
        background: transparent;
        color: #f1f5f9;
        padding: 0.12em 0.3em;
        border-radius: 0.25em;
        border-bottom: 2px solid transparent;
        transition: background 0.8s ease, color 0.5s ease, border-color 0.8s ease, box-shadow 0.8s ease;
      }
      mark.forensic-highlight.illuminated {
        background: linear-gradient(120deg, rgba(245, 158, 11, 0.25) 0%, rgba(245, 158, 11, 0.45) 100%);
        color: #fef08a;
        border-bottom: 2px solid #f59e0b;
        box-shadow: 0 0 15px rgba(245, 158, 11, 0.25);
      }
      mark.forensic-highlight:hover {
        background: rgba(245, 158, 11, 0.55);
        box-shadow: 0 0 25px rgba(245, 158, 11, 0.4);
      }

      /* Fond d'archives et ambiance Chiaroscuro subtile */
      body {
        background-color: #06080d;
        background-image: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.04) 0%, transparent 60%);
      }
    </style>

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-300 antialiased selection:bg-amber-500 selection:text-slate-950">
    <slot />
    
    <!-- Barre de Progression de Lecture Furtive (Stealth Reading Bar) -->
    <div id="readingProgressBar" class="fixed top-0 left-0 h-[2.5px] bg-gradient-to-r from-amber-500 via-amber-300 to-amber-500 z-[100] w-0 transition-all duration-150 pointer-events-none opacity-90"></div>

    <!-- Bouton Flottant "Retour en Haut" -->
    <button 
      id="backToTopBtn" 
      class="fixed bottom-6 right-6 p-3.5 rounded-2xl bg-amber-500/90 text-slate-950 font-bold shadow-2xl backdrop-blur border border-amber-400 hover:bg-amber-400 transition-all duration-300 opacity-0 pointer-events-none translate-y-4 z-50 flex items-center justify-center cursor-pointer group"
      aria-label="Retourner en haut de la page"
    >
      <span class="text-sm font-mono flex items-center gap-1">
        <span>▲</span>
        <span class="hidden sm:inline text-xs font-bold font-sans">HAUT</span>
      </span>
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('backToTopBtn');
        const progressBar = document.getElementById('readingProgressBar');
        
        window.addEventListener('scroll', function() {
          const scrollY = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          
          if (progressBar && docHeight > 0) {
            const progress = (scrollY / docHeight) * 100;
            progressBar.style.width = `${progress}%`;
          }

          if (btn) {
            if (scrollY > 400) {
              btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
              btn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
            } else {
              btn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
              btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
            }
          }
        });

        if (btn) {
          btn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }
      });
    </script>

    <!-- Moteur de Scrollytelling Forensique (Illumination fluide des preuves) -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const highlights = document.querySelectorAll('mark.forensic-highlight');
        if (!highlights.length) return;

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('illuminated');
                observer.unobserve(entry.target);
              }
            });
          }, { threshold: 0.25, rootMargin: '0px 0px -50px 0px' });

          highlights.forEach((h) => observer.observe(h));
        } else {
          highlights.forEach((h) => h.classList.add('illuminated'));
        }
      });
    </script>

    <!-- Leaflet JS -->
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </body>
</html>


<style is:global>
  /* ==========================================================================
     DESIGN SYSTEM SOUVERAIN L'OCHJU — MODE SOMBRE PERMANENT
     Obsidienne Minérale, Chiaroscuro & Or Antique Régalien
     ========================================================================== */

  :root, html, html.dark {
    scroll-behavior: smooth;
    --bg-main:          #06080d;
    --bg-card:          #0b0f17;
    --bg-card-hover:    #101724;
    --bg-header:        rgba(6, 8, 13, 0.95);
    --text-main:        #f1f5f9;
    --text-muted:       #94a3b8;
    --border-color:     #151d2c;
    --border-highlight: #d4af37;
    --accent-primary:   #d4af37;
    --accent-hover:     #facc15;
    --accent-glow:      rgba(212, 175, 55, 0.12);
    --accent-card:      rgba(212, 175, 55, 0.14);
    --body-gradient:
      radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.05) 0%, transparent 60%),
      radial-gradient(circle at 85% 30%, rgba(194, 109, 67, 0.04) 0%, transparent 50%);
  }

  /* ---------- APPLICATION DU FOND ET DE L'AMBIANCE BODY ---------- */
  body {
    background-color: var(--bg-main) !important;
    background-image: var(--body-gradient) !important;
    color: var(--text-main) !important;
  }

  /* ---------- HEADER, NAVIGATION & CONTENEURS NOBLES ---------- */
  header {
    background-color: var(--bg-header) !important;
    border-color: var(--border-color) !important;
  }

  nav {
    background-color: rgba(6, 8, 13, 0.90) !important;
    border-color: var(--border-color) !important;
  }

  /* Cartes d'enquête & conteneurs de données */
  .fiche-card,
  .hero-card-container,
  #manifeste-section > div,
  #alerte-censure-section > div {
    border-color: var(--border-color);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .fiche-card:hover {
    border-color: var(--border-highlight) !important;
  }

  /* --------------------------------------------------------------------------
     STYLES SPÉCIFIQUES POUR LES ARTICLES (STANDARD FORENSIC PULITZER)
     -------------------------------------------------------------------------- */

  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* ==========================================================================
     ENCARTS DE RÉVÉLATION FORENSIQUE & CITATIONS NOBLES (BLOOMBERG / FT STYLE)
     ========================================================================== */
  .article-body blockquote {
    position: relative !important;
    border-left: 3px solid var(--accent-primary, #d4af37) !important;
    background: var(--bg-card, rgba(11, 15, 23, 0.75)) !important;
    backdrop-filter: blur(12px) !important;
    padding: 1.5rem 1.75rem !important;
    margin: 2.5rem 0 !important;
    border-radius: 0 12px 12px 0 !important;
    border-top: 1px solid var(--border-color, rgba(212, 175, 55, 0.15)) !important;
    border-right: 1px solid var(--border-color, rgba(21, 29, 44, 0.6)) !important;
    border-bottom: 1px solid var(--border-color, rgba(21, 29, 44, 0.6)) !important;
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.5) !important;
  }

  /* Suppression définitive de l'ampoule CSS artificielle ::before */
  .article-body blockquote::before {
    display: none !important;
    content: none !important;
  }

  .article-body blockquote p {
    color: #e2e8f0 !important;
    font-family: 'Merriweather', serif !important;
    font-size: 1.05rem !important;
    line-height: 1.85 !important;
    margin-bottom: 0.5rem !important;
    font-style: normal !important;
  }

  .article-body blockquote strong, .article-body blockquote b {
    color: #fef08a !important;
    font-weight: 700 !important;
  }

  /* CODES & LABELS FORENSIQUES */
  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  /* SURBRILLANCES FORENSIQUES LUMINEUSES SOBRES (HIGH-END MINIMALIST) */
  mark.forensic-highlight {
    background-color: rgba(245, 158, 11, 0.08);
    color: #fef08a;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    border-bottom: 2px solid rgba(245, 158, 11, 0.4);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  mark.forensic-highlight.illuminated {
    background-color: rgba(245, 158, 11, 0.18);
    color: #ffffff;
    border-bottom-color: #f59e0b;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.25);
  }

  /* ==========================================================================
     STANDARD D'IMPRESSION A4 CITOYEN (AFFICHAGE VILLAGE / TRACT D'ACTION)
     ========================================================================== */
  @media print {
    /* Masquer les éléments interactifs et de navigation superflus sur papier */
    header, nav, footer, .no-print, [data-no-print], button {
      display: none !important;
    }

    body, html {
      background: #ffffff !important;
      color: #0f172a !important;
      font-size: 11pt !important;
      line-height: 1.5 !important;
    }

    /* Forcer l'encre noire et les contrastes nets pour les textes */
    p, span, li, td, th {
      color: #1e293b !important;
    }

    h1, h2, h3, h4 {
      color: #000000 !important;
      page-break-after: avoid;
    }

    /* Mise en valeur des surbrillances sur papier (soulignement élégant) */
    mark.forensic-highlight {
      background: transparent !important;
      color: #000000 !important;
      font-weight: 700 !important;
      text-decoration: underline 2px solid #b8860b !important;
      box-shadow: none !important;
    }

    /* Préservation des tableaux et bordures nettes */
    table {
      width: 100% !important;
      border-collapse: collapse !important;
      page-break-inside: avoid;
    }

    th, td {
      border: 1px solid #94a3b8 !important;
      padding: 6px 10px !important;
      font-size: 10pt !important;
    }

    th {
      background-color: #f1f5f9 !important;
      font-weight: bold !important;
    }

    /* Gestion des ruptures de page */
    article {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
  }
</style>
