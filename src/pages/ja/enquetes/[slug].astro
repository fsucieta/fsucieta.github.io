---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import CarteEnergieCorse from '../../../components/CarteEnergieCorse.astro';
import AudioBriefing from '../../../components/AudioBriefing.astro';
import SoutienCitoyen from '../../../components/SoutienCitoyen.astro';
import InvestigationHeader from '../../../components/InvestigationHeader.astro';
import PiecesJustificativesSection from '../../../components/PiecesJustificativesSection.astro';
import DebatCitoyenGiscus from '../../../components/DebatCitoyenGiscus.astro';

export async function getStaticPaths() {
  const enquetes = await getCollection('enquetes');
  const allowedIds = [2, 22, 18, 27, 7, 23, 28, 26, 4, 11];
  return enquetes.filter((entry) => allowedIds.includes(entry.data.id)).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'enquetes'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const imgPath = data.image.startsWith('http') ? data.image : `/${data.image.replace(/^\//, '')}`;
const ogImage = data.image.startsWith('http') ? data.image : `/${data.image.replace(/^\//, '')}`;
---

<Layout 
  title={`${data.title} — L'OCHJU`} 
  description={data.chapeau}
  image={ogImage}
  canonicalUrl={`https://fsucieta.github.io/ja/enquetes/${entry.slug}/`}
  lang="ja"
>
  <!-- Navigation Supérieure avec Logo Intact & Sélecteur 8 Langues -->
  <InvestigationHeader currentLang="ja" slug={entry.slug} refCode={data.ref} id={data.id} />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-10 md:py-16 space-y-12">
    
    <!-- En-tête Dossier -->
    <header class="space-y-6">
      <div class="flex flex-wrap items-center gap-3 font-mono-tech text-xs">
        <span class="px-3 py-1 rounded-full bg-amber-500 text-black font-black uppercase tracking-wider text-[10px]">
          対抗力ある封印済み公文書
        </span>
        <span class="theme-gold-text font-bold">[{data.ref || `DOSSIER-${data.id}`}]</span>
        <span class="text-slate-400 uppercase tracking-widest">• {data.category}</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-press font-black text-white leading-tight">
        {data.title}
      </h1>

      <p class="text-lg sm:text-xl font-press text-slate-300 leading-relaxed border-l-2 border-amber-500 pl-5">
        {data.chapeau}
      </p>

      <!-- Métadonnées ISO -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-xl bg-black/60 border border-white/10 font-mono-tech text-xs text-slate-400">
        <div>
          <div class="text-[10px] text-slate-500 uppercase">特別調査班</div>
          <div class="text-slate-200 font-bold truncate">{data.author}</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-500 uppercase">公開日</div>
          <div class="text-slate-200 font-bold">{data.date}</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-500 uppercase">OUTILS OPEN DATA</div>
          <div class="text-slate-200 font-bold truncate">{data.tool}</div>
        </div>
        <div>
          <div class="text-[10px] text-slate-500 uppercase">NORME FORENSIQUE</div>
          <div class="text-emerald-400 font-bold">ISO/IEC 27037</div>
        </div>
      </div>
    </header>

    <!-- Visuel Enquête -->
    <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-black">
      <img src={imgPath} alt={data.title} class="w-full h-auto object-cover max-h-[500px]" />
      {data.imageCaption && (
        <div class="p-3 bg-black/80 text-center font-mono-tech text-xs text-slate-400 border-t border-white/10">
          {data.imageCaption}
        </div>
      )}
    </div>

    <!-- Corps de l'Investigation -->
    <div class="prose prose-invert prose-amber max-w-none font-press leading-relaxed text-slate-200 space-y-6">
      <Content />
    </div>

    <!-- Sources Officielles Opposables -->
    <!-- SECTION FORENSIQUE DES SOURCES ET PIÈCES D'ÉTAT (ISO/IEC 27037) -->
    <PiecesJustificativesSection 
      sources={data.sources} 
      id={data.id} 
      refCode={data.ref} 
      date={data.date} 
      lang="ja" 
    />

    <!-- ESPACE DE DÉBAT CITOYEN & LIKES (GISCUS) -->
    <DebatCitoyenGiscus lang="ja" mapping="pathname" />

    <!-- Module de Soutien Citoyen -->
    <SoutienCitoyen variant="compact" idPrefix="enq_soutien_" />

    <!-- Retour Enquêtes -->
    <div class="pt-8 border-t border-white/10 flex items-center justify-between font-mono-tech text-xs">
      <a href="/ja/#enquetes" class="text-amber-400 hover:text-amber-300 font-bold flex items-center gap-1.5">
        <span>← 9大封印調査一覧へ戻る</span>
      </a>
      <a href="/soutenir/" class="px-4 py-2 rounded-xl bg-amber-500 text-black font-black uppercase">
        調査活動を支援する
      </a>
    </div>

  </article>
</Layout>
