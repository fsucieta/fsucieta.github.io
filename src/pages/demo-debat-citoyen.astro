---
import Layout from '../layouts/Layout.astro';
import InvestigationHeader from '../components/InvestigationHeader.astro';
import DebatCitoyenGiscus from '../components/DebatCitoyenGiscus.astro';
---

<Layout 
  title="Aperçu Espace Débats & Réactions — L'OCHJU" 
  description="Démonstration du système de likes, réactions et commentaires souverains propulsé par GitHub Discussions pour L'OCHJU."
>
  <InvestigationHeader currentLang="fr" />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 font-mono-tech text-xs uppercase tracking-widest">
        DÉMONSTRATION OPTION 1 • GISCUS / GITHUB
      </div>
      <h1 class="text-3xl sm:text-5xl font-press font-black text-white">
        Système de Likes & Débats Citoyens
      </h1>
      <p class="text-slate-300 font-press text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Voici à quoi ressemble l'espace interactif intégré en bas de chaque enquête ou sur la page principale.
      </p>
    </div>

    <!-- Le composant Débat Citoyen -->
    <DebatCitoyenGiscus />

    <div class="p-6 rounded-2xl bg-black/60 border border-white/10 font-mono-tech text-xs text-slate-400 space-y-3">
      <h4 class="text-amber-400 font-bold uppercase tracking-wider text-sm m-0">
        💡 Comment ça fonctionne concrètement pour nos lecteurs ?
      </h4>
      <ul class="space-y-2 pl-4 list-disc text-slate-300">
        <li><strong>Likes & Émojis rapides</strong> : Les lecteurs peuvent réagir instantanément en 1 clic (Utile, Solide, Résistance, Vigilance).</li>
        <li><strong>Fils de discussion imbriqués</strong> : Possibilité de répondre à un commentaire spécifique, de citer des passages ou de partager des liens d'archives.</li>
        <li><strong>Zéro frais d'hébergement</strong> : Toutes les données sont hébergées gratuitement et à vie dans l'onglet <em>Discussions</em> de notre dépôt GitHub <code>fsucieta/fsucieta.github.io</code>.</li>
        <li><strong>Modération totale</strong> : Vous pouvez masquer, épingler ou supprimer les messages indésirables directement depuis l'interface GitHub.</li>
      </ul>
    </div>
  </main>
</Layout>
