---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const enquetes = await getCollection('enquetes');
  return enquetes.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
---

<Layout title={`${data.title} — CASA DI CRISTALE`} description={data.chapeau}>
  <header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur sticky top-0 z-50 py-4 px-6">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="/" class="flex items-center gap-3 text-amber-400 font-bold text-xl hover:opacity-80 transition">
        <span>← ACCUEIL CASA DI CRISTALE 2.0</span>
      </a>
      <div class="text-xs text-slate-400 font-mono">
        {data.ref}
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <!-- En-tête d'Article -->
    <div class="mb-10 border-b border-amber-500/30 pb-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold uppercase tracking-wider">
          {data.category}
        </span>
        <span class="text-xs text-slate-400 font-mono">{data.date}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold text-slate-100 font-serif leading-tight mb-6">
        {data.title}
      </h1>

      <p class="text-lg md:text-xl text-amber-200/90 font-serif italic mb-8 leading-relaxed bg-amber-500/5 p-6 border-l-4 border-amber-500 rounded-r-lg">
        {data.chapeau}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-slate-400 pt-4 border-t border-slate-800">
        <div><strong>Auteur :</strong> {data.author}</div>
        <div><strong>Outil d'Audit :</strong> <code class="bg-slate-800 px-2 py-1 rounded text-cyan-400">{data.tool}</code></div>
      </div>
    </div>

    <!-- Image d'illustration -->
    {data.image && (
      <div class="mb-12 rounded-xl overflow-hidden border border-slate-800 shadow-2xl">
        <img src={`/${data.image}`} alt={data.title} class="w-full object-cover max-h-[450px]" />
      </div>
    )}

    <!-- Corps de l'Article Markdown -->
    <article class="prose prose-invert prose-amber max-w-none font-serif text-lg leading-relaxed text-slate-200">
      <Content />
    </article>

    <!-- Sources & Preuves -->
    {data.sources && data.sources.length > 0 && (
      <div class="mt-16 pt-8 border-t border-slate-800 bg-slate-950/50 p-6 rounded-xl border border-slate-800/80">
        <h3 class="text-xl font-bold text-amber-400 mb-4 font-sans flex items-center gap-2">
          <span>📚 Sources & Documentation Officielle</span>
        </h3>
        <ul class="space-y-3 font-sans text-sm">
          {data.sources.map(src => (
            <li class="flex flex-col md:flex-row md:items-center justify-between gap-2 p-3 bg-slate-900 rounded-lg border border-slate-800 hover:border-amber-500/40 transition">
              <a href={src.url} target="_blank" rel="noopener noreferrer" class="text-cyan-400 hover:underline font-semibold flex items-center gap-2">
                <span>🔗 {src.name}</span>
              </a>
              {src.sha256 && (
                <span class="text-xs font-mono text-slate-500 bg-slate-950 px-2 py-1 rounded">
                  SHA-256: {src.sha256.substring(0, 16)}...
                </span>
              )}
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Navigation retour -->
    <div class="mt-12 text-center">
      <a href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-amber-500 text-slate-950 font-bold rounded-lg hover:bg-amber-400 transition shadow-lg shadow-amber-500/20">
        <span>← Retour à toutes les enquêtes</span>
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 mt-20 text-center text-xs text-slate-500">
    CASA DI CRISTALE 2.0 — INVESTIGATION CITOYENNE SOUVERAINE CORSE
  </footer>
</Layout>
