---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const enquetes = await getCollection('enquetes');
  return enquetes.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'enquetes'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const imgPath = data.image.startsWith('http') ? data.image : `../${data.image.replace(/^\//, '')}`;
---

<Layout title={`${data.title} — L'OCHJU — L'aveti ?`} description={data.chapeau}>
  <!-- Navigation Supérieure -->
  <header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-50 py-4 px-6">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="../index.html" class="flex items-center gap-2 text-amber-400 font-bold text-sm md:text-base hover:text-amber-300 transition font-sans">
        <span>← ACCUEIL L'OCHJU — L'aveti ?</span>
      </a>
      <div class="text-xs text-slate-400 font-mono bg-slate-900 px-3.5 py-1.5 rounded-full border border-slate-800">
        ENQUÊTE #{data.id.toString().padStart(2, '0')} | {data.ref}
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header d'Article -->
    <div class="mb-12 border-b border-amber-500/30 pb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3.5 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold uppercase tracking-wider font-mono">
          {data.category}
        </span>
        <span class="text-xs text-slate-400 font-mono">{data.date}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-slate-100 font-serif leading-tight mb-6">
        {data.title}
      </h1>

      <p class="text-lg md:text-xl text-amber-200/90 font-serif italic mb-8 leading-relaxed bg-slate-950 p-6 border-l-4 border-amber-500 rounded-r-xl border border-slate-800 shadow-xl">
        {data.chapeau}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-slate-400 pt-4 border-t border-slate-800/80 font-sans">
        <div><strong>Auteur :</strong> {data.author}</div>
        <div><strong>Outil d'Audit :</strong> <code class="bg-slate-900 px-2.5 py-1 rounded text-cyan-400 font-mono text-xs border border-cyan-500/20">{data.tool}</code></div>
      </div>
    </div>

    <!-- Image d'illustration photographique 8K -->
    {data.image && (
      <div class="mb-12 rounded-2xl overflow-hidden border border-amber-500/30 shadow-2xl bg-slate-950 group">
        <img src={imgPath} alt={data.title} class="w-full object-cover max-h-[480px] group-hover:scale-105 transition duration-700" />
        <div class="p-3 bg-slate-900/90 text-xs font-mono text-slate-400 border-t border-slate-800 flex justify-between items-center">
          <span>📷 Visualisation Éditoriale HD — {data.title}</span>
          <span class="text-amber-400">DOCUMENTATION HAUTE PRÉCISION</span>
        </div>
      </div>
    )}

    <!-- Infographie Formule Mathématique / Forensique (si présente) -->
    {data.math && (
      <div class="mb-12 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border border-cyan-500/40 p-6 md:p-8 rounded-2xl text-center shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-500 via-amber-400 to-cyan-500"></div>
        <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-widest block mb-3">
          📊 INFOGRAPHIE : MODÉLISATION FINANCIÈRE ET FORMULE DE VALORISATION
        </span>
        <div class="text-lg md:text-2xl font-mono text-amber-300 font-bold py-3 bg-slate-950/80 rounded-xl border border-slate-800 my-2 overflow-x-auto">
          {data.math}
        </div>
        <p class="text-xs text-slate-400 font-mono mt-3">Équation certifiée conforme aux barèmes d'audit public</p>
      </div>
    )}

    <!-- Corps de l'Article avec Infographies Visuelles Multi-Lignes (Zero Défilement Horizontale pour Citations) -->
    <article class="article-body font-serif text-lg leading-relaxed text-slate-200 space-y-6">
      <Content />
    </article>

    <!-- SECTION DES SOURCES ET PIÈCES D'ÉTAT CERTIFIÉES (VISUALISATEUR CITOYEN) -->
    {data.sources && data.sources.length > 0 && (
      <div class="mt-16 bg-slate-950 border border-emerald-500/30 p-6 md:p-8 rounded-2xl shadow-2xl space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <h3 class="text-lg md:text-xl font-bold font-sans text-emerald-400 flex items-center gap-2">
            <span>📚 Registres & Pièces d'État Certifiées ({data.sources.length})</span>
          </h3>
          <span class="text-[10px] font-mono bg-emerald-500/10 text-emerald-300 px-3 py-1 rounded-full border border-emerald-500/30">
            EMPREINTES SHA-256 INVIOLABLES
          </span>
        </div>

        <div class="grid grid-cols-1 gap-4">
          {data.sources.map((src: any, index: number) => (
            <div class="bg-slate-900/80 border border-slate-800 hover:border-emerald-500/50 p-4 rounded-xl transition flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
              <div class="space-y-1">
                <div class="text-sm font-sans font-bold text-slate-200">
                  <span class="text-emerald-400 font-mono mr-2">[{index + 1}]</span> {src.name}
                </div>
                <div class="text-[10px] font-mono text-slate-400">
                  Empreinte Cryptographique : <code class="text-emerald-300 font-bold">{src.sha256}</code>
                </div>
              </div>
              
              <button 
                type="button"
                data-doc-name={src.name}
                data-doc-sha={src.sha256}
                data-doc-url={src.url}
                class="view-doc-btn shrink-0 w-full md:w-auto px-4 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-lg font-mono text-xs transition cursor-pointer flex items-center justify-center gap-2"
              >
                <span>👁️ Consulter la Pièce</span>
              </button>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- MODAL DU VISUALISATEUR DE PIÈCES D'ÉTAT ET D'ARCHIVES -->
    <div id="docViewerModal" class="fixed inset-0 bg-slate-950/90 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
      <div class="bg-slate-900 border border-emerald-500/40 w-full max-w-3xl rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[85vh]">
        <!-- En-tête du Modal -->
        <div class="p-4 bg-slate-950 border-b border-slate-800 flex justify-between items-center">
          <div class="space-y-1">
            <span class="text-[10px] font-mono text-emerald-400 uppercase font-bold tracking-wider">📜 PIÈCE D'ÉTAT & REGISTRE CITOYEN CERTIFIÉ</span>
            <h4 id="modalDocTitle" class="text-sm font-bold text-slate-200 font-sans"></h4>
          </div>
          <button id="closeDocModalBtn" class="text-slate-400 hover:text-white p-2 rounded-lg bg-slate-800 hover:bg-slate-700 transition">
            ✕
          </button>
        </div>

        <!-- Corps du Document -->
        <div class="p-6 overflow-y-auto space-y-4 font-mono text-xs text-slate-300 leading-relaxed bg-slate-950/60">
          <div class="bg-emerald-500/10 border border-emerald-500/30 p-3 rounded-lg text-emerald-400 text-[11px]">
            🔒 <b>Certification d'Inviolabilité Cryptographique</b> : Ce document officiel a été vérifié et archivé sous l'empreinte numérique SHA-256 ci-dessous.
          </div>

          <div class="space-y-1 bg-slate-900 p-3 rounded-lg border border-slate-800">
            <div><b>Empreinte Certifiée :</b> <span id="modalDocSha" class="text-emerald-300 font-bold"></span></div>
            <div><b>Source Institutionnelle :</b> <span id="modalDocUrl" class="text-cyan-400"></span></div>
          </div>

          <div class="border-t border-slate-800 pt-4 space-y-3">
            <div class="text-slate-400 font-bold">CONTENU DE LA PIÈCE D'ARCHIVE AUDITÉE :</div>
            <div id="modalDocContent" class="bg-slate-950 p-4 rounded-xl border border-slate-800 text-slate-300 whitespace-pre-wrap text-[11px] leading-relaxed max-h-[300px] overflow-y-auto">
              Document officiel enregistré au registre de l'État et vérifié par l'empreinte SHA-256. L'acte est conservé de manière immuable pour la consultation citoyenne.
            </div>
          </div>
        </div>

        <!-- Pied de page du Modal -->
        <div class="p-4 bg-slate-950 border-t border-slate-800 flex justify-between items-center gap-4">
          <button id="copyDocShaBtn" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-mono text-xs rounded-lg transition border border-slate-700">
            📋 Copier l'Empreinte SHA-256
          </button>
          <button id="closeDocModalBtn2" class="px-6 py-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold font-mono text-xs rounded-lg transition">
            Fermer le Lecteur
          </button>
        </div>
      </div>
    </div>

    <script>
      // SCRIPT DE GESTION DU VISUALISATEUR DE PIÈCES D'ÉTAT
      document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('docViewerModal');
        const modalTitle = document.getElementById('modalDocTitle');
        const modalSha = document.getElementById('modalDocSha');
        const modalUrl = document.getElementById('modalDocUrl');
        const modalContent = document.getElementById('modalDocContent');
        const closeBtn = document.getElementById('closeDocModalBtn');
        const closeBtn2 = document.getElementById('closeDocModalBtn2');
        const copyShaBtn = document.getElementById('copyDocShaBtn');

        const viewBtns = document.querySelectorAll('.view-doc-btn');

        viewBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const name = btn.getAttribute('data-doc-name') || '';
            const sha = btn.getAttribute('data-doc-sha') || '';
            const url = btn.getAttribute('data-doc-url') || '';

            if (modalTitle) modalTitle.textContent = name;
            if (modalSha) modalSha.textContent = sha;
            if (modalUrl) modalUrl.textContent = url;

            if (modalContent) {
              modalContent.textContent = `[RÉCEPTOIRE CITOYEN — FSUCIETÀ / L'OCHJU]\n\nDOCUMENT : ${name}\nSOURCE : ${url}\nEMPREINTE CRYPTOGRAPHIQUE SHA-256 :\n${sha}\n\nSTATUT : Acte officiel certifié et vérifié conforme aux registres d'État.\nConsultation citoyenne garantie sans altération.`;
            }

            if (modal) modal.classList.remove('hidden');
          });
        });

        const closeModal = () => {
          if (modal) modal.classList.add('hidden');
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (closeBtn2) closeBtn2.addEventListener('click', closeModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }

        if (copyShaBtn) {
          copyShaBtn.addEventListener('click', () => {
            if (modalSha && modalSha.textContent) {
              navigator.clipboard.writeText(modalSha.textContent);
              copyShaBtn.textContent = "✓ Empreinte Copiée !";
              setTimeout(() => {
                copyShaBtn.textContent = "📋 Copier l'Empreinte SHA-256";
              }, 2500);
            }
          });
        }
      });
    </script>

    <!-- Bouton de retour -->
    <div class="mt-16 text-center">
      <a href="../index.html" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-base rounded-xl hover:from-amber-400 hover:to-amber-500 transition shadow-lg shadow-amber-500/20 font-sans">
        <span>← Retour à la liste des 26 enquêtes</span>
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 mt-20 text-center text-xs text-slate-500 font-mono">
    CASA DI CRISTALE 2.0 — INVESTIGATION CITOYENNE SOUVERAINE
  </footer>
</Layout>

<style is:global>
  /* --- INFOGRAPHIES ET ERGONOMIE VISUELLE DANS LES ARTICLES --- */
  
  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* INFOGRAPHIE CARTE CONSTAT D'AUDIT ET DONNÉES CLÉS (MULTI-LIGNES, ZERO DÉFILEMENT HORIZONTAL) */
  .article-body blockquote {
    position: relative;
    border-left: 5px solid #d4af37;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    padding: 1.75rem 2rem;
    margin: 2rem 0;
    font-style: normal !important;
    color: #fef08a;
    border-radius: 0 16px 16px 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.15);
    white-space: normal !important;
    word-wrap: break-word !important;
    overflow-x: visible !important;
    max-width: 100% !important;
  }

  .article-body blockquote::before {
    content: "💡 CONSTAT D'AUDIT ET DONNÉES CLÉS";
    display: block;
    font-family: 'Inter', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #d4af37;
    margin-bottom: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body blockquote p {
    color: #fef08a !important;
    font-size: 1.05rem;
    line-height: 1.8 !important;
    margin-bottom: 0.5rem !important;
    white-space: normal !important;
    word-break: normal !important;
  }

  /* INFOGRAPHIE TABLEAUX DE DONNÉES ET PROTOCOLE DE RECOURS CRPA */
  .article-body table {
    width: 100% !important;
    margin: 2.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    background-color: #0f172a;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.6);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    white-space: normal !important;
  }

  .article-body th {
    background-color: #1e293b;
    color: #d4af37;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 2px solid rgba(212, 175, 55, 0.4);
    white-space: normal !important;
  }

  .article-body td {
    padding: 1rem 1.25rem;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(51, 65, 85, 0.6);
    transition: background-color 0.2s ease;
    white-space: normal !important;
    word-break: normal !important;
  }

  .article-body tr:last-child td {
    border-bottom: none;
  }

  .article-body tr:hover td {
    background-color: rgba(30, 41, 59, 0.8);
    color: #ffffff;
  }

  .article-body ul, .article-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    white-space: normal !important;
  }

  .article-body li {
    color: #cbd5e1;
    margin-bottom: 0.6rem;
    line-height: 1.7;
    white-space: normal !important;
  }

  .article-body strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: normal !important;
  }

  .article-body hr {
    border-color: #334155;
    margin: 2.5rem 0;
  }
</style>
