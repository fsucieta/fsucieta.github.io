---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SimulateurFiscalCommunes from '../../components/SimulateurFiscalCommunes.astro';

export async function getStaticPaths() {
  const enquetes = await getCollection('enquetes');
  return enquetes.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'enquetes'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const imgPath = data.image.startsWith('http') ? data.image : `../${data.image.replace(/^\//, '')}`;
---

<Layout title={`${data.title} — L'OCHJU — L'aveti ?`} description={data.chapeau}>
  <!-- Navigation Supérieure -->
  <header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-50 py-4 px-6">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <a href="../index.html" class="flex items-center gap-2 text-amber-400 font-bold text-sm md:text-base hover:text-amber-300 transition font-sans">
        <span>← ACCUEIL L'OCHJU — L'aveti ?</span>
      </a>
      <div class="text-xs text-slate-400 font-mono bg-slate-900 px-3.5 py-1.5 rounded-full border border-slate-800">
        ENQUÊTE #{data.id.toString().padStart(2, '0')} | {data.ref}
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <!-- Header d'Article -->
    <div class="mb-12 border-b border-amber-500/30 pb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="px-3.5 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold uppercase tracking-wider font-mono">
          {data.category}
        </span>
        <span class="text-xs text-slate-400 font-mono">{data.date}</span>
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-slate-100 font-serif leading-tight mb-6">
        {data.title}
      </h1>

      <p class="text-lg md:text-xl text-amber-200/90 font-serif italic mb-8 leading-relaxed bg-slate-950 p-6 border-l-4 border-amber-500 rounded-r-xl border border-slate-800 shadow-xl">
        {data.chapeau}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-slate-400 pt-4 border-t border-slate-800/80 font-sans">
        <div><strong>Auteur :</strong> {data.author}</div>
        <div><strong>Outil d'Audit :</strong> <code class="bg-slate-900 px-2.5 py-1 rounded text-cyan-400 font-mono text-xs border border-cyan-500/20">{data.tool}</code></div>
      </div>
    </div>

    <!-- Image d'illustration photographique officielle et authentique -->
    {data.image && (
      <div class="mb-10 rounded-2xl overflow-hidden border border-amber-500/30 shadow-2xl bg-slate-950 group">
        <img src={imgPath} alt={data.title} class="w-full object-cover max-h-[480px] group-hover:scale-105 transition duration-700" />
        <div class="p-3 bg-slate-900/90 text-xs font-mono text-slate-400 border-t border-slate-800 flex justify-between items-center">
          <span>📷 Document Photographique Officiel — Palais Lantivy (Hôtel de Préfecture & Siège de l'État en Corse)</span>
          <span class="text-amber-400">ARCHIVE CITOYENNE SOUVERAINE</span>
        </div>
      </div>
    )}

    <!-- SIMULATEUR CITOYEN DU VOL FISCAL DES 360 COMMUNES (Spécifique Enquête 02 - En avant-première) -->
    {data.id === 2 && (
      <div class="mb-12">
        <SimulateurFiscalCommunes />
      </div>
    )}

    <!-- Corps de l'Article avec Infographies Visuelles Multi-Lignes (Zero Défilement Horizontale pour Citations) -->
    <article class="article-body font-serif text-lg leading-relaxed text-slate-200 space-y-6">
      <Content />
    </article>

    <!-- Infographie Formule Mathématique / Forensique (Placée en fin d'article pour la fluidité de lecture) -->
    {data.math && (
      <div class="mt-16 mb-8 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border border-cyan-500/40 p-6 md:p-8 rounded-2xl text-center shadow-2xl relative overflow-hidden">
        <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-cyan-500 via-amber-400 to-cyan-500"></div>
        <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-widest block mb-3">
          📊 ANNEXE FINANCIÈRE : MODÉLISATION MATHÉMATIQUE DE LA CHARGE CITOYENNE
        </span>
        <div class="text-lg md:text-xl font-mono text-amber-300 font-bold py-3 bg-slate-950/80 rounded-xl border border-slate-800 my-2 overflow-x-auto">
          {data.math}
        </div>
        <p class="text-xs text-slate-400 font-mono mt-3">Modélisation mathématique réservée à l'analyse médico-légale des coûts</p>
      </div>
    )}

    <!-- SECTION DES SOURCES ET PIÈCES D'ÉTAT CERTIFIÉES (VISUALISATEUR CITOYEN) -->
    {data.sources && data.sources.length > 0 && (
      <div class="mt-16 bg-slate-950 border border-emerald-500/30 p-6 md:p-8 rounded-2xl shadow-2xl space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <h3 class="text-lg md:text-xl font-bold font-sans text-emerald-400 flex items-center gap-2">
            <span>📚 Registres & Pièces d'État Certifiées ({data.sources.length})</span>
          </h3>
          <span class="text-[10px] font-mono bg-emerald-500/10 text-emerald-300 px-3 py-1 rounded-full border border-emerald-500/30">
            EMPREINTES SHA-256 INVIOLABLES
          </span>
        </div>

        <!-- BANDEAU D'EXPLICATION PÉDAGOGIQUE DU SYSTÈME DE PREUVES -->
        <details class="bg-slate-900/90 border border-cyan-500/40 rounded-xl p-4 cursor-pointer group">
          <summary class="font-sans font-bold text-xs text-cyan-300 flex items-center justify-between select-none">
            <span class="flex items-center gap-2">💡 <b>Comment fonctionne notre système de preuves & d'accès aux actes d'État ?</b> (Cliquez pour comprendre)</span>
            <span class="text-slate-500 group-open:rotate-180 transition transform">▼</span>
          </summary>
          <div class="mt-3 text-[11px] font-mono text-slate-300 space-y-2 leading-relaxed border-t border-slate-800 pt-3">
            <p>
              🔒 <b>Pourquoi une empreinte SHA-256 ?</b> Sur Internet, les arrêtés et délibérations d'État peuvent être modifiés ou supprimés. L'empreinte SHA-256 est la carte d'identité numérique immuable du document original. Elle constitue une preuve médico-légale scientifiquement inviolable.
            </p>
            <p>
              🏛️ <b>Comment consulter le document PDF intégral ?</b> Les actes administratifs complets appartiennent aux archives publiques. En cliquant sur <i>"Consulter la Pièce"</i>, vous obtenez la fiche certifiée et pouvez générer en 1 clic votre demande légale CADA pour recevoir la copie PDF officielle directement de la Préfecture.
            </p>
          </div>
        </details>

        <div class="grid grid-cols-1 gap-4">
          {data.sources.map((src: any, index: number) => {
            const isLocalDoc = src.pdfDirect || src.url;
            return (
              <div class="bg-slate-900/90 border border-slate-800 hover:border-emerald-500/60 p-5 rounded-2xl transition flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-lg">
                <div class="space-y-1.5">
                  <div class="text-sm font-sans font-bold text-slate-100 flex items-center gap-2">
                    <span class="text-emerald-400 font-mono font-bold">[{index + 1}]</span> 
                    <span>{src.name}</span>
                  </div>
                  <div class="text-[11px] font-mono text-slate-400 flex items-center gap-2">
                    <span class="text-emerald-300 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">DOCUMENT BRUT HÉBERGÉ</span>
                    <span>• Consultation immédiate sans intermédiaire</span>
                  </div>
                </div>
                
                <a 
                  href={isLocalDoc}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 w-full md:w-auto px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl font-mono text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider"
                >
                  <span>📥 Ouvrir la Pièce (1-Clic) →</span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- MODAL DU VISUALISATEUR DE PIÈCES D'ÉTAT ET D'ARCHIVES ULTRA-MODERNE -->
    <div id="docViewerModal" class="fixed inset-0 bg-slate-950/95 backdrop-blur-xl z-50 flex items-center justify-center p-3 sm:p-6 hidden">
      <div class="bg-slate-900 border-2 border-emerald-500/50 w-full max-w-4xl rounded-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        <!-- En-tête du Modal -->
        <div class="p-5 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border-b border-emerald-500/30 flex justify-between items-center">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-mono font-bold uppercase tracking-widest">
                🛡️ PIÈCE D'ÉTAT SCELLÉE
              </span>
              <span class="text-[10px] font-mono text-cyan-400">NORME FORENSIQUE ISO 27037</span>
            </div>
            <h4 id="modalDocTitle" class="text-base sm:text-lg font-bold text-slate-100 font-serif leading-snug"></h4>
          </div>
          <button id="closeDocModalBtn" class="text-slate-400 hover:text-white p-2 rounded-xl bg-slate-800/80 hover:bg-rose-500/80 transition cursor-pointer">
            ✕
          </button>
        </div>

        <!-- Corps du Document -->
        <div class="p-6 overflow-y-auto space-y-6 font-sans text-xs text-slate-300 leading-relaxed bg-slate-950/80">
          
          <!-- Carte d'Identité Cryptographique de la Preuve -->
          <div class="bg-slate-900/90 border border-slate-800 rounded-xl p-4 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block">📄 Intitulé Officiel :</span>
              <div id="modalDocTitleSpan" class="text-slate-200 font-bold font-serif text-sm"></div>
              <div class="pt-2">
                <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block">🏛️ Organisme Émetteur :</span>
                <span id="modalDocAuthority" class="text-cyan-300 font-mono">Administration Centrale de l'État</span>
              </div>
            </div>

            <div class="space-y-2 bg-slate-950 p-3 rounded-lg border border-slate-800/80">
              <span class="text-[10px] font-mono uppercase text-emerald-400 font-bold block">🔒 Empreinte SHA-256 (Preuve Immuable) :</span>
              <code id="modalDocSha" class="text-emerald-300 font-mono text-[11px] font-bold break-all block leading-tight"></code>
              <button id="copyDocShaBtnInside" type="button" class="mt-2 text-[10px] font-mono text-slate-400 hover:text-amber-300 flex items-center gap-1 cursor-pointer">
                📋 Copier la clé de contrôle SHA-256
              </button>
            </div>
          </div>

          <!-- Zone de Téléchargement & Consultation Directe du Fichier -->
          <div id="modalPdfDirectBox" class="bg-gradient-to-r from-emerald-950/60 to-slate-900 border border-emerald-500/60 p-5 rounded-2xl shadow-xl space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-emerald-300 font-bold font-mono text-xs flex items-center gap-2">
                ⚡ DOCUMENT PHYSIQUE DISPONIBLE AU TÉLÉCHARGEMENT IMMÉDIAT
              </span>
              <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-mono">STOCKAGE SÉCURISÉ</span>
            </div>
            <p class="text-xs text-slate-300 font-sans leading-relaxed">
              Ce document officiel original est indexé et hébergé en local pour garantir un accès citoyen permanent, sans dépendre des suppressions d'adresses ministérielles.
            </p>
            <a 
              id="modalPdfDirectLink" 
              href="#" 
              target="_blank" 
              class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl text-xs font-mono uppercase tracking-wider shadow-lg shadow-emerald-500/20 transition cursor-pointer"
            >
              📥 Ouvrir / Télécharger le Fichier Officiel Intégral →
            </a>
          </div>

          <!-- Double Accès Web (Direct + Archive Immuable) -->
          <div class="bg-slate-900/60 border border-slate-800 p-4 rounded-xl space-y-2">
            <span class="text-[10px] font-mono uppercase text-slate-400 font-bold block">🌐 Sources Web & Horodatage :</span>
            <div class="flex flex-wrap gap-2 pt-1">
              <a id="modalDirectAccessLink" href="#" target="_blank" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-mono border border-slate-700 transition flex items-center gap-1.5">
                <span>🔗 Portail Web d'Origine</span>
              </a>
              <a id="modalArchiveLink" href="#" target="_blank" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-cyan-300 rounded-lg text-xs font-mono border border-cyan-500/30 transition flex items-center gap-1.5">
                <span>📦 Miroir Wayback Machine</span>
              </a>
            </div>
          </div>

          <!-- Saisine CADA en cas d'obstruction -->
          <div class="bg-amber-950/20 border border-amber-500/30 p-4 rounded-xl space-y-2">
            <span class="text-amber-400 font-bold font-mono text-xs flex items-center gap-1.5">
              ⚖️ Droit d'Accès Matériel aux Pièces (Loi CADA / Art. L. 311-1 CRPA)
            </span>
            <p class="text-[11px] text-slate-400 font-sans leading-relaxed">
              Si l'administration venait à contester ce registre, l'article L. 311-1 du Code des Relations entre le Public et l'Administration vous donne le droit légal d'exiger la communication sous 30 jours par saisine officielle pré-rédigée.
            </p>
          </div>

        </div>

        <!-- Pied de page du Modal -->
        <div class="p-4 bg-slate-950 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-3">
          <a href="../#cada-generator" class="w-full sm:w-auto px-5 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-mono text-xs rounded-xl transition text-center shadow-lg">
            ⚖️ Générer la Saisine CADA Pré-remplie
          </a>
          <button id="closeDocModalBtn2" class="w-full sm:w-auto px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-mono text-xs rounded-xl transition border border-slate-700 cursor-pointer">
            Fermer le Visualisateur
          </button>
        </div>
      </div>
    </div>

    <script>
      // SCRIPT DE GESTION DU VISUALISATEUR DE PIÈCES D'ÉTAT
      document.addEventListener('DOMContentLoaded', () => {
        const modal = document.getElementById('docViewerModal');
        const modalTitle = document.getElementById('modalDocTitle');
        const modalTitleSpan = document.getElementById('modalDocTitleSpan');
        const modalSha = document.getElementById('modalDocSha');
        const modalUrl = document.getElementById('modalDocUrl');
        const modalDirectAccessLink = document.getElementById('modalDirectAccessLink') as HTMLAnchorElement | null;
        const modalArchiveLink = document.getElementById('modalArchiveLink') as HTMLAnchorElement | null;
        const modalPdfBox = document.getElementById('modalPdfDirectBox');
        const modalPdfLink = document.getElementById('modalPdfDirectLink') as HTMLAnchorElement | null;
        const closeBtn = document.getElementById('closeDocModalBtn');
        const closeBtn2 = document.getElementById('closeDocModalBtn2');
        const copyShaBtn = document.getElementById('copyDocShaBtn');

        const viewBtns = document.querySelectorAll('.view-doc-btn');

        viewBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const name = btn.getAttribute('data-doc-name') || '';
            const sha = btn.getAttribute('data-doc-sha') || '';
            const url = btn.getAttribute('data-doc-url') || '';
            const pdfDirect = btn.getAttribute('data-doc-pdf-direct') || '';

            if (modalTitle) modalTitle.textContent = name;
            if (modalTitleSpan) modalTitleSpan.textContent = name;
            if (modalSha) modalSha.textContent = sha;
            if (modalUrl) {
              modalUrl.textContent = url;
              modalUrl.setAttribute('href', url);
            }
            if (modalDirectAccessLink) {
              modalDirectAccessLink.setAttribute('href', url);
            }
            if (modalArchiveLink) {
              modalArchiveLink.setAttribute('href', `https://web.archive.org/web/*/${url}`);
            }

            if (pdfDirect && modalPdfBox && modalPdfLink) {
              modalPdfLink.setAttribute('href', pdfDirect);
              modalPdfBox.classList.remove('hidden');
            } else if (modalPdfBox) {
              modalPdfBox.classList.add('hidden');
            }

            if (modal) modal.classList.remove('hidden');
          });
        });

        const closeModal = () => {
          if (modal) modal.classList.add('hidden');
        };

        if (closeBtn) closeBtn.addEventListener('click', closeModal);
        if (closeBtn2) closeBtn2.addEventListener('click', closeModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }

        if (copyShaBtn) {
          copyShaBtn.addEventListener('click', () => {
            if (modalSha && modalSha.textContent) {
              navigator.clipboard.writeText(modalSha.textContent);
              copyShaBtn.textContent = "✓ Empreinte Copiée !";
              setTimeout(() => {
                copyShaBtn.textContent = "📋 Copier l'Empreinte SHA-256";
              }, 2500);
            }
          });
        }
      });
    </script>

    <!-- Bouton de retour -->
    <div class="mt-16 text-center">
      <a href="../index.html" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-base rounded-xl hover:from-amber-400 hover:to-amber-500 transition shadow-lg shadow-amber-500/20 font-sans">
        <span>← Retour à la liste des 26 enquêtes</span>
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 mt-20 text-center text-xs text-slate-500 font-mono">
    CASA DI CRISTALE 2.0 — INVESTIGATION CITOYENNE SOUVERAINE
  </footer>
</Layout>

<style is:global>
  /* --- INFOGRAPHIES ET ERGONOMIE VISUELLE DANS LES ARTICLES --- */
  
  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* INFOGRAPHIE CARTE CONSTAT D'AUDIT ET DONNÉES CLÉS (MULTI-LIGNES, ZERO DÉFILEMENT HORIZONTAL) */
  .article-body blockquote {
    position: relative;
    border-left: 5px solid #d4af37;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    padding: 1.75rem 2rem;
    margin: 2rem 0;
    font-style: normal !important;
    color: #fef08a;
    border-radius: 0 16px 16px 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.15);
    white-space: normal !important;
    word-wrap: break-word !important;
    overflow-x: visible !important;
    max-width: 100% !important;
  }

  .article-body blockquote::before {
    content: "💡 CONSTAT D'AUDIT ET DONNÉES CLÉS";
    display: block;
    font-family: 'Inter', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #d4af37;
    margin-bottom: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body blockquote p {
    color: #fef08a !important;
    font-size: 1.05rem;
    line-height: 1.8 !important;
    margin-bottom: 0.5rem !important;
    white-space: normal !important;
    word-break: normal !important;
  }

  /* INFOGRAPHIE TABLEAUX DE DONNÉES ET PROTOCOLE DE RECOURS CRPA */
  .article-body table {
    width: 100% !important;
    margin: 2.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    background-color: #0f172a;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.6);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    white-space: normal !important;
  }

  .article-body th {
    background-color: #1e293b;
    color: #d4af37;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 2px solid rgba(212, 175, 55, 0.4);
    white-space: normal !important;
  }

  .article-body td {
    padding: 1rem 1.25rem;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(51, 65, 85, 0.6);
    transition: background-color 0.2s ease;
    white-space: normal !important;
    word-break: normal !important;
  }

  .article-body tr:last-child td {
    border-bottom: none;
  }

  .article-body tr:hover td {
    background-color: rgba(30, 41, 59, 0.8);
    color: #ffffff;
  }

  .article-body ul, .article-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    white-space: normal !important;
  }

  .article-body li {
    color: #cbd5e1;
    margin-bottom: 0.6rem;
    line-height: 1.7;
    white-space: normal !important;
  }

  .article-body strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: normal !important;
  }

  .article-body hr {
    border-color: #334155;
    margin: 2.5rem 0;
  }
</style>
