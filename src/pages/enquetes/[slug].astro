---
import SoutienCitoyen from '../../components/SoutienCitoyen.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SimulateurFiscalCommunes from '../../components/SimulateurFiscalCommunes.astro';
import CarteEnergieCorse from '../../components/CarteEnergieCorse.astro';
import SimulateurRacketCarburant from '../../components/SimulateurRacketCarburant.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AudioBriefing from '../../components/AudioBriefing.astro';
import InvestigationHeader from '../../components/InvestigationHeader.astro';
import PiecesJustificativesSection from '../../components/PiecesJustificativesSection.astro';
import DebatCitoyenGiscus from '../../components/DebatCitoyenGiscus.astro';

export async function getStaticPaths() {
  const enquetes = await getCollection('enquetes');
  // SANCTUARISATION STRICTE : Uniquement les 7 enquêtes officiellement finalisées
  const allowedIds = [2, 27, 7, 23, 28, 26, 4, 18, 11, 22];
  return enquetes.filter((entry) => allowedIds.includes(entry.data.id)).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'enquetes'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const imgPath = data.image.startsWith('http') ? data.image : `../../${data.image.replace(/^\//, '')}`;
const ogImage = data.image.startsWith('http') ? data.image : `/${data.image.replace(/^\//, '')}`;

// Correspondance automatique avec la version anglaise (par slug identique ou par ID d'enquête)
const investigations = await getCollection('investigations');
const enMatch = investigations.find((inv) => inv.slug === entry.slug || inv.data.id === data.id);
const enSlug = enMatch ? enMatch.slug : entry.slug;
---

<Layout 
  title={`${data.title} — L'OCHJU — L'aveti ?`} 
  description={data.chapeau}
  image={ogImage}
  canonicalUrl={`https://fsucieta.github.io/enquetes/${entry.slug}/`}
  lang="fr"
  category={data.category}
  refCode={data.ref}
  sources={data.sources}
>
  <!-- Navigation Supérieure avec Logo Intact & Sélecteur 8 Langues -->
  <InvestigationHeader currentLang="fr" slug={entry.slug} refCode={data.ref} id={data.id} />

  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-12 py-8 sm:py-12 box-border overflow-hidden">
    <!-- En-tête Dossier de Haute Rigueur Forensique -->
    <header class="space-y-8 mb-12">
      <div class="flex flex-wrap items-center gap-3 font-mono-tech text-xs">
        <span class="px-3 py-1 rounded-full bg-amber-500 text-black font-black uppercase tracking-wider text-[10px]">
          ACTE OPPOSABLE SCELLÉ
        </span>
        <span class="theme-gold-text font-bold">[{data.ref || `DOSSIER-${data.id}`}]</span>
        <span class="text-slate-400 uppercase tracking-widest">• {data.category}</span>
        {data.status === 'cloturee' && (
          <span class="px-3 py-0.5 bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded-full text-[10px] font-mono-tech font-bold flex items-center gap-1.5 ml-auto">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>INSTRUCTION CONTRADICTOIRE CLÔTURÉE</span>
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-press font-black text-white leading-[1.1] tracking-tight">
        {data.title}
      </h1>

      {data.subtitle && (
        <h2 class="text-xl md:text-2xl font-press font-bold theme-gold-text leading-snug">
          {data.subtitle}
        </h2>
      )}

      <p class="text-xl sm:text-2xl font-press text-slate-200 leading-relaxed border-l-4 border-amber-500 pl-6 py-1 bg-black/30 rounded-r-2xl font-normal">
        {data.chapeau}
      </p>

      <!-- Cartouche de Métadonnées ISO/IEC 27037 en Verre Fumé 3D -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-2xl bg-black/60 border border-white/10 font-mono-tech text-xs text-slate-400 shadow-xl">
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">CELLULE D'INSTRUCTION</div>
          <div class="text-slate-200 font-bold truncate mt-0.5">{data.author}</div>
        </div>
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">DATE DE SCELLEMENT</div>
          <div class="text-slate-200 font-bold mt-0.5">{data.date}</div>
        </div>
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">OUTILS OPEN DATA</div>
          <div class="text-slate-200 font-bold truncate mt-0.5">{data.tool}</div>
        </div>
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">NORME FORENSIQUE</div>
          <div class="text-emerald-400 font-bold mt-0.5">ISO/IEC 27037</div>
        </div>
      </div>

      <!-- Barre d'Action Citoyenne & Diffusion -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2 border-t border-white/10">
        <div class="flex items-center gap-3 font-mono-tech text-xs">
          <span class="text-amber-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
            <span>📢</span> Diffuser :
          </span>
          <ShareButtons title={data.title} chapeau={data.chapeau} />
        </div>
        <button 
          onclick="window.print()" 
          class="no-print inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/30 text-xs font-mono-tech font-bold transition shadow-sm cursor-pointer"
          title="Imprimer cette enquête en format tract citoyen A4 haute fidélité"
        >
          <span>🖨️</span>
          <span>Fiche Citoyenne A4</span>
        </button>
      </div>
    </header>

    <!-- Image d'illustration photographique officielle et authentique -->
    {data.image && (
      <div class="mb-8 rounded-2xl overflow-hidden border border-amber-500/30 shadow-2xl bg-slate-950 group">
        <img src={imgPath} alt={data.title} class="w-full object-cover max-h-[480px] group-hover:scale-105 transition duration-700" />
        <div class="p-3 bg-slate-900/90 text-xs font-mono text-slate-400 border-t border-slate-800 flex justify-between items-center">
          <span>{data.imageCaption || `📷 Document Photographique Officiel — ${data.title}`}</span>
          <span class="text-amber-400">ARCHIVE CITOYENNE SOUVERAINE</span>
        </div>
      </div>
    )}

    <!-- Corps de l'Article avec Infographies Visuelles Multi-Lignes (Zero Défilement Horizontale pour Citations) -->
    <!-- 🎙️ Mini-Lecteur Audio Forensique (s'affiche uniquement si audioBriefingFr ou audioBriefingEn est renseigné) -->
    <AudioBriefing srcFr={data.audioBriefingFr} srcEn={data.audioBriefingEn} lang="fr" />

    <article class="article-body font-press text-xl leading-relaxed text-slate-200 space-y-8">
      <Content />
    </article>

    <!-- SIMULATEUR CITOYEN DU VOL FISCAL DES 360 COMMUNES (Spécifique Enquête 02 - Outil d'Action Citoyenne) -->
    {data.id === 2 && (
      <div class="my-16">
        <SimulateurFiscalCommunes />
      </div>
    )}

    <!-- CARTE INTERACTIVE DU MONOPOLE ÉNERGÉTIQUE (Spécifique Enquête 18) -->
    {data.id === 18 && (
      <div class="my-16">
        <CarteEnergieCorse lang="fr" />
      </div>
    )}

    <!-- SIMULATEUR CITOYEN DU RACKET À LA POMPE (Spécifique Enquête 26 - Outil d'Action Citoyenne) -->
    {(data.id === 26 || data.id === '26' || entry.slug.includes('26')) && (
      <div class="my-16">
        <SimulateurRacketCarburant />
      </div>
    )}


    <!-- SECTION FORENSIQUE DES SOURCES ET PIÈCES D'ÉTAT (ISO/IEC 27037) -->
    <PiecesJustificativesSection 
      sources={data.sources} 
      id={data.id} 
      refCode={data.ref} 
      date={data.date} 
      lang="fr" 
    />

    <!-- ESPACE DE DÉBAT CITOYEN & LIKES SOUVERAINS (GISCUS / GITHUB DISCUSSIONS) -->
    <DebatCitoyenGiscus lang="fr" mapping="pathname" />

    <!-- BLOC DE DIFFUSION CITOYENNE EN FIN D'ENQUÊTE -->
    <div class="no-print my-12 p-6 sm:p-8 rounded-2xl bg-slate-900/90 border border-amber-500/30 text-center space-y-4 shadow-xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 font-mono text-xs uppercase tracking-widest">
        <span>📢</span> DIFFUSION POPULAIRE
      </div>
      <h3 class="text-xl sm:text-2xl font-serif font-bold text-slate-100">
        Le Savoir partagé est notre contre-pouvoir
      </h3>
      <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto leading-relaxed">
        Cette enquête est une arme citoyenne. Diffusez-la dans vos cercles, vos groupes de village et vos réseaux pour briser le silence.
      </p>
      <div class="pt-2 flex justify-center">
        <ShareButtons title={data.title} chapeau={data.chapeau} variant="card" />
      </div>
    </div>

    <!-- CARTOUCHE DE SOUTIEN CITOYEN DISCRET ET NOBLE -->
    <div class="no-print my-10 p-6 rounded-2xl bg-slate-950 border border-slate-800/80 text-center max-w-xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-slate-900 text-slate-400 font-mono text-[10px] uppercase tracking-wider border border-slate-800">
        <span>🛡️</span> INDÉPENDANCE TOTALE • 0 € DE SUBVENTION PUBLIQUE
      </div>
      <p class="text-xs text-slate-400 leading-relaxed font-sans">
        L'OCHJU ne dépend d'aucun parti, d'aucun groupe de presse et d'aucun intérêt privé. Nos investigations vivent exclusivement du relais et de la solidarité citoyenne.
      </p>
      <div class="pt-1">
        <button 
          type="button" 
          class="open-soutien-modal-btn inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 hover:text-amber-200 border border-amber-400/40 text-xs font-mono font-bold transition shadow-sm cursor-pointer"
        >
          <span>🤝</span> <span>Consulter la Charte de Soutien Citoyen</span>
        </button>
      </div>
    </div>

    <!-- Bouton de retour -->
    <div class="no-print mt-16 text-center">
      <a href="../../" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-base rounded-xl hover:from-amber-400 hover:to-amber-500 transition shadow-lg shadow-amber-500/20 font-sans">
        <span>← Retour à la liste des 29 enquêtes</span>
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 mt-20 text-center text-xs text-slate-500 font-mono">
    L'OCHJU — INVESTIGATION CITOYENNE SOUVERAINE & OPEN DATA
  </footer>
</Layout>

<style is:global>
  /* --- INFOGRAPHIES ET ERGONOMIE VISUELLE DANS LES ARTICLES --- */
  
  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: block;
    line-height: 1.35;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* INFOGRAPHIE CARTE CONSTAT D'AUDIT ET DONNÉES CLÉS (MULTI-LIGNES, ZERO DÉFILEMENT HORIZONTAL) */
  .article-body blockquote {
    position: relative;
    border-left: 5px solid #d4af37;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    padding: 1.75rem 2rem;
    margin: 2rem 0;
    font-style: normal !important;
    color: #fef08a;
    border-radius: 0 16px 16px 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.15);
    white-space: normal !important;
    word-wrap: break-word !important;
    overflow-x: visible !important;
    max-width: 100% !important;
  }

  .article-body blockquote::before {
    content: "💡 CONSTAT D'AUDIT ET DONNÉES CLÉS";
    display: block;
    font-family: 'Inter', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #d4af37;
    margin-bottom: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body blockquote p {
    color: #fef08a !important;
    font-size: 1.05rem;
    line-height: 1.8 !important;
    margin-bottom: 0.5rem !important;
    white-space: normal !important;
    word-break: normal !important;
  }

  /* INFOGRAPHIE TABLEAUX DE DONNÉES ET PROTOCOLE DE RECOURS CRPA */
  .article-body table {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    margin: 2.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    background-color: #0f172a;
    border-radius: 14px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.6);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    white-space: normal !important;
  }

  .article-body th {
    background-color: #1e293b;
    color: #d4af37;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 2px solid rgba(212, 175, 55, 0.4);
    white-space: normal !important;
  }

  .article-body td {
    padding: 1rem 1.25rem;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(51, 65, 85, 0.6);
    transition: background-color 0.2s ease;
    white-space: normal !important;
    word-break: normal !important;
  }

  .article-body tr:last-child td {
    border-bottom: none;
  }

  .article-body tr:hover td {
    background-color: rgba(30, 41, 59, 0.8);
    color: #ffffff;
  }

  .article-body ul, .article-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    white-space: normal !important;
  }

  .article-body li {
    color: #cbd5e1;
    margin-bottom: 0.6rem;
    line-height: 1.7;
    white-space: normal !important;
  }

  .article-body strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: normal !important;
  }

  .article-body hr {
    border-color: #334155;
    margin: 2.5rem 0;
  }

    /* --- BLINDAGE MOBILE & SOUVERAINETÉ RESPONSIVE --- */
    .article-body {
      overflow-wrap: break-word !important;
      word-break: break-word !important;
      word-wrap: break-word !important;
      max-width: 100% !important;
      overflow-x: hidden !important;
    }

    .article-body table {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch !important;
      border-collapse: collapse !important;
      margin: 1.5rem 0 !important;
    }

    .article-body pre {
      max-width: 100% !important;
      overflow-x: auto !important;
      white-space: pre-wrap !important;
      word-break: break-all !important;
    }

    .article-body a {
      overflow-wrap: break-word !important;
      word-break: break-all !important;
    }
</style>
