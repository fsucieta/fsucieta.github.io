---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';
import { marked } from 'marked';
import crypto from 'node:crypto';

export async function getStaticPaths() {
  const baseDir = path.resolve('public/docs/pieces-enquete-02');
  const results: { params: { piece: string } } = [];

  if (fs.existsSync(baseDir)) {
    const files = fs.readdirSync(baseDir);
    for (const f of files) {
      if (f.endsWith('.md')) {
        const pieceSlug = f.replace(/\.md$/, '');
        results.push({
          params: { piece: pieceSlug },
        });
      }
    }
  }

  return results;
}

const { piece } = Astro.params;
const rawMdPath = path.resolve(`public/docs/pieces-enquete-02/${piece}.md`);
let mdContent = '';
let renderedHtml = '';
let errorMsg = '';

if (fs.existsSync(rawMdPath)) {
  mdContent = fs.readFileSync(rawMdPath, 'utf-8');
  renderedHtml = await marked.parse(mdContent);
} else {
  errorMsg = "Pièce administrative introuvable au greffe citoyen.";
}

let sha256Hash = '';
if (mdContent) {
  sha256Hash = crypto.createHash('sha256').update(mdContent, 'utf8').digest('hex');
}

const downloadUrl = `/docs/pieces-enquete-02/${piece}.md`;
const cleanTitle = piece ? piece.replace(/^PIECE_\d+_/i, '').replace(/_/g, ' ') : 'Pièce Justificative Officielle';
---

<Layout
  title={`${cleanTitle} — Pièce Officielle Certifiée L'OCHJU`}
  description={`Consultation intégrale et opposable de la pièce d'État : ${cleanTitle}`}
  image="/logo_l_ochju.jpg"
  canonicalUrl={`https://fsucieta.github.io/pieces-enquete-02/${piece}/`}
  lang="fr"
>
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-3 px-6 shadow-2xl">
    <div class="max-w-5xl mx-auto flex items-center justify-between gap-4">
      <a href="/enquetes/02-le-mythe-des-subventions/" class="flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-amber-400 transition font-bold">
        <span>←</span> <span>Retour à l'Enquête 02</span>
      </a>

      <a href="/" class="flex items-center gap-3">
        <img 
          src="/logo_l_ochju.jpg" 
          alt="L'OCHJU" 
          class="h-9 w-auto object-contain rounded border border-amber-500/50 shadow"
        />
        <div class="hidden sm:block text-left">
          <span class="text-xs font-serif font-black tracking-widest text-slate-100 block">L'OCHJU</span>
          <span class="text-[9px] font-mono text-emerald-400 block uppercase">Greffe & Pièces à Conviction</span>
        </div>
      </a>

      <div class="flex items-center gap-2">
        <button 
          onclick="window.print()" 
          class="text-xs font-mono bg-slate-900 hover:bg-slate-800 text-slate-200 px-3 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5 cursor-pointer"
          title="Imprimer cette pièce officielle"
        >
          <span>🖨️</span> <span class="hidden sm:inline">Imprimer</span>
        </button>
        <a 
          href={downloadUrl} 
          download={`${piece}.md`}
          class="text-xs font-mono bg-emerald-500 hover:bg-emerald-400 text-slate-950 px-3 py-1.5 rounded-lg font-black transition flex items-center gap-1.5 shadow"
        >
          <span>📥</span> <span>Télécharger (.MD)</span>
        </a>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-10 text-slate-200 space-y-8">
    
    <!-- BANDEAU SCELLÉ D'AUTORITÉ -->
    <div class="p-5 rounded-2xl bg-slate-900/90 border border-emerald-500/40 shadow-2xl flex flex-wrap items-center justify-between gap-4">
      <div class="space-y-1">
        <div class="flex items-center gap-2.5">
          <span class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 uppercase">
            ⚖️ PIÈCE OFFICIELLE VERSÉE AU DOSSIER
          </span>
          <span class="text-xs font-mono text-slate-400">Dossier : <strong>LOCHJU-ENQUETE-02-PIECES</strong></span>
        </div>
        <h1 class="text-xl sm:text-2xl font-serif font-black text-white m-0 pt-1">
          {cleanTitle}
        </h1>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-emerald-400">
        <span>🔒 Norme ISO/IEC 27037 Scellée</span>
      </div>
    </div>

    <!-- CERTIFICAT DE SCELLÉ CRYPTOGRAPHIQUE -->
    <div class="p-4 rounded-xl bg-black/60 border border-slate-800 font-mono text-xs text-slate-400 space-y-1">
      <div class="flex items-center justify-between">
        <span class="text-slate-500 uppercase font-bold text-[10px]">Empreinte Forensique SHA-256 Intègre :</span>
        <span class="text-emerald-400 text-[10px]">Certifié conforme au bit près</span>
      </div>
      <code class="text-amber-300 select-all block text-[11px] break-all bg-black/80 p-2.5 rounded border border-white/5">
        {sha256Hash}
      </code>
      <div class="text-[10px] text-slate-500 pt-1">
        Document communicable de plein droit (Loi CADA / Art. L. 311-1 CRPA). Preuve médico-légale opposable devant les juridictions.
      </div>
    </div>

    {errorMsg ? (
      <div class="p-6 rounded-2xl bg-red-950/50 border border-red-500 text-red-200 font-mono text-sm">
        {errorMsg}
      </div>
    ) : (
      <article class="prose prose-invert max-w-none bg-slate-950/90 border border-slate-800 p-6 sm:p-10 rounded-2xl shadow-2xl leading-relaxed text-slate-200 space-y-6 piece-content">
        <div set:html={renderedHtml} />
      </article>
    )}

    <!-- RAPPEL DOCTRINAL DE SOUVERAINETÉ POPULAIRE -->
    <div class="p-5 rounded-2xl bg-amber-950/20 border border-amber-500/30 text-amber-200 text-xs sm:text-sm leading-relaxed space-y-2">
      <p class="font-bold text-amber-300">
        🏛️ Doctrine de Souveraineté Populaire de L'OCHJU :
      </p>
      <p class="text-slate-300 text-xs">
        L'OCHJU ne transmet aucun document aux parquets de l'État central pour son propre compte. La cellule rassemble les actes juridiques authentiques, calcule les ratios médico-légaux et les remet au peuple : ce sont les citoyens, les contribuables, les élus et les collectifs qui font valoir souverainement leurs droits.
      </p>
    </div>

    <footer class="pt-8 border-t border-slate-800 text-center font-mono text-xs text-slate-500">
      L'OCHJU — CELLULE D'INVESTIGATION CITOYENNE SOUVERAINE
    </footer>

  </main>
</Layout>

<style is:global>
  .piece-content h1 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    border-bottom: 2px solid #10b981;
    padding-bottom: 0.5rem;
    margin-top: 1rem;
    margin-bottom: 1.25rem;
  }
  .piece-content h2, .piece-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  .piece-content p, .piece-content ul, .piece-content ol {
    color: #e2e8f0;
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }
  .piece-content blockquote {
    border-left: 3px solid #10b981;
    background: rgba(16, 185, 129, 0.08);
    padding: 1rem 1.25rem;
    border-radius: 0 0.75rem 0.75rem 0;
    color: #f1f5f9;
    font-style: italic;
    margin: 1.5rem 0;
  }
  .piece-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.85rem;
  }
  .piece-content th, .piece-content td {
    padding: 0.6rem 0.8rem;
    border: 1px solid #334155;
  }
  .piece-content th {
    background: #0f172a;
    color: #38bdf8;
    font-family: 'JetBrains Mono', monospace;
  }
  .piece-content tr:nth-child(even) {
    background: rgba(15, 23, 42, 0.5);
  }
  .piece-content code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    color: #fbbf24;
    background: rgba(0, 0, 0, 0.5);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
</style>
