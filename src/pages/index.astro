  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 text-center text-xs text-slate-500 font-mono mt-16" role="contentinfo">
    L'OCHJU — MÉDIA CITOYEN D'INVESTIGATION FORENSIQUE & OPEN DATA | LES GRANDES ENQUÊTES SCELLÉES POUR LA TRANSPARENCE ET LA SOUVERAINETÉ
  </footer>

  <!-- Script de Recherche Temps Réel (Recherche sur l'Ensemble des Dossiers) -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
      const allCards = document.querySelectorAll<HTMLElement>('.fiche-card');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const term = (e.target as HTMLInputElement).value.toLowerCase().trim();

          allCards.forEach((card) => {
            const title = card.getAttribute('data-title') || '';
            const category = card.getAttribute('data-category') || '';
            const chapeau = card.getAttribute('data-chapeau') || '';

            if (!term || title.includes(term) || category.includes(term) || chapeau.includes(term)) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      }
    });
  </script>

  <!-- MODAL GLOBAL DE PARTAGE D'ENQUÊTE -->
  <div id="cardShareModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden" onclick="if(event.target === this) closeShareModal();">
    <div class="bg-slate-900 border border-amber-500/40 w-full max-w-md rounded-2xl shadow-2xl overflow-hidden p-6 space-y-5">
      <div class="flex justify-between items-start">
        <div class="space-y-1">
          <span class="text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">📤 Mobilisation Citoyenne</span>
          <h3 id="modalShareTitle" class="text-base font-bold font-serif text-slate-100 leading-snug"></h3>
        </div>
        <button onclick="closeShareModal()" class="text-slate-400 hover:text-white p-1.5 rounded-lg bg-slate-800 hover:bg-rose-500/80 transition cursor-pointer text-sm">✕</button>
      </div>

      <p class="text-xs text-slate-400 font-sans">Diffusez cette enquête sur vos réseaux pour briser l'omerta et informer les citoyens :</p>

      <div class="grid grid-cols-3 gap-2.5">
        <a id="shareXLink" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-950 hover:bg-black text-slate-200 hover:text-white border border-slate-800 hover:border-slate-700 text-xs font-mono font-medium transition shadow-sm">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg> <span>X</span>
        </a>
        <a id="shareFbLink" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-950 hover:bg-[#1877F2] text-slate-200 hover:text-white border border-slate-800 hover:border-[#1877F2] text-xs font-mono font-medium transition shadow-sm">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg> <span>Facebook</span>
        </a>
        <a id="shareWaLink" href="#" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-950 hover:bg-[#25D366] text-slate-200 hover:text-white border border-slate-800 hover:border-[#25D366] text-xs font-mono font-medium transition shadow-sm">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.669-.699c.969.54 1.77.828 2.791.828 3.18 0 5.767-2.587 5.767-5.766.001-3.18-2.585-5.766-5.767-5.766zm0 10.518c-.896 0-1.636-.263-2.378-.716l-.17-.104-1.764.463.471-1.721-.115-.183c-.496-.788-.758-1.552-.757-2.49 0-2.618 2.13-4.748 4.748-4.748 2.618 0 4.748 2.13 4.748 4.748 0 2.617-2.13 4.747-4.748 4.747z"/></svg> <span>WhatsApp</span>
        </a>
      </div>

      <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
        <span class="text-[11px] font-mono text-slate-400">Lien direct :</span>
        <button id="shareCopyModalBtn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500 text-amber-300 hover:text-slate-950 border border-amber-500/30 text-xs font-mono font-bold transition cursor-pointer">
          <span id="shareCopyModalIcon">🔗</span> <span id="shareCopyModalLabel">Copier le lien</span>
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    let activeShareUrl = '';

    function openShareModal(button) {
      const title = button.getAttribute('data-share-title') || '';
      const rawUrl = button.getAttribute('data-share-url') || '';
      const chapeau = button.getAttribute('data-share-chapeau') || '';
      
      const fullUrl = rawUrl.startsWith('http') ? rawUrl : (window.location.origin + '/' + rawUrl.replace(/^\.\//, '').replace(/^\//, ''));
      activeShareUrl = fullUrl;

      document.getElementById('modalShareTitle').textContent = title;

      const tweetText = `🔴 Enquête L'OCHJU : ${title}\n\n${chapeau ? chapeau.slice(0, 140) + '...' : ''}\n\nÀ lire ici :`;
      document.getElementById('shareXLink').href = `https://twitter.com/intent/tweet?text=${encodeURIComponent(tweetText)}&url=${encodeURIComponent(fullUrl)}`;

      document.getElementById('shareFbLink').href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(fullUrl)}`;

      const waText = `🔴 *Enquête L'OCHJU : ${title}*\n\n${chapeau ? chapeau + '\n\n' : ''}👉 ${fullUrl}`;
      document.getElementById('shareWaLink').href = `https://api.whatsapp.com/send?text=${encodeURIComponent(waText)}`;



      document.getElementById('cardShareModal').classList.remove('hidden');
    }

    function closeShareModal() {
      document.getElementById('cardShareModal').classList.add('hidden');
    }

    document.addEventListener('DOMContentLoaded', () => {
      const copyBtn = document.getElementById('shareCopyModalBtn');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          if (!activeShareUrl) return;
          navigator.clipboard.writeText(activeShareUrl).then(() => {
            const label = document.getElementById('shareCopyModalLabel');
            const icon = document.getElementById('shareCopyModalIcon');
            if (label && icon) {
              label.textContent = 'Copié !';
              icon.textContent = '✅';
              setTimeout(() => {
                label.textContent = 'Copier le lien';
                icon.textContent = '🔗';
              }, 2500);
            }
          });
        });
      }
    });
  </script>
</Layout>
