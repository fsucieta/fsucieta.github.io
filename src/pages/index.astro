---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import MatriceImpact from '../components/MatriceImpact.astro';
import GisMap from '../components/GisMap.astro';
import CadaGenerator from '../components/CadaGenerator.astro';
import WhistleblowerVault from '../components/WhistleblowerVault.astro';
import FoncierDvfRadar from '../components/FoncierDvfRadar.astro';

const allEnquetes = await getCollection('enquetes');
// Trier par ID (1 à 26)
const enquetes = allEnquetes.sort((a, b) => a.data.id - b.data.id);
const uneEnquete = enquetes[0]; // Dossier majeur à la Une (#01)
---

<Layout title="L'OCHJU — Média Citoyen d'Investigation & Open Data (L'aveti ?)">
  <!-- En-tête / Header Éditorial L'OCHJU Centré & Épuré -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Gauche : Mention Discrète d'Ancrage -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <!-- Centre : Logo Officiel Géant Centré Majestueux -->
      <a href="./" class="group flex justify-center">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-r from-amber-500/40 via-amber-300/30 to-amber-500/40 rounded-2xl blur-md opacity-40 group-hover:opacity-100 transition duration-500"></div>
          <img 
            src="./logo_l_ochju.jpg" 
            alt="L'OCHJU — Média Citoyen (L'aveti ?)" 
            class="relative h-20 md:h-28 w-auto object-contain rounded-xl border-2 border-amber-500/60 group-hover:border-amber-400 transition duration-300 shadow-2xl shadow-amber-500/40"
          />
        </div>
      </a>

      <!-- Droite : Switcher Jour / Nuit (Forensic) -->
      <div class="w-48 flex justify-end">
        <ThemeToggle />
      </div>

    </div>
  </header>

  <!-- Navigation Rapide Sticky (Confort Ergonomique Mobile & Desktop) -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[108px] z-40 py-2.5 px-6 shadow-md overflow-x-auto">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-3 text-xs font-mono whitespace-nowrap">
      <a href="#manifeste-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🙏 Le Manifeste</span>
      </a>
      <a href="#fiches-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>📂 26 Enquêtes</span>
      </a>
      <a href="#gis-map-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🗺️ Carte 360 Communes</span>
      </a>
      <a href="#foncier-dvf-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🤝 Radar DVF</span>
      </a>
      <a href="#cada-generator" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ Droit de Savoir (CADA)</span>
      </a>
      <a href="#whistleblower-vault" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🔒 Coffre-Fort PGP</span>
      </a>
    </div>
  </nav>

  <!-- ================= SECTION MANIFESTE INTEGRAL ("LA PRIERE DE L'OCHJU") ================= -->
  <section class="max-w-7xl mx-auto px-6 pt-8 pb-4" id="manifeste-section">
    <div class="hero-card-container border border-amber-500/40 rounded-2xl p-6 md:p-10 shadow-2xl relative overflow-hidden bg-slate-900">
      
      <!-- CITATION HISTORIQUE DE PASQUALE PAOLI EN FRANÇAIS (AU-DESSUS DU TITRE) -->
      <div class="bg-amber-500/5 border border-amber-500/30 rounded-xl p-6 mb-8 text-center">
        <p class="font-serif italic text-slate-100 text-base md:text-lg leading-relaxed">
          « La Justice, la vertu et l'amour de la Patrie doivent être les seuls moteurs de nos actions. Le Peuple Corse, ayant recouvré sa liberté, entend donner une forme durable à son gouvernement en fondant sa Constitution sur la raison et la vérité. »
        </p>
        <span class="font-mono text-xs text-amber-400 uppercase tracking-widest mt-3 block">
          — Pasquale Paoli, Préambule de la Constitution de la Corse (18 Novembre 1755)
        </span>
      </div>

      <div class="text-center border-b border-slate-800 pb-6 mb-8">
        <h1 class="text-3xl md:text-5xl font-black font-serif text-slate-100 mb-3">🙏 LA PRIÈRE DE L'OCHJU</h1>
        <p class="font-serif italic text-amber-400 text-base md:text-lg">Au-delà des 200 000 vues : la parole qui dissipe l'opacité et délivre le peuple par le Savoir.</p>
      </div>

      <div class="font-serif text-lg text-slate-100 border-l-4 border-rose-600 pl-6 mb-8 leading-relaxed">
        👁️ Vous croyez qu'il ne s'agit que d'articles. Vous pensez qu'il ne s'agit que de chiffres alignés sur un écran.
        <br/><br/>
        200 000 fois. En quelques jours, l'écran s'est éclairé deux cent mille fois. Ce n'est pas un simple succès d'audience : c'est un dysfonctionnement majeur dans leur système. C'est la preuve que sous le vernis du silence et de la résignation, vous n'attendiez tous qu'une seule chose : l'étincelle de la vérité.
      </div>

      <div class="font-serif text-base text-slate-300 space-y-4 mb-8 leading-relaxed">
        <p>Pendant des décennies, ils ont régné sur un empire d'opacité. Ils ont misé sur votre fatigue. Ils ont compté sur une arme silencieuse, mais terrifiante : l'ignorance. Ils vous ont dit que les dossiers étaient "trop complexes", que le foncier était "un casse-tête juridique", que l'eau, les transports ou l'énergie échappaient à votre contrôle. <strong class="text-slate-100">Ils vous ont menti.</strong></p>
      </div>

      <h2 class="font-mono text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 mb-4">⚡ BIENVENUE DANS L'INFORMATION 2.0 (INTELLIGENCE & DONNÉES BRUTES)</h2>
      <div class="font-serif text-base text-slate-300 space-y-4 mb-8 leading-relaxed">
        <p>L'OCHJU n'est pas un média classique. L'OCHJU n'est pas une tribune d'opinion. L'OCHJU est une rupture forensique dans leur système.</p>
        <p>Nous combinons la rigueur absolue de l'ingénierie de données — extraction d'actes officiels bruts, analyse cadastrale avec notre partenaire de veille foncière <strong class="text-amber-400 font-sans">Bufitonu.fr</strong>, décryptage des bilans financiers et des flux d'argent — avec la seule force qu'ils ne pourront jamais pirater : la vérité du terrain et l'éveil d'un peuple.</p>
        <p>À partir d'aujourd'hui, le mot "ignorer" est effacé de notre vocabulaire. Ni les décideurs dans leurs bureaux dorés, ni les notables du silence ne pourront plus jamais prononcer cette phrase : <em class="italic text-slate-100">"Nous ne savions pas."</em></p>
        <p>Parce que désormais, VOUS savez. Et le Savoir partagé n'est pas une simple information : c'est l'arme ultime de votre réappropriation. C'est l'acte de naissance de notre souveraineté citoyenne.</p>
      </div>

      <h2 class="font-mono text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 mb-4">🏛️ LES QUATRE PILIERS INATTAQUABLES</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5">
          <h4 class="font-mono text-xs font-bold text-rose-500 uppercase mb-2">I. L'ÉPREUVE DU FAIT</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">Pas de rumeurs. Pas de bavardages. Chaque fait révélé est adossé à des pièces officielles consultables et vérifiables au bit près.</p>
        </div>
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5">
          <h4 class="font-mono text-xs font-bold text-rose-500 uppercase mb-2">II. LA DOUBLE ÉTAGÈRE</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">Le concept financier ou juridique le plus complexe rendu limpide pour chaque foyer. Comprendre, c'est désarmer le pouvoir.</p>
        </div>
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5">
          <h4 class="font-mono text-xs font-bold text-rose-500 uppercase mb-2">III. LA RIPOSTE ET LA SOLUTION</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">L'indignation est stérile sans l'action. À chaque dysfonctionnement mis à nu, nous apportons la feuille de route et l'alternative de gouvernance.</p>
        </div>
        <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-5">
          <h4 class="font-mono text-xs font-bold text-rose-500 uppercase mb-2">IV. L'INDÉPENDANCE SANS CONCESSION</h4>
          <p class="text-xs text-slate-400 leading-relaxed font-sans">Ni maîtres, ni actionnaires, ni agendas politiques. Ce média n'a d'exigences qu'envers ses lecteurs et son unique cause est la défense de la terre corse et la survie de son PEUPLE.</p>
        </div>
      </div>

      <h2 class="font-mono text-sm font-bold text-amber-400 uppercase tracking-wider border-b border-slate-800 pb-2 mb-2">📂 27 DOSSIERS. 27 SERRURES À CROCHETER.</h2>
      <p class="text-xs text-slate-400 italic mb-6"><em>(Veille cadastrale & foncière menée en partenariat avec Bufitonu.fr)</em></p>

      <div class="space-y-2 font-sans mb-8">
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">01</span><span class="text-slate-100 font-semibold">Le Grand Verrou Financier</span> — <span class="text-slate-400">Prêts In Fine, non-résidents et accès au crédit pour les locaux.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">02</span><span class="text-slate-100 font-semibold">Le Mythe des Subventions</span> — <span class="text-slate-400">Balance fiscale réelle et vérité sur les transferts financiers Bercy/Corse.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">03</span><span class="text-slate-100 font-semibold">Outre-Mer & Europe</span> — <span class="text-slate-400">Jurisprudences constitutionnelles et européennes sur le statut de résident.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-emerald-500/30 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-emerald-400 font-bold mr-2">04</span><span class="text-slate-100 font-semibold">La Marchandisation de l'Eau</span> — <span class="text-slate-400">Abondance naturelle vs 50 % de fuites réseau, gouvernance des délégataires privés et coût par foyer.</span></div>
          <span class="px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-mono text-[10px]">🟢 DOSSIER CLÔTURÉ</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">05</span><span class="text-slate-100 font-semibold">L'Empire des SCI Non-Résidentes</span> — <span class="text-slate-400">Registres des bénéficiaires effectifs (RBE), suivi cadastre (Bufitonu.fr) et mitage du patrimoine.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">06</span><span class="text-slate-100 font-semibold">Le Pillage des Quotas de Pêche</span> — <span class="text-slate-400">Thon rouge, chalutiers industriels et exclusion des pêcheurs artisanaux.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">07</span><span class="text-slate-100 font-semibold">Le Cadastre Minier Secret</span> — <span class="text-slate-400">Terres rares, antimoine, passif toxique et inventaire BRGM.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">08</span><span class="text-slate-100 font-semibold">Le Pillage de la Forêt Corse</span> — <span class="text-slate-400">Exportation des grumes, filière bois et massifs confisqués.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">09</span><span class="text-slate-100 font-semibold">L'Évasion des Capitaux Touristiques</span> — <span class="text-slate-400">Captation de la valeur ajoutée par les centrales d'achat continentales.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">10</span><span class="text-slate-100 font-semibold">La Tutelle de la Haute Fonction Publique</span> — <span class="text-slate-400">Administration du zapping et blocages des projets locaux.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">11</span><span class="text-slate-100 font-semibold">L'Emprise et les Servitudes Militaires</span> — <span class="text-slate-400">Solenzara, Aspretto et blocages du développement foncier.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">12</span><span class="text-slate-100 font-semibold">La Dépendance Sanitaire EVASAN</span> — <span class="text-slate-400">Absence de CHU, fuite des budgets vers Marseille et déficit T2A.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">13</span><span class="text-slate-100 font-semibold">Le Sous-Investissement Éducatif</span> — <span class="text-slate-400">Université de Corte, exil des cerveaux et précarité étudiante.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">14</span><span class="text-slate-100 font-semibold">Le Dessaisissement Judiciaire JIRS</span> — <span class="text-slate-400">Procédure pénale d'exception et délocalisation à Marseille.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">15</span><span class="text-slate-100 font-semibold">Le Contrôle de Légalité & Censure</span> — <span class="text-slate-400">Traque des maires ruraux vs laxisme sur le littoral.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">16</span><span class="text-slate-100 font-semibold">La Continuité des Arrêtés Miot</span> — <span class="text-slate-400">Indivision foncière, démantèlement fiscal et rôle du GIRTEC.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">17</span><span class="text-slate-100 font-semibold">Le Verrou de la Charte Européenne</span> — <span class="text-slate-400">Dogme de la langue unique et blocage de la co-officialité.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">18</span><span class="text-slate-100 font-semibold">Le Monopole Énergétique EDF-SEI</span> — <span class="text-slate-400">Centrales au fioul lourd, CSPE et blocage des renouvelables.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-lg p-3 flex justify-between items-center text-xs">
          <div><span class="font-mono text-amber-400 font-bold mr-2">19</span><span class="text-slate-100 font-semibold">La Dépendance Numérique & Data</span> — <span class="text-slate-400">Vulnérabilité des câbles sous-marins et évasion des données.</span></div>
          <span class="px-2 py-1 rounded bg-slate-800 text-slate-400 font-mono text-[10px]">À DÉVELOPPER</span>
        </div>
