---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GisMap from '../components/GisMap.astro';
import CadaGenerator from '../components/CadaGenerator.astro';
import DoctrinePreuves from '../components/DoctrinePreuves.astro';
import FoncierDvfRadar from '../components/FoncierDvfRadar.astro';

const allEnquetes = await getCollection('enquetes');

// Sélection souveraine et stricte des 7 Grandes Enquêtes Clôturées & Opposables
// Ordre d'affichage stratégique : Angelo (27), Mines (7), Sécurité Civile (23), Muvitarra (28), Pétrole (26), Eau (4), Énergie (18)
const idsFinalises = [27, 7, 23, 28, 26, 4, 18, 11, 22];
const enquetesFinalisees = idsFinalises
  .map(id => allEnquetes.find(e => e.data.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---

<Layout 
  title="L'OCHJU — Média Citoyen d'Investigation & Open Data (L'aveti ?)"
  description="L'OCHJU — Premier média citoyen d'investigation en Corse fondé sur l'open data et la preuve médico-légale. Les 8 grandes enquêtes scellées en libre accès."
  canonicalUrl="https://fsucieta.github.io/"
  image="/alerte_censure_lochju.jpg"
  lang="fr"
>
  <!-- En-tête / Header Éditorial L'OCHJU Centré & Épuré -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Gauche : Mention Discrète d'Ancrage -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <!-- Centre : Logo Officiel Géant Centré Majestueux -->
      <a href="./" class="group flex justify-center" aria-label="Retour à l'accueil de L'OCHJU">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-r from-amber-500/40 via-amber-300/30 to-amber-500/40 rounded-2xl blur-md opacity-40 group-hover:opacity-100 transition duration-500"></div>
          <img 
            src="./logo_l_ochju.jpg" 
            alt="L'OCHJU — Média Citoyen (L'aveti ?)" 
            class="relative h-20 md:h-28 w-auto object-contain rounded-xl border-2 border-amber-500/60 group-hover:border-amber-400 transition duration-300 shadow-2xl shadow-amber-500/40"
          />
        </div>
      </a>

      <!-- Droite : Sélecteur Langue -->
      <div class="w-48 flex justify-end items-center gap-3">
        <a href="./soutenir/" class="text-xs font-mono bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 px-3 py-1.5 rounded-lg border border-amber-400/50 transition flex items-center gap-1.5 font-bold">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> <span>SOUTENIR</span>
        </a>
        <a href="./en/" class="text-xs font-mono bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 px-3 py-1.5 rounded-lg border border-amber-500/30 transition flex items-center gap-1.5 font-bold">
          <span>🇬🇧</span> <span>EN</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Navigation Rapide Sticky (Confort Ergonomique Mobile & Desktop) -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[112px] md:top-[144px] z-40 py-2 px-4 shadow-md overflow-hidden" style="scrollbar-width: none; -ms-overflow-style: none;" aria-label="Navigation rapide par sections">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-2 text-xs font-mono">
      <button type="button" class="open-soutien-modal-btn px-3.5 py-1.5 rounded-lg bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-400/60 font-mono text-xs font-bold shadow-md shadow-amber-500/10 transition flex items-center gap-1.5 cursor-pointer">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> <span>SOUTENIR LA CELLULE</span>
      </button>
      <a href="./analyse-globale-finale/" class="px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 text-slate-950 font-mono text-xs font-black shadow-lg shadow-amber-500/20 hover:brightness-110 transition flex items-center gap-1.5 border border-amber-300">
        <span>🏛️</span> <span>MÉMORANDUM SUPRÊME</span>
      </a>
      <a href="#fiches-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-amber-500/40 text-amber-300 hover:border-amber-400 hover:text-amber-200 transition flex items-center gap-1.5 font-bold">
        <span>📂 8 Enquêtes Scellées</span>
      </a>
      <a href="#registre-instruction-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5 font-mono">
        <span>⚖️ Registre d'Instruction</span>
      </a>
      <a href="#gis-map-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🗺️ Carte 360 Communes</span>
      </a>
      <a href="#foncier-dvf-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🤝 Radar DVF</span>
      </a>
      <a href="#cada-generator" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ Droit de Savoir (CADA)</span>
      </a>
      <a href="#doctrine-preuves" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ Doctrine des Preuves</span>
      </a>
    </div>
  </nav>

  <main id="main-content">

  <!-- ================= BANDEAU D'ÉTAT CITOYEN : LE GRAND MÉMORANDUM D'ÉMANCIPATION ================= -->
  <section class="max-w-7xl mx-auto px-6 pt-6 pb-2">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-amber-950/40 via-slate-900 to-slate-950 border-2 border-amber-500/60 p-6 md:p-8 shadow-2xl shadow-amber-500/10">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2.5 py-1 rounded bg-amber-500 text-slate-950 text-xs font-mono font-black uppercase tracking-wider">
              ACTE D'OPPOSABILITÉ SUPRÊME
            </span>
            <span class="text-xs font-mono text-amber-400 font-bold">
              • Synthèse des 29 Piliers de Souveraineté
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-white mb-2 leading-tight">
            L'Inversion de la Dette : Mémorandum d'Émancipation de la Corse
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
            La démonstration chiffrée de <strong>4,72 milliards d'euros</strong> siphonnés chaque année hors de notre île (28 693 € par foyer) et l'architecture de rupture constitutionnelle (Titre XIII, Protocole Åland).
          </p>
        </div>
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full lg:w-auto">
          <a 
            href="./analyse-globale-finale/" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-mono text-xs font-black tracking-wide text-center transition shadow-xl shadow-amber-500/20"
          >
            👁️ LIRE LE MÉMORANDUM
          </a>
          <a 
            href="./docs/MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
            download="MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
            class="w-full sm:w-auto px-4 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 border border-amber-500/40 font-mono text-xs font-bold text-center transition"
          >
            📥 Mémorandum Officiel (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>

  

  <!-- Section 1 : Grille des 8 Grandes Enquêtes Scellées (100% Opposables) -->
  <section class="max-w-7xl mx-auto px-6 py-12" id="fiches-section">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-emerald-500/30 pb-4">
      <div>
        <span class="px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider flex items-center gap-1.5 w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          ENQUÊTES FINALISÉES · PREUVES SCELLÉES ISO 27037
        </span>
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
          🟢 Les 8 Grandes Enquêtes Scellées & Opposables
        </h2>
        <p class="text-xs font-mono text-slate-400 mt-1">Dossiers d'investigation médico-légale complets, bilans financiers audités et actes officiels consultables.</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <!-- Barre de Recherche intégrée aux 7 dossiers -->
        <div class="w-full sm:w-72">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Filtrer les 8 dossiers..." 
            aria-label="Rechercher ou filtrer les enquêtes par titre, mot-clé ou commune"
            class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-amber-400 transition font-sans shadow-inner"
          />
        </div>
      </div>
    </div>

    <!-- Grille des 7 Enquêtes Clôturées -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fichesGrid">
      {enquetesFinalisees.map((enquete) => {
        const d = enquete.data;
        const imgPath = d.image.startsWith('http') ? d.image : `./${d.image.replace(/^\//, '')}`;
        const displayTitle = d.title.replace(/^Enquête\s+\d+\s*:\s*/i, '');
        return (
          <a 
            href={`./enquetes/${enquete.slug}/`}
            class="fiche-card relative bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800/80 hover:border-emerald-500/60 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col shadow-xl hover:shadow-2xl hover:shadow-emerald-500/10 group cursor-pointer block hover:-translate-y-1"
            data-title={displayTitle.toLowerCase()}
            data-category={d.category.toLowerCase()}
            data-chapeau={d.chapeau.toLowerCase()}
          >
            <!-- Liseré supérieur émeraude de certification -->
            <div class="h-1 w-full bg-gradient-to-r from-transparent via-emerald-500/50 to-transparent group-hover:via-emerald-400 transition-all duration-500"></div>

            <!-- Visuel carte -->
            <div class="h-52 bg-slate-950 overflow-hidden relative">
              <img 
                src={imgPath} 
                alt={displayTitle} 
                class="w-full h-full object-cover grayscale-[20%] contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition duration-700 ease-out"
              />
              <div class="absolute top-3.5 left-3.5 pointer-events-none flex items-center gap-2">
                <span class="bg-slate-950/90 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-mono font-bold text-emerald-400 border border-emerald-500/40 shadow-lg flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span>ENQUÊTE COMPLÈTE</span>
                </span>
                {(d.id === 23 || d.id === 26 || d.id === 7) && (
                  <span class="bg-rose-600 text-white font-mono font-black text-[10px] px-2.5 py-1 rounded-full uppercase tracking-wider shadow-lg shadow-rose-600/40 flex items-center gap-1.5 animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    <span>NOUVEAU</span>
                  </span>
                )}
              </div>
            </div>

            <!-- Contenu du Dossier Scellé -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                  <span class="text-[11px] font-mono uppercase tracking-widest text-cyan-400 font-bold">{d.category}</span>
                </div>
                <h3 class="text-lg font-bold font-serif text-slate-100 group-hover:text-amber-300 transition duration-300 leading-snug">
                  {displayTitle}
                </h3>
                <p class="text-slate-400 text-sm line-clamp-3 mt-2.5 leading-relaxed font-serif">
                  {d.chapeau}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                <span class="text-xs font-mono font-bold text-amber-400 group-hover:text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
                  <span>Consulter le Dossier</span>
                  <span class="transition transform group-hover:translate-x-1">→</span>
                </span>
                <button
                  type="button"
                  class="card-share-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900 hover:bg-amber-500 text-slate-400 hover:text-slate-950 border border-slate-800 hover:border-amber-400 text-[11px] font-mono font-semibold transition duration-200 z-10"
                  data-share-title={displayTitle}
                  data-share-url={`./enquetes/${enquete.slug}/`}
                  data-share-chapeau={d.chapeau}
                  title="Partager cette enquête"
                  onclick="event.preventDefault(); event.stopPropagation(); openShareModal(this);"
                >
                  <span>📤</span> <span>Partager</span>
                </button>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

    <!-- Section 2 : Registre d'Instruction & Prochains Dossiers (Greffe Citoyen) -->
  <section class="max-w-7xl mx-auto px-6 py-12 border-t border-amber-500/20" id="registre-instruction-section">
    <div class="mb-8 border-b border-amber-500/30 pb-4 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
      <div>
        <span class="px-3 py-1 bg-amber-500/10 text-amber-300 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider flex items-center gap-1.5 w-fit">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          GREFFE CITOYEN · INSTRUCTIONS FORENSIQUES EN COURS
        </span>
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
          ⚖️ Registre d'Instruction des Futurs Dossiers
        </h2>
        <p class="text-xs font-mono text-slate-400 mt-1">Dossiers en cours d'instruction dans les laboratoires de la cellule. Aucune publication tant que chaque calcul n'est pas scellé au bit près.</p>
      </div>

      <a 
        href="#doctrine-preuves" 
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-amber-500 text-amber-300 hover:text-slate-950 border border-amber-500/40 text-xs font-mono font-bold transition shadow-lg"
      >
        <span>⚖️</span>
        <span>Doctrine & Pureté des Preuves</span>
      </a>
    </div>

    <!-- Tableau d'Instruction Solennel -->
    <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/80 shadow-2xl">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/90 text-[11px] font-mono text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4 font-bold">Réf. Dossier</th>
            <th class="py-3.5 px-4 font-bold">Thématique & Cible</th>
            <th class="py-3.5 px-4 font-bold hidden sm:table-cell">Discipline Multi-INT</th>
            <th class="py-3.5 px-4 font-bold">État d'Instruction</th>
            <th class="py-3.5 px-4 text-right font-bold">Action Citoyenne</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-xs font-mono">
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-01</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">Le Grand Verrou Financier</div>
              <div class="text-[11px] text-slate-400 font-serif">La mécanique secrète des prêts in fine et la captation de l'épargne insulaire</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-cyan-400 font-bold">FININT / DGFIP</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Audit des flux bancaires
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#cada-generator" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Exiger la pièce (CADA) →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-03</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">Le Manifeste Universel du Sol</div>
              <div class="text-[11px] text-slate-400 font-serif">Autopsie de la dépossession foncière, des préemptions et des zonages PLU</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-emerald-400 font-bold">GEOINT / Cadastre</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Cartographie 360 communes
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#cada-generator" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Exiger la pièce (CADA) →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-05</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">L'Empire des SCI Non-Résidentes</div>
              <div class="text-[11px] text-slate-400 font-serif">Radiographie des bénéficiaires effectifs (RBE) et cascades de sociétés</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-cyan-400 font-bold">OSINT / INPI RNE</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Croisement RBE en cours
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#cada-generator" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Exiger la pièce (CADA) →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-15</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">Le Scandale des Primes PAC & Terres Agricoles</div>
              <div class="text-[11px] text-slate-400 font-serif">Audit du registre parcellaire graphique (RPG) et des captations d'aides européennes</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-emerald-400 font-bold">GEOINT / RPG</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Croisement cadastral en cours
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#cada-generator" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Exiger la pièce (CADA) →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-21</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">Le Scandale des Déchets du SYVADEC</div>
              <div class="text-[11px] text-slate-400 font-serif">La rente privée de l'exportation maritime des déchets vers le continent</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-cyan-400 font-bold">DECP / Marchés Publics</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Audit des bordereaux de prix
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#cada-generator" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Exiger la pièce (CADA) →</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 3 : Cartographie SIG 360 Communes -->
  <section class="max-w-7xl mx-auto px-6 py-4" id="gis-map-section">
    <GisMap />
  </section>

  <!-- Section DVF Open Data : Radar des Transactions Foncières & Tension -->
  <section class="max-w-7xl mx-auto px-6 py-4" id="dvf-foncier-section">
    <FoncierDvfRadar />
  </section>

