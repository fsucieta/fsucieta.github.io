---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import MatriceImpact from '../components/MatriceImpact.astro';
import GisMap from '../components/GisMap.astro';
import CadaGenerator from '../components/CadaGenerator.astro';
import WhistleblowerVault from '../components/WhistleblowerVault.astro';

const allEnquetes = await getCollection('enquetes');
// Trier par ID (1 à 26)
const enquetes = allEnquetes.sort((a, b) => a.data.id - b.data.id);
const uneEnquete = enquetes[0]; // Dossier majeur à la Une (#01)
---

<Layout title="L'OCHJU — Média Citoyen d'Investigation & Open Data (L'aveti ?)">
  <!-- En-tête / Header Éditorial L'OCHJU Centré & Épuré -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Gauche : Mention Discrète d'Ancrage -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <!-- Centre : Logo Officiel Géant Centré Majestueux -->
      <a href="./" class="group flex justify-center">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-r from-amber-500/40 via-amber-300/30 to-amber-500/40 rounded-2xl blur-md opacity-40 group-hover:opacity-100 transition duration-500"></div>
          <img 
            src="./logo_l_ochju.jpg" 
            alt="L'OCHJU — Média Citoyen (L'aveti ?)" 
            class="relative h-20 md:h-28 w-auto object-contain rounded-xl border-2 border-amber-500/60 group-hover:border-amber-400 transition duration-300 shadow-2xl shadow-amber-500/40"
          />
        </div>
      </a>

      <!-- Droite : Switcher Jour / Nuit (Forensic) -->
      <div class="w-48 flex justify-end">
        <ThemeToggle />
      </div>

    </div>
  </header>

  <!-- Hero Éditorial / "À LA UNE" -->
  <section class="max-w-7xl mx-auto px-6 pt-8 pb-4">
    <div class="hero-card-container border border-amber-500/40 rounded-2xl p-6 md:p-10 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/40 rounded-full text-xs font-bold uppercase tracking-wider font-mono">
          ★ ÉDITION INAUGURALE — 26 ENQUÊTES EXCLUSIVES (+40 000 MOTS)
        </span>
        <span class="px-3 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-mono">
          OPEN DATA SOUVERAINE
        </span>
      </div>

      <!-- Dossier à la Une -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center mt-4">
        <div class="lg:col-span-7">
          <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider block mb-2">
            GRAND DOSSIER D'INVESTIGATION #{uneEnquete.data.id.toString().padStart(2, '0')}
          </span>
          <h1 class="text-2xl md:text-4xl font-black font-serif text-slate-100 mb-4 leading-tight hover:text-amber-400 transition">
            <a href={`./enquetes/${uneEnquete.slug}.html`}>
              {uneEnquete.data.title}
            </a>
          </h1>
          <p class="text-slate-300 text-base md:text-lg font-serif mb-6 leading-relaxed line-clamp-3">
            {uneEnquete.data.chapeau}
          </p>
          <div class="flex flex-wrap items-center gap-4">
            <a 
              href={`./enquetes/${uneEnquete.slug}.html`} 
              class="bg-amber-500 text-slate-950 font-bold px-5 py-2.5 rounded-lg hover:bg-amber-400 transition font-sans text-xs uppercase tracking-wider shadow-lg shadow-amber-500/20"
            >
              Lire le Grand Dossier (1500w) →
            </a>
            <a 
              href="#fiches-grid-section" 
              class="bg-slate-900 border border-slate-700 text-slate-300 font-bold px-4 py-2.5 rounded-lg hover:bg-slate-800 transition font-sans text-xs uppercase tracking-wider"
            >
              📂 Découvrir les 26 Enquêtes
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-xl overflow-hidden border border-slate-800 shadow-2xl group">
            <img 
              src={`./img_enquete_${uneEnquete.data.id.toString().padStart(2, '0')}.jpg`} 
              alt={uneEnquete.data.title} 
              class="w-full h-64 md:h-80 object-cover group-hover:scale-105 transition duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80"></div>
            <div class="absolute bottom-4 left-4 right-4 text-xs font-mono text-amber-300 bg-slate-950/90 p-3 rounded-lg border border-amber-500/30 backdrop-blur">
              💡 <span class="font-bold">L'OCHJU Citoyen</span> : Visualisez l'audit médico-légal et les saisines CADA associées.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1 : Grille des 26 Enquêtes d'Impact (100% Cliquables) -->
  <section class="max-w-7xl mx-auto px-6 py-8" id="fiches-section">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-slate-800 pb-4">
      <div>
        <span class="px-3 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider">
          DOSSIERS D'INVESTIGATION CITOYENNE
        </span>
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
          📁 Les 26 Enquêtes d'Impact (+40 000 Mots)
        </h2>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <!-- Barre de Recherche intégrée à la section -->
        <div class="w-full sm:w-72">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Filtrer les 26 enquêtes..." 
            class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-amber-400 transition font-sans shadow-inner"
          />
        </div>
        <span class="text-xs font-mono text-slate-400 bg-slate-900 px-3 py-2 rounded-xl border border-slate-800" id="cardsCount">
          26 / 26 Dossiers Visibles
        </span>
      </div>
    </div>

    <!-- Grille des 26 Fiches Enquêtes -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fichesGrid">
      {enquetes.map((enquete) => {
        const d = enquete.data;
        const imgPath = `./img_enquete_${d.id.toString().padStart(2, '0')}.jpg`;
        return (
          <a 
            href={`./enquetes/${enquete.slug}.html`}
            class="fiche-card bg-slate-950 border border-slate-800 rounded-xl overflow-hidden hover:border-amber-500/60 transition duration-300 flex flex-col shadow-lg hover:shadow-amber-500/10 group cursor-pointer block"
            data-title={d.title.toLowerCase()}
            data-category={d.category.toLowerCase()}
            data-chapeau={d.chapeau.toLowerCase()}
          >
            <!-- Visuel carte cliquable -->
            <div class="h-48 bg-slate-900 overflow-hidden relative">
              <img 
                src={imgPath} 
                alt={d.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
              />
              <div class="absolute top-3 left-3 bg-slate-950/90 backdrop-blur px-3 py-1 rounded-full text-xs font-bold text-amber-400 border border-amber-500/30 font-mono">
                Enquête #{d.id.toString().padStart(2, '0')}
              </div>
            </div>

            <!-- Contenu carte cliquable -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono text-cyan-400 font-bold block mb-2">{d.category}</span>
                <h3 class="text-lg font-bold font-serif text-slate-100 mb-3 group-hover:text-amber-400 transition leading-snug">
                  {d.title}
                </h3>
                <p class="text-slate-400 text-sm line-clamp-3 mb-4 leading-relaxed font-serif">
                  {d.chapeau}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-xs font-bold text-amber-400 group-hover:text-amber-300 uppercase tracking-wider flex items-center gap-1 font-sans">
                  Consulter l'enquête (1500w) →
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Section 2 : Matrice d'Impact des 26 Enquêtes par Pôles -->
  <section class="max-w-7xl mx-auto px-6 py-4" id="network-section">
    <MatriceImpact />
  </section>

  <!-- Section 3 : Cartographie SIG 360 Communes -->
  <section class="max-w-7xl mx-auto px-6 py-4" id="gis-map-section">
    <GisMap />
  </section>

  <!-- Section 4 : Boîte à Outils CADA (Action Citoyenne) -->
  <section class="max-w-7xl mx-auto px-6 py-4" id="cada-generator">
    <CadaGenerator />
  </section>

  <!-- Section 5 : Coffre-Fort Lanceurs d'Alerte -->
  <section class="max-w-7xl mx-auto px-6 py-4" id="whistleblower-section">
    <WhistleblowerVault />
  </section>

  <!-- Script de Recherche Temps Réel -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInput') as HTMLInputElement | null;
      const cards = document.querySelectorAll<HTMLElement>('#fichesGrid .fiche-card');
      const cardsCount = document.getElementById('cardsCount');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const term = (e.target as HTMLInputElement).value.toLowerCase().trim();
          let visibleCount = 0;

          cards.forEach((card) => {
            const title = card.getAttribute('data-title') || '';
            const category = card.getAttribute('data-category') || '';
            const chapeau = card.getAttribute('data-chapeau') || '';

            if (title.includes(term) || category.includes(term) || chapeau.includes(term)) {
              card.style.display = 'flex';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (cardsCount) {
            cardsCount.textContent = `${visibleCount} / 26 Dossiers Visibles`;
          }
        });
      }
    });
  </script>
</Layout>
