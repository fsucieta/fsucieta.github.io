---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GisMap from '../components/GisMap.astro';
import CadaGenerator from '../components/CadaGenerator.astro';
import WhistleblowerVault from '../components/WhistleblowerVault.astro';
import FoncierDvfRadar from '../components/FoncierDvfRadar.astro';

const allEnquetes = await getCollection('enquetes');
// Trier par ID
const enquetes = allEnquetes.sort((a, b) => a.data.id - b.data.id);

// Séparation éditoriale claire : Dossiers Clôturés vs Enquêtes en Cours d'Instruction
const enquetesCloturees = enquetes.filter(e => e.data.status !== 'en_cours');
const enquetesEnCours = enquetes.filter(e => e.data.status === 'en_cours');

// Les Grandes Enquêtes Clôturées Majeures pour le Carrousel à la Une (Priorité aux dernières révélations certifiées)
const idsClotures = [26, 7, 29, 2, 3, 4, 6, 18, 27, 28];
const enquetesAlaUne = idsClotures.map(id => enquetes.find(e => e.data.id === id)).filter(Boolean);
---

<Layout 
  title="L'OCHJU — Média Citoyen d'Investigation & Open Data (L'aveti ?)"
  description="L'OCHJU — Premier média citoyen d'investigation en Corse fondé sur l'open data et la preuve médico-légale. 29 grandes enquêtes en libre accès."
  canonicalUrl="https://fsucieta.github.io/"
  image="/alerte_censure_lochju.jpg"
  lang="fr"
>
  <!-- En-tête / Header Éditorial L'OCHJU Centré & Épuré -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Gauche : Mention Discrète d'Ancrage -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <!-- Centre : Logo Officiel Géant Centré Majestueux -->
      <a href="./" class="group flex justify-center" aria-label="Retour à l'accueil de L'OCHJU">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-r from-amber-500/40 via-amber-300/30 to-amber-500/40 rounded-2xl blur-md opacity-40 group-hover:opacity-100 transition duration-500"></div>
          <img 
            src="./logo_l_ochju.jpg" 
            alt="L'OCHJU — Média Citoyen (L'aveti ?)" 
            class="relative h-20 md:h-28 w-auto object-contain rounded-xl border-2 border-amber-500/60 group-hover:border-amber-400 transition duration-300 shadow-2xl shadow-amber-500/40"
          />
        </div>
      </a>

      <!-- Droite : Sélecteur Langue -->
      <div class="w-48 flex justify-end items-center gap-3">
        <a href="./en/" class="text-xs font-mono bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 px-3 py-1.5 rounded-lg border border-amber-500/30 transition flex items-center gap-1.5 font-bold">
          <span>🇬🇧</span> <span>EN</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Navigation Rapide Sticky (Confort Ergonomique Mobile & Desktop) -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[108px] z-40 py-2.5 px-6 shadow-md overflow-x-auto" aria-label="Navigation rapide par sections">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-3 text-xs font-mono whitespace-nowrap">
      <a href="#fiches-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-amber-500/40 text-amber-300 hover:border-amber-400 hover:text-amber-200 transition flex items-center gap-1.5 font-bold">
        <span>📂 29 Enquêtes</span>
      </a>
      <a href="#gis-map-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🗺️ Carte 360 Communes</span>
      </a>
      <a href="#foncier-dvf-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🤝 Radar DVF</span>
      </a>
      <a href="#cada-generator" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ Droit de Savoir (CADA)</span>
      </a>
      <a href="#whistleblower-vault" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🔒 Coffre-Fort PGP</span>
      </a>
      <a href="#alerte-censure-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-rose-500/40 text-rose-300 hover:border-rose-400 hover:text-rose-200 transition flex items-center gap-1.5">
        <span>🔴 Alerte Censure</span>
      </a>
      <a href="#manifeste-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>📜 Le Manifeste</span>
      </a>
    </div>
  </nav>

  <main id="main-content">
  <!-- ================= CARROUSEL INTERACTIF "À LA UNE" : LES 8 ENQUÊTES CLÔTURÉES ================= -->
  <section class="max-w-7xl mx-auto px-6 pt-8 pb-4" id="carousel-alaune-section">
    <div class="hero-card-container border border-amber-500/40 rounded-2xl p-6 md:p-10 shadow-2xl relative overflow-hidden bg-slate-900">
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <!-- En-tête du Carrousel avec Indicateur d'Édition et Boutons de Navigation -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6 border-b border-slate-800/80 pb-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/40 rounded-full text-xs font-bold uppercase tracking-wider font-mono flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            ★ DOSSIERS MAJEURS À LA UNE (ENQUÊTES CLÔTURÉES)
          </span>
          <span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-mono font-bold">
            🗺️ 360 COMMUNES
          </span>
          <span class="px-3 py-1 bg-slate-950 text-slate-300 border border-slate-800 rounded-full text-xs font-mono font-bold" id="carouselCounter">
            Dossier 1 / {enquetesAlaUne.length}
          </span>
        </div>

        <!-- Contrôles Précédent / Suivant et Pause -->
        <div class="flex items-center gap-2">
          <button 
            id="carouselPrevBtn" 
            type="button" 
            class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 hover:text-amber-400 hover:border-amber-400 transition cursor-pointer shadow-md"
            title="Dossier précédent"
          >
            ◀
          </button>
          <button 
            id="carouselPlayPauseBtn" 
            type="button" 
            class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-slate-300 hover:text-amber-400 hover:border-amber-400 transition cursor-pointer shadow-md"
            title="Mettre en pause / Relancer le défilement automatique"
          >
            ⏸️ Pause
          </button>
          <button 
            id="carouselNextBtn" 
            type="button" 
            class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 hover:text-amber-400 hover:border-amber-400 transition cursor-pointer shadow-md"
            title="Dossier suivant"
          >
            ▶
          </button>
        </div>
      </div>

      <!-- Diapositives du Carrousel (Chaque enquête clôturée) -->
      <div class="relative overflow-hidden min-h-[440px]" id="carouselSlidesContainer">
        {enquetesAlaUne.map((enq, index) => {
          const d = enq.data;
          const isFirst = index === 0;
          return (
            <div 
              class={`carousel-slide transition-opacity duration-700 ${isFirst ? 'opacity-100 relative' : 'opacity-0 absolute inset-0 pointer-events-none'}`}
              data-slide-index={index}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-7">
                  <div class="flex items-center gap-2.5 mb-3">
                    <span class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider">
                      GRAND DOSSIER D'INVESTIGATION #{d.id.toString().padStart(2, '0')}
                    </span>
                    <span class="px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 font-mono text-[10px] font-bold">
                      {d.id === 29 ? '⭐ HORS-SÉRIE MONUMENTAL' : '🟢 DOSSIER CLÔTURÉ'}
                    </span>
                    {(d.id === 26 || d.id === 7) && (
                      <span class="px-2 py-0.5 rounded-full bg-rose-600 text-white font-mono text-[10px] font-black uppercase tracking-wider shadow-lg shadow-rose-600/40 flex items-center gap-1 animate-pulse">
                        <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                        <span>NOUVEAU</span>
                      </span>
                    )}
                  </div>

                  <h2 class="text-2xl md:text-4xl font-black font-serif text-slate-100 mb-4 leading-tight hover:text-amber-400 transition">
                    <a href={`./enquetes/${enq.slug}/`}>
                      {d.title}
                    </a>
                  </h2>

                  <p class="text-slate-300 text-base md:text-lg font-serif mb-6 leading-relaxed line-clamp-3">
                    {d.chapeau}
                  </p>

                  <div class="flex flex-wrap items-center gap-4">
                    <a 
                      href={`./enquetes/${enq.slug}/`} 
                      class="bg-amber-500 text-slate-950 font-bold px-5 py-2.5 rounded-lg hover:bg-amber-400 transition font-sans text-xs uppercase tracking-wider shadow-lg shadow-amber-500/20"
                    >
                      Lire le Grand Dossier (6 MIN) →
                    </a>
                    <a 
                      href="#fiches-section" 
                      class="bg-slate-950 border border-slate-700 text-slate-300 font-bold px-4 py-2.5 rounded-lg hover:bg-slate-800 transition font-sans text-xs uppercase tracking-wider"
                    >
                      📂 Voir les 29 Enquêtes
                    </a>
                  </div>
                </div>

                <div class="lg:col-span-5">
                  <div class="relative rounded-xl overflow-hidden border border-slate-800 shadow-2xl group">
                    <img 
                      src={d.image.startsWith('http') ? d.image : `./${d.image.replace(/^\//, '')}`} 
                      alt={d.title} 
                      class="w-full h-64 md:h-80 object-cover group-hover:scale-105 transition duration-500"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80"></div>
                    <div class="absolute bottom-4 left-4 right-4 text-xs font-mono text-amber-300 bg-slate-950/90 p-3 rounded-lg border border-amber-500/30 backdrop-blur">
                      💡 <span class="font-bold">L'OCHJU Citadinu</span> : {d.subtitle || "Dossier médico-légal et pièces d'archives certifiées."}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Puces de Navigation / Pagination -->
      <div class="flex items-center justify-center gap-2 mt-8 pt-4 border-t border-slate-800/80" id="carouselDots">
        {enquetesAlaUne.map((_, index) => (
          <button 
            type="button" 
            class={`carousel-dot w-3 h-3 rounded-full transition-all duration-300 cursor-pointer ${index === 0 ? 'bg-amber-400 w-8' : 'bg-slate-700 hover:bg-slate-500'}`}
            data-dot-index={index}
            title={`Aller au dossier ${index + 1}`}
          ></button>
        ))}
      </div>

    </div>
  </section>

  <!-- Script du Carrousel Dynamique -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const slides = document.querySelectorAll('.carousel-slide');
      const dots = document.querySelectorAll('.carousel-dot');
      const prevBtn = document.getElementById('carouselPrevBtn');
      const nextBtn = document.getElementById('carouselNextBtn');
      const playPauseBtn = document.getElementById('carouselPlayPauseBtn');
      const counter = document.getElementById('carouselCounter');
      const container = document.getElementById('carousel-alaune-section');

      if (!slides.length) return;

      let currentIndex = 0;
      let isPlaying = true;
      let autoTimer = null;
      const total = slides.length;

      function updateSlide(newIndex) {
        slides.forEach((slide, idx) => {
          if (idx === newIndex) {
            slide.classList.remove('opacity-0', 'absolute', 'pointer-events-none');
            slide.classList.add('opacity-100', 'relative');
          } else {
            slide.classList.remove('opacity-100', 'relative');
            slide.classList.add('opacity-0', 'absolute', 'pointer-events-none');
          }
        });

        dots.forEach((dot, idx) => {
          if (idx === newIndex) {
            dot.classList.add('bg-amber-400', 'w-8');
            dot.classList.remove('bg-slate-700');
          } else {
            dot.classList.remove('bg-amber-400', 'w-8');
            dot.classList.add('bg-slate-700');
          }
        });

        if (counter) {
          counter.textContent = `Dossier ${newIndex + 1} / ${total}`;
        }

        currentIndex = newIndex;
      }

      function nextSlide() {
        const next = (currentIndex + 1) % total;
        updateSlide(next);
      }

      function prevSlide() {
        const prev = (currentIndex - 1 + total) % total;
        updateSlide(prev);
      }

      function startTimer() {
        stopTimer();
        autoTimer = setInterval(nextSlide, 5500);
      }

      function stopTimer() {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          prevSlide();
          if (isPlaying) startTimer();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          nextSlide();
          if (isPlaying) startTimer();
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const idx = parseInt(e.target.getAttribute('data-dot-index') || '0', 10);
          updateSlide(idx);
          if (isPlaying) startTimer();
        });
      });

      if (playPauseBtn) {
        playPauseBtn.addEventListener('click', () => {
          isPlaying = !isPlaying;
          if (isPlaying) {
            playPauseBtn.textContent = '⏸️ Pause';
            startTimer();
          } else {
            playPauseBtn.textContent = '▶️ Lecture';
            stopTimer();
          }
        });
      }

      if (container) {
        container.addEventListener('mouseenter', () => {
          if (isPlaying) stopTimer();
        });
        container.addEventListener('mouseleave', () => {
          if (isPlaying) startTimer();
        });
      }

      startTimer();
    });
  </script>

  <!-- Section 1 : Grille des Enquêtes d'Impact (100% Cliquables & Filtrage par Statut) -->
  <!-- Section 1 : Dossiers d'Enquête Clôturés & Scellés (100% Cliquables) -->
  <section class="max-w-7xl mx-auto px-6 py-8" id="fiches-section">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-emerald-500/30 pb-4">
      <div>
        <span class="px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider flex items-center gap-1.5 w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          ENQUÊTES COMPLÈTES · PREUVES VÉRIFIÉES
        </span>
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
          🟢 Les Dossiers Majeurs Clôturés ({enquetesCloturees.length})
        </h2>
        <p class="text-xs font-mono text-slate-400 mt-1">Enquêtes avec preuves médico-légales complètes, bilans financiers audités et documents officiels consultables.</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <!-- Barre de Recherche intégrée à la section -->
        <div class="w-full sm:w-72">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="🔍 Filtrer les dossiers..." 
            aria-label="Rechercher ou filtrer les enquêtes par titre, mot-clé ou commune"
            class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-amber-400 transition font-sans shadow-inner"
          />
        </div>
      </div>
    </div>

    <!-- Grille des Fiches Enquêtes Clôturées -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fichesGrid">
      {enquetesCloturees.map((enquete) => {
        const d = enquete.data;
        const imgPath = d.image.startsWith('http') ? d.image : `./${d.image.replace(/^\//, '')}`;
        const displayTitle = d.title.replace(/^Enquête\s+\d+\s*:\s*/i, '');
        return (
          <a 
            href={`./enquetes/${enquete.slug}/`}
            class="fiche-card relative bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800/80 hover:border-emerald-500/60 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col shadow-xl hover:shadow-2xl hover:shadow-emerald-500/10 group cursor-pointer block hover:-translate-y-1"
            data-title={displayTitle.toLowerCase()}
            data-category={d.category.toLowerCase()}
            data-chapeau={d.chapeau.toLowerCase()}
          >
            <!-- Liseré supérieur émeraude de certification -->
            <div class="h-1 w-full bg-gradient-to-r from-transparent via-emerald-500/50 to-transparent group-hover:via-emerald-400 transition-all duration-500"></div>

            <!-- Visuel carte -->
            <div class="h-52 bg-slate-950 overflow-hidden relative">
              <img 
                src={imgPath} 
                alt={displayTitle} 
                class="w-full h-full object-cover grayscale-[20%] contrast-110 group-hover:grayscale-0 group-hover:scale-105 transition duration-700 ease-out"
              />
              <div class="absolute top-3.5 left-3.5 pointer-events-none flex items-center gap-2">
                <span class="bg-slate-950/90 backdrop-blur-md px-3 py-1 rounded-full text-[11px] font-mono font-bold text-emerald-400 border border-emerald-500/40 shadow-lg flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  <span>ENQUÊTE COMPLÈTE</span>
                </span>
                {(d.id === 26 || d.id === 7) && (
                  <span class="bg-rose-600 text-white font-mono font-black text-[10px] px-2.5 py-1 rounded-full uppercase tracking-wider shadow-lg shadow-rose-600/40 flex items-center gap-1.5 animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    <span>NOUVEAU</span>
                  </span>
                )}
              </div>
            </div>

            <!-- Contenu du Dossier Scellé -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                  <span class="text-[11px] font-mono uppercase tracking-widest text-cyan-400 font-bold">{d.category}</span>
                </div>
                <h3 class="text-lg font-bold font-serif text-slate-100 group-hover:text-amber-300 transition duration-300 leading-snug">
                  {displayTitle}
                </h3>
                <p class="text-slate-400 text-sm line-clamp-3 mt-2.5 leading-relaxed font-serif">
                  {d.chapeau}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
                <span class="text-xs font-mono font-bold text-amber-400 group-hover:text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
                  <span>Consulter le Dossier</span>
                  <span class="transition transform group-hover:translate-x-1">→</span>
                </span>
                <button
                  type="button"
                  class="card-share-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-900 hover:bg-amber-500 text-slate-400 hover:text-slate-950 border border-slate-800 hover:border-amber-400 text-[11px] font-mono font-semibold transition duration-200 z-10"
                  data-share-title={displayTitle}
                  data-share-url={`./enquetes/${enquete.slug}/`}
                  data-share-chapeau={d.chapeau}
                  title="Partager cette enquête"
                  onclick="event.preventDefault(); event.stopPropagation(); openShareModal(this);"
                >
                  <span>📤</span> <span>Partager</span>
                </button>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Section 2 : Enquêtes Ouvertes & Instructions en Cours (Appel à Pièces Citoyennes) -->
  <section class="max-w-7xl mx-auto px-6 py-8 border-t border-amber-500/20" id="enquetes-en-cours-section">
    <div class="mb-8 border-b border-amber-500/30 pb-4">
      <span class="px-3 py-1 bg-amber-500/10 text-amber-300 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider flex items-center gap-1.5 w-fit">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        INSTRUCTION EN COURS · APPEL À PIÈCES ET SIGNALEMENTS
      </span>
      <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
        🟡 Enquêtes en Cours d'Instruction ({enquetesEnCours.length})
      </h2>
      <p class="text-xs font-mono text-slate-400 mt-1">Dossiers d'investigation actifs : vous détenez des documents officiels, des arrêtés ou des pièces justificatives ? Transmettez-les via notre coffre-fort PGP.</p>
    </div>

    <!-- Grille des Enquêtes en Cours d'Instruction -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fichesGridEnCours">
      {enquetesEnCours.map((enquete) => {
        const d = enquete.data;
        const imgPath = d.image.startsWith('http') ? d.image : `./${d.image.replace(/^\//, '')}`;
        const displayTitle = d.title.replace(/^Enquête\s+\d+\s*:\s*/i, '');
        return (
          <a 
            href={`./enquetes/${enquete.slug}/`}
            class="fiche-card relative bg-gradient-to-b from-slate-900/90 to-slate-950 border border-amber-500/30 hover:border-amber-400 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col shadow-xl hover:shadow-2xl hover:shadow-amber-500/10 group cursor-pointer block hover:-translate-y-1"
            data-title={displayTitle.toLowerCase()}
            data-category={d.category.toLowerCase()}
            data-chapeau={d.chapeau.toLowerCase()}
