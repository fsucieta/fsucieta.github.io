  <!-- SCRIPT DU MOTEUR DE THÈMES & RECHERCHE INSTANTANÉE -->
  <script is:inline>
    function setGlobalTheme(name) {
      document.documentElement.setAttribute('data-theme', name);
      localStorage.setItem('lochju_theme', name);
    }

    const savedTheme = localStorage.getItem('lochju_theme') || 'noir';
    setGlobalTheme(savedTheme);

    // Filtrage dynamique des 9 enquêtes
    const searchInput = document.getElementById('searchInput');
    const cards = document.querySelectorAll('.enquete-card');

    if (searchInput) {
      searchInput.addEventListener('input', e => {
        const query = e.target.value.toLowerCase().trim();
        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const category = card.getAttribute('data-category') || '';
          const chapeau = card.getAttribute('data-chapeau') || '';
          const matches = title.includes(query) || category.includes(query) || chapeau.includes(query);
          card.style.display = matches ? 'flex' : 'none';
        });
      });
    }
  </script>
