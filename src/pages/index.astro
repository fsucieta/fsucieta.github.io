---
// index.astro - VERSION OFFICIELLE COMPLÈTE L'OCHJU
// Typographie Presse d'Investigation Mondiale (Newsreader / Publico + Inter + JetBrains Mono)
// Intégralité des outils : 9 Enquêtes + SIG 360 Communes + Radar DVF + CADA + Doctrine ISO 27037
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import GisMap from '../components/GisMap.astro';
import CadaGenerator from '../components/CadaGenerator.astro';
import DoctrinePreuves from '../components/DoctrinePreuves.astro';
import FoncierDvfRadar from '../components/FoncierDvfRadar.astro';

const allEnquetes = await getCollection('enquetes');
const idsFinalises = [22, 18, 27, 7, 23, 28, 26, 4, 11];
const enquetesFinalisees = idsFinalises
  .map(id => allEnquetes.find(e => e.data.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

const impactFoyer: Record<number, { val: string; label: string }> = {
  22: { val: "10 475 €", label: "Captation Épargne / foyer" },
  18: { val: "2 140 €", label: "Surcoût Énergie / an" },
  27: { val: "38 M€", label: "Argent Public Englouti" },
  7: { val: "100 %", label: "Sous-Sol Minier Concédé" },
  23: { val: "5 Canadairs", label: "Déficit Sécurité Civile" },
  28: { val: "12,5 M€", label: "Dette Transports Transférée" },
  26: { val: "+0,18 € / L", label: "Rente Monopole Carburant" },
  4: { val: "68 %", label: "Fuites d'Eau Facturées" },
  11: { val: "4 200 ha", label: "Emprise Militaire Gelée" }
};
---

<Layout 
  title="L'OCHJU — Média Citoyen d'Investigation Médico-Légale (L'aveti ?)"
  description="L'OCHJU — Premier média d'investigation en Corse fondé sur l'open data et la preuve médico-légale. Les 9 grandes enquêtes scellées en libre accès."
>
  <!-- TYPOGRAPHIE PRESSE D'INVESTIGATION PRESTIGE : Newsreader (Éditorial ProPublica/NYT) + Inter + JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400;1,6..72,700&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      /* Thème actif par défaut : Noir Absolu & Or Pur 24K (Thème 3) */
      --lochju-bg: #030304;
      --lochju-surface: #0a0b0e;
      --lochju-surface-hover: #12141a;
      --lochju-border: #1a1d24;
      --lochju-border-active: #d4af37;
      --lochju-text-title: #ffffff;
      --lochju-text-body: #d1d5db;
      --lochju-text-muted: #848a96;
      --lochju-gold: #f59e0b;
      --lochju-gold-light: #fbbf24;
      --lochju-gold-glow: rgba(245, 158, 11, 0.25);
    }

    [data-theme="granit"] {
      --lochju-bg: #111215;
      --lochju-surface: #18191e;
      --lochju-surface-hover: #21232a;
      --lochju-border: #2b2e38;
      --lochju-border-active: #fbbf24;
      --lochju-text-title: #f8fafc;
      --lochju-text-body: #cbd5e1;
      --lochju-text-muted: #94a3b8;
      --lochju-gold: #fbbf24;
      --lochju-gold-light: #fde047;
      --lochju-gold-glow: rgba(251, 191, 36, 0.25);
    }

    [data-theme="emeraude"] {
      --lochju-bg: #040d07;
      --lochju-surface: #09190e;
      --lochju-surface-hover: #0f2717;
      --lochju-border: #163821;
      --lochju-border-active: #f59e0b;
      --lochju-text-title: #f0fdf4;
      --lochju-text-body: #dcfce7;
      --lochju-text-muted: #86efac;
      --lochju-gold: #f59e0b;
      --lochju-gold-light: #fbbf24;
      --lochju-gold-glow: rgba(245, 158, 11, 0.25);
    }

    body {
      background-color: var(--lochju-bg) !important;
      color: var(--lochju-text-body) !important;
      font-family: 'Inter', system-ui, sans-serif !important;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    .font-press {
      font-family: 'Newsreader', Georgia, serif !important;
      letter-spacing: -0.015em;
    }

    .font-mono-tech {
      font-family: 'JetBrains Mono', monospace !important;
      font-variant-numeric: tabular-nums;
    }

    .theme-surface {
      background-color: var(--lochju-surface) !important;
      border-color: var(--lochju-border) !important;
    }

    .theme-surface:hover {
      background-color: var(--lochju-surface-hover) !important;
      border-color: var(--lochju-border-active) !important;
    }

    .theme-gold-text {
      color: var(--lochju-gold-light) !important;
    }

    .theme-gold-glow {
      box-shadow: 0 0 25px var(--lochju-gold-glow) !important;
    }
  </style>

  <!-- HEADER OFFICIEL L'OCHJU : LOGO OFFICIEL HISTORIQUE CENTRÉ ET MAJESTUEUX -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-2.5 sm:py-3 md:py-4 px-3 sm:px-4 md:px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-1 sm:gap-4">
      
      <!-- Gauche : Mention Discrète d'Ancrage -->
      <div class="hidden md:block w-44 lg:w-48 shrink-0">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <!-- Centre : Logo Officiel L'OCHJU Authentique (100% Intact, Zéro Rognage) -->
      <a href="./" class="group flex items-center py-1 shrink min-w-0" aria-label="Retour à l'accueil de L'OCHJU">
        <img 
          src="./logo_l_ochju_intact_100pct.png" 
          alt="L'OCHJU — Média Citoyen (L'aveti ?)" 
          class="h-6 sm:h-9 md:h-12 w-auto max-w-[130px] sm:max-w-none object-contain filter drop-shadow-[0_2px_12px_rgba(245,158,11,0.25)] transition duration-300"
        />
      </a>

      <!-- Droite : Actions Citoyennes & Sélecteur Langue Global 8 Langues -->
      <div class="flex items-center justify-end gap-1.5 sm:gap-2 shrink-0">
        <a href="./soutenir/" class="text-xs font-mono bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 px-2 sm:px-3 py-1 sm:py-1.5 rounded-lg border border-amber-400/50 transition flex items-center gap-1 sm:gap-1.5 font-bold text-[10px] sm:text-xs tracking-wider shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> <span class="hidden sm:inline">SOUTENIR</span><span class="sm:hidden">DON</span>
        </a>
        
        <!-- Dropdown Sélecteur International 8 Langues -->
        <div class="relative group/lang">
          <button class="text-xs font-mono bg-black/60 hover:bg-white/10 text-slate-300 px-1.5 sm:px-2.5 py-1 sm:py-1.5 rounded-lg border border-white/20 transition flex items-center gap-1 font-bold cursor-pointer text-[10px] sm:text-xs shrink-0">
            <span>FR</span> <span class="text-[10px] text-amber-400">▼</span>
          </button>
          <div class="absolute right-0 top-full mt-1 bg-black/95 border border-white/20 rounded-xl shadow-2xl py-2 px-1 hidden group-hover/lang:flex flex-col gap-1 w-32 z-50 font-mono text-xs">
            <a href="./" class="px-3 py-1 hover:bg-white/10 rounded text-amber-400 font-bold flex items-center justify-between"><span>Français</span> <span class="text-[10px] text-slate-500">FR</span></a>
            <a href="./en/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>English</span> <span class="text-[10px] text-slate-500">EN</span></a>
            <a href="./it/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>Italiano</span> <span class="text-[10px] text-slate-500">IT</span></a>
            <a href="./es/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>Español</span> <span class="text-[10px] text-slate-500">ES</span></a>
            <a href="./pt/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>Português</span> <span class="text-[10px] text-slate-500">PT</span></a>
            <a href="./ru/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>Русский</span> <span class="text-[10px] text-slate-500">RU</span></a>
            <a href="./zh/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>中文</span> <span class="text-[10px] text-slate-500">ZH</span></a>
            <a href="./ja/" class="px-3 py-1 hover:bg-white/10 rounded text-slate-300 hover:text-white flex items-center justify-between"><span>日本語</span> <span class="text-[10px] text-slate-500">JA</span></a>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Navigation Rapide Sticky par Sections -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[64px] md:top-[80px] z-40 py-2 px-4 shadow-md overflow-x-auto" aria-label="Navigation rapide par sections">
    <div class="max-w-7xl mx-auto flex flex-nowrap overflow-x-auto whitespace-nowrap scrollbar-none items-center justify-start sm:justify-center gap-1.5 sm:gap-2 text-xs font-mono-tech px-2">
      <a href="#memorandum" class="px-3 py-1.5 rounded-lg text-amber-300 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 transition font-bold">Mémorandum</a>
      <a href="#enquetes" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">9 Enquêtes</a>
      <a href="#gis-map" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">Carte 360</a>
      <a href="#foncier-dvf" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">Radar DVF</a>
      <a href="#cada" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">Recours CADA</a>
      <a href="#doctrine" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">Chaîne ISO</a>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-10 space-y-20">
    
    <!-- ================= 1. LE GRAND MÉMORANDUM D'ÉMANCIPATION (L'Espoir Démontré) ================= -->
    <section class="relative rounded-3xl theme-surface border p-6 sm:p-10 shadow-2xl overflow-hidden" id="memorandum">
      <div class="max-w-4xl space-y-6">
        
        <div class="flex flex-wrap items-center gap-2.5 font-mono-tech text-xs">
          <span class="px-3 py-1 rounded-full bg-amber-500 text-black font-black tracking-wider uppercase">
            RÉVÉLATION MAJEURE
          </span>
          <span class="theme-gold-text font-bold">
            • Consolidation des 29 Piliers d'Instruction
          </span>
          <span class="text-slate-500 hidden sm:inline">• NORME ISO/IEC 27037</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-press font-black text-white leading-[1.08] tracking-tight">
          L'Inversion de la Dette : <br/>
          <span class="theme-gold-text">Le Mémorandum d'Émancipation de la Corse</span>
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-press">
          La démonstration comptable et juridique de <strong>4,72 milliards d'euros</strong> siphonnés chaque année hors de notre île (28 693 € par foyer) et l'architecture républicaine pour reprendre en main notre destin populaire.
        </p>

        <!-- 3 Métriques Fondatrices -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-white/10 font-mono-tech">
          <div class="p-4 rounded-xl bg-black/40 border border-white/10">
            <span class="text-[10px] uppercase text-slate-400 block">Siphonné par an</span>
            <span class="text-2xl sm:text-3xl font-black text-rose-400 block mt-1">4,72 Md€</span>
            <span class="text-[10px] text-slate-400">Rentes, banques, fioul, fret</span>
          </div>
          <div class="p-4 rounded-xl bg-black/40 border border-amber-500/40">
            <span class="text-[10px] uppercase theme-gold-text block">Impact par Foyer</span>
            <span class="text-2xl sm:text-3xl font-black theme-gold-text block mt-1">28 693 € / an</span>
            <span class="text-[10px] text-slate-400">5 mois et demi de salaire</span>
          </div>
          <div class="p-4 rounded-xl bg-black/40 border border-white/10">
            <span class="text-[10px] uppercase text-emerald-400 block">Solde Net pour la Corse</span>
            <span class="text-2xl sm:text-3xl font-black text-emerald-400 block mt-1">+1,72 Md€</span>
            <span class="text-[10px] text-slate-400">La Corse est créancière</span>
          </div>
        </div>

        <!-- CTA Mémorandum -->
        <div class="flex flex-wrap items-center gap-3 pt-2 font-mono-tech text-xs">
          <a 
            href="./analyse-globale-finale/" 
            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 text-black font-black uppercase tracking-wider hover:brightness-110 shadow-lg transition"
          >
            Consulter le Mémorandum Complet →
          </a>
          <a 
            href="./docs/MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
            download="MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
            class="px-5 py-3.5 rounded-xl border border-white/20 hover:border-amber-400 text-slate-200 transition font-bold"
          >
            Télécharger l'Acte Officiel (PDF)
          </a>
        </div>

      </div>
    </section>

    <!-- ================= 2. LES 9 GRANDES ENQUÊTES SCELLÉES ================= -->
    <section class="space-y-6" id="enquetes">
      
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-white/10 pb-4">
        <div>
          <div class="flex items-center gap-2 font-mono-tech text-xs font-bold text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>PREUVES SCELLÉES · SOUS NORME ISO/IEC 27037</span>
          </div>
          <h2 class="text-2xl sm:text-4xl font-press font-bold text-white mt-1">
            Les 9 Grandes Enquêtes d'Instruction
          </h2>
          <p class="font-mono-tech text-xs text-slate-400 mt-1">
            Autopsies médico-légales complètes, bilans financiers certifiés et pièces opposables au juge.
          </p>
        </div>

        <!-- Recherche instantanée en direct -->
        <div class="w-full sm:w-80 font-mono-tech">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Filtrer les 9 enquêtes..." 
            class="w-full px-4 py-2.5 rounded-xl bg-black/50 border border-white/20 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-amber-400 transition"
          />
        </div>
      </div>

      <!-- Grille des 9 Dossiers -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="enquetesGrid">
        {enquetesFinalisees.map((enquete, index) => {
          const d = enquete.data;
          const displayTitle = d.title.replace(/^Enquête\s+\d+\s*:\s*/i, '');
          const imgPath = d.image.startsWith('http') ? d.image : `./${d.image.replace(/^\//, '')}`;
          const impact = impactFoyer[d.id];
          const isLead = index === 0;

          return (
            <article 
              class={`enquete-card theme-surface border rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300 group ${isLead ? 'md:col-span-2 lg:col-span-2' : 'col-span-1'}`}
              data-title={displayTitle.toLowerCase()}
              data-category={d.category.toLowerCase()}
              data-chapeau={d.chapeau.toLowerCase()}
            >
              <!-- En-tête de la chemise d'enquête -->
              <div class="p-4 bg-black/40 border-b border-white/10 flex items-center justify-between font-mono-tech text-[11px]">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span class="theme-gold-text font-bold">[{d.reference || `DOSSIER-${d.id}`}]</span>
                  <span class="text-slate-400 uppercase tracking-wider hidden sm:inline">· {d.category}</span>
                </div>
                {d.id === 22 ? (
                  <span class="bg-rose-600/90 text-white font-mono-tech font-black text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-md shadow-rose-600/30 flex items-center gap-1.5 animate-pulse border border-rose-400/50">
                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                    <span>NOUVELLE ENQUÊTE</span>
                  </span>
                ) : d.id === 18 ? (
                  <span class="bg-amber-500/20 text-amber-300 font-mono-tech font-bold text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider border border-amber-500/40 shadow-sm flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                    <span>MISE À JOUR RÉCENTE</span>
                  </span>
                ) : (
                  <span class="bg-emerald-500/10 text-emerald-400 font-mono-tech font-bold text-[10px] px-2.5 py-0.5 rounded-full uppercase tracking-wider border border-emerald-500/30 flex items-center gap-1.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <span>DOSSIER SCELLÉ</span>
                  </span>
                )}
              </div>

              <!-- Visuel Documentaire -->
              <div class={`relative overflow-hidden bg-black ${isLead ? 'h-64 sm:h-72' : 'h-48'}`}>
                <img 
                  src={imgPath} 
                  alt={displayTitle} 
                  class="w-full h-full object-cover filter brightness-90 contrast-110 group-hover:scale-105 group-hover:brightness-100 transition duration-700 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
                {impact && (
                  <div class="absolute bottom-3 left-4 font-mono-tech text-[10px] text-slate-300 bg-black/90 px-2.5 py-1 rounded border border-white/20 backdrop-blur">
                    {impact.label}
                  </div>
                )}
              </div>

              <!-- Corps Éditorial -->
              <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                <div>
                  <h3 class={`font-press font-bold text-white group-hover:text-amber-300 transition leading-snug ${isLead ? 'text-2xl sm:text-3xl' : 'text-lg sm:text-xl'}`}>
                    <a href={`./enquetes/${enquete.slug}/`} class="hover:underline">
                      {displayTitle}
                    </a>
                  </h3>
                  <p class="text-slate-300 text-xs sm:text-sm line-clamp-3 mt-3 leading-relaxed font-press">
                    {d.chapeau}
                  </p>
                </div>

                <div class="pt-4 border-t border-white/10 flex items-center justify-between font-mono-tech text-xs">
                  <a 
                    href={`./enquetes/${enquete.slug}/`} 
                    class="theme-gold-text font-bold uppercase tracking-wider text-[11px] group-hover:underline flex items-center gap-1.5"
                  >
                    <span>Consulter le Dossier</span>
                    <span>→</span>
                  </a>

                  <button
                    type="button"
                    class="px-2.5 py-1 rounded bg-black/60 hover:bg-amber-400 hover:text-black text-slate-400 border border-white/20 hover:border-amber-400 text-[10px] font-bold transition"
                    data-share-title={displayTitle}
                    data-share-url={`./enquetes/${enquete.slug}/`}
                    data-share-chapeau={d.chapeau}
                    onclick="event.preventDefault(); openShareModal(this);"
                  >
                    Partager
                  </button>
                </div>
              </div>

            </article>
          );
        })}
      </div>

    </section>

    <!-- ================= 3. LE SYSTEME SIG & CADASTRE 360 COMMUNES ================= -->
    <section class="space-y-4 pt-10 border-t border-white/10" id="gis-map">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
        <div>
          <span class="font-mono-tech text-xs theme-gold-text uppercase tracking-widest block">GÉOLOCALISATION FORENSIQUE</span>
          <h2 class="text-2xl sm:text-3xl font-press font-bold text-white">Carte Interactive des 360 Communes de Corse</h2>
        </div>
        <span class="font-mono-tech text-xs text-slate-400">Cadastre DGFiP · Coordonnées WGS84</span>
      </div>
      <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <GisMap />
      </div>
    </section>

    <!-- ================= 4. LE RADAR FONCIER DVF ================= -->
    <section class="space-y-4 pt-10 border-t border-white/10" id="foncier-dvf">
      <div class="flex items-center justify-between">
        <div>
          <span class="font-mono-tech text-xs theme-gold-text uppercase tracking-widest block">DONNÉES OFFICIELLES DVF</span>
          <h2 class="text-2xl sm:text-3xl font-press font-bold text-white">Radar des Transactions & Spéculation Foncière</h2>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <FoncierDvfRadar />
      </div>
    </section>

    <!-- ================= 5. LE DROIT DE SAVOIR : GÉNÉRATEUR CADA ================= -->
    <section class="space-y-4 pt-10 border-t border-white/10" id="cada">
      <div class="flex items-center justify-between">
        <div>
          <span class="font-mono-tech text-xs text-emerald-400 uppercase tracking-widest block">SOUVERAINETÉ POPULAIRE DIRECTE</span>
          <h2 class="text-2xl sm:text-3xl font-press font-bold text-white">Générateur Automatique de Recours CADA</h2>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
        <CadaGenerator />
      </div>
    </section>

    <!-- ================= 6. DOCTRINE DES PREUVES & CHAÎNE ISO 27037 ================= -->
    <section class="space-y-4 pt-10 border-t border-white/10" id="doctrine">
      <DoctrinePreuves />
    </section>

  </main>

