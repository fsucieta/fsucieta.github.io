---
// Page Pilote d'Émancipation Populaire & d'Espoir : L'Aube de L'OCHJU
// localhost:4330/proto/espoir-emancipation/
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allEnquetes = await getCollection('enquetes');
const idsFinalises = [22, 18, 27, 7, 23, 28, 26, 4, 11];
const dossiers = idsFinalises
  .map(id => allEnquetes.find(e => e.data.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));

// Les 5 Piliers d'Espoir Concret (La Corse Souveraine de Demain)
const solutionsEspoir = [
  {
    secteur: "ÉPARGNE & BANQUE LOCALE",
    constatPillage: "10 475 € siphonnés par famille vers les holdings parisiennes",
    solutionSouveraine: "Création de la Caisse d'Épargne & de Crédit Populaire Corse",
    gainCitoyen: "Crédit à taux zéro pour chaque artisan, paysan et jeune primo-accédant corse",
    statutLegal: "Fonds souverain territorial sous contrôle citoyen direct (Art. 72 de la Constitution)"
  },
  {
    secteur: "ÉNERGIE & RESSOURCES NATURELLES",
    constatPillage: "2 140 € de surcoût par an pour alimenter la rente fioul lourd d'EDF-SEI",
    solutionSouveraine: "Régie Publique de l'Énergie Corse (Hydroélectricité + Solaire insulaire)",
    gainCitoyen: "Baisse immédiate de 35% de la facture électrique pour tous les foyers insulaires",
    statutLegal: "Reprise des concessions hydroélectriques échues (Directives européennes & CGCT)"
  },
  {
    secteur: "EAU POTABLE DU PEUPLE",
    constatPillage: "68% de fuites d'eau payées par les usagers pendant que les marges privées explosent",
    solutionSouveraine: "Régie Municipale & Intercommunale de l'Eau à Prix Coûtant",
    gainCitoyen: "Les 40 premiers mètres cubes gratuits pour chaque famille, fin des dividendes privés",
    statutLegal: "Retour en régie directe d'office pour motif d'intérêt général"
  },
  {
    secteur: "TERRE, CADASTRE & LOGEMENT",
    constatPillage: "4 200 hectares gelés et terres agricoles accaparées pour la spéculation",
    solutionSouveraine: "Sanctuarisation Foncier Populaire & Statut de Résident Opposable",
    gainCitoyen: "Priorité absolue aux enfants de cette terre pour vivre et bâtir au village",
    statutLegal: "Modèle constitutionnel des îles Åland (Union Européenne - Protocole n°2)"
  },
  {
    secteur: "CARBURANT & FRET ESSENTIEL",
    constatPillage: "Rente monopolistique de +0,18 € par litre de carburant sur les dépôts pétroliers",
    solutionSouveraine: "Nationalisation Territoriale des Dépôts & Régie Fret Citoyenne",
    gainCitoyen: "Carburant au prix coûtant réel sans surtaxe occulte de holding",
    statutLegal: "Saisine Antitrust & Expropriation pour cause d'utilité publique majeure"
  }
];
---

<Layout 
  title="L'OCHJU — Le Réveil Populaire & L'Inversion de la Dette"
  description="La Corse n'est pas pauvre : on l'appauvrit. Découvrez les preuves médico-légales de notre richesse confisquée et les armes républicaines pour bâtir notre souveraineté."
>
  <div class="min-h-screen bg-[#06080d] text-slate-100 selection:bg-amber-400 selection:text-slate-950 font-sans">
    
    <!-- HEADER SOLENNEL & ÉPURÉ -->
    <header class="border-b border-amber-500/20 bg-[#06080d]/95 backdrop-blur-md sticky top-0 z-50 py-3.5 px-6">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <a href="../../" class="flex items-center gap-3 group">
          <img 
            src="../../logo_l_ochju.jpg" 
            alt="Logo L'OCHJU" 
            class="h-10 sm:h-12 w-auto rounded border border-amber-500/50 shadow-md group-hover:border-amber-400 transition" 
          />
          <div>
            <span class="block text-lg font-serif font-black tracking-widest text-slate-100 group-hover:text-amber-300 transition">L'OCHJU</span>
            <span class="block text-[9px] font-mono tracking-widest text-amber-400/90 uppercase font-semibold">Le regard qui ne se détourne plus</span>
          </div>
        </a>

        <!-- Bouton Munitions Citoyennes Directes -->
        <div class="flex items-center gap-3">
          <a 
            href="#munitions-section" 
            class="text-xs font-mono bg-gradient-to-r from-amber-500 to-amber-400 text-slate-950 px-4 py-2 rounded font-black tracking-wider uppercase transition hover:brightness-110 shadow-lg shadow-amber-500/20 flex items-center gap-1.5"
          >
            <span>ARMES LÉGALES</span>
            <span class="hidden sm:inline">CITOYENNES</span>
          </a>
        </div>
      </div>
    </header>

    <!-- SECTION 1 : LE CHOC INITIAL DE L'ESPOIR (Le Mythe Brisé) -->
    <section class="max-w-5xl mx-auto px-6 pt-16 pb-20 text-center">
      
      <!-- Sceau de Légitimité Populaire -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 font-mono text-xs font-bold uppercase tracking-wider mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>DÉMONSTRATION COMPTABLE OFFICIELLE · 29 DOSSIERS SCELLÉS ISO 27037</span>
      </div>

      <!-- Titre d'Espoir Monumental -->
      <h1 class="text-3xl sm:text-5xl md:text-6xl font-serif font-black text-white leading-[1.1] mb-8">
        On vous a fait croire que la Corse était pauvre. <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-200 to-amber-400">
          Les chiffres prouvent que c'est nous qui les enrichissons.
        </span>
      </h1>

      <p class="text-base sm:text-xl text-slate-300 font-serif max-w-3xl mx-auto leading-relaxed mb-12">
        Pendant des décennies, on a nourri notre peuple d'une honte artificielle : nous serions sous perfusion, incapables de vivre sans la charité d'autrui. 
        <strong class="text-amber-300 font-bold block mt-3 font-sans">
          C'est faux. Les actes officiels du greffe démontrent l'exact opposé : la Corse est un géant économique confisqué.
        </strong>
      </p>

      <!-- ÉQUATION DU RÉVEIL : LE DOUBLE ÉTAGÈRE EN FRONTALE -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto text-left">
        
        <!-- Carte 1 : Le Mensonge Déconstruit -->
        <div class="p-6 sm:p-8 rounded-xl bg-[#0b0f17] border border-rose-500/40 shadow-xl relative overflow-hidden">
          <div class="flex items-center justify-between font-mono text-[10px] text-rose-400 uppercase tracking-widest mb-3">
            <span>Le Discours de l'Impuissance</span>
            <span>RÉCIT OFFICIEL</span>
          </div>
          <span class="block text-4xl font-mono font-black text-rose-400 mb-2">3,0 Md€</span>
          <span class="text-sm font-serif font-bold text-slate-200 block mb-2">La prétendue perfusion d'aides publiques</span>
          <p class="text-xs font-sans text-slate-400 leading-relaxed">
            Le prétexte permanent pour justifier le statu quo, la dépendance et le refus du statut d'autonomie réelle.
          </p>
        </div>

        <!-- Carte 2 : La Vérité Émancipatrice -->
        <div class="p-6 sm:p-8 rounded-xl bg-gradient-to-b from-[#101927] to-[#090d14] border-2 border-amber-400 shadow-2xl shadow-amber-500/15 relative overflow-hidden">
          <div class="flex items-center justify-between font-mono text-[10px] text-amber-400 uppercase tracking-widest mb-3">
            <span>La Réalité Médico-Légale</span>
            <span>PIÈCES SCELLÉES</span>
          </div>
          <span class="block text-4xl font-mono font-black text-amber-300 mb-2">4,72 Md€</span>
          <span class="text-sm font-serif font-bold text-white block mb-2">Siphonnés chaque année hors de notre île</span>
          <p class="text-xs font-sans text-slate-300 leading-relaxed">
            Banques, concessions énergétiques, rentes pétrolières et grande distribution : <strong>28 693 € par foyer</strong> s'évaporent au profit d'actionnaires lointains.
          </p>
        </div>

      </div>

      <!-- LE SOLDE RÉEL D'ÉMANCIPATION -->
      <div class="mt-8 p-5 max-w-4xl mx-auto rounded-lg bg-emerald-950/20 border border-emerald-500/40 text-emerald-300 font-mono text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3 text-left">
          <span class="w-3 h-3 rounded-full bg-emerald-400 shrink-0"></span>
          <span><strong>LE VERDICT DES COMPTES :</strong> La Corse a un solde créditeur net de <strong>+1,72 milliard d'euros</strong> par an.</span>
        </div>
        <span class="px-3 py-1 bg-emerald-500/20 text-emerald-200 rounded font-bold uppercase tracking-wider text-xs shrink-0">
          NOUS SOMMES LES CRÉANCIERS
        </span>
      </div>

    </section>

    <!-- SECTION 2 : L'AVENIR QUE NOUS BÂTISSONS (L'Espoir en Actes) -->
    <section class="max-w-6xl mx-auto px-6 py-16 border-t border-amber-500/20">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest bg-amber-500/10 px-3 py-1 rounded border border-amber-500/30 inline-block mb-3">
          LE RETOUR DE LA SOUVERAINETÉ POPULAIRE
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-black text-white leading-tight">
          Ce que devient la Corse dès que nous fermons les robinets de la spoliation
        </h2>
        <p class="text-slate-400 text-sm mt-3 font-sans">
          Chaque centime récupéré est réinjecté directement dans la vie de nos familles, de nos villages et de notre jeunesse.
        </p>
      </div>

      <!-- La Grille des 5 Souverainetés Concrètes -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {solutionsEspoir.map((s, index) => (
          <div class="p-6 rounded-xl bg-[#0a0e16] border border-[#1e293b] hover:border-amber-400/70 transition-all duration-300 flex flex-col justify-between group shadow-xl">
            <div>
              <div class="flex items-center justify-between font-mono text-[10px] text-amber-400 font-bold mb-3 pb-2 border-b border-[#1c2433]">
                <span>PILIER #{String(index + 1).padStart(2, '0')}</span>
                <span class="text-slate-500 uppercase">{s.secteur}</span>
              </div>

              <!-- Ce qu'ils nous volent -->
              <div class="mb-4">
                <span class="text-[9px] font-mono uppercase text-rose-400 tracking-wider block">Le Pillage Actuel :</span>
                <p class="text-xs font-sans text-slate-300 mt-0.5 line-clamp-2">
                  {s.constatPillage}
                </p>
              </div>

              <!-- La Solution L'OCHJU -->
              <div class="mb-4 p-3 rounded bg-[#06080d] border border-amber-500/30">
                <span class="text-[9px] font-mono uppercase text-amber-400 font-bold tracking-wider block">La Solution Souveraine :</span>
                <p class="text-sm font-serif font-bold text-white mt-1 leading-snug">
                  {s.solutionSouveraine}
                </p>
              </div>

              <!-- Le Gain Direct Famille -->
              <div>
                <span class="text-[9px] font-mono uppercase text-emerald-400 font-bold tracking-wider block">Le Gain Concret pour Vous :</span>
                <p class="text-xs font-sans text-emerald-200/90 mt-1 leading-relaxed">
                  {s.gainCitoyen}
                </p>
              </div>
            </div>

            <!-- Cadre Juridique Opposable -->
            <div class="mt-6 pt-3 border-t border-[#1c2433] text-[10px] font-mono text-slate-500 flex items-center justify-between">
              <span class="truncate">{s.statutLegal}</span>
              <span class="text-amber-400 group-hover:translate-x-1 transition font-bold font-sans">→</span>
            </div>
          </div>
        ))}

        <!-- Carte 6 Spéciale : Le Grand Mémorandum d'Émancipation -->
        <div class="p-6 rounded-xl bg-gradient-to-br from-amber-500/15 via-[#0b0f17] to-[#06080d] border-2 border-amber-400 flex flex-col justify-between shadow-2xl">
          <div>
            <div class="flex items-center justify-between font-mono text-[10px] text-amber-300 font-bold mb-3 pb-2 border-b border-amber-500/30">
              <span>CADRE GLOBAL</span>
              <span>CONSTITUTIONNEL</span>
            </div>
            <h3 class="text-xl font-serif font-black text-white leading-snug mb-3">
              Le Mémorandum d'Émancipation de la Corse
            </h3>
            <p class="text-xs font-sans text-slate-300 leading-relaxed mb-4">
              L'architecture juridique complète fondée sur le droit international et le modèle d'Åland pour formaliser la créance de la Corse sur l'État et reprendre le contrôle de notre avenir.
            </p>
          </div>
          <a 
            href="../../analyse-globale-finale/" 
            class="px-4 py-2.5 rounded bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono text-xs font-black uppercase tracking-wider text-center transition shadow-lg"
          >
            CONSULTER LE MÉMORANDUM COMPLET →
          </a>
        </div>
      </div>

    </section>

    <!-- SECTION 3 : LES MUNITIONS CITOYENNES (L'Action Concrète Immédiate) -->
    <section class="max-w-5xl mx-auto px-6 py-16 border-t border-amber-500/20" id="munitions-section">
      
      <div class="bg-gradient-to-b from-[#0e1420] to-[#070a10] border-2 border-amber-500/60 rounded-2xl p-8 sm:p-12 shadow-2xl relative overflow-hidden">
        
        <div class="max-w-3xl">
          <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block mb-2">
            DOCTRINE DE SOUVERAINETÉ POPULAIRE
          </span>
          <h2 class="text-3xl sm:text-4xl font-serif font-black text-white leading-tight mb-4">
            L'OCHJU ne demande rien à l'État. <br/>
            <span class="text-amber-300">Nous donnons les armes au Peuple.</span>
          </h2>
          <p class="text-slate-300 text-sm sm:text-base font-serif leading-relaxed mb-8">
            La Cellule ne dépose aucune plainte : ce n'est pas à des experts d'agir à votre place. Toutes nos preuves sont scellées sous empreinte cryptographique SHA-256 (norme ISO/IEC 27037). Téléchargez vos kits d'action et portez vous-mêmes les délibérations et sommations devant vos élus et tribunaux.
          </p>
        </div>

        <!-- Le Triptyque des Armes Populaires -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
          
          <div class="p-4 rounded-lg bg-[#05070a] border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">01 · KIT PRESSE</span>
            <span class="text-slate-200 font-serif font-bold block mb-1">Pour les Médias & Citoyens</span>
            <p class="text-[11px] font-sans text-slate-400 mb-4">Les faits bruts, graphiques et chiffres certifiés prêts à diffuser sans risque juridique.</p>
            <span class="text-[10px] text-emerald-400 font-bold">100% LIBRE ACCÈS</span>
          </div>

          <div class="p-4 rounded-lg bg-[#05070a] border border-amber-500/40">
            <span class="text-amber-400 font-bold block mb-1">02 · BORDEREAU TRIBUNAL</span>
            <span class="text-white font-serif font-bold block mb-1">Vos Munitions Judiciaires</span>
            <p class="text-[11px] font-sans text-slate-300 mb-4">Actes préfectoraux et bilans certifiés prêts pour saisir le procureur ou le tribunal administratif.</p>
            <span class="text-[10px] text-amber-300 font-bold">OPPOSABLE EN JUSTICE</span>
          </div>

          <div class="p-4 rounded-lg bg-[#05070a] border border-slate-800">
            <span class="text-amber-400 font-bold block mb-1">03 · SOMMATION D'ÉLUS</span>
            <span class="text-slate-200 font-serif font-bold block mb-1">Interpellation en Conseil</span>
            <p class="text-[11px] font-sans text-slate-400 mb-4">Modèles de délibérations municipales et territoriales pour forcer le vote de la régie publique.</p>
            <span class="text-[10px] text-emerald-400 font-bold">FORCE DE LOI LOCALE</span>
          </div>

        </div>

      </div>

    </section>

    <!-- FOOTER RITUEL SOUVERAIN -->
    <footer class="border-t border-[#1c2433] bg-[#05070a] py-12 px-6 text-center font-mono text-xs text-slate-500">
      <div class="max-w-4xl mx-auto space-y-4">
        <p class="text-sm font-serif italic text-slate-300">
          « Le Savoir partagé est notre contre-pouvoir. L'OCHJU, c'est le regard qui ne se détourne plus. »
        </p>
        <div class="flex items-center justify-center gap-4 text-[10px]">
          <span>CELLULE D'INVESTIGATION L'OCHJU</span>
          <span>•</span>
          <span>NORME ISO/IEC 27037 SCELLÉE</span>
          <span>•</span>
          <span>SOUVERAINETÉ POPULAIRE</span>
        </div>
      </div>
    </footer>

  </div>
</Layout>
