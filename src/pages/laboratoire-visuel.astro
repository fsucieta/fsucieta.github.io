---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Laboratoire Visuel & Composants Tactiques — L'OCHJU" 
  description="Banc d'essai des nouvelles technologies graphiques et interactives open-source pour les enquêtes de L'OCHJU."
>
  <!-- En-tête du Laboratoire -->
  <header class="border-b border-amber-500/20 bg-slate-950/80 backdrop-blur-md sticky top-0 z-50 py-4 px-6">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-3">
        <a href="../" class="text-amber-400 hover:text-amber-300 transition text-sm font-bold flex items-center gap-2">
          <span>← RETOUR AU SITE</span>
        </a>
        <span class="text-slate-600">|</span>
        <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 bg-cyan-950/40 border border-cyan-500/30 px-2.5 py-1 rounded-full">
          🧪 Banc d'Essai Local
        </span>
      </div>
      <div class="text-xs font-mono text-slate-400 hidden sm:block">
        LABORATOIRE VISUEL L'OCHJU v1.0
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 space-y-20">

    <!-- INTRO -->
    <section class="text-center space-y-4">
      <h1 class="text-3xl md:text-5xl font-black text-slate-100 font-serif">
        Laboratoire des Composants Visuels
      </h1>
      <p class="text-slate-400 font-sans max-w-2xl mx-auto text-sm md:text-base">
        Tous ces composants sont 100 % open-source, ultra-légers, responsives et respectent l'identité graphique sombre de <strong>L'OCHJU</strong>. Testez-les directement ci-dessous.
      </p>
    </section>

    <!-- ========================================================================= -->
    <!-- DÉMO 1 : CARTOUCHE VERRE FUMÉ 3D (GLASSMORPHISM & GLOW NÉON) -->
    <!-- ========================================================================= -->
    <section class="space-y-4">
      <div class="flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-wider font-bold">
        <span>01</span> <span>·</span> <span>Cartouche de Preuve en Verre Fumé 3D & Halo Ambré</span>
      </div>

      <!-- Le Bloc Verre Fumé -->
      <div class="relative group rounded-2xl p-[1px] bg-gradient-to-b from-amber-500/40 via-amber-500/10 to-transparent shadow-[0_0_30px_-5px_rgba(245,158,11,0.15)] hover:shadow-[0_0_40px_-2px_rgba(245,158,11,0.25)] transition-all duration-500">
        
        <!-- Intérieur Translucide -->
        <div class="relative bg-slate-900/60 backdrop-blur-xl rounded-2xl p-6 md:p-8 space-y-5 border border-white/5">
          
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4">
            <div class="flex items-center gap-2">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">
                ISO/IEC 27037 Scellé & Opposable
              </span>
            </div>
            <span class="text-[11px] font-mono text-slate-400 bg-slate-800/80 px-2.5 py-1 rounded-md border border-slate-700">
              COTE : DUP-2A-2023-12-04-00001
            </span>
          </div>

          <div class="space-y-2">
            <h3 class="text-xl font-serif font-bold text-slate-100">
              Délibération CAPA N° 2023/184 — Avenant Financier Secret
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed font-sans">
              Cet acte public certifie le transfert d'une indemnité forfaitaire de <strong class="text-amber-400 font-bold">2 390 000 €</strong> vers la filiale POMA sans mise en concurrence préalable, validée sous avis tacite.
            </p>
          </div>

          <!-- Ligne de Hash Cryptographique Cliquable -->
          <div class="bg-black/40 rounded-xl p-3 border border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 font-mono text-xs">
            <div class="flex items-center gap-2 text-slate-400 truncate">
              <span class="text-amber-400 font-bold">SHA-256 :</span>
              <span class="text-slate-300 select-all font-mono text-[11px] truncate">0e4dc5d256a817e783594ecf33f26a2610b6f6b02fe20174adb623be8da49f5a</span>
            </div>
            <button 
              onclick="navigator.clipboard.writeText('0e4dc5d256a817e783594ecf33f26a2610b6f6b02fe20174adb623be8da49f5a'); alert('Empreinte SHA-256 copiée dans le presse-papier !');"
              class="px-3 py-1.5 rounded-lg bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold transition flex items-center gap-1.5 shrink-0 cursor-pointer"
            >
              <span>📋</span> <span>Copier l'Empreinte</span>
            </button>
          </div>

        </div>
      </div>
      <p class="text-xs text-slate-500 font-sans">
        💡 <em>Effet : verre fumé translucide biseauté, halo néon ambré diffus, pastille émeraude pulsante et bouton de copie forensique directe.</em>
      </p>
    </section>

    <!-- ========================================================================= -->
    <!-- DÉMO 2 : SLIDER AVANT / APRÈS INTERACTIF (SATELLITE & TERRASEMENT) -->
    <!-- ========================================================================= -->
    <section class="space-y-4">
      <div class="flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-wider font-bold">
        <span>02</span> <span>·</span> <span>Slider Avant / Après Tactile (Comparateur Satellite Foncier)</span>
      </div>

      <!-- Conteneur du Slider -->
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden border border-slate-800 shadow-2xl select-none group" id="slider-container">
        
        <!-- Image "APRÈS" (Arrière-plan : Terrassement / Chantier) -->
        <div class="absolute inset-0 bg-slate-900 flex flex-col items-center justify-center text-center p-6 bg-gradient-to-br from-red-950/40 to-slate-900">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-red-400 font-bold bg-red-950/60 border border-red-500/40 px-3 py-1 rounded-full">
              SATELLITE SENTINEL-2 · OCTOBRE 2026 (APRÈS)
            </span>
            <h4 class="text-xl md:text-2xl font-black text-slate-100 font-serif">
              Terrassement en Zone Protégée PADDUC
            </h4>
            <p class="text-slate-400 text-xs md:text-sm max-w-md">
              Décapage végétal de 14 000 m² constaté sans autorisation de défrichement préalable (Infraction Code Forestier Art. L.341-3).
            </p>
          </div>
        </div>

        <!-- Image "AVANT" (Premier-plan découpé par le curseur) -->
        <div class="absolute inset-y-0 left-0 bg-slate-950 border-r-2 border-amber-400 flex flex-col items-center justify-center text-center p-6 bg-gradient-to-br from-emerald-950/40 to-slate-950 overflow-hidden" id="slider-before" style="width: 50%;">
          <div class="space-y-2 whitespace-nowrap">
            <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-500/40 px-3 py-1 rounded-full">
              SATELLITE COPERNICUS · MAI 2023 (AVANT)
            </span>
            <h4 class="text-xl md:text-2xl font-black text-slate-100 font-serif">
              Maquis Primaire Intact (ESA)
            </h4>
            <p class="text-slate-400 text-xs md:text-sm">
              Espace Stratégique Agricole sanctuarisé au cadastre DGFiP.
            </p>
          </div>
        </div>

        <!-- Curseur Interactif Réglable (Input Range Invisible au-dessus) -->
        <input 
          type="range" 
          min="0" 
          max="100" 
          value="50" 
          class="absolute inset-0 w-full h-full opacity-0 cursor-ew-resize z-30" 
          id="slider-range" 
          oninput="document.getElementById('slider-before').style.width = this.value + '%'; document.getElementById('slider-handle').style.left = this.value + '%';"
        />

        <!-- Poignée Visuelle de Glisse -->
        <div class="absolute inset-y-0 pointer-events-none z-20 flex items-center justify-center -ml-4" id="slider-handle" style="left: 50%;">
          <div class="w-8 h-8 rounded-full bg-amber-400 text-slate-950 font-black flex items-center justify-center shadow-lg text-xs">
            ⇄
          </div>
        </div>

      </div>
      <p class="text-xs text-slate-500 font-sans">
        💡 <em>Action : Glissez votre souris ou votre doigt sur le curseur central ⇄ pour révéler l'avant/après.</em>
      </p>
    </section>

    <!-- ========================================================================= -->
    <!-- DÉMO 3 : EFFET DE SCROLLYTELLING (RÉVÉLATION DE CHIFFRE AU DÉFILEMENT) -->
    <!-- ========================================================================= -->
    <section class="space-y-4">
      <div class="flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-wider font-bold">
        <span>03</span> <span>·</span> <span>Scrollytelling & Métriques Chocs Dynamiques</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Chiffre 1 -->
        <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-5 hover:border-amber-500/40 transition group">
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-1">Coût Consolidé</div>
          <div class="text-3xl md:text-4xl font-serif font-black text-amber-400 group-hover:scale-105 transition-transform origin-left">
            62 000 000 €
          </div>
          <div class="text-xs text-slate-500 mt-2 font-sans">Dépassement de +210 % par rapport à l'estimation initiale de 2018.</div>
        </div>

        <!-- Chiffre 2 -->
        <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-5 hover:border-red-500/40 transition group">
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-1">Déficit Annuel Projeté</div>
          <div class="text-3xl md:text-4xl font-serif font-black text-red-400 group-hover:scale-105 transition-transform origin-left">
            1 800 000 € / an
          </div>
          <div class="text-xs text-slate-500 mt-2 font-sans">À la charge directe du contribuable ajaccien via le budget principal.</div>
        </div>

        <!-- Chiffre 3 -->
        <div class="bg-slate-900/50 border border-slate-800 rounded-xl p-5 hover:border-emerald-500/40 transition group">
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider mb-1">Gain Solution Citoyenne</div>
          <div class="text-3xl md:text-4xl font-serif font-black text-emerald-400 group-hover:scale-105 transition-transform origin-left">
            + 104 500 € / an
          </div>
          <div class="text-xs text-slate-500 mt-2 font-sans">Autofinancement net via l'extension ferroviaire CFC (Art. L.6 CCP).</div>
        </div>
      </div>
      <p class="text-xs text-slate-500 font-sans">
        💡 <em>Effet : mise en valeur des 3 grandeurs scalaires avec contraste thermique (Ambre / Rouge / Émeraude).</em>
      </p>
    </section>

    <!-- ========================================================================= -->
    <!-- DÉMO 4 : MINI-GRAPHE INTERACTIF DES CONFLITS D'INTÉRÊTS -->
    <!-- ========================================================================= -->
    <section class="space-y-4">
      <div class="flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-wider font-bold">
        <span>04</span> <span>·</span> <span>Cartographie Relationnelle des Réseaux d'Affaires</span>
      </div>

      <div class="bg-slate-900/40 border border-slate-800 rounded-2xl p-6 md:p-8 space-y-6">
        <div class="flex items-center justify-between">
          <h4 class="text-base font-serif font-bold text-slate-200">
            Nœud d'Intérêts : Marché de la Continuité Numérique
          </h4>
          <span class="text-xs font-mono text-cyan-400 bg-cyan-950/40 border border-cyan-500/30 px-2 py-0.5 rounded">
            Standard FollowTheMoney
          </span>
        </div>

        <!-- Schéma SVG Relationnel Interactif -->
        <div class="w-full overflow-x-auto py-4">
          <div class="min-w-[500px] flex items-center justify-between gap-4 relative">
            
            <!-- Nœud 1 : Collectivité -->
            <div class="flex-1 bg-slate-950 border border-amber-500/40 rounded-xl p-4 text-center space-y-1 shadow-lg shadow-amber-500/5">
              <span class="text-[10px] font-mono text-amber-400 uppercase font-bold">Autorité Publique</span>
              <div class="text-sm font-bold text-slate-100">Collectivité Publique</div>
              <div class="text-[11px] text-slate-400">Budget engagé : 14,2 M€</div>
            </div>

            <!-- Flèche Flux -->
            <div class="flex flex-col items-center justify-center px-2">
              <span class="text-[10px] font-mono text-slate-500 font-bold mb-1">DSP 12 ans</span>
              <div class="w-12 h-0.5 bg-gradient-to-r from-amber-500 to-cyan-500"></div>
              <span class="text-[10px] text-slate-600 mt-1">▶</span>
            </div>

            <!-- Nœud 2 : Société Délégataire -->
            <div class="flex-1 bg-slate-950 border border-cyan-500/40 rounded-xl p-4 text-center space-y-1 shadow-lg shadow-cyan-500/5">
              <span class="text-[10px] font-mono text-cyan-400 uppercase font-bold">Délégataire Privé</span>
              <div class="text-sm font-bold text-slate-100">Société Holding X</div>
              <div class="text-[11px] text-slate-400">Siège : Paris 8e</div>
            </div>

            <!-- Flèche Dividendes -->
            <div class="flex flex-col items-center justify-center px-2">
              <span class="text-[10px] font-mono text-red-400 font-bold mb-1">Remontée Cash</span>
              <div class="w-12 h-0.5 bg-gradient-to-r from-cyan-500 to-red-500"></div>
              <span class="text-[10px] text-slate-600 mt-1">▶</span>
            </div>

            <!-- Nœud 3 : Bénéficiaire Final -->
            <div class="flex-1 bg-slate-950 border border-red-500/40 rounded-xl p-4 text-center space-y-1 shadow-lg shadow-red-500/5">
              <span class="text-[10px] font-mono text-red-400 uppercase font-bold">Actionnaire Ultime</span>
              <div class="text-sm font-bold text-slate-100">Fonds d'Investissement</div>
              <div class="text-[11px] text-slate-400">Dividende : 3,8 M€/an</div>
            </div>

          </div>
        </div>
      </div>
      <p class="text-xs text-slate-500 font-sans">
        💡 <em>Effet : visualisation immédiate du tuyau de siphonage financier entre l'argent public local et la remontée de dividendes extérieurs.</em>
      </p>
    </section>

    <!-- ========================================================================= -->
    <!-- DÉMO 5 : LECTEUR AUDIO HAUTE FIDÉLITÉ (AUDIO BRIEFING SOUVERAIN) -->
    <!-- ========================================================================= -->
    <section class="space-y-4">
      <div class="flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-wider font-bold">
        <span>05</span> <span>·</span> <span>Lecteur Audio Citoyen Épuré (Briefing 3 minutes)</span>
      </div>

      <div class="bg-slate-900/60 border border-amber-500/30 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="flex items-center gap-4 w-full sm:w-auto">
          <!-- Bouton Play Tactique -->
          <button 
            onclick="const audio = document.getElementById('demo-audio-player'); if(audio.paused){ audio.play(); this.innerHTML='⏸'; } else { audio.pause(); this.innerHTML='▶'; }"
            class="w-14 h-14 rounded-full bg-gradient-to-tr from-amber-500 to-amber-300 text-slate-950 font-black flex items-center justify-center text-xl shadow-lg shadow-amber-500/20 hover:scale-105 transition-transform shrink-0 cursor-pointer"
          >
            ▶
          </button>
          
          <div class="space-y-1">
            <div class="text-xs font-mono text-amber-400 uppercase tracking-wider font-bold">
              AUDIO BRIEFING L'OCHJU
            </div>
            <div class="text-sm font-bold text-slate-100">
              Synthèse Vocale : 3 minutes pour tout comprendre
            </div>
            <div class="text-xs text-slate-400 font-mono">
              Voix souveraine locale · Fichier MP3 certifié SHA-256
            </div>
          </div>
        </div>

        <!-- Fausse Onde Sonore Ambrée Animée -->
        <div class="flex items-center gap-1 h-8 px-4 py-2 bg-black/40 rounded-xl border border-white/5 w-full sm:w-auto justify-center">
          <span class="w-1 bg-amber-400/80 rounded-full h-3 animate-pulse"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-6 animate-pulse delay-75"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-4 animate-pulse delay-100"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-7 animate-pulse delay-150"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-5 animate-pulse delay-200"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-8 animate-pulse delay-300"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-4 animate-pulse delay-150"></span>
          <span class="w-1 bg-amber-400/80 rounded-full h-2 animate-pulse delay-75"></span>
        </div>

        <audio id="demo-audio-player" class="hidden">
          <source src="/briefing_audio_demo.mp3" type="audio/mpeg">
        </audio>
      </div>
      <p class="text-xs text-slate-500 font-sans">
        💡 <em>Effet : lecteur audio sans distraction commerciale, avec onde sonore vivante et contrôle direct.</em>
      </p>
    </section>

  </main>
</Layout>
