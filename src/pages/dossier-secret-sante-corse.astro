<script is:inline>
  const TARGET_HASH = "b9beef0497b6b2aefd56ad4a88a72f472adccbc7bd62601d217738d24589ab62";
  const MAX_ATTEMPTS = 5;
  const LOCKOUT_TIME_MS = 30000;

  async function sha256(message) {
    const msgBuffer = new TextEncoder().encode(message.trim());
    const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
  }

  function constantTimeCompare(a, b) {
    if (a.length !== b.length) return false;
    let result = 0;
    for (let i = 0; i < a.length; i++) {
      result |= a.charCodeAt(i) ^ b.charCodeAt(i);
    }
    return result === 0;
  }

  function unlockVault() {
    const lockScreen = document.getElementById('auth-lock-screen');
    const vaultContent = document.getElementById('vault-content');
    if (lockScreen && vaultContent) {
      lockScreen.classList.add('hidden');
      vaultContent.classList.remove('hidden');
    }
  }

  function lockVault() {
    sessionStorage.removeItem('lochju_vault_token_sante_corse');
    const lockScreen = document.getElementById('auth-lock-screen');
    const vaultContent = document.getElementById('vault-content');
    if (lockScreen && vaultContent) {
      vaultContent.classList.add('hidden');
      lockScreen.classList.remove('hidden');
    }
  }

  if (sessionStorage.getItem('lochju_vault_token_sante_corse') === 'authorized') {
    unlockVault();
  }

  const authForm = document.getElementById('auth-form');
  const authError = document.getElementById('auth-error');
  const authLockout = document.getElementById('auth-lockout');
  const passwordInput = document.getElementById('access-key-input');
  const lockVaultBtn = document.getElementById('lock-vault-btn');

  let failedAttempts = parseInt(sessionStorage.getItem('lochju_auth_failed_sante') || '0', 10);
  let lockoutUntil = parseInt(sessionStorage.getItem('lochju_auth_lockout_sante') || '0', 10);

  function checkLockout() {
    const now = Date.now();
    if (lockoutUntil > now) {
      if (authLockout) authLockout.classList.remove('hidden');
      if (authForm) {
        const btn = authForm.querySelector('button');
        if (btn) btn.disabled = true;
      }
      return true;
    } else {
      if (authLockout) authLockout.classList.add('hidden');
      if (authForm) {
        const btn = authForm.querySelector('button');
        if (btn) btn.disabled = false;
      }
      return false;
    }
  }

  checkLockout();

  if (authForm) {
    authForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (checkLockout()) return;

      const entered = passwordInput.value;
      const hashed = await sha256(entered);

      if (constantTimeCompare(hashed, TARGET_HASH)) {
        sessionStorage.setItem('lochju_vault_token_sante_corse', 'authorized');
        sessionStorage.removeItem('lochju_auth_failed_sante');
        sessionStorage.removeItem('lochju_auth_lockout_sante');
        if (authError) authError.classList.add('hidden');
        unlockVault();
      } else {
        failedAttempts++;
        sessionStorage.setItem('lochju_auth_failed_sante', failedAttempts.toString());
        if (authError) authError.classList.remove('hidden');
        if (failedAttempts >= MAX_ATTEMPTS) {
          lockoutUntil = Date.now() + LOCKOUT_TIME_MS;
          sessionStorage.setItem('lochju_auth_lockout_sante', lockoutUntil.toString());
          checkLockout();
        }
      }
    });
  }

  if (lockVaultBtn) {
    lockVaultBtn.addEventListener('click', lockVault);
  }

  // SIMULATEUR INTERACTIF
  const slider = document.getElementById('rapatriement-slider');
  const sliderVal = document.getElementById('slider-val');
  const recettesSpan = document.getElementById('recettes-rapatriees');
  const postesSpan = document.getElementById('postes-titulaires');

  if (slider && sliderVal && recettesSpan && postesSpan) {
    slider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      sliderVal.textContent = val + ' %';
      
      const recettes = (83.25 * (val / 100)).toFixed(2);
      recettesSpan.textContent = recettes + ' M€';

      const postes = Math.round((24620000 + (83250000 * (val / 100) * 0.25)) / 136000);
      postesSpan.textContent = postes + ' PU-PH / PH';
    });
  }

  // COPIE DES PIECES D'ASSAUT
  function setupCopy(btnId, textId) {
    const btn = document.getElementById(btnId);
    const container = document.getElementById(textId);
    if (btn && container) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(container.textContent).then(() => {
          const original = btn.textContent;
          btn.textContent = '✅ Copié !';
          setTimeout(() => { btn.textContent = original; }, 2000);
        });
      });
    }
  }

  setupCopy('copy-assaut-1-btn', 'text-assaut-1');
  setupCopy('copy-assaut-2-btn', 'text-assaut-2');
  setupCopy('copy-assaut-3-btn', 'text-assaut-3');
  setupCopy('copy-assaut-4-btn', 'text-assaut-4');
  setupCopy('copy-assaut-5-btn', 'text-assaut-5');
  setupCopy('copy-assaut-6-btn', 'text-assaut-6');
</script>
