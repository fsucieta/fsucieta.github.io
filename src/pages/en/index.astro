  <!-- Script de recherche en temps réel pour la section anglaise -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInputEn') as HTMLInputElement | null;
      const allCards = document.querySelectorAll<HTMLElement>('.fiche-card-en');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const term = (e.target as HTMLInputElement).value.toLowerCase().trim();

          allCards.forEach((card) => {
            const title = card.getAttribute('data-title') || '';
            const category = card.getAttribute('data-category') || '';
            const chapeau = card.getAttribute('data-chapeau') || '';

            if (!term || title.includes(term) || category.includes(term) || chapeau.includes(term)) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      }
    });
  </script>

