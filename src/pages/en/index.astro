---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import GisMap from '../../components/GisMap.astro';
import CadaGeneratorEn from '../../components/CadaGeneratorEn.astro';
import WhistleblowerVaultEn from '../../components/WhistleblowerVaultEn.astro';
import FoncierDvfRadarEn from '../../components/FoncierDvfRadarEn.astro';

const allInvestigations = await getCollection('investigations');

// Sovereign selection of the 8 Major Concluded & Opposable Investigations
// Strategic display order: Angelo (27), Mines (7), Civil Defense (23), Muvitarra (28), Oil (26), Water (4), Energy (18), Military Enclaves (11)
const idsFinalises = [27, 7, 23, 28, 26, 4, 18, 11];
const enquetesFinalisees = idsFinalises
  .map(id => allInvestigations.find(e => e.data.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
---

<Layout 
  title="L'OCHJU — Citizen Investigative Media & Open Data (The Eye of Corsica)"
  description="L'OCHJU — First citizen open data investigative media in Corsica. 8 major sealed forensic investigations in full open access."
  canonicalUrl="https://fsucieta.github.io/en/"
  image="/alerte_censure_lochju.jpg"
  lang="en"
>
  <!-- Top Editorial Header Centered & Streamlined -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Left: Sovereign Brand Anchor -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          INTERNATIONAL INVESTIGATION DESK
        </span>
      </div>

      <!-- Center: Majestic Official Centered Logo -->
      <a href="./" class="group flex justify-center" aria-label="Return to L'OCHJU English Homepage">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-r from-amber-500/40 via-amber-300/30 to-amber-500/40 rounded-2xl blur-md opacity-40 group-hover:opacity-100 transition duration-500"></div>
          <img 
            src="../logo_l_ochju.jpg" 
            alt="L'OCHJU — Investigative Media" 
            class="relative h-20 md:h-28 w-auto object-contain rounded-xl border-2 border-amber-500/60 group-hover:border-amber-400 transition duration-300 shadow-2xl shadow-amber-500/40"
          />
        </div>
      </a>

      <!-- Right: Language Switcher to FR -->
      <div class="w-48 flex justify-end items-center gap-3">
        <a href="../" class="text-xs font-mono bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 px-3 py-1.5 rounded-lg border border-amber-500/30 transition flex items-center gap-1.5 font-bold">
          <span>🇫🇷</span> <span>Version FR</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Sticky Quick Navigation Menu -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[108px] z-40 py-2 px-4 shadow-md overflow-hidden" style="scrollbar-width: none; -ms-overflow-style: none;" aria-label="Quick section navigation">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-2 text-xs font-mono">
      <a href="../analyse-globale-finale/" class="px-3.5 py-1.5 rounded-lg bg-gradient-to-r from-amber-500 via-amber-400 to-amber-500 text-slate-950 font-mono text-xs font-black shadow-lg shadow-amber-500/20 hover:brightness-110 transition flex items-center gap-1.5 border border-amber-300">
        <span>🏛️</span> <span>SUPREME MEMORANDUM</span>
      </a>
      <a href="#fiches-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-amber-500/40 text-amber-300 hover:border-amber-400 hover:text-amber-200 transition flex items-center gap-1.5 font-bold">
        <span>📂 8 Sealed Investigations</span>
      </a>
      <a href="#registre-instruction-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5 font-mono">
        <span>⚖️ Citizen Registry</span>
      </a>
      <a href="#gis-map-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🗺️ 360 Municipalities GIS</span>
      </a>
      <a href="#foncier-dvf-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🤝 DVF Radar</span>
      </a>
      <a href="#cada-generator" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ FOIA / CADA</span>
      </a>
      <a href="#doctrine-preuves" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ Evidence Doctrine</span>
      </a>
    </div>
  </nav>

  <main id="main-content">

  <!-- ================= MASTER BANNER : SUPREME EMANCIPATION MEMORANDUM ================= -->
  <section class="max-w-7xl mx-auto px-6 pt-6 pb-2">
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-amber-950/40 via-slate-900 to-slate-950 border-2 border-amber-500/60 p-6 md:p-8 shadow-2xl shadow-amber-500/10">
      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
        <div class="max-w-3xl">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2.5 py-1 rounded bg-amber-500 text-slate-950 text-xs font-mono font-black uppercase tracking-wider">
              ACT OF SUPREME OPPOSABILITY
            </span>
            <span class="text-xs font-mono text-amber-400 font-bold">
              • Synthesis of the 29 Sovereignty Pillars
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-white mb-2 leading-tight">
            Reversal of Debt: Memorandum for Corsica's Emancipation
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-sans">
            Forensic quantification of <strong>€4.72 billion</strong> siphoned off the island annually (€28,693 per household), and constitutional transition architecture.
          </p>
        </div>
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-3 w-full lg:w-auto">
          <a 
            href="../analyse-globale-finale/" 
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-400 hover:from-amber-400 hover:to-amber-300 text-slate-950 font-mono text-xs font-black tracking-wide text-center transition shadow-xl shadow-amber-500/20"
          >
            👁️ READ THE MEMORANDUM
          </a>
          <a 
            href="../docs/MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" download="MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" class="w-full sm:w-auto px-4 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 border border-amber-500/40 font-mono text-xs font-bold text-center transition">📥 Official Memorandum (PDF)</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Grid of the 8 Sealed & Opposable Investigations -->
  <section class="max-w-7xl mx-auto px-6 py-12" id="fiches-section">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 border-b border-emerald-500/30 pb-4">
      <div>
        <span class="px-3 py-1 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider flex items-center gap-1.5 w-fit">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          COMPLETED INQUIRIES · ISO 27037 SEALED EVIDENCE
        </span>
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
          🟢 The 8 Major Sealed & Opposable Investigations
        </h2>
        <p class="text-xs font-mono text-slate-400 mt-1">Full forensic investigative files, audited balance sheets and opposable public decrees.</p>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <!-- Search filter for the 8 dossiers -->
        <div class="w-full sm:w-72">
          <input 
            type="text" 
            id="searchInputEn" 
            placeholder="🔍 Filter the 8 dossiers..." 
            aria-label="Search investigations by title, keyword or municipality"
            class="w-full px-4 py-2 bg-slate-900 border border-slate-700 rounded-xl text-xs text-slate-200 focus:outline-none focus:border-amber-400 transition font-sans shadow-inner"
          />
        </div>
      </div>
    </div>

    <!-- Grid of the 8 Concluded Inquiries -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="fichesGridEn">
      {enquetesFinalisees.map((enquete) => {
        const d = enquete.data;
        const imgPath = d.image.startsWith('http') ? d.image : `../${d.image.replace(/^\//, '')}`;
        const displayTitle = d.title.replace(/^Enquête\s+\d+\s*:\s*/i, '');
        return (
          <a 
            href={`./investigations/${enquete.slug}/`}
            class="fiche-card relative bg-gradient-to-b from-slate-900/90 to-slate-950 border border-slate-800/80 hover:border-emerald-500/60 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col shadow-xl hover:shadow-2xl hover:shadow-emerald-500/10 group cursor-pointer block hover:-translate-y-1"
            data-title={displayTitle.toLowerCase()}
            data-category={d.category.toLowerCase()}
            data-chapeau={d.chapeau.toLowerCase()}
          >
            <!-- Top certified emerald bar -->
            <div class="h-1 bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-500 w-full"></div>

            <!-- Card Image with Certified Badge -->
            <div class="relative h-48 overflow-hidden bg-slate-950">
              <img 
                src={imgPath} 
                alt={d.title} 
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>
              
              <!-- Badges -->
              <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 items-center">
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-bold bg-slate-950/90 text-amber-400 border border-amber-500/40 shadow-lg">
                  #{d.id.toString().padStart(2, '0')} · {d.ref}
                </span>
                <span class="px-2.5 py-1 rounded-md text-[10px] font-mono font-bold bg-emerald-950/90 text-emerald-300 border border-emerald-500/50 shadow-lg flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  SEALED ISO 27037
                </span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                  <span class="text-[11px] font-mono uppercase tracking-widest text-emerald-400 font-bold">{d.category}</span>
                </div>
                <h3 class="text-lg font-bold font-serif text-slate-100 group-hover:text-amber-300 transition duration-300 leading-snug">
                  {displayTitle}
                </h3>
                <p class="text-slate-400 text-sm line-clamp-3 mt-2.5 leading-relaxed font-serif">
                  {d.chapeau}
                </p>
              </div>

              <!-- Button & Forensic Footnote -->
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-amber-400 group-hover:text-amber-300 uppercase tracking-wider flex items-center gap-1.5">
                  <span>Open Investigation File</span>
                  <span class="transition transform group-hover:translate-x-1">→</span>
                </span>
                <span class="text-[11px] font-mono text-slate-500">
                  {d.sources?.length || 0} certified exhibits
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Section 2: Registry of Inquiries & Upcoming Investigations -->
  <section class="max-w-7xl mx-auto px-6 py-12 border-t border-amber-500/20" id="registre-instruction-section">
    <div class="mb-8 border-b border-amber-500/30 pb-4 flex flex-col md:flex-row justify-between items-start md:items-end gap-4">
      <div>
        <span class="px-3 py-1 bg-amber-500/10 text-amber-300 border border-amber-500/30 rounded-full text-xs font-bold font-mono uppercase tracking-wider flex items-center gap-1.5 w-fit">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          CITIZEN REGISTRY · ACTIVE FORENSIC INQUIRIES
        </span>
        <h2 class="text-2xl md:text-3xl font-bold font-serif text-slate-100 mt-2">
          ⚖️ Registry of Inquiries for Upcoming Dossiers
        </h2>
        <p class="text-xs font-mono text-slate-400 mt-1">Dossiers currently under examination in our forensic labs. No publication occurs until every single calculation is verified down to the bit.</p>
      </div>

      <a 
        href="#whistleblower-vault" 
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-amber-500 text-amber-300 hover:text-slate-950 border border-amber-500/40 text-xs font-mono font-bold transition shadow-lg"
      >
        <span>🔒</span>
        <span>Submit Anonymous Evidence</span>
      </a>
    </div>

    <!-- Solemn Investigation Table -->
    <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/80 shadow-2xl">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-900/90 text-[11px] font-mono text-slate-400 uppercase tracking-wider">
            <th class="py-3.5 px-4 font-bold">Ref. Dossier</th>
            <th class="py-3.5 px-4 font-bold">Topic & Scope</th>
            <th class="py-3.5 px-4 font-bold hidden sm:table-cell">Multi-INT Discipline</th>
            <th class="py-3.5 px-4 font-bold">Status of Investigation</th>
            <th class="py-3.5 px-4 text-right font-bold">Citizen Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-xs font-mono">
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-01</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">The Grand Financial Lock</div>
              <div class="text-[11px] text-slate-400 font-serif">Mechanics of bullet loans and capture of local savings</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-cyan-400 font-bold">FININT / Tax Records</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Auditing financial flows
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#whistleblower-vault" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Submit record →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-03</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">The Universal Manifesto of Soil</div>
              <div class="text-[11px] text-slate-400 font-serif">Land dispossession, preemption rights and urban planning zones</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-emerald-400 font-bold">GEOINT / Cadastre</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                360 municipalities mapping
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#whistleblower-vault" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Submit record →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-05</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">The Non-Resident Real Estate Holdings</div>
              <div class="text-[11px] text-slate-400 font-serif">Beneficial ownership registries (RBE) and offshore cascades</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-cyan-400 font-bold">OSINT / Corporate Registry</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Cross-checking ownership chains
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#whistleblower-vault" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Submit record →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-15</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">The CAP Subsidies & Farmland Scandal</div>
              <div class="text-[11px] text-slate-400 font-serif">Audit of Land Parcel Identification System (LPIS) and European aid diversion</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-emerald-400 font-bold">GEOINT / LPIS</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Cadastral cross-referencing
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#whistleblower-vault" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Submit record →</a>
            </td>
          </tr>
          <tr class="hover:bg-slate-900/50 transition">
            <td class="py-4 px-4 font-bold text-amber-400">DOSSIER-21</td>
            <td class="py-4 px-4">
              <div class="font-bold text-slate-200 font-sans text-sm">The Waste Scandal of SYVADEC</div>
              <div class="text-[11px] text-slate-400 font-serif">Maritime export rents and treatment monopolies</div>
            </td>
            <td class="py-4 px-4 hidden sm:table-cell text-cyan-400 font-bold">DECP / Procurement</td>
            <td class="py-4 px-4">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-500/10 text-amber-300 border border-amber-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                Auditing unit price schedules
              </span>
            </td>
            <td class="py-4 px-4 text-right">
              <a href="#whistleblower-vault" class="text-xs text-amber-400 hover:text-amber-300 underline font-sans">Submit record →</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Real-time search script for English cards -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const searchInput = document.getElementById('searchInputEn');
      const allCards = document.querySelectorAll('#fichesGridEn .fiche-card');

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const term = e.target.value.toLowerCase().trim();

          allCards.forEach((card) => {
            const title = card.getAttribute('data-title') || '';
            const category = card.getAttribute('data-category') || '';
            const chapeau = card.getAttribute('data-chapeau') || '';

            if (!term || title.includes(term) || category.includes(term) || chapeau.includes(term)) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      }
    });
  </script>

  <!-- 2. GIS Map 360 Communes -->
  <section class="max-w-7xl mx-auto px-6" id="gis-map-section">
    <GisMap lang="en" />
  </section>

  <!-- 3. DVF Real Estate Radar -->
  <section class="max-w-7xl mx-auto px-6" id="foncier-dvf-section">
    <FoncierDvfRadarEn />
  </section>

  <!-- 4. FOIA / CADA Generator -->
  <section class="max-w-7xl mx-auto px-6" id="cada-generator">
    <CadaGeneratorEn />
  </section>

  <!-- 5. Whistleblower Vault -->
  <section class="max-w-7xl mx-auto px-6" id="whistleblower-vault">
    <WhistleblowerVaultEn />
  </section>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 text-center text-xs text-slate-500 font-mono mt-16" role="contentinfo">
    L'OCHJU — THE EYE OF CORSICA | 8 SEALED FORENSIC CITIZEN INVESTIGATIONS IN CO-OFFICIAL ENGLISH TRANSLATION
  </footer>
</Layout>
