---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import GisMap from '../../components/GisMap.astro';
import CadaGeneratorEn from '../../components/CadaGeneratorEn.astro';
import WhistleblowerVaultEn from '../../components/WhistleblowerVaultEn.astro';
import FoncierDvfRadarEn from '../../components/FoncierDvfRadarEn.astro';

const allInvestigations = await getCollection('investigations');
// Tri par identifiant (Le numéro 29 en premier, puis de 01 à 28)
const investigations = allInvestigations.sort((a, b) => {
  if (a.data.id === 29) return -1;
  if (b.data.id === 29) return 1;
  return a.data.id - b.data.id;
});

// Séparation éditoriale : Sealed Records vs Active Inquiries
const investigationsCloturees = investigations.filter(i => i.data.status !== 'en_cours');
const investigationsEnCours = investigations.filter(i => i.data.status === 'en_cours');

// Option A : Sélection des enquêtes clôturées / finalisées majeures
const idsClotures = [26, 7, 29, 2, 3, 4, 6, 18, 27, 28];
const investigationsAlaUne = idsClotures
  .map(id => investigations.find(i => i.data.id === id))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));
---

<Layout 
  title="L'OCHJU — Citizen Investigative Media & Open Data (The Eye of Corsica)"
  description="L'OCHJU — First citizen open data investigative media in Corsica. 29 major forensic investigations on sovereignty, public finance and transparency."
  canonicalUrl="https://fsucieta.github.io/en/"
  image="/alerte_censure_lochju.jpg"
  lang="en"
>
  <!-- Top Navigation / Header Centered & Majestic -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Left : Brand Anchor -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          INTERNATIONAL INVESTIGATION DESK
        </span>
      </div>

      <!-- Center : Official Majestic Logo -->
      <a href="./" class="group flex justify-center" aria-label="Return to L'OCHJU Homepage">
        <div class="relative">
          <div class="absolute -inset-2 bg-gradient-to-r from-amber-500/40 via-amber-300/30 to-amber-500/40 rounded-2xl blur-md opacity-40 group-hover:opacity-100 transition duration-500"></div>
          <img 
            src="../logo_l_ochju.jpg" 
            alt="L'OCHJU — Investigative Media" 
            class="relative h-20 md:h-28 w-auto object-contain rounded-xl border-2 border-amber-500/60 group-hover:border-amber-400 transition duration-300 shadow-2xl shadow-amber-500/40"
          />
        </div>
      </a>

      <!-- Right : Language Switcher to FR & Theme Toggle -->
      <div class="w-48 flex justify-end items-center gap-3">
        <a href="../" class="text-xs font-mono bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 px-3 py-1.5 rounded-lg border border-amber-500/30 transition flex items-center gap-1.5 font-bold">
          <span>🇫🇷</span> <span>Version FR</span>
        </a>
        <ThemeToggle />
      </div>

    </div>
  </header>

  <!-- Sticky Quick Navigation Menu (Identical to FR) -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[108px] z-40 py-2.5 px-6 shadow-md overflow-x-auto" aria-label="Quick section navigation">
    <div class="max-w-7xl mx-auto flex items-center justify-center gap-3 text-xs font-mono whitespace-nowrap">
      <a href="#manifeste-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🙏 The Manifesto</span>
      </a>
      <a href="#fiches-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>📂 29 Investigations</span>
      </a>
      <a href="#gis-map-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>🗺️ 360 Municipalities GIS</span>
      </a>
      <a href="#foncier-dvf-section" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🤝 DVF Real Estate Radar</span>
      </a>
      <a href="#cada-generator" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-amber-400 hover:text-amber-400 transition flex items-center gap-1.5">
        <span>⚖️ FOIA / CADA Generator</span>
      </a>
      <a href="#whistleblower-vault" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:border-cyan-400 hover:text-cyan-400 transition flex items-center gap-1.5">
        <span>🔒 Whistleblower Vault</span>
      </a>
    </div>
  </nav>

  <main id="main-content">
<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-4" id="alerte-censure-section">
  <div class="relative rounded-3xl p-6 sm:p-8 md:p-10 border border-amber-500/30 bg-gradient-to-b from-slate-900/90 via-slate-950 to-slate-950 shadow-2xl backdrop-blur-xl overflow-hidden">
    <!-- Subtle Ambient Glow -->
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      
      <!-- Left Column : HD Artwork centered -->
      <div class="lg:col-span-4 flex flex-col items-center justify-center">
        <div class="relative group w-full max-w-[280px] sm:max-w-xs">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-amber-500/30 to-amber-300/20 rounded-2xl blur-md opacity-50 group-hover:opacity-100 transition duration-500"></div>
          <img src="../alerte_censure_lochju.jpg" alt="L'OCHJU - Truth Will Not Be Silenced" class="relative w-full h-auto rounded-2xl border border-amber-500/40 shadow-2xl">
        </div>
      </div>

      <!-- Right Column : Official Statement & Balanced Actions -->
      <div class="lg:col-span-8 flex flex-col justify-center space-y-5">
        
        <!-- Header Press Badge with Historic Milestone -->
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-mono font-bold uppercase tracking-widest bg-rose-500/20 text-rose-300 border border-rose-500/40">
            <span class="w-2 h-2 rounded-full bg-rose-400 animate-pulse"></span>
            OFFICIAL COMMUNIQUÉ • CENSORSHIP ALERT
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-[11px] font-mono font-bold uppercase tracking-widest bg-amber-500/15 text-amber-300 border border-amber-500/30">
            🔥 +700,000 VIEWS IN 30 DAYS
          </span>
          <span class="text-[11px] font-mono text-slate-500 hidden sm:inline">09.09.2026</span>
        </div>

        <!-- Major Headline -->
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black font-serif text-slate-100 leading-tight">
          Truth will not be silenced. <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-200">Become the megaphone of L’OCHJU.</span>
        </h2>

        <!-- Context Explanation -->
        <p class="text-sm sm:text-base text-slate-300 font-sans leading-relaxed">
          Facing a historic democratic surge — <strong class="text-amber-400 font-semibold">+700,000 readers in a single month</strong> across our 29 forensic investigations and cadastral audits —, our social media channels are experiencing coordinated censorship attempts. 
          <strong class="text-slate-100">The freedom to inform does not belong to private algorithms.</strong> Help us break the digital blackout by sharing this official alert across your networks.
        </p>

        <!-- Structured Quote Box & Actions -->
        <div class="rounded-2xl bg-slate-950/90 border border-slate-800/90 p-4 sm:p-5 space-y-4">
          
          <!-- Message line + Copy Button -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider flex items-center gap-2">
                <span>📜</span> Official message ready to broadcast:
              </span>
              <button id="copyCensureBtnEn" onclick="copyCensureMessageEn()" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold font-mono text-xs uppercase tracking-wider transition-all duration-200 cursor-pointer shadow-sm hover:scale-105 active:scale-95">
                <span id="copyBtnIconEn">📋</span> <span id="copyBtnLabelEn">Copy text</span>
              </button>
            </div>

            <div id="censureMessageTextEn" class="text-xs font-mono text-slate-300 leading-relaxed max-h-40 overflow-y-auto whitespace-pre-wrap selection:bg-amber-500 selection:text-slate-950 p-3 rounded-xl bg-slate-900/60 border border-slate-800/60">🔴 CITIZEN TIDAL WAVE: OVER 700,000 VIEWS IN ONE MONTH ON L'OCHJU!
🔴 CENSORSHIP ALERT: TRUTH WILL NOT BE SILENCED!

Following the historic public awakening and our 29 forensic citizen investigations (+700,000 readers in 30 days), our social media channels are currently subject to coordinated mass-reporting and censorship attempts.

Those who profit from opacity and economic rent believe they can extinguish truth with an algorithmic click. But information sovereignty belongs to no private platform.

Access all 29 major investigative dossiers, cadastral land audits, and certified archive records freely, publicly, and independently on our official site:
👉 https://fsucieta.github.io/en/

Truth belongs to no master. Share this message widely to break the silence and uphold the freedom to inform! ✊👁️</div>
          </div>

          <!-- Harmonized Action & Share Grid (5 Columns) -->
          <div class="pt-3 border-t border-slate-800/80">
            <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-2.5">
              Broadcast or download alert:
            </span>

            <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
              <!-- Facebook -->
              <a href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Ffsucieta.github.io%2Fen%2F" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-900/90 hover:bg-[#1877F2] text-slate-200 hover:text-white border border-slate-800 hover:border-[#1877F2] text-xs font-mono font-semibold transition-all duration-200 shadow-sm text-center">
                <span>📘</span> <span>Facebook</span>
              </a>

              <!-- X / Twitter -->
              <a href="https://twitter.com/intent/tweet?url=https%3A%2F%2Ffsucieta.github.io%2Fen%2F&text=%F0%9F%94%B4%20CENSORSHIP%20ALERT%3A%20THE%20EYE%20WILL%20NOT%20BE%20SILENCED!%0A%0AExplore%20the%2028%20forensic%20investigations%20in%20free%20open%20access%20on%20the%20official%20portal%3A" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-900/90 hover:bg-black text-slate-200 hover:text-white border border-slate-800 hover:border-slate-700 text-xs font-mono font-semibold transition-all duration-200 shadow-sm text-center">
                <span>✖️</span> <span>X</span>
              </a>

              <!-- WhatsApp -->
              <a href="https://api.whatsapp.com/send?text=%F0%9F%94%B4%20CENSORSHIP%20ALERT%3A%20THE%20EYE%20WILL%20NOT%20BE%20SILENCED!%0A%0AFollowing%20our%20investigations%2C%20our%20channels%20are%20targeted%20by%20censorship.%20Truth%20does%20not%20belong%20to%20algorithms.%0A%0AAll%2028%20investigations%20in%20open%20access%3A%20https%3A%2F%2Ffsucieta.github.io%2Fen%2F" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-900/90 hover:bg-[#25D366] text-slate-200 hover:text-white border border-slate-800 hover:border-[#25D366] text-xs font-mono font-semibold transition-all duration-200 shadow-sm text-center">
                <span>💬</span> <span>WhatsApp</span>
              </a>

              <!-- Telegram -->
              <a href="https://t.me/share/url?url=https%3A%2F%2Ffsucieta.github.io%2Fen%2F&text=%F0%9F%94%B4%20CENSORSHIP%20ALERT%3A%20THE%20EYE%20WILL%20NOT%20BE%20SILENCED!%20Discover%20the%2028%20open-access%20investigations%20on%20the%20official%20website." target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 py-2.5 px-3 rounded-xl bg-slate-900/90 hover:bg-[#0088cc] text-slate-200 hover:text-white border border-slate-800 hover:border-[#0088cc] text-xs font-mono font-semibold transition-all duration-200 shadow-sm text-center">
                <span>✈️</span> <span>Telegram</span>
              </a>

              <!-- Download HD Artwork -->
              <a href="../alerte_censure_lochju.jpg" download="L-OCHJU-TRUTH-WILL-NOT-BE-SILENCED.jpg" class="col-span-2 sm:col-span-1 flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl bg-amber-500/10 hover:bg-amber-500 text-amber-300 hover:text-slate-950 border border-amber-500/30 text-xs font-mono font-bold transition-all duration-200 shadow-sm text-center">
                <span>📥</span> <span>HD Poster</span>
              </a>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>

<script>
  function copyCensureMessageEn() {
    const text = document.getElementById('censureMessageTextEn').innerText;
    navigator.clipboard.writeText(text).then(() => {
      const label = document.getElementById('copyBtnLabelEn');
      const icon = document.getElementById('copyBtnIconEn');
      label.innerText = 'Copied!';
      icon.innerText = '✅';
      setTimeout(() => {
        label.innerText = 'Copy text';
        icon.innerText = '📋';
      }, 3000);
    });
  }
</script>

  

  <!-- ================= SECTION MANIFESTE SOUVERAIN ÉPURÉ ("THE OATH OF L'OCHJU") ================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 pb-2" id="manifeste-section">
    <div class="relative border border-amber-500/30 rounded-3xl p-6 sm:p-8 shadow-2xl overflow-hidden bg-gradient-to-b from-slate-900/90 via-slate-950 to-slate-950 backdrop-blur-xl">
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- HISTORICAL QUOTE BY PASQUALE PAOLI -->
      <div class="max-w-3xl mx-auto text-center mb-6">
        <blockquote class="!bg-transparent !border-0 !p-0 !m-0 !shadow-none">
          <p class="font-serif italic text-amber-200/90 text-sm sm:text-base md:text-lg leading-relaxed">
            « Justice, virtue, and love of Country must be the sole engines of our actions. The Corsican People, having recovered their liberty, intend to give a lasting form to their government by founding their Constitution upon reason and truth. »
          </p>
          <cite class="font-mono text-[11px] text-amber-400/80 uppercase tracking-widest mt-2 block not-italic">
            — Pasquale Paoli, Preamble to the Constitution of Corsica (November 18, 1755)
          </cite>
        </blockquote>
      </div>

      <!-- SYNTHESIS OF THE CITIZEN OATH (3 IMPACTFUL LINES) -->
      <div class="max-w-4xl mx-auto text-center border-t border-b border-slate-800/80 py-5 my-5 space-y-2">
        <h1 class="text-xl sm:text-2xl font-serif font-black text-slate-100 tracking-wide">
          SHARED KNOWLEDGE IS OUR COUNTER-POWER
        </h1>
        <p class="font-serif text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
          Beneath the varnish of silence, the screen lit up <strong class="text-amber-400 font-mono">+700,000 times</strong> in a single month. No masters, no compromises: here is the certified truth to restore citizen sovereignty.
        </p>
      </div>

      <!-- THE 4 PILLARS IN COMPACT HORIZONTAL CARDS -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 max-w-5xl mx-auto my-6">
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
          <span class="text-[10px] font-mono font-bold text-rose-400 block mb-0.5 uppercase tracking-wider">I. Proof of Fact</span>
          <span class="text-[11px] text-slate-400 font-sans">0 rumors · Decrees verified down to the bit</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
          <span class="text-[10px] font-mono font-bold text-amber-400 block mb-0.5 uppercase tracking-wider">II. Double-Shelf</span>
          <span class="text-[11px] text-slate-400 font-sans">Law & finance translated for every home</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
          <span class="text-[10px] font-mono font-bold text-cyan-400 block mb-0.5 uppercase tracking-wider">III. Direct Remedy</span>
          <span class="text-[11px] text-slate-400 font-sans">For every failure, a concrete statutory solution</span>
        </div>
        <div class="p-3 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
          <span class="text-[10px] font-mono font-bold text-emerald-400 block mb-0.5 uppercase tracking-wider">IV. Full Independence</span>
          <span class="text-[11px] text-slate-400 font-sans">Zero subsidies, zero corporate shareholders</span>
        </div>
      </div>

      <!-- EXPANDABLE FULL MANIFESTO TEXT ON DEMAND -->
      <details class="max-w-3xl mx-auto group border border-slate-800/80 rounded-xl bg-slate-950/60 transition duration-300">
        <summary class="p-3 text-center cursor-pointer font-mono text-xs text-amber-400 hover:text-amber-300 flex items-center justify-center gap-2 select-none">
          <span>📜 Read the Full Manifesto Text</span>
          <span class="text-slate-500 group-open:rotate-180 transition transform">▼</span>
        </summary>
        <div class="p-6 border-t border-slate-800/80 font-serif text-sm text-slate-300 space-y-4 leading-relaxed bg-slate-900/40">
          <p class="border-l-2 border-rose-500 pl-4 italic text-slate-200">
            👁️ You think these are merely articles. You believe these are just numbers aligned on a screen. Seven hundred thousand times in a month, the screen lit up. Living proof that you were waiting for only one thing: the spark of truth.
          </p>
          <p>
            For decades, they reigned over an empire of opacity. They counted on a terrifying weapon: ignorance. They told you files were "too complex", that land was a puzzle, that water or energy were beyond your control. <strong class="text-slate-100">They lied to you.</strong>
          </p>
          <p>
            L'OCHJU is not an opinion platform. It is a forensic rupture in their system. We combine data engineering (raw official decrees, cadastral monitoring with <strong class="text-amber-400">Bufitonu.fr</strong>, corporate ledger audits) with citizen awakening.
          </p>
          <p class="text-center font-serif italic text-amber-400 pt-2 border-t border-slate-800">
            « Opacity is not a fatality. Shared Knowledge is our counter-power. »
          </p>
        </div>
      </details>

      <!-- Fast Anchor Button -->
      <div class="mt-6 text-center">
        <a href="#carousel-alaune-section" class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-amber-500/20">
          <span>Access Featured Investigations Directly ↓</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ================= INTERACTIVE CAROUSEL "FEATURED DOSSIERS" : THE 8 COMPLETED INVESTIGATIONS ================= -->
  <section class="max-w-7xl mx-auto px-6 pt-8 pb-4" id="carousel-alaune-section">
    <div class="hero-card-container border border-amber-500/40 rounded-2xl p-6 md:p-10 shadow-2xl relative overflow-hidden bg-slate-900">
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <!-- Carousel Header with Mode Indicator and Navigation Controls -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6 border-b border-slate-800/80 pb-4">
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/40 rounded-full text-xs font-bold uppercase tracking-wider font-mono flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            ★ FEATURED MAJOR DOSSIERS (COMPLETED INVESTIGATIONS)
          </span>
          <span class="px-2.5 py-1 bg-rose-500/10 text-rose-300 border border-rose-500/30 rounded-full text-xs font-mono font-bold">
            🔥 +700,000 VIEWS
          </span>
          <span class="px-2.5 py-1 bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 rounded-full text-xs font-mono font-bold">
            🗺️ 360 MUNICIPALITIES
          </span>
          <span class="px-3 py-1 bg-slate-950 text-slate-300 border border-slate-800 rounded-full text-xs font-mono font-bold" id="carouselCounter">
            Investigation 1 / {investigationsAlaUne.length}
          </span>
        </div>

        <!-- Controls : Previous / Next and Pause -->
        <div class="flex items-center gap-2">
          <button 
            id="carouselPrevBtn" 
            type="button" 
            class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 hover:text-amber-400 hover:border-amber-400 transition cursor-pointer shadow-md"
            title="Previous dossier"
          >
            ◀
          </button>
          <button 
            id="carouselPlayPauseBtn" 
            type="button" 
            class="px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-slate-300 hover:text-amber-400 hover:border-amber-400 transition cursor-pointer shadow-md"
            title="Pause / Resume auto-play"
          >
            ⏸️ Pause
          </button>
          <button 
            id="carouselNextBtn" 
            type="button" 
            class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 text-slate-300 hover:text-amber-400 hover:border-amber-400 transition cursor-pointer shadow-md"
            title="Next dossier"
          >
            ▶
          </button>
        </div>
      </div>

      <!-- Carousel Slides (Each completed investigation) -->
      <div class="relative overflow-hidden min-h-[440px]" id="carouselSlidesContainer">
        {investigationsAlaUne.map((enq, index) => {
          const d = enq.data;
          const isFirst = index === 0;
          const imgPath = d.image.startsWith('http') ? d.image : `../${d.image.replace(/^\//, '')}`;
          return (
            <div 
              class={`carousel-slide transition-opacity duration-700 ${isFirst ? 'opacity-100 relative' : 'opacity-0 absolute inset-0 pointer-events-none'}`}
              data-slide-index={index}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
