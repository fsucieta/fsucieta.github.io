---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import CarteEnergieCorse from '../../../components/CarteEnergieCorse.astro';
import AudioBriefing from '../../../components/AudioBriefing.astro';
import InvestigationHeader from '../../../components/InvestigationHeader.astro';
import PiecesJustificativesSection from '../../../components/PiecesJustificativesSection.astro';

export async function getStaticPaths() {
  const investigations = await getCollection('investigations');
  // SANCTUARISATION STRICTE : Uniquement les 7 enquêtes officiellement finalisées
  const allowedIds = [27, 7, 23, 28, 26, 4, 18, 11, 22];
  return investigations.filter((entry) => allowedIds.includes(entry.data.id)).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'investigations'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const imgPath = data.image.startsWith('http') ? data.image : `../../../${data.image.replace(/^\//, '')}`;
const ogImage = data.image.startsWith('http') ? data.image : `/${data.image.replace(/^\//, '')}`;
---

<Layout 
  title={`${data.title} — L'OCHJU — The Eye of Investigation`} 
  description={data.chapeau}
  image={ogImage}
  canonicalUrl={`https://fsucieta.github.io/en/investigations/${entry.slug}/`}
  lang="en"
>
  <!-- Top Navigation with Sovereign Header -->
  <InvestigationHeader currentLang="en" slug={entry.slug} refCode={data.ref} id={data.id} />

  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 md:px-12 py-8 sm:py-12 box-border overflow-hidden">
    <!-- High Forensic Standard Article Header -->
    <header class="space-y-8 mb-12">
      <div class="flex flex-wrap items-center gap-3 font-mono-tech text-xs">
        <span class="px-3 py-1 rounded-full bg-amber-500 text-black font-black uppercase tracking-wider text-[10px]">
          SEALED OPPOSABLE RECORD
        </span>
        <span class="theme-gold-text font-bold">[{data.ref || `DOSSIER-${data.id}`}]</span>
        <span class="text-slate-400 uppercase tracking-widest">• {data.category}</span>
        {data.status === 'cloturee' && (
          <span class="px-3 py-0.5 bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 rounded-full text-[10px] font-mono-tech font-bold flex items-center gap-1.5 ml-auto">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>CONTRADICTORY AUDIT SEALED</span>
          </span>
        )}
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-press font-black text-white leading-[1.1] tracking-tight">
        {data.title}
      </h1>

      {data.subtitle && (
        <h2 class="text-xl md:text-2xl font-press font-bold theme-gold-text leading-snug">
          {data.subtitle}
        </h2>
      )}

      <p class="text-xl sm:text-2xl font-press text-slate-200 leading-relaxed border-l-4 border-amber-500 pl-6 py-1 bg-black/30 rounded-r-2xl font-normal">
        {data.chapeau}
      </p>

      <!-- ISO/IEC 27037 Metadata Grid in 3D Smoked Glass -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 p-4 rounded-2xl bg-black/60 border border-white/10 font-mono-tech text-xs text-slate-400 shadow-xl">
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">INVESTIGATION DESK</div>
          <div class="text-slate-200 font-bold truncate mt-0.5">{data.author}</div>
        </div>
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">DATE OF SEALING</div>
          <div class="text-slate-200 font-bold mt-0.5">{data.date}</div>
        </div>
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">OPEN DATA AUDIT TOOL</div>
          <div class="text-slate-200 font-bold truncate mt-0.5">{data.tool}</div>
        </div>
        <div class="p-2">
          <div class="text-[10px] text-slate-500 uppercase tracking-wider">FORENSIC STANDARD</div>
          <div class="text-emerald-400 font-bold mt-0.5">ISO/IEC 27037</div>
        </div>
      </div>

      <!-- Citizen Action Bar & Sharing -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2 border-t border-white/10">
        <div class="flex items-center gap-3 font-mono-tech text-xs">
          <span class="text-amber-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
            <span>📢</span> Share :
          </span>
          <ShareButtons title={data.title} chapeau={data.chapeau} />
        </div>
        <button 
          onclick="window.print()" 
          class="no-print inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/30 text-xs font-mono-tech font-bold transition shadow-sm cursor-pointer"
          title="Print this investigation in high-fidelity A4 citizen briefing format"
        >
          <span>🖨️</span>
          <span>Print A4 Briefing</span>
        </button>
      </div>
    </header>

        <!-- Official Photographic Document -->
    {data.image && (
      <div class="mb-8 rounded-2xl overflow-hidden border border-amber-500/30 shadow-2xl bg-slate-950 group">
        <img src={imgPath} alt={data.title} class="w-full object-cover max-h-[480px] group-hover:scale-105 transition duration-700" />
        <div class="p-3 bg-slate-900/90 text-xs font-mono text-slate-400 border-t border-slate-800 flex justify-between items-center">
          <span>{data.imageCaption || `📷 Official Photographic Document — ${data.title}`}</span>
          <span class="text-amber-400">SOVEREIGN CITIZEN ARCHIVE</span>
        </div>
      </div>
    )}

    <!-- Main Article Body -->
    <!-- 🎙️ Audio Briefing Player (visible only when audioBriefingFr or audioBriefingEn is defined in frontmatter) -->
    <AudioBriefing srcFr={data.audioBriefingFr} srcEn={data.audioBriefingEn} lang="en" />

    <article class="article-body font-press text-xl leading-relaxed text-slate-200 space-y-8">
      <Content />
    </article>

    <!-- FORENSIC POWER MONOPOLY INTERACTIVE MAP (Investigation 18) -->
    {data.id === 18 && (
      <div class="my-16">
        <CarteEnergieCorse lang="en" />
      </div>
    )}



    <!-- CERTIFIED OFFICIAL STATE REGISTRIES & PRIMARY ARCHIVES SECTION (ISO/IEC 27037) -->
    <PiecesJustificativesSection 
      sources={data.sources} 
      id={data.id} 
      refCode={data.ref} 
      date={data.date} 
      lang="en" 
    />

    <!-- Back Button -->
    <div class="mt-16 text-center">
      <a href="../../../en/" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-base rounded-xl hover:from-amber-400 hover:to-amber-500 transition shadow-lg shadow-amber-500/20 font-sans">
        <span>← Return to Investigations Directory</span>
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 mt-20 text-center text-xs text-slate-500 font-mono">
    L'OCHJU — THE EYE OF CORSICA | INDEPENDENT CITIZEN INVESTIGATION
  </footer>
</Layout>

<style is:global>
  /* --- INFOGRAPHIES ET ERGONOMIE VISUELLE DANS LES ARTICLES (IDENTIQUE FR) --- */
  
  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* INFOGRAPHIE CARTE CONSTAT D'AUDIT ET DONNÉES CLÉS (MULTI-LIGNES, ZERO DÉFILEMENT HORIZONTAL) */
  .article-body blockquote {
    position: relative;
    border-left: 5px solid #d4af37;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    padding: 1.75rem 2rem;
    margin: 2rem 0;
    font-style: normal !important;
    color: #fef08a;
    border-radius: 0 16px 16px 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.15);
    white-space: normal !important;
    word-wrap: break-word !important;
    overflow-x: visible !important;
    max-width: 100% !important;
  }

  .article-body blockquote::before {
    content: "💡 FORENSIC AUDIT & KEY HISTORICAL EVIDENCE";
    display: block;
    font-family: 'Inter', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #d4af37;
    margin-bottom: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body blockquote p {
    color: #fef08a !important;
    font-size: 1.05rem;
    line-height: 1.8 !important;
    margin-bottom: 0.5rem !important;
    white-space: normal !important;
    word-break: normal !important;
  }

  .article-body ul, .article-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    white-space: normal !important;
  }

  .article-body li {
    color: #cbd5e1;
    margin-bottom: 0.6rem;
    line-height: 1.7;
    white-space: normal !important;
  }

  .article-body strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: normal !important;
  }

  .article-body hr {
    border-color: #334155;
    margin: 2.5rem 0;
  }

  /* INFOGRAPHIE TABLEAUX DE DONNÉES ET PROTOCOLE DE RECOURS (RESPONSIVE) */
  .article-body table {
    display: block !important;
    width: 100% !important;
    max-width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
    margin: 2.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    background-color: #0f172a;
    border-radius: 14px;
    border: 1px solid rgba(212, 175, 55, 0.3);
    box-shadow: 0 15px 30px -10px rgba(0, 0, 0, 0.6);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    white-space: normal !important;
  }

  .article-body th {
    background-color: #1e293b;
    color: #d4af37;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.82rem;
    letter-spacing: 0.05em;
    padding: 1rem 1.25rem;
    text-align: left;
    border-bottom: 2px solid rgba(212, 175, 55, 0.4);
    white-space: normal !important;
  }

  .article-body td {
    padding: 1rem 1.25rem;
    color: #cbd5e1;
    border-bottom: 1px solid rgba(51, 65, 85, 0.6);
    transition: background-color 0.2s ease;
    white-space: normal !important;
    word-break: normal !important;
  }


    /* --- BLINDAGE MOBILE & SOUVERAINETÉ RESPONSIVE --- */
    .article-body {
      overflow-wrap: break-word !important;
      word-break: break-word !important;
      word-wrap: break-word !important;
      max-width: 100% !important;
      overflow-x: hidden !important;
    }

    .article-body table {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch !important;
      border-collapse: collapse !important;
      margin: 1.5rem 0 !important;
    }

    .article-body pre {
      max-width: 100% !important;
      overflow-x: auto !important;
      white-space: pre-wrap !important;
      word-break: break-all !important;
    }

    .article-body a {
      overflow-wrap: break-word !important;
      word-break: break-all !important;
    }
</style>
