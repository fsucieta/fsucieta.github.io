---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import ForensicSeal from '../../../components/ForensicSeal.astro';
import EvidenceViewer from '../../../components/EvidenceViewer.astro';
import AudioBriefing from '../../../components/AudioBriefing.astro';

export async function getStaticPaths() {
  const investigations = await getCollection('investigations');
  return investigations.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'investigations'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const imgPath = data.image.startsWith('http') ? data.image : `../../../${data.image.replace(/^\//, '')}`;
const ogImage = data.image.startsWith('http') ? data.image : `/${data.image.replace(/^\//, '')}`;
---

<Layout 
  title={`${data.title} — L'OCHJU — The Eye of Investigation`} 
  description={data.chapeau}
  image={ogImage}
  canonicalUrl={`https://fsucieta.github.io/en/investigations/${entry.slug}/`}
  lang="en"
>
  <!-- Top Navigation -->
  <header class="border-b border-slate-800 bg-slate-950/90 backdrop-blur sticky top-0 z-50 py-4 px-6">
    <div class="max-w-6xl mx-auto flex justify-between items-center gap-4">
      <a href="../../../en/" class="flex items-center gap-2 text-amber-400 font-bold text-sm md:text-base hover:text-amber-300 transition font-sans">
        <span>← HOME L'OCHJU — The Eye</span>
      </a>
      
      <div class="flex items-center gap-4">
        <!-- Language Switcher to FR -->
        <a href={`../../../enquetes/${entry.slug}/`} class="text-xs font-mono bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 px-3 py-1.5 rounded-lg border border-amber-500/30 transition flex items-center gap-1.5 font-bold">
          <span>🇫🇷</span> <span>Version Française</span>
        </a>
        <div class="hidden sm:block text-xs text-slate-400 font-mono bg-slate-900 px-3.5 py-1.5 rounded-full border border-slate-800">
          INVESTIGATION #{data.id.toString().padStart(2, '0')} | {data.ref}
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12">
    <!-- Article Header -->
    <div class="mb-12 border-b border-amber-500/30 pb-10">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <span class="px-3.5 py-1 bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded-full text-xs font-bold uppercase tracking-wider font-mono">
          {data.category}
        </span>
        <span class="text-xs text-slate-400 font-mono">{data.date}</span>
        {data.status === 'cloturee' && (
          <span class="px-3 py-0.5 bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 rounded-full text-[11px] font-mono font-bold flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span>Sealed Record · Last Contradictory Verification: September 2026</span>
          </span>
        )}
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-slate-100 font-serif leading-tight mb-4">
        {data.title}
      </h1>

      {data.subtitle && (
        <h2 class="text-lg md:text-2xl font-bold text-amber-400 font-serif leading-snug mb-6 opacity-95">
          {data.subtitle}
        </h2>
      )}

      <p class="text-xl md:text-2xl text-slate-300 font-serif leading-relaxed mb-8 opacity-90 border-l-2 border-slate-700 pl-6 my-6 font-light">
        {data.chapeau}
      </p>

      <div class="flex flex-wrap items-center justify-between gap-4 text-sm text-slate-400 pt-4 border-t border-slate-800/80 font-sans">
        <div><strong>Investigation Desk :</strong> {data.author}</div>
        <div><strong>Forensic Audit Tool :</strong> <code class="bg-slate-900 px-2.5 py-1 rounded text-cyan-400 font-mono text-xs border border-cyan-500/20">{data.tool}</code></div>
      </div>

      <!-- Citizen Sharing & Printable A4 Briefing Module (Top of Article) -->
      <div class="mt-6 pt-4 border-t border-slate-800/60 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="flex items-center gap-3">
          <span class="text-xs font-mono text-amber-400 uppercase tracking-wider font-semibold flex items-center gap-1.5">
            <span>📤</span> Share :
          </span>
          <ShareButtons title={data.title} chapeau={data.chapeau} />
        </div>
        <button 
          onclick="window.print()" 
          class="no-print inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-amber-400 border border-amber-500/30 text-xs font-mono font-bold transition shadow-sm cursor-pointer"
          title="Print this investigation in high-fidelity A4 citizen briefing format"
        >
          <span>🖨️</span>
          <span>Print A4 Briefing</span>
        </button>
      </div>
    </div>

    <!-- Official Photographic Document -->
    {data.image && (
      <div class="mb-8 rounded-2xl overflow-hidden border border-amber-500/30 shadow-2xl bg-slate-950 group">
        <img src={imgPath} alt={data.title} class="w-full object-cover max-h-[480px] group-hover:scale-105 transition duration-700" />
        <div class="p-3 bg-slate-900/90 text-xs font-mono text-slate-400 border-t border-slate-800 flex justify-between items-center">
          <span>{data.imageCaption || `📷 Official Photographic Document — ${data.title}`}</span>
          <span class="text-amber-400">SOVEREIGN CITIZEN ARCHIVE</span>
        </div>
      </div>
    )}

    <!-- Main Article Body -->
    <!-- 🎙️ Audio Briefing Player (visible only when audioBriefingFr or audioBriefingEn is defined in frontmatter) -->
    <AudioBriefing srcFr={data.audioBriefingFr} srcEn={data.audioBriefingEn} lang="en" />

    <article class="article-body font-serif text-lg leading-relaxed text-slate-200 space-y-6">
      <Content />
    </article>

    <!-- Forensic Seal ISO 27037 & Digital Chain of Custody (Investigation Closing Certification) -->
    <div class="mt-16 pt-8 border-t border-amber-500/30">
      <ForensicSeal 
        id={data.id}
        refCode={data.ref}
        author={data.author}
        date={data.date}
        tool={data.tool}
        sources={data.sources || []}
        lang="en"
      />
    </div>

    <!-- Primary Sealed Evidence Viewer (Certified Primary Archive) -->
    {data.sources && data.sources.length > 0 && (
      <EvidenceViewer source={data.sources[0]} id={data.id} lang="en" />
    )}

    <!-- Citizen Mobilization & Sharing Callout (Article Footer) -->
    <div class="mt-12 p-6 rounded-2xl bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border border-amber-500/30 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="font-serif font-bold text-slate-100 text-base">You hold the power to act</h4>
        <p class="font-sans text-xs text-slate-400">Light travels through you. Share this investigation to break the digital silence.</p>
      </div>
      <ShareButtons title={data.title} chapeau={data.chapeau} />
    </div>

    <!-- CERTIFIED OFFICIAL STATE REGISTRIES & PRIMARY ARCHIVES SECTION -->
    {data.sources && data.sources.length > 0 && (
      <div class="mt-16 bg-slate-950 border border-emerald-500/30 p-6 md:p-8 rounded-2xl shadow-2xl space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <h3 class="text-lg md:text-xl font-bold font-sans text-emerald-400 flex items-center gap-2">
            <span>📚 Certified State Registries & Primary Archives ({data.sources.length})</span>
          </h3>
          <span class="text-[10px] font-mono bg-emerald-500/10 text-emerald-300 px-3 py-1 rounded-full border border-emerald-500/30">
            IMMUABLE SHA-256 CHECKSUMS
          </span>
        </div>

        <!-- EXPLANATORY BANNER -->
        <details class="bg-slate-900/90 border border-cyan-500/40 rounded-xl p-4 cursor-pointer group">
          <summary class="font-sans font-bold text-xs text-cyan-300 flex items-center justify-between select-none">
            <span class="flex items-center gap-2">💡 <b>How does our evidence and primary source verification system work?</b> (Click to expand)</span>
            <span class="text-slate-500 group-open:rotate-180 transition transform">▼</span>
          </summary>
          <div class="mt-3 text-[11px] font-mono text-slate-300 space-y-2 leading-relaxed border-t border-slate-800 pt-3">
            <p>
              🔒 <b>Why a SHA-256 checksum?</b> On the internet, state decrees and official records can be altered or removed. The cryptographic SHA-256 fingerprint represents the unalterable digital identity of the original source. It serves as scientifically inviolable forensic evidence.
            </p>
            <p>
              🏛️ <b>How to access complete documents?</b> Official treaties and state papers belong in the public domain. Clicking on <i>"Access Official Source"</i> connects you directly to primary institutional repositories (National Archives, Library of Congress, UN Digital Library).
            </p>
          </div>
        </details>

        <div class="grid grid-cols-1 gap-4">
          {data.sources.map((src: any, index: number) => {
            const rawTarget = src.pdfDirect || src.url;
            let finalHref = rawTarget;
            if (!rawTarget.startsWith('http')) {
              const cleanTarget = rawTarget.replace(/^(\.\.\/)+/, '').replace(/^\//, '');
              finalHref = `../../../${cleanTarget}`;
            }
            return (
              <div class="bg-slate-900/90 border border-slate-800 hover:border-emerald-500/60 p-5 rounded-2xl transition flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-lg">
                <div class="space-y-1.5">
                  <div class="text-sm font-sans font-bold text-slate-100 flex items-center gap-2">
                    <span class="text-emerald-400 font-mono font-bold">[{index + 1}]</span> 
                    <span>{src.name}</span>
                  </div>
                  <div class="text-[11px] font-mono text-slate-400 flex items-center gap-2">
                    <span class="text-emerald-300 font-bold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">CERTIFIED OFFICIAL SOURCE</span>
                    {src.sha256 && (
                      <span class="font-mono text-[10px] text-slate-500 bg-slate-950 px-2 py-0.5 rounded border border-slate-800">
                        SHA-256: {src.sha256.substring(0, 8)}...
                      </span>
                    )}
                  </div>
                </div>
                
                <a 
                  href={finalHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 w-full md:w-auto px-5 py-2.5 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold rounded-xl font-mono text-xs transition shadow-lg shadow-emerald-500/20 flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider"
                >
                  <span>📥 Access Official Source (1-Click) →</span>
                </a>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <!-- Back Button -->
    <div class="mt-16 text-center">
      <a href="../../../en/" class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 font-bold text-base rounded-xl hover:from-amber-400 hover:to-amber-500 transition shadow-lg shadow-amber-500/20 font-sans">
        <span>← Return to Investigations Directory</span>
      </a>
    </div>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-8 px-6 mt-20 text-center text-xs text-slate-500 font-mono">
    L'OCHJU — THE EYE OF CORSICA | INDEPENDENT CITIZEN INVESTIGATION
  </footer>
</Layout>

<style is:global>
  /* --- INFOGRAPHIES ET ERGONOMIE VISUELLE DANS LES ARTICLES (IDENTIQUE FR) --- */
  
  .article-body h2 {
    font-family: 'Inter', sans-serif;
    font-size: 1.75rem;
    font-weight: 800;
    color: #f8fafc;
    margin-top: 2.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #d4af37;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .article-body h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #38bdf8;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .article-body p {
    color: #e2e8f0;
    line-height: 1.85;
    margin-bottom: 1.5rem;
    white-space: normal !important;
    word-break: break-word;
  }

  /* INFOGRAPHIE CARTE CONSTAT D'AUDIT ET DONNÉES CLÉS (MULTI-LIGNES, ZERO DÉFILEMENT HORIZONTAL) */
  .article-body blockquote {
    position: relative;
    border-left: 5px solid #d4af37;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
    padding: 1.75rem 2rem;
    margin: 2rem 0;
    font-style: normal !important;
    color: #fef08a;
    border-radius: 0 16px 16px 0;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(212, 175, 55, 0.15);
    white-space: normal !important;
    word-wrap: break-word !important;
    overflow-x: visible !important;
    max-width: 100% !important;
  }

  .article-body blockquote::before {
    content: "💡 FORENSIC AUDIT & KEY HISTORICAL EVIDENCE";
    display: block;
    font-family: 'Inter', monospace;
    font-size: 0.8rem;
    font-weight: 800;
    color: #d4af37;
    margin-bottom: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-body blockquote p {
    color: #fef08a !important;
    font-size: 1.05rem;
    line-height: 1.8 !important;
    margin-bottom: 0.5rem !important;
    white-space: normal !important;
    word-break: normal !important;
  }

  .article-body ul, .article-body ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    white-space: normal !important;
  }

  .article-body li {
    color: #cbd5e1;
    margin-bottom: 0.6rem;
    line-height: 1.7;
    white-space: normal !important;
  }

  .article-body strong {
    color: #ffffff;
    font-weight: 700;
  }

  .article-body code {
    background-color: #090d16;
    color: #38bdf8;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-family: monospace;
    font-size: 0.88em;
    border: 1px solid rgba(56, 189, 248, 0.2);
    white-space: normal !important;
  }

  .article-body hr {
    border-color: #334155;
    margin: 2.5rem 0;
  }
</style>
