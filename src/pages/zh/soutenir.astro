---
import Layout from '../../layouts/Layout.astro';
import SoutienCitoyen from '../../components/SoutienCitoyen.astro';
---

<Layout
  title="实质性独立与公民支持宪章 — L'OCHJU"
  description="L'OCHJU 拒绝任何公共财政补贴与商业广告，确保面向所有公众完全免费公开9项封存法务调查。"
  canonicalUrl="https://fsucieta.github.io/zh/soutenir/"
  image="/alerte_censure_lochju.jpg"
  lang="zh"
>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400;1,6..72,700&family=Noto+Sans+SC:wght@400;700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --lochju-bg: #030304;
      --lochju-surface: #0a0b0e;
      --lochju-surface-hover: #12141a;
      --lochju-border: #1a1d24;
      --lochju-border-active: #d4af37;
      --lochju-text-title: #ffffff;
      --lochju-text-body: #d1d5db;
      --lochju-text-muted: #848a96;
      --lochju-gold: #f59e0b;
      --lochju-gold-light: #fbbf24;
      --lochju-gold-glow: rgba(245, 158, 11, 0.25);
    }
    body {
      background-color: var(--lochju-bg) !important;
      color: var(--lochju-text-body) !important;
      font-family: 'Inter', system-ui, sans-serif !important;
    }
    .font-press {
      font-family: 'Newsreader', Georgia, serif !important;
      letter-spacing: -0.015em;
    }
    .font-mono-tech {
      font-family: 'JetBrains Mono', monospace !important;
      font-variant-numeric: tabular-nums;
    }
    .theme-surface {
      background-color: var(--lochju-surface) !important;
      border-color: var(--lochju-border) !important;
    }
  </style>

  <!-- HEADER OFFICIEL L'OCHJU -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <a href="/zh/" class="group flex justify-center py-1" aria-label="L'OCHJU">
        <img 
          src="/logo_l_ochju_intact_100pct.png" 
          alt="L'OCHJU" 
          class="h-12 md:h-14 w-auto object-contain filter drop-shadow-[0_2px_12px_rgba(245,158,11,0.25)] group-hover:drop-shadow-[0_4px_20px_rgba(245,158,11,0.5)] transition duration-300"
        />
      </a>

      <div class="w-48 flex justify-end items-center gap-3">
        <a href="/zh/" class="text-xs font-mono bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 px-3 py-1.5 rounded-lg border border-amber-400/50 transition flex items-center gap-1.5 font-bold">
          <span>← 返回已封存司法调查卷宗</span>
        </a>
      </div>

    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16 space-y-16">

    <!-- 1. MANIFESTE DOCTRINAL D'INDÉPENDANCE -->
    <section class="space-y-6 border-b border-white/10 pb-12">
      <div class="flex flex-wrap items-center gap-2.5 font-mono-tech text-xs">
        <span class="px-3 py-1 rounded-full bg-amber-500 text-black font-black uppercase tracking-wider text-[10px]">
          独立调查实质性宪章
        </span>
        <span class="text-amber-300 font-bold">• L'OCHJU</span>
        <span class="text-slate-400 hidden sm:inline">• 公民最高通告 · ISO/IEC 27037 证据标准认证</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-press font-black text-white leading-[1.1] tracking-tight">
        绝不可能在接受资助的同时， <br class="hidden sm:inline" />
        <span class="text-amber-400">对掌权者展开真正自由的调查。</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-200 font-press leading-relaxed max-w-4xl border-l-2 border-amber-500 pl-5 sm:pl-6">
        L'OCHJU 不申请任何法国国家资助，不获取科西嘉地方当局财政拨款，严拒一切商业广告赞助。
      </p>

      <p class="text-sm sm:text-base text-slate-400 font-press leading-relaxed max-w-3xl">
        在公帑预算深层影响媒体生态的岛屿上，拒绝接受任何公款资助是我们保持调查绝对客观与司法威力的唯一凭据。
      </p>
    </section>

    <!-- 2. LES 3 PILIERS D'HONNEUR L'OCHJU -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="theme-surface border rounded-2xl p-6 space-y-3">
        <div class="font-mono-tech text-xs font-bold text-amber-400 uppercase tracking-widest border-b border-white/10 pb-2 flex items-center justify-between">
          <span>01 · 零负债</span>
          <span>🏛️</span>
        </div>
        <h2 class="text-base font-bold font-press text-white">
          零公共财政资金
        </h2>
        <p class="text-xs font-press text-slate-400 leading-relaxed">
          我们无须向任何行政长官、地方官员或跨国财团妥协汇报。
        </p>
      </div>

      <div class="theme-surface border rounded-2xl p-6 space-y-3">
        <div class="font-mono-tech text-xs font-bold text-cyan-400 uppercase tracking-widest border-b border-white/10 pb-2 flex items-center justify-between">
          <span>02 · 自由意愿</span>
          <span>⚖️</span>
        </div>
        <h2 class="text-base font-bold font-press text-white">
          无任何强制赞助门槛
        </h2>
        <p class="text-xs font-press text-slate-400 leading-relaxed">
          不设捆绑式订阅，绝不道德绑架。每一次支持都是公民自主决策的独立声援。
        </p>
      </div>

      <div class="theme-surface border rounded-2xl p-6 space-y-3">
        <div class="font-mono-tech text-xs font-bold text-emerald-400 uppercase tracking-widest border-b border-white/10 pb-2 flex items-center justify-between">
          <span>03 · 公共福祉</span>
          <span>📖</span>
        </div>
        <h2 class="text-base font-bold font-press text-white">
          100% 永久免费开放
        </h2>
        <p class="text-xs font-press text-slate-400 leading-relaxed">
          司法级法务证据绝非商品。我们封存的调查报告面向全社会永久免费开放查阅。
        </p>
      </div>
    </section>

    <!-- 3. LE MODULE MAÎTRE DE SOUTIEN -->
    <SoutienCitoyen variant="full" idPrefix="poly_soutien_" />

    <!-- 4. DEVISE SOLENNELLE -->
    <section class="pt-10 border-t border-white/10 text-center space-y-6">
      <p class="font-press italic text-amber-400 text-sm sm:text-base max-w-2xl mx-auto">
        « 共享的知识是我们的制衡力量。L'OCHJU，是永不再回避的目光。—— L'OCHJU 调查小组 »
      </p>

      <div>
        <a 
          href="/zh/" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-black/60 border border-white/20 hover:border-amber-400 text-white font-mono-tech text-xs font-bold uppercase tracking-wider transition"
        >
          <span>← 返回已封存司法调查卷宗</span>
        </a>
      </div>
    </section>

  </main>

  <footer class="border-t border-slate-800 bg-slate-950 py-10 px-6 mt-20 text-center font-mono-tech text-xs text-slate-500 space-y-3">
    <div class="text-slate-300 font-bold uppercase tracking-widest">
      L'OCHJU — CELLULE D'INVESTIGATION CITOYENNE & OPEN DATA
    </div>
    <div class="text-[11px] text-slate-600 font-sans max-w-3xl mx-auto leading-relaxed">
      Édition citoyenne non professionnelle à but non lucratif (LCEN) · Conforme au règlement européen MiCA (UE 2023/1114).
    </div>
  </footer>
</Layout>
