---
/**
 * PAGE DÉDIÉE : /soutenir/ — MANIFESTE D'INDÉPENDANCE & SOUTIEN CITOYEN
 * Alignée à 100 % sur la charte et les évolutions de la frontpage (index.astro) :
 * - Header officiel unifié avec logo officiel intact 100%, ancre FSUCIETÀ 09.05.2026.
 * - Navigation rapide sticky par sections.
 * - Variables CSS globales identiques (--lochju-bg, --lochju-surface, etc.).
 * - Typographie Newsreader + JetBrains Mono.
 * - Largeur max unifiée (max-w-7xl).
 */
import Layout from '../layouts/Layout.astro';
import SoutienCitoyen from '../components/SoutienCitoyen.astro';
---

<Layout
  title="Manifeste d'Indépendance & Soutien Citoyen — L'OCHJU"
  description="L'OCHJU ne reçoit aucun argent public, refuse toute publicité et garantit la gratuité absolue de ses 9 enquêtes scellées pour tous les foyers corses."
  canonicalUrl="https://fsucieta.github.io/soutenir/"
  image="/alerte_censure_lochju.jpg"
  lang="fr"
>
  <!-- TYPOGRAPHIE PRESSE D'INVESTIGATION PRESTIGE (IDEM FRONTPAGE) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;0,6..72,800;1,6..72,400;1,6..72,700&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --lochju-bg: #030304;
      --lochju-surface: #0a0b0e;
      --lochju-surface-hover: #12141a;
      --lochju-border: #1a1d24;
      --lochju-border-active: #d4af37;
      --lochju-text-title: #ffffff;
      --lochju-text-body: #d1d5db;
      --lochju-text-muted: #848a96;
      --lochju-gold: #f59e0b;
      --lochju-gold-light: #fbbf24;
      --lochju-gold-glow: rgba(245, 158, 11, 0.25);
    }

    body {
      background-color: var(--lochju-bg) !important;
      color: var(--lochju-text-body) !important;
      font-family: 'Inter', system-ui, sans-serif !important;
    }

    .font-press {
      font-family: 'Newsreader', Georgia, serif !important;
      letter-spacing: -0.015em;
    }

    .font-mono-tech {
      font-family: 'JetBrains Mono', monospace !important;
      font-variant-numeric: tabular-nums;
    }

    .theme-surface {
      background-color: var(--lochju-surface) !important;
      border-color: var(--lochju-border) !important;
    }

    .theme-surface:hover {
      border-color: var(--lochju-border-active) !important;
    }
  </style>

  <!-- ================= HEADER OFFICIEL IDENTIQUE À LA FRONTPAGE ================= -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-4 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <!-- Gauche : Mention Discrète d'Ancrage -->
      <div class="w-48 hidden md:block">
        <span class="text-[10px] font-mono text-slate-500 uppercase tracking-widest block opacity-75 hover:opacity-100 transition">
          Powered by <strong class="text-amber-500/80 font-bold">FSUCIETÀ</strong>
        </span>
        <span class="text-[9px] font-mono text-slate-600 block">
          09.05.2026
        </span>
      </div>

      <!-- Centre : Logo Officiel L'OCHJU Authentique (100% Intact, Zéro Rognage) -->
      <a href="/" class="group flex justify-center py-1" aria-label="Retour à l'accueil de L'OCHJU">
        <img 
          src="/logo_l_ochju_intact_100pct.png" 
          alt="L'OCHJU — Média Citoyen (L'aveti ?)" 
          class="h-12 md:h-14 w-auto object-contain filter drop-shadow-[0_2px_12px_rgba(245,158,11,0.25)] group-hover:drop-shadow-[0_4px_20px_rgba(245,158,11,0.5)] transition duration-300"
        />
      </a>

      <!-- Droite : Retour Accueil & Langue -->
      <div class="w-48 flex justify-end items-center gap-3">
        <a href="/" class="text-xs font-mono bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 px-3 py-1.5 rounded-lg border border-amber-400/50 transition flex items-center gap-1.5 font-bold">
          <span>←</span> <span>ACCUEIL</span>
        </a>
        <a href="/en/" class="text-xs font-mono bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 px-3 py-1.5 rounded-lg border border-amber-500/30 transition flex items-center gap-1.5 font-bold">
          <span>EN</span>
        </a>
      </div>

    </div>
  </header>

  <!-- ================= NAVIGATION RAPIDE STICKY PAR SECTIONS ================= -->
  <nav class="bg-slate-950/90 border-b border-slate-800 backdrop-blur sticky top-[72px] md:top-[88px] z-40 py-2 px-4 shadow-md overflow-hidden" aria-label="Navigation rapide par sections">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-2 text-xs font-mono-tech">
      <a href="#charte" class="px-3 py-1.5 rounded-lg text-amber-300 bg-amber-500/10 border border-amber-500/30 hover:bg-amber-500/20 transition font-bold">Charte d'Indépendance</a>
      <a href="#voie-cb" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">1. Carte / Apple Pay</a>
      <a href="#voie-crypto" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">2. Cake Wallet (Monero / BTC)</a>
      <a href="#voie-citoyenne" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">3. Action Citoyenne 0 €</a>
      <a href="/" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">9 Enquêtes Scellées</a>
    </div>
  </nav>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16 space-y-16">

    <!-- ================= 1. MANIFESTE DOCTRINAL D'INDÉPENDANCE ================= -->
    <section class="space-y-6 border-b border-white/10 pb-12" id="charte">
      
      <div class="flex flex-wrap items-center gap-2.5 font-mono-tech text-xs">
        <span class="px-3 py-1 rounded-full bg-amber-500 text-black font-black uppercase tracking-wider text-[10px]">
          CHARTE D'INDÉPENDANCE MATÉRIELLE
        </span>
        <span class="text-amber-300 font-bold">· L'OCHJU 2026</span>
        <span class="text-slate-400 hidden sm:inline">· NORME ISO/IEC 27037 SCELLÉE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl md:text-6xl font-press font-black text-white leading-[1.1] tracking-tight">
        On n’enquête pas librement sur le pouvoir <br class="hidden sm:inline" />
        <span class="text-amber-400">qui vous finance.</span>
      </h1>

      <p class="text-base sm:text-xl text-slate-200 font-press leading-relaxed max-w-4xl border-l-2 border-amber-500 pl-5 sm:pl-6">
        L’OCHJU ne sollicite <strong>aucune subvention de l’État</strong>, n’émarge à <strong>aucun budget de la Collectivité de Corse</strong> ni d’aucune intercommunalité, et refuse catégoriquement toute publicité commerciale.
      </p>

      <p class="text-sm sm:text-base text-slate-400 font-press leading-relaxed max-w-3xl">
        Dans une île où les budgets institutionnels et la commande publique conditionnent l'économie des médias, refuser le moindre euro public demeure notre seul gage d'infaillibilité.
      </p>

    </section>

    <!-- ================= 2. LES 3 PILIERS D'HONNEUR L'OCHJU ================= -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <div class="theme-surface border rounded-2xl p-6 space-y-3">
        <div class="font-mono-tech text-xs font-bold text-amber-400 uppercase tracking-widest border-b border-white/10 pb-2 flex items-center justify-between">
          <span>01 · SANS DETTE</span>
          <span>🏛️</span>
        </div>
        <h2 class="text-base font-bold font-press text-white">
          Zéro euro public
        </h2>
        <p class="text-xs font-press text-slate-400 leading-relaxed">
          Nous n'avons de comptes à rendre à aucun préfet, aucun président d'exécutif, aucun groupe financier.
        </p>
      </div>

      <div class="theme-surface border rounded-2xl p-6 space-y-3">
        <div class="font-mono-tech text-xs font-bold text-cyan-400 uppercase tracking-widest border-b border-white/10 pb-2 flex items-center justify-between">
          <span>02 · LIBRE ARBITRE</span>
          <span>⚖️</span>
        </div>
        <h2 class="text-base font-bold font-press text-white">
          Zéro montant imposé
        </h2>
        <p class="text-xs font-press text-slate-400 leading-relaxed">
          Aucun palier artificiel, aucune incitation culpabilisante. Chaque soutien est un geste citoyen ponctuel et souverain.
        </p>
      </div>

      <div class="theme-surface border rounded-2xl p-6 space-y-3">
        <div class="font-mono-tech text-xs font-bold text-emerald-400 uppercase tracking-widest border-b border-white/10 pb-2 flex items-center justify-between">
          <span>03 · BIEN COMMUN</span>
          <span>📖</span>
        </div>
        <h2 class="text-base font-bold font-press text-white">
          Accès 100 % gratuit
        </h2>
        <p class="text-xs font-press text-slate-400 leading-relaxed">
          La preuve légale n'est pas une marchandise. Nos 9 enquêtes restent ouvertes en libre accès à l'ensemble du peuple corse.
        </p>
      </div>

    </section>

    <!-- ================= 3. LE MODULE MAÎTRE DE SOUTIEN (PASSERELLE CB + CAKE WALLET) ================= -->
    <SoutienCitoyen variant="full" idPrefix="page_soutien_" />

    <!-- ================= 4. DEVISE SOLENNELLE D'OUTRO ================= -->
    <section class="pt-10 border-t border-white/10 text-center space-y-6">
      <p class="font-press italic text-amber-400 text-sm sm:text-base max-w-2xl mx-auto">
        « Le Savoir partagé est notre contre-pouvoir. L'OCHJU, c'est le regard qui ne se détourne plus. — Cellule d'Investigation L'OCHJU »
      </p>

      <div>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-black/60 border border-white/20 hover:border-amber-400 text-white font-mono-tech text-xs font-bold uppercase tracking-wider transition"
        >
          <span>←</span> Retourner aux 9 Enquêtes Scellées
        </a>
      </div>
    </section>

  </main>

  <!-- ================= FOOTER OFFICIEL UNIFIÉ ================= -->
  <footer class="border-t border-slate-800 bg-slate-950 py-10 px-6 mt-20 text-center font-mono-tech text-xs text-slate-500 space-y-3">
    <div class="text-slate-300 font-bold uppercase tracking-widest">
      L'OCHJU — CELLULE D'INVESTIGATION CITOYENNE & OPEN DATA
    </div>
    <div class="text-[11px] text-slate-600 font-sans max-w-3xl mx-auto leading-relaxed">
      Édition citoyenne non professionnelle à but non lucratif (art. 6-III-2 de la loi n° 2004-575 du 21 juin 2004 — LCEN) · Conforme au règlement européen MiCA (UE 2023/1114) · Hébergement statique souverain GitHub Pages.
    </div>
  </footer>
</Layout>
