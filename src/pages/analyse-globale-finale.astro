---
import Layout from '../layouts/Layout.astro';

// Métadonnées du Grand Mémorandum
const pageTitle = "L'Inversion de la Dette : Mémorandum d'Émancipation et d'Opposabilité Constitutionnelle — L'OCHJU";
const pageDescription = "Comment 4,72 milliards d'euros sont extraits chaque année hors de Corse : autopsie médico-légale des 29 enquêtes citoyennes et architecture de rupture constitutionnelle.";
const sha256Scelle = "bb1d218c379130bc5c311d2248568baea2264fda793794b8baa50e793f91a483";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="https://fsucieta.github.io/analyse-globale-finale/"
  image="/logo_l_ochju.jpg"
  lang="fr"
>
  <!-- En-tête / Header de Navigation Interne Local -->
  <header class="border-b border-slate-800 bg-slate-950/95 backdrop-blur sticky top-0 z-50 py-3 px-6 shadow-2xl">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      
      <a href="../" class="flex items-center gap-2 text-xs font-mono text-slate-400 hover:text-amber-400 transition font-bold">
        <span>←</span> <span>Retour à l'Accueil (29 Enquêtes)</span>
      </a>

      <!-- Logo Officiel Sanctuarisé -->
      <a href="../" class="flex items-center gap-3">
        <img 
          src="../logo_l_ochju.jpg" 
          alt="L'OCHJU — Média Citoyen" 
          class="h-10 md:h-12 w-auto object-contain rounded-lg border border-amber-500/50 shadow-md"
        />
        <div class="hidden sm:block text-left">
          <span class="text-xs font-serif font-black tracking-widest text-slate-100 block">L'OCHJU</span>
          <span class="text-[9px] font-mono text-amber-400 block uppercase">Cellule d'Investigation</span>
        </div>
      </a>

      <!-- Bouton Téléchargement Direct Pièce Scellée -->
      <a 
        href="../docs/MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
        download="MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
        class="text-xs font-mono bg-amber-500 hover:bg-amber-400 text-slate-950 px-3 py-1.5 rounded-lg font-bold transition flex items-center gap-1.5 shadow"
      >
        <span>📥</span> <span class="hidden sm:inline">Mémorandum Officiel</span> <span>(PDF)</span>
      </a>

    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 md:py-16 text-slate-200">
    
    <!-- BANDEAU SUPRÊME : STATUT ET CLASSIFICATION FORENSIQUE -->
    <div class="mb-8 p-4 rounded-xl bg-slate-900/90 border border-amber-500/40 shadow-xl flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40">
          🏛️ MÉMORANDUM D'ÉTAT CITOYEN
        </span>
        <span class="text-xs font-mono text-slate-400">
          Réf : <strong class="text-slate-200">LOCHJU-MEMORANDUM-SUPREME-2026</strong>
        </span>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono text-emerald-400">
        <span>🔒 Norme ISO/IEC 27037 Scellée</span>
        <span class="text-slate-600">•</span>
        <span class="text-slate-400">Octobre 2026</span>
      </div>
    </div>

    <!-- TITRAGE MONUMENTAL -->
    <div class="mb-12 text-center md:text-left">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif font-black tracking-tight text-white mb-6 leading-tight">
        L'Inversion de la Dette : <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-200 to-amber-500">
          Le Grand Mémorandum d'Émancipation de la Corse
        </span>
      </h1>
      <p class="text-base sm:text-lg md:text-xl text-slate-300 font-sans leading-relaxed max-w-4xl">
        Comment <strong>4,72 milliards d'euros</strong> sont siphonnés chaque année hors de notre île pendant que l'État et le Sénat verrouillent l'autonomie : autopsie médico-légale des 29 enquêtes citoyennes et architecture de rupture constitutionnelle.
      </p>
    </div>

    <!-- CARTOUCHE MAÎTRE POPULAIRE : U SAPÈ CITADINU -->
    <section class="mb-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-b from-slate-900 to-slate-950 border-2 border-amber-500/60 shadow-2xl shadow-amber-500/10">
      <div class="flex items-center justify-between mb-6 pb-4 border-b border-amber-500/30">
        <div class="flex items-center gap-3">
          <span class="text-2xl">👁️</span>
          <div>
            <h2 class="text-xl font-serif font-black text-amber-400 tracking-wider">U SAPÈ CITADINU</h2>
            <p class="text-xs font-mono text-slate-400">L'Étage Populaire & L'Impact Direct par Famille Corse</p>
          </div>
        </div>
        <span class="text-xs font-mono bg-amber-500/20 text-amber-300 px-2.5 py-1 rounded border border-amber-500/30 font-bold">
          CONSOLIDATION 29 DOSSIERS
        </span>
      </div>

      <!-- 4 Cartes Chiffrées Maîtresses -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        
        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
          <span class="text-[11px] font-mono text-slate-400 block mb-1">Extraction Annuelle Brute</span>
          <span class="text-2xl sm:text-3xl font-mono font-black text-rose-500 block">4,72 Md€</span>
          <span class="text-[11px] text-slate-400 mt-1 block">Rentes, banques, fret, énergie</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/80 border border-amber-500/40">
          <span class="text-[11px] font-mono text-amber-400 block mb-1">Perte Nette par Foyer</span>
          <span class="text-2xl sm:text-3xl font-mono font-black text-amber-300 block">28 693 € / an</span>
          <span class="text-[11px] text-slate-400 mt-1 block">5 mois et demi de salaire par famille</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
          <span class="text-[11px] font-mono text-slate-400 block mb-1">Spoliation Directe</span>
          <span class="text-2xl sm:text-3xl font-mono font-black text-amber-400 block">28 693 €</span>
          <span class="text-[11px] text-slate-400 mt-1 block">Par foyer corse chaque année</span>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/80 border border-slate-800">
          <span class="text-[11px] font-mono text-slate-400 block mb-1">Dossiers d'Instruction</span>
          <span class="text-2xl sm:text-3xl font-mono font-black text-emerald-400 block">29 Scellés</span>
          <span class="text-[11px] text-slate-400 mt-1 block">100 % sous norme ISO/IEC 27037</span>
        </div>

      </div>

      <!-- Encadré Traduction Citoyenne Directe -->
      <div class="p-4 rounded-xl bg-amber-950/20 border border-amber-500/30 text-amber-100/90 text-sm leading-relaxed">
        <strong class="text-amber-300 font-bold block mb-1">En clair pour votre foyer :</strong>
        On vous répète que la Corse est « sous perfusion de 3 milliards d'euros ». C'est mathématiquement faux. Les tableaux comptables des 29 enquêtes démontrent que les monopoles d'État et les grands groupes continentaux retirent <strong>4,72 milliards d'euros chaque année</strong> de notre île. Le solde réel est en faveur de la France : la Corse enrichit les actionnaires de banques, de cargos et de centrales thermiques parisiens pendant que nos jeunes ne peuvent plus se loger sur leur propre terre.
      </div>
    </section>

    <!-- SECTION I : L'AUTOPSIE MACRO-ÉCONOMIQUE -->
    <section class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-1 rounded border border-amber-500/30">
          CHAPITRE I
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">
          L'Autopsie Macro-Économique : La Table de l'Extraction
        </h2>
      </div>

      <p class="text-slate-300 leading-relaxed mb-6">
        Chaque euro calculé ci-dessous est raccordé à une pièce administrative opposable, à un registre financier public ou à un rapport de la Cour des Comptes scellé dans nos 29 dossiers :
      </p>

      <!-- Table Macro-Économique Responsive -->
      <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950 mb-6">
        <table class="w-full text-left text-xs sm:text-sm font-sans">
          <thead class="bg-slate-900/90 text-slate-400 font-mono text-[11px] uppercase border-b border-slate-800">
            <tr>
              <th class="py-3 px-4">Dossier L'OCHJU</th>
              <th class="py-3 px-4">Secteur / Rente Opposable</th>
              <th class="py-3 px-4 text-right">Montant Brut Siphonné</th>
              <th class="py-3 px-4">Autorité Source & Preuve</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60 font-mono">
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquêtes 05 & 09</td>
              <td class="py-3 px-4 text-slate-200">Tourisme Prédateur & Évasion Dividendes SCI</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">1 200 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">DGFiP / DVF INSEE 2024</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 22</td>
              <td class="py-3 px-4 text-slate-200">Captation Bancaire (8,9 Md€ d'épargne déportée)</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">600 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Banque de France / IEDOM 2024</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 18</td>
              <td class="py-3 px-4 text-slate-200">Rente Énergétique EDF SEI & Centrale Ricanto</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">413 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Commission Régulation Énergie (CRE)</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 04</td>
              <td class="py-3 px-4 text-slate-200">Captation de l'Eau & Énergie Hydroélectrique</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">280 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Office Équipement Hydraulique (OEHC)</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 12</td>
              <td class="py-3 px-4 text-slate-200">Exil Médical EVASAN & Mercenariat Intérim</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">170 870 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">DREES SAE 2023 / ATIH</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 20</td>
              <td class="py-3 px-4 text-slate-200">Fraude aux Primes PAC & Faux Hectares</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">148 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Agence de Services et de Paiement (ASP)</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquêtes 01 & 02</td>
              <td class="py-3 px-4 text-slate-200">Surtaxes Fret Maritime & Rentes DSP</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">120 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Cour des Comptes / ADLC</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 26</td>
              <td class="py-3 px-4 text-slate-200">Monopole Pétrolier Rubis / Vito (Dépôts)</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">68 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Autorité de la Concurrence n° 20-D-15</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquête 21</td>
              <td class="py-3 px-4 text-slate-200">Rente Déchets Syvadec & Exportation Bateaux</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">65 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Chambre Régionale des Comptes (CRC)</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Enquêtes 11 & 23</td>
              <td class="py-3 px-4 text-slate-200">Servitudes Militaires & Sous-Dotation Secours</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">45 000 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">Ministère des Armées / SIS 2A-2B</td>
            </tr>
            <tr class="hover:bg-slate-900/40">
              <td class="py-3 px-4 text-amber-400 font-bold">Autres Enquêtes</td>
              <td class="py-3 px-4 text-slate-200">Transit IP Orange, Forêt Corse, Mines BRGM</td>
              <td class="py-3 px-4 text-right text-rose-400 font-bold">12 130 000 €</td>
              <td class="py-3 px-4 text-slate-400 text-xs">ARCEP / ONF / BRGM</td>
            </tr>
            <tr class="bg-amber-500/10 font-bold border-t-2 border-amber-500/50">
              <td class="py-4 px-4 text-amber-300 uppercase">TOTAL GÉNÉRAL</td>
              <td class="py-4 px-4 text-white">Extraction Annuelle Brute Hors de Corse</td>
              <td class="py-4 px-4 text-right text-amber-400 text-base sm:text-lg">4 722 000 000 €</td>
              <td class="py-4 px-4 text-emerald-400 text-xs">SCELLÉ ISO/IEC 27037</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    

    <!-- SECTION III : LE PIÈGE DE L'ARTICLE 89 -->
    <section class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-1 rounded border border-amber-500/30">
          CHAPITRE II
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">
          L'Impasse Constitutionnelle : Le Piège de l'Article 89
        </h2>
      </div>

      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4 text-slate-300 text-sm leading-relaxed">
        <p>
          Le dialogue de Beauvau engagé en 2022 est enfermé dans le carcan de l'<strong>Article 89 de la Constitution</strong>, qui exige le vote conforme dans les mêmes termes de l'Assemblée nationale et du Sénat.
        </p>
        <p>
          Le Sénat, garant de l'ordre régalien unitaire, a confirmé son droit de veto absolu : la commission des lois vient de supprimer de la copie gouvernementale la reconnaissance de la <strong>« communauté corse »</strong> et du <strong>« lien singulier à la terre »</strong>.
        </p>
        <p>
          Attendre que le Sénat accorde l'autonomie législative et fiscale revient à demander aux bénéficiaires des rentes de voter leur propre expropriation. L'Article 89 est le verrou juridique conçu pour que rien ne change jamais.
        </p>
      </div>
    </section>

    <!-- SECTION IV : L'ARCHITECTURE DE RUPTURE SOUVERAINE -->
    <section class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-1 rounded border border-amber-500/30">
          CHAPITRE III
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">
          Les 3 Clés de Déverrouillage Souverain
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        
        <div class="p-6 rounded-2xl bg-slate-950 border border-amber-500/40 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-amber-400 font-bold block mb-2">ARMURE N° 1</span>
            <h3 class="text-lg font-serif font-bold text-white mb-3">Le Titre XIII Constitutionnel</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              S'appuyer sur le précédent historique de l'Accord de Nouméa (1998) : exiger un <strong>Titre spécifique dans la Constitution</strong> adopté par accord politique ou référendum, immunisé contre le veto parlementaire ordinaire du Sénat.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
            Compétence Législative Pleine
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-950 border border-cyan-500/40 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-cyan-400 font-bold block mb-2">ARMURE N° 2</span>
            <h3 class="text-lg font-serif font-bold text-white mb-3">Le Protocole Européen Åland</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Mobiliser l'Article 174 du TFUE et le Protocole n° 2 du Traité d'Adhésion de la Finlande : instaurer le <strong>statut de résident (5 ans pour acquérir un bien)</strong> et l'autonomie fiscale reconnus par le droit primaire de l'Union Européenne.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
            Protection Foncier & Langue
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-950 border border-emerald-500/40 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono text-emerald-400 font-bold block mb-2">ARMURE N° 3</span>
            <h3 class="text-lg font-serif font-bold text-white mb-3">Régie Publique & Banque de Corse</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Créer la <strong>Banca Pupulari Corsa</strong> pour réinjecter les 8,9 Md€ d'épargne locale dans le logement des jeunes. Remplacer les DSP maritimes privées et EDF par des Régies Publiques Territoriales directes.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-800 text-[11px] font-mono text-slate-500">
            Reprise en Main des Rentes
          </div>
        </div>

      </div>
    </section>

    <!-- SECTION V : LE TRIPTYQUE DES MUNITIONS CITOYENNES -->
    <section class="mb-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-1 rounded border border-amber-500/30">
          CHAPITRE IV
        </span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-white">
          Les Munitions Citoyennes : Vos Droits Devant l'Histoire
        </h2>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border border-slate-800 shadow-xl space-y-6">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-6 border-b border-slate-800">
          <div>
            <h3 class="text-lg font-serif font-bold text-white">Le Dossier d'Instruction Intégral Scellé (ISO/IEC 27037)</h3>
            <p class="text-xs text-slate-400 mt-1">Document officiel d'autorité opposable, recueil des cotes greffes et démonstration médico-légale chiffrée (Norme ISO/IEC 27037).</p>
            <p class="text-[10px] font-mono text-slate-500 mt-1">SHA-256 : {sha256Scelle}</p>
          </div>
          <a 
            href="../docs/MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
            download="MEMORANDUM_EMANCIPATION_CORSE_LOCHJU_OFFICIEL.pdf" 
            class="py-3 px-6 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono text-xs font-black text-center transition shadow-lg whitespace-nowrap"
          >
            📥 Télécharger le Mémorandum Officiel (PDF)
          </a>
        </div>

        <div class="text-xs sm:text-sm text-slate-300 space-y-3">
          <p>
            <strong>La Doctrine de Souveraineté Populaire de L'OCHJU :</strong> Notre cellule d'investigation ne transmet aucun document aux parquets de l'État central. L'OCHJU forge les preuves mathématiques et juridiques, et les remet souverainement aux citoyens.
          </p>
          <p>
            Ce sont les usagers, les collectifs, les élus et le peuple corse qui choisissent de déposer ces dossiers devant l'Assemblée de Corse, devant le tribunal de l'opinion ou devant les juridictions européennes (CJUE, CEDH).
          </p>
        </div>
      </div>
    </section>

    <!-- SIGNATURE RITUELLE -->
    <footer class="pt-8 border-t border-slate-800 text-center">
      <blockquote class="italic text-base sm:text-lg font-serif text-slate-300 max-w-2xl mx-auto mb-4">
        « Le Savoir partagé est notre contre-pouvoir. L'OCHJU, c'est le regard qui ne se détourne plus. »
      </blockquote>
      <p class="text-xs font-mono text-amber-400 font-bold tracking-widest uppercase">
        — Cellule d'Investigation L'OCHJU —
      </p>
    </footer>

  </main>
</Layout>
