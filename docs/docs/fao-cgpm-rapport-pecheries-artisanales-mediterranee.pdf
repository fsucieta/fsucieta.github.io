uid&q;:&q;13d2a2f1-4910-4225-ac53-da5c20c29c18&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;37cd0d4b-6651-4b44-a209-2f06d3b6712a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; NRI; AWARD;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;b1e4e908-a94f-4273-8668-0267a574a195&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Africa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;8664ce58-af03-42aa-bbf3-1bc689df5ef1&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-11T11:50:47Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;0a9b37e1-7cf3-47b8-abb7-305684903256&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-11T11:50:47Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;cb3c9135-3f8f-4beb-a6da-7c1f977825e6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;02e467aa-ae8c-492b-95db-d3bc367a8fc3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-11T11:49:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;dd1b9412-5b32-476a-8420-590319c2afd4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The status of women in agrifood systems in sub-Saharan Africa provides the latest data, policy highlights and recommendations for policy- and decision-makers about gender in agrifood systems in sub-Saharan Africa. The report reviews and analyses women’s opportunities and constraints in economic and social processes in sub-Saharan Africa, while taking stock and assessing progress made in closing a series of gender gaps. It provides new directions, examples of policies and good practices that promote gender, climate and environmentally just agrifood systems in sub-Saharan Africa.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;a2c7e5f9-cc23-4aa0-9664-f16c185518d8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;274 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;c873a61d-88d6-494e-a44e-a34cf9bc0056&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140633-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7868e100-784e-4873-b39c-458942a2d9d1&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9262en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;f81887e3-f759-4b8b-8e05-65279be8eb1e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;d30c9da3-61ef-4507-b78f-fb82ec5cebc0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; African Women in Agricultural Research and Development (AWARD) ; Natural Resources Institute of University of Greenwich (NRI) ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;f470e206-9464-4165-b3db-fa4cc54732ef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;17f85e08-4a40-40ca-a368-ea8988dbb0b6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;d7da8676-218b-4ac3-a08e-70b0fded5eee&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The status of women in agrifood systems in sub-Saharan Africa&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;ac87682f-459c-4be8-bca3-c3ff23d4ff92&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;076e2399-348d-4c0c-ad24-0cc7e7cb8279&q;,&q;languag