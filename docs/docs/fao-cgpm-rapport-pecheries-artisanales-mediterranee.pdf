ly use the oceans, seas and marine resources for sustainable development&q;,&q;place&q;:6,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;92228773-b198-4f9e-8a27-281127634964&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;15. Protect, restore and promote sustainable use of terrestrial ecosystems, sustainably manage forests, combat desertification, and halt and reverse land degradation and halt biodiversity loss&q;,&q;place&q;:7,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.specialapprover.identifier&q;:[{&q;uuid&q;:&q;c4134794-cf7c-4fba-94a0-8abe3dbaa2d3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;17&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.subject.agrovoc&q;:[{&q;uuid&q;:&q;77a924fa-e3ad-4f25-98cd-1a57993f6aea&q;,&q;language&q;:&q;es&q;,&q;value&q;:&q;Efecto del cambio climático&q;,&q;place&q;:0,&q;authority&q;:&q;29055e384a074352700999c6a34235ab5270231d&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;1928f048-e634-4bcf-afdd-95153b3f4400&q;,&q;language&q;:&q;es&q;,&q;value&q;:&q;Desastre natural&q;,&q;place&q;:1,&q;authority&q;:&q;67e40817dfb0536bf20577bf6679a2022dc4b911&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;9d6d0676-68ca-4fc3-9762-dc27b362894a&q;,&q;language&q;:&q;es&q;,&q;value&q;:&q;Pérdidas y daños&q;,&q;place&q;:2,&q;authority&q;:&q;e8dba184927c609ca109e7cde1d1146b8b83cfaa&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;459e8f15-6f89-4bcb-812f-6814ddf5f8eb&q;,&q;language&q;:&q;es&q;,&q;value&q;:&q;Sistema agroalimentario&q;,&q;place&q;:3,&q;authority&q;:&q;389decfcf67db581f047c2d17036c693ec9d5601&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;f5f093e5-b4d0-4378-bc80-d63e6a6b3305&q;,&q;language&q;:&q;es&q;,&q;value&q;:&q;Producción agrícola&q;,&q;place&q;:4,&q;authority&q;:&q;93c213bfea7d4da22e1806024eaef9bb4a4cde3d&q;,&q;confidence&q;:600},{&q;uuid&q;:&q;a5e680d6-b6d6-4b3f-9637-98def76334a8&q;,&q;language&q;:&q;es&q;,&q;value&q;:&q;Recurso natural&q;,&q;place&q;:5,&q;authority&q;:&q;02a9837997b6b94a361fcb419b6b98727a668730&q;,&q;confidence&q;:600},{&q;u