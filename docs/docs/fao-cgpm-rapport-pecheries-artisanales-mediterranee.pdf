A.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;a47f586f-c9cb-48a1-ad6a-51b3b6aadaed&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Latin America and the Caribbean&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;a886c045-8f9a-489d-945a-e1bb5ddf4b6a&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T17:15:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;796aa0fa-0e09-4f9c-b00e-e9494cece45b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T17:15:15Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;6e261bd8-fbd7-4e9e-bf40-9488a4132eb7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;f96c3c73-0448-47e3-bc7c-d719b7264e4b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T17:10:13Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;0e1aa597-f1e4-4441-ad8c-513c0350caa6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;En esta publicación se presenta un análisis integral de la FAO sobre el estado de los sistemas agroalimentarios en las contribuciones determinadas a nivel nacional de América Latina y el Caribe. Se examina el grado en que estas están contribuyendo a la transformación de los sistemas agroalimentarios resilientes al clima y con bajas emisiones. Asimismo, se presentan de forma concisa las metas nacionales de adaptación y mitigación, así como los objetivos y acciones en los sistemas agroalimentarios, incluidas las necesidades de financiamiento, tecnología y fortalecimiento de capacidades.Se analizaron un total de 33 contribuciones determinadas a nivel nacional de América Latina y el Caribe presentadas al registro de contribuciones determinadas a nivel nacional de la Convención Marco de las Naciones Unidas sobre el Cambio Climático hasta el 30 de diciembre de 2023. El análisis busca identificar tendencias y desafíos relacionados con los sistemas agroalimentarios, incluidos los impactos del cambio climático y las medidas de adaptación, mitigación, necesidades de apoyo, condiciones habilitantes para la acción climática, así como la inclusión y transparencia de la acción climática desde una perspectiva sectorial. Esta publicación se dirige principalmente a planificadores y responsables de políticas públicas involucrados en la planificación nacional sobre cambio climático y sistemas agroalimentarios, con el fin de promover la coherencia de políticas, la coordinación intersectorial y la participación de múltiples actores en la implementación de las contribuciones determinadas a nivel nacional a diferentes escalas. También resulta relevante para organizaciones internacionales, organizaciones no gubernamentales de desarrollo e instituciones financieras con mandato para apoyar resultados sostenibles, inclusivos y resilientes al clima en los sistemas agroalimentarios.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;4b9cb3d3-cf8e-4b9c-92c1-bfb5a821d6a5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;125 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;9330026b-1fca-4e67-92fd-d48b91b07148&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2706-607X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;0943caf6-9196-4369-aa6f-a4d706ee1d03&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140760-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;df394afd-819c-4df7-b3ea-c775ef2b6436&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2227-4650&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;5410f9f8-0853-42ef-a9ad-dd120247fc62&q;,&q;language&q;:null,&q;value&q;:&q;htt