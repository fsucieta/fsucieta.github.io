73-499f-8cdd-38a20274a31a&q;}},&q;_name&q;:&q;The State of Agricultural Commodity Markets 2026&q;,&q;id&q;:&q;97062385-6773-499f-8cdd-38a20274a31a&q;,&q;uuid&q;:&q;97062385-6773-499f-8cdd-38a20274a31a&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;b17461b0-fb28-496c-8990-0509e825c518&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;0fa3a871-8b85-4824-b4e8-4e4a2712a3c4&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-11T11:35:29Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;530c4f1c-3278-47cd-8a45-3c2649b333ef&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-11T11:35:29Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;8a63e185-0ce7-43b0-af76-abdf6f5c3f7e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;da1070e0-5850-4c33-af8e-e025026f298a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-11T11:31:32Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;53586d11-653d-44a8-a835-e67e217a10e2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food and agricultural trade increased fivefold between 2000 and 2024, with low- and middle-income countries becoming more integrated into global markets. Yet these markets face growing exposure to shocks, including extreme weather, conflicts, pandemics, macroeconomic pressures and financial crises. The 2026 edition of The State of Agricultural Commodity Markets examines how such shocks affect trade, how disruptions are transmitted through trade linkages, and what this means for global food security. It highlights the need for trade policies that reflect the interdependence of agrifood systems, strengthen resilience and help mitigate the effects of shocks on food markets and food security.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;bae658c8-3a24-4d55-b9e3-d9a8b96012ab&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;103&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;fbee03ec-d9d8-42c4-aece-e2318f854573&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8215&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;42bc8765-62e4-4ab2-b495-26b04fd376d4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140464-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;bcbafa92-0797-421d-8b7a-7192f1e79892&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8207&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;58153405-18f5-42de-9fee-475c48207812&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8309en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;4baeef8b-55ea-4898-86d2-7fe8692f05b0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;ce3928e9-cffc-4873-8fd2-7ec5779e3f69&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;59f9b5ac-64d8-416c-b311-449e845a08df&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of Agricultural Commodity Markets (SOCO)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;2edb661f-6855-4dd9-b053-450dcd133d8c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;6744ae40-7975-4d9b-8cbb-c51a490d1eb4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q