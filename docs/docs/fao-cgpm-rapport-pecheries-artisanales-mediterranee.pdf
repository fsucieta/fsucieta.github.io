ence&q;:-1}],&q;fao.date.available&q;:[{&q;uuid&q;:&q;d0a7cf82-b857-473e-92ac-0e43ef114e4e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-26T22:00:00Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.embargo&q;:[{&q;uuid&q;:&q;02e9cae8-7105-44e9-ae8b-b79da9747e99&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.fasttrack&q;:[{&q;uuid&q;:&q;22d5fbd6-ceda-4ba8-a6ab-c9a97134063c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.doi&q;:[{&q;uuid&q;:&q;a21419ca-c01e-4d58-84cc-078ecee507f9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;https://doi.org/10.4060/cd8857en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.jobnumber&q;:[{&q;uuid&q;:&q;0fa9c052-506e-4667-b961-857d6cd5165a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CD8857EN&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.identifier.pws&q;:[{&q;uuid&q;:&q;33f56514-d879-470a-8280-d22dfa2f6d6d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;335810&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.initiator&q;:[{&q;uuid&q;:&q;661ad394-4dc3-4cd0-ae48-900a1c043d32&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Graham, Alison (OSG)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.leadauthoringunit&q;:[{&q;uuid&q;:&q;ba17d4b4-9d73-4dcd-9843-8515b69fca80&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;OSG - Office of Sustainable Development Goals&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.placeofpublication&q;:[{&q;uuid&q;:&q;29fbfbb1-74f9-4549-8434-507f2d214236&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Rome, Italy ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.previewpage&q;:[{&q;uuid&q;:&q;abe2d82f-2c46-4354-8074-9bf91cbfbfa0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;&l;p&g;The following FAO SDG briefs are available for download:&l;/p&g;&l;ul&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg1.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 1: End poverty in all its forms everywhere&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg2.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 2: End hunger, achieve food security and improved nutrition and promote sustainable agriculture&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg3.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 3: Ensure healthy lives and promote well-being for all at all ages&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg4.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 4: Ensure inclusive and equitable quality education and promote lifelong learning opportunities for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg5.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 5: Achieve gender equality and empower all women and girls&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg6.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 6: Ensure availability and sustainable management of water and sanitation for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg7.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 7: Ensure access to affordable, reliable, sustainable and modern energy for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg8.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 8: Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg9.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 9: Build resilient infrastructure, promote inclusive and sustainable industrialization and foster innovation&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg10.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 10: Reduce inequality within and among countries&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg11.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 11: Make cities and human settlements inclusive, safe, resilient and sustainable&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg12.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 12: Ensure sustainable consumption and production patterns&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg13.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 13: Take urgent action to combat climate change and its impacts&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg14.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 14: Conserve and sustainably use the oceans, seas and marine resources for sustainable development&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg15.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 15: Protect, restore and promote sustainable use of terrestrial ecosystems, sustainably manage forests, combat desertification, and halt and reverse land degradation and halt biodiversity loss&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg16.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 16: Promote peaceful and inclusive societies for sustainable development, provide access to justice for all and build effective, accountable and inclusive institutions at all levels&l;/a&g;&l;/li&g;  &l;li&g;&l;a href=\&q;https://www.fao.org/3/cd8857en/fao-sdg17.pdf\&q; target=\&q;_blank\&q;&g;FAO and SDG 17: Strengthen the means of implementation and revitalize the Global Partnership for Sustainable Development&l;/a&g;&l;/li&g;&l;/ul&g;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.sdgs&q;:[{&q;uuid&q;:&q;3ba4c138-61fd-430a-b7e2-f57f7dc5c12c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;01. End poverty in all its forms everywhere&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;1431d45f-8359-42ca-a968-af1593