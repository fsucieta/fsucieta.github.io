ate.accessioned&q;:[{&q;uuid&q;:&q;8066624d-9191-45a6-963e-c28c3fc283bb&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-25T08:30:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;7c5d42e0-ca9b-4db3-b116-31571a7f47e7&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-25T08:30:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;e4337f32-43ed-4ee7-9f5c-d4b1be53cb17&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;d333f5c8-4578-4fc1-aa5a-34b873d50d75&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-25T08:27:13Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;c6d26694-347c-48c8-b8b5-c65a4687fb7b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This report generates, presents and assesses innovative data, and extracts insights regarding land tenure systems and governance frameworks, with special focus on women&s;s land rights and the importance of customary tenure for mitigating climate change and ensuring the protection of biodiversity. Bringing together tenure- and sex- disaggregated data and analyses on land tenure and governance from a variety of sources (governments, civil society and academia) at different levels (from local to global), it builds an evidence base for action towards the achievement of numerous Sustainable Development Goals, the uptake of the Voluntary Guidelines on the Responsible Governance of Tenure of Land, Fisheries and Forests in the Context of National Food Security (VGGT), and other international frameworks (such as the Principles for Responsible Investment in Agriculture and Food Systems [CFS-RAI] and the Rio Conventions).The report also aims to provide policymakers, intergovernmental organizations, civil society, the private sector, and academia with a clear reference point on data and analyses on land tenure and governance. Moreover, it endeavours to mainstream and highlight the importance of land tenure for inclusive and sustainable development.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;8ee30ab4-e80c-47a5-896a-ed02e1135b43&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;264 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;725c3218-b317-4975-ad42-bc73da09954c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140491-1&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;323f7977-4812-408a-90ae-f69104343850&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8473en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;7e37dfaf-f053-47b4-94b1-ddd581e36fc6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7c47dad7-5565-4501-b075-0d3cf107335b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; ILC ; CIRAD ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;75ea8c24-75a4-4978-a30f-dc5383306146&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Shared&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;43a1e627-35d5-4b9f-81e4-59b16cc0c466&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;b7a03494-c84b-48e4-a472-d61945917ea5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The status of land tenure and governance&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;4a8666b7-6389-411c-98e5-af6664a5c7f8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q