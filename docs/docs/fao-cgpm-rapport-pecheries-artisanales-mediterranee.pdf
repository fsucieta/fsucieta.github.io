sion&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/a764cdc9-6bea-4600-a075-88a53c3d04aa&q;}},&q;_name&q;:&q;Wood products in the bioeconomy&q;,&q;id&q;:&q;a764cdc9-6bea-4600-a075-88a53c3d04aa&q;,&q;uuid&q;:&q;a764cdc9-6bea-4600-a075-88a53c3d04aa&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;d70e0e71-7371-4bb7-aac2-79019b270a25&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Reck, B.K.; Johnston, C.; Foong, A.; Gupta, A.; Karpov, A.; Holsten, A.; Misselwitz, P.; Keenan, R.J.; Formenton Cardoso, N.; Walter, S.; Bull, L.; Steel, E.A.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;a0ab1afc-fe38-4945-a00c-22768b1f965b&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-25T07:50:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;c2fbfbef-fa35-4130-98f2-62e0f6dc4158&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-25T07:50:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;ee69a556-a29e-4a25-b605-6a5f090de5e2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;46b1114d-84b0-42dd-b9e1-33ef58f48bfd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-25T07:46:12Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d8abcda6-c73a-4767-9707-53a3906b9cdd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;A joint FAO and Bauhaus technical report examining how greater adoption of engineered wood products (EWPs) in construction could contribute to climate change mitigation. Using the FOROM global forest model, the report runs multiple scenarios out to 2070, testing different urbanization and wood-use assumptions, to project future EWP demand, estimate carbon storage and emissions substitution benefits, and benchmark results against national climate commitments (nationally determined contributions). Even under conservative assumptions, the findings point to EWPs as a credible and scalable climate strategy within a sustainably managed forest-based bioeconomy.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;17730489-ce2a-465f-ae4b-21984fd123eb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;142 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;4769b541-8576-43b7-a6e8-45638da7d8bd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140786-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;8b8679fe-f222-47b3-bf96-105ff33b8ef3&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0315en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;76737658-93e9-40ff-ba67-63726af1062f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;a092aa8b-1862-4caa-b9aa-155f7acd9c98&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;20f4c733-2a2a-42e7-94f0-acf770d78422&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}