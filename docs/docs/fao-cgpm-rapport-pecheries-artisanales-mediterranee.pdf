tems/63b052f9-f2c1-453b-97a3-1d814facea36/bundles&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/63b052f9-f2c1-453b-97a3-1d814facea36&q;}},&q;_name&q;:&q;The State of Food Security and Nutrition in the World 2026&q;,&q;id&q;:&q;63b052f9-f2c1-453b-97a3-1d814facea36&q;,&q;uuid&q;:&q;63b052f9-f2c1-453b-97a3-1d814facea36&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;bb3cac5f-2147-46cf-a155-c00a3dc5f337&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; IFAD; UNICEF; WFP; WHO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;524e3112-aec5-40f1-9962-8b49f88acdb4&q;,&q;language&q;:null,&q;value&q;:&q;2026-07-24T12:00:56Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;b38416db-7e27-415e-a6ba-9f61432ef37c&q;,&q;language&q;:null,&q;value&q;:&q;2026-07-24T12:00:56Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;42c65939-f603-443f-b868-48ae4a85ae3e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;6359fc30-8f21-42a2-9443-e862a9ba5c0e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-07-24T11:57:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;f17c19bd-41b6-4e92-a94e-6feac863f1bd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Despite sustained, gradual improvement in recent years, global hunger and food insecurity remain far above the targets set by the 2030 Agenda for Sustainable Development. It is estimated that 645 million people faced hunger in 2025.  Beyond ensuring access to sufficient dietary energy, populations must have economic access to safe, diverse and nutritious foods. Yet, healthy diets are unaffordable for about 2.7 billion people worldwide, with the crisis deepening particularly in Africa. The 2026 edition of The State of Food Security and Nutrition in the World evaluates this pressing challenge, exploring the structural drivers behind the persistently high cost of a healthy diet. This report reveals that the high prices of nutrient-dense items – specifically animal source foods, fruits and vegetables – account for nearly 70 percent of the cost of a healthy diet. By leveraging existing data and analytical tools, it examines how geographical disparities, agricultural productivity deficits, and value chain inefficiencies, including food loss and waste, create formidable barriers to accessing a healthy diet. To sustainably achieve Zero Hunger, policymakers must implement targeted, multisectoral interventions, from shifting agricultural subsidies towards horticulture, to investing in robust cold chains and transport networks. This report provides a comprehensive strategy for governments and stakeholders aiming to structurally lower diet costs and safeguard human capital, while avoiding the hidden costs of agrifood systems.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c1c8441e-d5e2-47c2-9c7a-c166380d1c41&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;249 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;3316183e-f932-4503-a944-0fad539228e3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-807X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;ec40931d-a1f6-4bdb-ad14-5b68d1365c3e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140461-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;4f76c385-12c5-4b38-aa32-50a50260dc4a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8061&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;46f9a513-e994-466e-8936-95286b6b9d2e&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8306en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;57888ff0-218f-465b-9143-3045743ef007&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;cb6e6db1-5f95-49dd-8ef6-258d8629ef26&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; IFAD ; UNICEF ; WFP ; WHO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;bb2e905b-2dec-4189-9491-ef1149952b9e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The State of Food Security and Nutrition in the World (SOFI)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;d595b65a-5a16-4d7f-a52f-b8a0f7f409ab&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;42b746f5-9034-4bdc-97de-558da39d