tps://openknowledge.fao.org/server/api/core/items/ce338d15-a83b-4e09-992b-9d553fa6589c&q;}},&q;_name&q;:&q;General principles of food hygiene&q;,&q;id&q;:&q;ce338d15-a83b-4e09-992b-9d553fa6589c&q;,&q;uuid&q;:&q;ce338d15-a83b-4e09-992b-9d553fa6589c&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;4c87b7d7-d39d-4c17-bdfa-71e830bbae58&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WHO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;ca8c3770-55a6-455a-9cf8-57dd975709a8&q;,&q;language&q;:null,&q;value&q;:&q;2025-03-18T11:22:11Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;e8584e10-2f0d-4201-a330-88953ef54c38&q;,&q;language&q;:null,&q;value&q;:&q;2025-03-18T11:22:11Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;1becff10-7e46-4c5e-90c1-dae9c43e66ac&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2023&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;a0cadfe7-e373-41e7-af69-602684b73d19&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2025-03-18T11:17:04Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;fa46b2c0-663f-4ad8-b574-16c9042c9edf&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This document outlines the general principles that should be understood and followed by food business operators at all stages of the food chain and that provide a basis for competent authorities to oversee food safety and suitability.This edition contains a new annex which introduces tools to determine the critical control points in a hazard analysis and critical control point (HACCP) system.The term \&q;Codex Alimentarius\&q; is Latin and means \&q;food code”. Codex standards are international food texts, i.e. standards, codes of practice, codes of hygienic practice, guidelines and other recommendations, established to protect the health of the consumers and to ensure fair practices in the food trade. The collection of food standards and related texts adopted by the Codex Alimentarius Commission is known as the Codex Alimentarius.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;7ae78633-2adc-4f68-9989-06b6f7a4fdd5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;60 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;12e227a3-3774-4f9f-9e2d-d12594e1f0b5&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cc6125en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.url&q;:[{&q;uuid&q;:&q;e241e436-796d-4c4d-85fb-de7d87239f37&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;http://www.fao.org/3/cc6125en/cc6125en.pdf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;ea065c10-d743-455e-9071-9378ce5514f8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;071ecfec-a5ef-4498-9973-6e09a319aa86&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WHO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;0eee1957-3a59-4f9d-8c89-20d702d2d2f6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;33e03740-b434-497c-8cd7-70ea727342b7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;General principles of food hygiene&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;7875468b-3062-4cfc-aca1-a2d6a5372b34&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Document&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;6ea22db3-2308-4b0d-8c40-85ebfafb17b2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authori