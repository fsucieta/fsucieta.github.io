e&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;2486d248-5495-4402-930f-efb3dcf24f28&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;06af7193-69dd-4fe6-ae23-7ca25b4302e4&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;9af14a58-c77c-4749-ac84-b3dd765568d5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;5ec65351-cf1e-48c7-b665-21b8dfb08ec2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:05:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;35b06406-325a-4735-81f7-f64500e4e2e8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;يقدم تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم 2026 أحدث المعلومات والرؤى القائمة على الأدلة بشأن التحديات والفرص والحلول التي تشكّل حاضر القطاع ومستقبله.وتستعرض طبعة عام 2026 السبل التي تسلكها منظمة الأغذية والزراعة لترجمة رؤية \&q;التحوّل الأزرق\&q; إلى أثر، من خلال تنفيذ مشاريع ميدانية بالتعاون الوثيق مع الأعضاء والشركاء وأصحاب المصلحة الرئيسيين. ويسلّط التقرير الضوء على الجهود المبذولة لتعظيم مساهمة الأغذية المائية في الأمن الغذائي العالمي والحدّ من الفقر وتحقيق التنمية الاقتصادية، وتعزيز الدعوة في مجال السياسات، والنهوض بالبحوث العلمية والابتكارات، وتعزيز تنمية القدرات.ويقدم الجزء الأول استعراضًا عالميًا محدّثًا لإنتاج مصايد الأسماك وتربية الأحياء المائية والعمالة والاستخدام والتجارة، مستفيدًا من التحسينات الكبيرة في جمع البيانات وفي أدوات ومنهجيات التحليل والتقييم. ويستكشف الجزء الثاني الإجراءات التحويلية التي تضطلع بها المنظمة وأعضاؤها وأصحاب المصلحة الرئيسيون لتحفيز التغييرات اللازمة لدعم التوسّع في تربية الأحياء المائية وتكثيفها، والإدارة الفعالة لمصايد الأسماك العالمية، وتطوير سلاسل القيمة المائية. ويتناول الجزء الثالث التزامات المنظمة بتعزيز نظم الأغذية المائية على نحو شامل، مع التركيز على دور الأجهزة الإقليمية لمصايد الأسماك في ترجمة الالتزامات الدولية إلى تدابير إقليمية قابلة للتنفيذ؛ ويشدّد على أهمية البحوث والنماذج المناخية العالمية لإثراء سياسات وقرارات الإدارة التكيّفية لمصايد الأسماك. ويقدم أيضًا نظرة مستقبلية بشأن قطاع مصايد الأسماك وتربية الأحياء المائية حتى عام 2034، استنادًا إلى التوقعات.ويتوجه تقرير حالة الموارد السمكية وتربية الأحياء المائية في العالم إلى جمهور واسع ومتنامٍ من واضعي السياسات والمديرين والباحثين والجهات الفاعلة في القطاع الخاص والمجتمع المدني والمستهلكين.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c1f0d938-153f-4aac-b7eb-c3e8cdc24369&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;234 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;d8f9e332-c811-44eb-a929-82263aa72e8c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8665&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;722dea2f-9d46-402f-9f0f-2d5f55b5c1d0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140834-6&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;530b3c60-0fcf-4b73-842d-57d1dc23e054&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5519&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;072dd84e-a7c5-443c-9921-5551c613ff6a&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357ar&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;13fdf231-b02d-4a46-8118-8cfeb6ea65c7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Arabic&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;826dbdab-82ab-414e-99ce-3a9f886bdbbb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;منظمة الأغذية والزراعة ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.is