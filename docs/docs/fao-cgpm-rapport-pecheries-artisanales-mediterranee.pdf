la agricultura familiar y otras actividades económicas (diversificación), las principales características de la sociedad rural, y la presencia del sector privado. También se discuten las tendencias en la migración y otros procesos sociales o económicos relevantes para la descripción de la situación rural.\n\nEl texto también analiza la importancia del desarrollo rural para lograr los ODS mediante la identificación de la situación actual y el alcance del cambio requerido para cumplir con los ODS.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;67852209-525b-46ca-ab9d-c03a2589b2c9&q;,&q;language&q;:null,&q;value&q;:&q;25 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;cb63bcea-1044-4318-811f-dd9e83c05d80&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ca7349es&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.url&q;:[{&q;uuid&q;:&q;b428a83e-d5d1-4bf0-a72b-06b4ce6bd327&q;,&q;language&q;:null,&q;value&q;:&q;http://www.fao.org/3/ca7349es/ca7349es.pdf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;7db386bd-a7cb-4606-9409-860ebadbb00d&q;,&q;language&q;:null,&q;value&q;:&q;Spanish&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;6ccae944-d8ef-4695-88e7-82b28a7e7616&q;,&q;language&q;:null,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;38d8985e-f31d-470a-947d-88b54f800918&q;,&q;language&q;:null,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;78d7b582-542d-40ab-a7e3-63d8e2aa35ad&q;,&q;language&q;:null,&q;value&q;:&q;CC BY NC SA 3.0 IGO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;6a74d1c1-db1f-4517-8847-7a3a472264a4