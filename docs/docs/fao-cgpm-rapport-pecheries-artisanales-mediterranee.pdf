bfd287db4da/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/54f2a585-b703-4663-8537-5bfd287db4da&q;}},&q;_name&q;:&q;FAO and the SDGs&q;,&q;id&q;:&q;54f2a585-b703-4663-8537-5bfd287db4da&q;,&q;uuid&q;:&q;54f2a585-b703-4663-8537-5bfd287db4da&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;4f39cea6-b087-4d07-a2e1-4d541592ab58&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;1de7f986-b695-446f-8d37-bc043129fea9&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;6014964c-6f3b-46a0-9de1-ad6ab2d914a6&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-27T16:11:51Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;fcbc8e7b-ee66-41ba-84d5-922bdbd6dc22&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;27651153-8998-4b0f-9db7-f1f237cf3dd4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-05-27T16:02:49Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;ef797fe1-3c14-4bcb-b046-0bf3dd11eb70&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO and the SDGs – Accelerating transformation through the four betters provides a comprehensive overview of how transforming agrifood systems can drive progress across the entire 2030 Agenda for Sustainable Development. Drawing on FAO’s mandate and the Strategic Framework 2022–2031, the publication highlights the central role that sustainable, inclusive and resilient agrifood systems play in addressing global challenges such as hunger, poverty, inequality, climate change and environmental degradation.The publication brings together 17 concise briefs, one for each Sustainable Development Goal (SDG). Each brief outlines the relevance of agrifood systems to the Goal, presents key global trends and challenges, and highlights FAO’s areas of action and support to Members. It also identifies priority actions, innovations and partnerships needed to accelerate progress, offering practical entry points for governments and partners working to advance sustainable development.Together, the briefs show how progress on the SDGs is deeply interconnected with agrifood systems transformation. Framed through FAO’s four betters – better production, better nutrition, better environment and a better life – the publication presents an integrated roadmap for accelerating action across all 17 SDGs, while ensuring that agrifood systems contribute to a more sustainable, resilient and inclusive future.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;2c38ae65-e795-46ba-8ceb-27ba087be129&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;162 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;175cc114-38b7-44ce-ba03-38510bb36252&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140625-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;06a81218-55a5-4358-85d7-09b05573e18f&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8857en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;f700cbc1-bdbe-4314-9fb5-6b76c8585285&q;,