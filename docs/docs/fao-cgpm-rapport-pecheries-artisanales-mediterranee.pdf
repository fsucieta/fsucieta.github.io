erver/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/f635e477-b37a-46f8-bc10-34d56cec6332&q;}},&q;_name&q;:&q;Extreme heat and agriculture&q;,&q;id&q;:&q;f635e477-b37a-46f8-bc10-34d56cec6332&q;,&q;uuid&q;:&q;f635e477-b37a-46f8-bc10-34d56cec6332&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;ccc8e524-f2e9-4abd-9c2f-a2da8db47be6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WMO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;46c2c744-054a-481b-aea2-10710d44a31b&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;69ac4ed3-54ac-43ed-bd86-5c4680041996&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-22T07:40:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;9c1d68c9-4821-4c43-be08-7c82a8857077&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;0da23330-4e45-4ebd-a21e-cfc6a37f5853&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-22T07:36:05Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;6fa58924-3168-4e2b-adab-5aabceab4551&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Extreme heat is emerging as one of the most urgent and least understood threats to agriculture and food security. Rising temperatures, prolonged heatwaves, and shifting climate patterns are already disrupting crop yields, livestock health, water availability, and rural livelihoods – with impacts falling disproportionately on the most vulnerable.Because extreme heat is predictable, strengthening climate services and early warning systems linked to anticipatory actions is a key opportunity. It is also clear that there are profound limits to what adaptation can achieve. With global mean temperatures on the cusp of exceeding the 1.5 °C warming limit outlined in the Paris Agreement, the urgency for adaptation and mitigation action only grows. The only durable solution to protect the future of global agrifood systems from the escalating threat of extreme heat lies in ambitious, multilateral climate change mitigation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e55560e5-baad-46cd-91d7-8444915b714e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;108 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;34bd7523-779f-4215-af5b-8d0ac758a2ad&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140656-4&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;4ffce7b9-2b6f-4092-8386-94b4492e41e3&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9394en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;5d713d73-9bbf-4345-8c1c-e66e99561348&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;