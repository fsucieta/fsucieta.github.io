2d05188-3ce1-4650-92c8-d0465c7c863c&q;}},&q;_name&q;:&q;Cropland and greenhouse availability in the Gaza Strip as of 24 June 2026&q;,&q;id&q;:&q;22d05188-3ce1-4650-92c8-d0465c7c863c&q;,&q;uuid&q;:&q;22d05188-3ce1-4650-92c8-d0465c7c863c&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;28d126e2-13a3-4274-a142-6ef597318d0a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;a1e00137-fdc2-431b-97c4-a91c0c23f36e&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T12:35:24Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;6b5d8c7e-6d72-42d7-871a-0a05c98e1181&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T11:55:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;b67874c3-0701-42c7-8ef5-1f743201ac5d&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T12:35:24Z&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;ec433406-3d33-4745-8fb7-b9cef5f587f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;7523eb5d-a307-4545-8c3d-9bbb0e2c7fdb&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T11:53:26Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;2fb7e801-1bd6-49b2-84c2-f3e484a5312e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Cropland and greenhouse availability were assessed as areas that were not damaged and not subject to access restrictions. The damage was evaluated by the Food and Agriculture Organization of the United Nations (FAO) and the United Nations Satellite Centre (UNOSAT) as of 29 April 2026. Accessible areas excluded locations classified by OCHA as areas of “military presence” or “areas where Israeli authorities require coordination for humanitarian movements”, as of 24 June 2026.2 Results were compared with the October 2025 assessment for both cropland and greenhouse availability.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;070e53af-5a19-4e1e-9640-5707471cafb9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;9f585aef-8047-46f3-a020-5b8f1fdbb72c&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1141en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;c9400b3d-abda-473e-998a-e5aa32f9d0f1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;5fe84de7-16e6-4081-b988-7fbb71358160&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;0c35f6d0-ed03-4511-bf59-0a386c098293&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;621472da-ec50-49b3-8486-847ab10e3f56&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;631c59e6-f634-4a39-9ff5-e1374b9eb635&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Cropland and greenhouse availability in the Gaza Strip as of 24 June 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;1292ea09-1271-42b6-8184-f45473f9904a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Brochure, flyer, fact-sheet&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q;uuid&q;:&q;40f63fc9-b004-4131-b970-447ddfd340f3&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.cardvisibilitytype&q;:[{&q;uuid&q;:&q;6743b9cc-a9a