e&q;:[{&q;uuid&q;:&q;4d5ae392-e862-4868-af66-fabddd99ec13&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:10:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;1cff338b-a573-4406-bad5-fba8d7be0e87&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;9670182d-20d1-4a8b-9939-e303776c405d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:06:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;acdb5200-619b-4673-af40-25b727a60829&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;《2026年世界渔业和水产养殖状况》以实证为依据，提供最新信息，并提出深刻见解，剖析影响行业现状与未来的挑战、机遇及解决方案。2026年报告阐述粮农组织如何与成员、合作伙伴和关键利益相关方紧密协作，通过开展实地项目，将“蓝色转型”愿景转化为实效。本报告重点介绍各方为最大限度利用水产食品促进全球粮食安全、减贫和经济发展而付出的努力，包括加强政策宣导、推进科研创新、推进能力建设等方面。&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;1b56afe2-e485-456e-a527-dfa4254332b7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;236 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;9bd7c17b-c080-41ed-a24a-0dba569dc543&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8622&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;e509978c-9b02-495b-a0df-bf4d8bc199c9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140835-3&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;fce564c9-d646-4131-8af2-30ebcf7536b8&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1020-5527&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;85dbdee8-62c2-4948-9660-7c2a8ff96e54&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8357zh&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;f0214922-e23e-42a7-a1d1-bde45261