.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;}},&q;_name&q;:&q;Food Outlook – Biannual report on global food markets&q;,&q;id&q;:&q;9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;,&q;uuid&q;:&q;9054dd1a-e9eb-456e-88f7-c6ab657f22ad&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;de1f9745-3ee7-43ab-b1cf-5f8d1d460c9b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;697ac401-6d27-4235-8cb2-e3aeca04b938&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-18T08:45:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;e811511c-c947-4490-9e0c-2c8749d988fe&q;,&q;language&q;:null,&q;value&q;:&q;2026-06-18T08:45:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;e54d5dc2-8532-4d62-88a8-e0a78bddce95&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;38b0bdc8-70e9-4aa1-a1ce-5f6fbeed5afd&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-06-18T08:39:42Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;d9bc99b6-ca1a-488a-a58c-aa303e037579&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Despite spillovers from energy and fertilizer markets into agriculture, FAO’s latest assessments point to a still relatively favourable outlook for global food commodity markets. Cereal production is expected to ease from record highs but remain at historically elevated levels. Nevertheless, the outlook remains highly contingent on weather developments, including emergence of El Niño, which continue to pose significant risks to production. At the same time, rising conflicts and geopolitical tensions, uncertainty surrounding trade policies, as well as broader macroeconomic headwinds, weigh on trade prospects and market stability.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;f2d9740b-faa4-4d54-9297-e8bd5b2ac210&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;137 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;2530a6f6-53d8-406e-84d5-35b317b1ab5b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1560-8182&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a3fee82a-da69-4a2d-b5bb-39ceb10f8f57&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140448-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;498cb5d4-9ac0-4896-8bc8-32b7b8ba9143&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;0251-1959&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;f8d19a7a-f959-4654-9278-f7ef74a8eed7&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce0204en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;e0bdb11b-1f5f-47a2-85a2-3d949d27f444&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;a18ff4cb-51e7-4e0b-a5b8-05134a42daf4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;d2f132d0-e998-4f23-9e54-3b1dd9175e68&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Food Outlook&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;492d1ded-6e0f-47d6-8dfa-a4d7cd4185f9&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;June 2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;ce