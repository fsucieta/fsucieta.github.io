b828688a-34d5-4e08-8421-423f57b81c87/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/b828688a-34d5-4e08-8421-423f57b81c87&q;}},&q;_name&q;:&q;Guidance for conducting financial performance reviews of fishing fleets&q;,&q;id&q;:&q;b828688a-34d5-4e08-8421-423f57b81c87&q;,&q;uuid&q;:&q;b828688a-34d5-4e08-8421-423f57b81c87&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;ba1e1069-6c22-46e9-b19a-8e1b6f6d73c1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Kitts, A.;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;24d2f29c-c016-41a2-aabd-79ce0b7f116e&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T13:00:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;b427b34d-d3f4-471e-bb5b-4027a59029a5&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T13:00:16Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;082f5293-d469-443d-851e-4845673a49a7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;0d7716da-4711-4ea9-85fd-4d5571db49ee&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T12:58:43Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;9eea970f-1a99-4893-86f3-77fcf29d7c9f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;This circular presents guidance for conducting financial performance reviews of fishing fleets as part of the next generation of FAO techno-economic fleet performance assessments. Building on previous FAO Techno-economic fleet performance reviews and best practice guidance from the National Oceanic and Atmospheric Administration of the United States of America, it introduces revised definitions for revenues, costs and financial indicators to improve consistency and comparability across countries and fleet segments. The methodology proposed adopts harmonized financial reporting based on income statement and cash flow approaches and incorporates new indicators, including earnings before interest, taxes, depreciation and amortization (EBITDA), return on fixed assets, fuel intensity and fuel efficiency, while simplifying asset valuation and depreciation.The circular also includes a practical training manual to support fisheries economists and data collectors in survey design, collecting representative vessel-level financial data and applying standardized definitions for revenues, labour, running, vessel, overhead and capital costs. The detailed guidance is complemented by two Excel-based tools for vessel- and fleet-level data entry that automatically generate financial statements and calculate standardized indicators. Together, the methodology, training manual and Excel-based tools provide a practical framework for producing reliable, internationally comparable financial performance profiles of fishing fleets to support fisheries management and policy development.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;01227a33-2f64-4977-bcdb-3034e1d0ce63&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;26 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;6d1482e4-68e8-4f35-9ecd-82e9d07daa2e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140919-0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;46134695-d0d9-4c7e-bc0c-5ad7d05de202&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2070-6065&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;ec1ab8eb-e3dc-418b-9b06-0f84de17b1d9&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1048en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;bdb89eb6-e4a6-474d-9cc3-9d8d66a4a626&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;d5dba13d-5f66-400e-b6fa-3398f17f77e2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;f67cb33d-c758-47d3-9a1a-22a1dd0895ec&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO Fisheries and Aquaculture Circular&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.number&q;:[{&q;uuid&q;:&q;d12d38aa-47fb-42b4-bb3c-10623086ffd5&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;No. 1286&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;f0d20924-0c20-4be2-8bbd-c79b1abcd82f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;c0b3f05b-e4f2-4b6c-8460-62b25938a533&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;27698184-02bc-47c5-94bf-ac9b6ffe314b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Guidance for conducting financial performance reviews of fishing fleets&q;,&q;place&