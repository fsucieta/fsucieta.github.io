null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;4c68a47f-e746-401c-b71a-b1602afe56c6&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-04T14:05:17Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;7248586e-f847-4bec-bcf8-d2abd6bfaebc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;afb83d1e-30e7-42cc-9448-e68d6aac45b4&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-04T14:03:34Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;ff3d449d-497b-4a82-a7be-150ac1c1d26c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;L’édition de 2026 de La Situation mondiale des pêches et de l’aquaculture fournit les informations et les analyses factuelles les plus récentes sur les défis, les opportunités et les solutions qui façonnent le présent et l’avenir du secteur. Le rapport montre comment la FAO traduit la vision de la transformation bleue dans des résultats concrets, par le biais des projets de terrain qu’elle mène en étroite collaboration avec ses membres, ses partenaires et les principales parties prenantes. Il présente les actions réalisées afin de maximiser la contribution des produits alimentaires d’origine aquatique à la sécurité alimentaire mondiale, à la réduction de la pauvreté et au développement économique, ainsi que les efforts déployés pour orienter les politiques, faire progresser la recherche scientifique et l’innovation, et favoriser le renforcement des capacités.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;c989dadd-4b03-4f7f-a12b-f335d2562659&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;256 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;597eee4d-7d5e-4621-99a4-05e03116734d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2663-8371&q;,&q;place&q;:0,&q;aut