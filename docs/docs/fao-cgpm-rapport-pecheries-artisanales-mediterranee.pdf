af217d-356b-4c44-a367-960ff79914f1/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/84af217d-356b-4c44-a367-960ff79914f1/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/84af217d-356b-4c44-a367-960ff79914f1&q;}},&q;_name&q;:&q;Twelve misconceptions about agrosilvopastoral systems – and how to overcome them&q;,&q;id&q;:&q;84af217d-356b-4c44-a367-960ff79914f1&q;,&q;uuid&q;:&q;84af217d-356b-4c44-a367-960ff79914f1&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;0362664e-2705-4b0d-a692-869168015678&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;9c2b2abb-20cc-4083-84c8-2e945cd804f8&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T12:15:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;b25e479e-f95c-4086-bef1-db4cc78e047b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-14T12:15:14Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;927d62da-a2af-4bac-90b3-843c568612e6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;2dd647a7-632f-4601-853c-e225072ae7ef&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-08-14T12:13:36Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;b2f2aa6a-2ed0-4719-a72d-df59e229b407&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Agrosilvopastoral systems can contribute to food security, resilient livelihoods, biodiversity, climate adaptation and sustainable land management. Yet they are often reduced to simplified practice, such as grazing under trees or adding trees to livestock and farming landscapes; this brochure examines 12 common misconceptions about agrosilvopastoral systems and explains how evidence, policy and practice can overcome them. It presents these systems as deliberately managed socio-ecological systems linking forests, trees and shrubs, rangelands, crops and forage, livestock and other animal species, people, knowledge systems, institutions and value chains. It highlights managed interactions, multifunctionality, biodiversity, social diversity, tenure, mobility and equitable participation, and concludes with five principles for moving from isolated interventions towards locally adapted and inclusive system transformation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e02cc993-3e4f-4536-a628-143a363c2b4a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;35 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;fad3d3a0-c35d-44e8-abc3-183f2f804013&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ce1144en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;493ef534-2e69-4f1c-8254-9a3c5193625f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;36f5c831-e1bb-46b2-ae2d-10b417fcdb4d&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;9ec7dfec-9935-4ca7-842f-80ab3c856f4c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;6bde6097-ff7a-48f6-9cf4-8a0df81a09f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;b8fc8d29-01cd-46dd-87d1-e65f8b10f352&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Twelve misconceptions about agrosilvopastoral systems – and how to overcome them&q;,&q;place&q