  <ds-selective-truncatable _ngcontent-sc866="" _nghost-sc864="" class="ng-star-inserted">
<div _ngcontent-sc864="" dsdragclick="">
    
    <a _ngcontent-sc866="" rel="noopener noreferrer" class="lead item-list-title dont-break-out text-primary ng-star-inserted" href="/items/3a1a6dad-beac-4d19-bf76-4f6de874954f" target="_self">Review of the Biennial Transparency Reports of the countries of Europe and Central Asia</a><!---->
    <!---->
    <h6 _ngcontent-sc866="" class="mt-1 ng-star-inserted">Loss and damage in agriculture</h6><!---->
    <span _ngcontent-sc866="" class="flex-group text-muted d-block mt-1">
      <span _ngcontent-sc866="" class="item-list-date py-1 ng-star-inserted">2026</span><!---->
      <ds-language-availability _ngcontent-sc866="" _nghost-sc865="" class="d-none"><ds-metadata-field-wrapper _ngcontent-sc865="" _nghost-sc219="" class="ng-star-inserted"><div _ngcontent-sc219="" class="simple-view-element">
  <h5 _ngcontent-sc219="" class="simple-view-element-header ng-star-inserted">Also available in:</h5><!---->
  <div _ngcontent-sc219="" class="simple-view-element-body">
    <ds-atmire-show-more _ngcontent-sc865="" _nghost-sc617="" class="ng-tns-c617-20 ng-star-inserted">
<div _ngcontent-sc617="" class="show-more ng-tns-c617-20 d-flex">
  <ds-atmire-object-collection _ngcontent-sc617="" class="ng-tns-c617-20 ng-tns-c616-21 ng-star-inserted" _nghost-sc616="">
