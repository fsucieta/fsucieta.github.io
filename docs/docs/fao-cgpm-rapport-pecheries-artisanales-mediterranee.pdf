2030 (WCA 2030), is intended to provide guidance on agricultural censuses carried out by countries in the period between 2026 and 2035. The census of agriculture continues to play a key role in the collection of structural data on the agriculture sector. The WCA 2030 aims to provide countries with the tools and knowledge necessary to conduct comprehensive and accurate agricultural censuses, ensuring that the data collected is relevant, timely, internationally comparable and actionable.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;f8faa48a-cac9-4c27-a2df-ec431870b19a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;232 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.eissn&q;:[{&q;uuid&q;:&q;97c2e028-8596-4baf-bc67-c0b59755602c&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2664-746X&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;a3da7aaa-45fb-4d3e-bc02-be7ada76d3cc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140661-8&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.issn&q;:[{&q;uuid&q;:&q;ed0e90b4-2b07-473f-9919-cf4f378ccc0b&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;1014-3378&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;19c7199b-55f1-4158-843d-ccf74a2f54c4&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9437en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;0004d76d-6c81-49ae-9309-9c671ed99908&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;ce1b8e5a-930e-4fb7-b062-d6476f4a08f0&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.ispartofseries&q;:[{&q;uuid&q;:&q;0734cd69-f062-4fe2-8d07-ef1970f4ad92&q;,&q