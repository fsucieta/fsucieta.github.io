ta&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;0597fc7b-7230-42ac-86f3-1de8a30d17f3&q;,&q;language&q;:null,&q;value&q;:&q;Popkin,  B.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.coverage.spatial&q;:[{&q;uuid&q;:&q;7ae7922c-b20e-424b-9b32-395c721f5a63&q;,&q;language&q;:null,&q;value&q;:&q;Latin America and the Caribbean&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;fd4ec2e8-3722-405a-bb79-ff7d32a3e3a6&q;,&q;language&q;:null,&q;value&q;:&q;2023-04-27T13:16:59Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;20fba557-188a-4d52-b6d0-da603bb5ad11&q;,&q;language&q;:null,&q;value&q;:&q;2023-04-27T13:16:59Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;78695f4f-cf9d-46d9-9b5b-602f6f594dca&q;,&q;language&q;:null,&q;value&q;:&q;2019&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;32d5a876-99e4-4bac-a65c-106e8b4cf268&q;,&q;language&q;:null,&q;value&q;:&q;2020-02-12T09:27:22.0000000Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;e8f25ac6-ba41-401a-bc9b-0c40f0cfdcfc&q;,&q;language&q;:null,&q;value&q;:&q;The document presents a description of the structure of the rural environment, demography, the supply of goods and services, the main inequalities, levels of poverty, importance and role of family agriculture and other economic activities (diversification), the main features of rural society and the presence of the private sector. It will also discuss trends in migration and other social or economic processes relevant to the description of the rural situation.\n\nThe text will also discuss the importance of rural development in achieving the SDGs by identifying the current situation and the extent of change required to meet the SDGs.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;f3e8ab36-dc20-4c50-b434-0ee9d1c2e498&q;,&q;language&q;:null,&q;value&q;:&q;25 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;310adde2-212c-4bdf-acdd-05a6e351ffe0&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/ca7349en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.url&q;:[{&q;uuid&q;:&q;d2b3c3ac-b878-4dd4-bdac-2e621c806171&q;,&q;language&q;:null,&q;value&q;:&q;http://www.fao.org/3/ca7349en/ca7349en.pdf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;0abd06f4-5384-4224-a726-fe20e954d65a&q;,&q;language&q;:null,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;848872ac-d39f-4bd9-ae15-7da525a1e67c&q;,&q;language&q;:null,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;6cdf614b-38c7-450e-8d86-c3c006213efa&q;,&q;language&q;:null,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;6162e57a-e38a-423e-b145-87d23df69266&q;,&q;language&q;:null,&q;value&q;:&q;CC BY NC SA 3.0 IGO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;282bf2f0-aad4-4e29-832f-0c9fc40ed6ac&q;,&q;language&q;:null,&q;value&q;:&q;Ultra-processed foods’ impacts on health&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.englishtranslation&q;:[{&q;uuid&q;:&q;b0ff1c24-3a54-4fd9-b926-119d580221e9&q;,&q;language&q;:null,&q;value&q;:&q;Impactos en la salud de los alimentos ultra-procesados&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title.subtitle&q;:[{&q;uuid&q;:&q;93e0b6d8-48a9-4a4b-b55b-aa14d68b92e6&q;,&q;language&q;:null,&q;value&q;:&q;Document No. 34,  2030 - Food, agriculture and rural devel