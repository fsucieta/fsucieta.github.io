3660ada9d3/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/thumbnail&q;},&q;relateditemlistconfigs&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/572a3305-91ea-4264-8ef1-b63660ada9d3&q;}},&q;_name&q;:&q;2026 Global Report on Food Crises&q;,&q;id&q;:&q;572a3305-91ea-4264-8ef1-b63660ada9d3&q;,&q;uuid&q;:&q;572a3305-91ea-4264-8ef1-b63660ada9d3&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;cb53536f-73c7-4ff4-9d8f-dfa7088dc2e1&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO; WFP; Global Network Against Food Crises (GNAFC);&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;be65eb7b-dd3e-4358-bd21-3cad4dc1570f&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-24T07:35:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;c839eb45-0fdc-4c1f-893b-4bc21e39eef4&q;,&q;language&q;:null,&q;value&q;:&q;2026-04-24T07:35:23Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;2bef4bea-4b67-40da-9677-34b08506ef51&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;5eca9645-a676-46e3-84de-f540a8b7ed94&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-04-24T07:30:41Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;fd2b5019-760e-4c22-a5d4-e109aa95f222&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Global Report on Food Crises (GRFC) 2026 reveals that acute food insecurity and malnutrition remain at alarmingly high and deeply entrenched levels, with crises increasingly concentrated in a core group of countries. In its tenth edition, the report shows that acute hunger has doubled over the past decade, with two famines declared last year for the first time in its history.As a flagship publication of the Global Network Against Food Crises (GNAFC), the GRFC serves as the key reference for understanding acute food insecurity at global, regional and country levels. Produced through a collaborative effort among 18 partners, it provides a consensus-based assessment of acute food insecurity and malnutrition in countries affected by food crises, with the aim of informing and guiding both humanitarian and development responses.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;b076ff79-843c-4678-b791-7bedbb87b3d7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;80 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.isbn&q;:[{&q;uuid&q;:&q;730a20d7-5d13-4526-954a-fd0ef619c804&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;978-92-5-140659-5&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;1f82271e-06d9-455a-b080-1041d6e202f5&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd9424en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;f98105b4-d1cb-404b-931e-faa7e0786c21&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;7b06837c-277b-48b4-9b1d-e48da52c8e42&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ; WFP ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;96f6e9c6-65a0-4425-84f0-7943