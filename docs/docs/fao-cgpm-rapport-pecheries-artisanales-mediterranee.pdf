server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d/relateditemlistconfigs&q;},&q;self&q;:{&q;href&q;:&q;https://openknowledge.fao.org/server/api/core/items/6b19b909-9671-4db9-b494-66ca2155c39d&q;}},&q;_name&q;:&q;Highlights of science and innovation in FAO’s work&q;,&q;id&q;:&q;6b19b909-9671-4db9-b494-66ca2155c39d&q;,&q;uuid&q;:&q;6b19b909-9671-4db9-b494-66ca2155c39d&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e665e306-2cbb-4fcb-8e03-ccd3018f4a1a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;6d1679d6-2f87-45c2-b022-ec7d43a28f10&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-26T09:20:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;d030796f-cc06-4240-8019-da9d861d16f5&q;,&q;language&q;:null,&q;value&q;:&q;2026-02-26T09:20:27Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;def1da25-02e6-4b90-b734-5b5b1138207e&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.lastModified&q;:[{&q;uuid&q;:&q;e6401f95-2008-4419-ad8a-b45a44d2bc8f&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;2026-02-26T09:15:07Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;0ec43ff5-3105-4452-bb53-27dc4e7ec0f6&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;The Highlights of science and innovation in FAO’s Work report was developed to illustrate the breadth and depth of science and innovation in FAO’s efforts. The FAO Science and Innovation Strategy is a key tool to support the implementation of the FAO Strategic Framework 2022-31. The report presents examples of FAO&s;s work that reflect the Strategy’s broad scope, inclusive of all scientific disciplines and all types of innovation. The examples span FAO’s work -- from enhancing productivity to healthy diets and reducing food loss and waste, from strengthening agricultural extension and advisory services to harnessing better data and digital agriculture, from One Health to adapting to climate uncertainty, from prevention and early warning to scaling investments and development of global and regional platforms for sharing data, among others.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.format.numberofpages&q;:[{&q;uuid&q;:&q;e6ca81c5-00e5-465b-8251-d39b81a73c6a&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;71 p.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;24272960-f062-4d81-b1f6-437f9006966f&q;,&q;language&q;:null,&q;value&q;:&q;https://openknowledge.fao.org/handle/20.500.14283/cd8352en&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;ae329f7e-181e-4552-b103-a34d54b80a66&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;English&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;b685dfea-ade2-4e4b-a350-8f2eb0b980d7&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO ;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.copyright&q;:[{&q;uuid&q;:&q;b2595de9-c76a-4828-82ae-75e61aa76b97&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;FAO&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.license&q;:[{&q;uuid&q;:&q;02c38c8f-c049-4de3-9177-351ecac28da2&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;CC BY 4.0&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;ebc3bf7f-f8e6-481b-bf26-8064718e6081&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Highlights of science and innovation in FAO’s work&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;a0793168-5e62-4a8b-abff-c381436b6bfc&q;,&q;language&q;:&q;&q;,&q;value&q;:&q;Book (stand-alone)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;fao.altmetricbadge&q;:[{&q